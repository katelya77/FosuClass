.index-page {
  padding-left: 16rpx;
  padding-right: 16rpx;
}

.hero {
  padding: 24rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.brand {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 16rpx;
}

.brand-logo {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #f3f5f8;
}

.fallback-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #c62828;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
}

.brand-copy {
  min-width: 0;
}

.app-title {
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
}

.app-subtitle {
  overflow: hidden;
  max-width: 390rpx;
  margin-top: 8rpx;
  color: #687386;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.meta-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f3f6fb;
  color: #536174;
  font-size: 22rpx;
  line-height: 1.2;
}

.hero-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
}

.action-button,
.sync-button {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.action-button {
  background: #f1f4f9;
  color: #39465a;
}

.sync-button {
  background: #c62828;
  color: #ffffff;
}

.schedule {
  margin-top: 18rpx;
  overflow: hidden;
}

.schedule-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 22rpx 16rpx;
}

.schedule-hint {
  color: #8a94a6;
  font-size: 22rpx;
}

.schedule-header {
  display: flex;
  border-top: 1rpx solid #edf0f5;
  border-bottom: 1rpx solid #edf0f5;
  background: #fbfcfe;
}

.time-head {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  min-height: 72rpx;
  color: #7a8494;
  font-size: 22rpx;
}

.weekday-heads {
  display: flex;
  flex: 1;
  min-width: 0;
}

.weekday-head {
  position: relative;
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  color: #4c586a;
  font-size: 24rpx;
  font-weight: 700;
}

.weekday-head.is-today {
  color: #c62828;
}

.today-dot {
  position: absolute;
  bottom: 10rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #c62828;
}

.schedule-body {
  display: flex;
  overflow: hidden;
  background: #ffffff;
}

.time-column {
  width: 92rpx;
  border-right: 1rpx solid #edf0f5;
  background: #fbfcfe;
}

.time-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #edf0f5;
}

.section-no {
  color: #172033;
  font-size: 24rpx;
  font-weight: 800;
}

.time-text {
  margin-top: 2rpx;
  color: #9aa4b5;
  font-size: 17rpx;
  line-height: 1.1;
}

.days-area {
  display: flex;
  flex: 1;
  min-width: 0;
}

.day-column {
  position: relative;
  flex: 1;
  min-width: 0;
  border-right: 1rpx solid #edf0f5;
}

.day-column:last-child {
  border-right: 0;
}

.section-slot {
  border-bottom: 1rpx solid #edf0f5;
}
