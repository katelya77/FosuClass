.index-page {
  width: 100%;
  padding: 16rpx 16rpx calc(24rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.compact-header,
.schedule {
  width: 100%;
  overflow: hidden;
}

.compact-header {
  padding: 18rpx;
  border-radius: 14rpx;
}

.header-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-width: 0;
  min-height: 56rpx;
}

.brand {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.brand-logo {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #f1f4f8;
}

.fallback-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #c62828;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.brand-copy {
  min-width: 0;
}

.app-title {
  overflow: hidden;
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.week-badge {
  flex: 0 0 auto;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff1f1;
  color: #b4232a;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.class-line,
.date-line,
.today-line,
.source-line {
  overflow: hidden;
  color: #6b7688;
  font-size: 23rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.class-line {
  margin-top: 8rpx;
  color: #536174;
  font-weight: 700;
}

.date-line {
  margin-top: 6rpx;
}

.today-line {
  margin-top: 6rpx;
}

.source-line {
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 21rpx;
}

.disclaimer-line {
  margin-top: 8rpx;
  color: #9aa4b5;
  font-size: 21rpx;
  line-height: 1.45;
  white-space: normal;
}

.control-row,
.action-row {
  width: 100%;
  min-width: 0;
  margin-top: 14rpx;
}

.action-scroll {
  width: 100%;
  min-width: 0;
  white-space: nowrap;
}

.action-list {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 4rpx;
  vertical-align: top;
}

.chip-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 999rpx;
  background: #f7f9fc;
  color: #364358;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
}

.sync-chip {
  border-color: #f2c7c7;
  background: #fff6f6;
  color: #c62828;
}

.schedule {
  margin-top: 12rpx;
  border-radius: 14rpx;
}

.schedule-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-width: 0;
  padding: 16rpx 18rpx 12rpx;
}

.schedule-title-row .section-title {
  flex: 0 0 auto;
  font-size: 30rpx;
}

.schedule-hint {
  overflow: hidden;
  min-width: 0;
  color: #8a94a6;
  font-size: 21rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.table-shell {
  width: 100%;
  overflow: hidden;
  border-top: 1rpx solid #edf0f5;
  background: #ffffff;
}

.schedule-scroll-x {
  width: 100%;
  min-width: 0;
}

.schedule-grid {
  display: flex;
  min-width: 100%;
  background: #ffffff;
}

.time-axis {
  flex: 0 0 76rpx;
  width: 76rpx;
  border-right: 1rpx solid #edf0f5;
  background: #fbfcfe;
  position: sticky;
  left: 0;
  z-index: 10;
}

.time-head {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-bottom: 1rpx solid #edf0f5;
  color: #7a8494;
  font-size: 21rpx;
  font-weight: 700;
}

.time-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #edf0f5;
}

.section-no {
  color: #172033;
  font-size: 19rpx;
  font-weight: 800;
}

.time-text-single {
  margin-top: 4rpx;
  color: #8a94a6;
  font-size: 17rpx;
  line-height: 1.1;
  font-weight: 600;
}

.section-divider {
  border-bottom: 2rpx solid rgba(198, 40, 40, 0.25) !important;
}


.day-track {
  flex: 0 0 auto;
  min-width: 0;
}

.weekday-heads {
  display: flex;
  height: 64rpx;
  border-bottom: 1rpx solid #edf0f5;
  background: #fbfcfe;
  position: sticky;
  top: 0;
  z-index: 8;
}

.weekday-head {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #edf0f5;
  color: #4c586a;
  font-size: 22rpx;
  font-weight: 800;
}

.weekday-head:last-child {
  border-right: 0;
}

.weekday-head.is-today {
  color: #c62828;
  background: #fff7f7;
}

.weekday-date {
  margin-top: 2rpx;
  color: #9aa4b5;
  font-size: 17rpx;
  font-weight: 700;
}

.today-dot {
  position: absolute;
  bottom: 6rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #c62828;
}

.days-area {
  display: flex;
  position: relative;
}

.day-column {
  position: relative;
  flex: 0 0 auto;
  min-width: 0;
  border-right: 1rpx solid #edf0f5;
}

.day-column:last-child {
  border-right: 0;
}

.section-slot {
  border-bottom: 1rpx solid #edf0f5;
}

.day-column.is-today .section-slot {
  background: #fffafa;
}

/* ================== 新增页面优化样式 ================== */

/* 顶部压缩信息区域 */
.info-grid {
  margin-top: 12rpx;
}

.class-line {
  font-size: 28rpx;
  color: #1a202c;
  font-weight: 800;
}

.date-line {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #4a5568;
}

.separator {
  margin: 0 8rpx;
  color: #cbd5e0;
}

.today-tag {
  color: #c62828;
  font-weight: 800;
}

.source-line {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #718096;
}

.disclaimer-short {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a0aec0;
  display: flex;
  align-items: center;
}

.info-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #4a5568;
  font-size: 16rpx;
  margin-left: 6rpx;
  font-weight: bold;
}

.action-grid {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  font-size: 23rpx;
  font-weight: 800;
  border: 1rpx solid #e1e7f0;
  border-radius: 12rpx;
  background: #f7f9fc;
  color: #364358;
}

.action-btn.sync-btn {
  border-color: #fca5a5;
  background: #fef2f2;
  color: #dc2626;
}

/* 空状态卡片 */
.empty-schedule-card {
  margin-top: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 32rpx;
}

.empty-btn {
  height: 72rpx;
  line-height: 70rpx;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 36rpx;
  padding: 0 40rpx;
  background: #f7f9fc;
  color: #4a5568;
  border: 1rpx solid #cbd5e0;
}

.empty-btn.primary {
  background: #c62828;
  color: #ffffff;
  border-color: #c62828;
  box-shadow: 0 4rpx 12rpx rgba(198, 40, 40, 0.2);
}

/* 周课表控制区 */
.schedule-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 18rpx;
}

.schedule-control-wrapper {
  flex: 1;
  max-width: 460rpx;
}

/* 底部免责声明 */
.footer-disclaimer {
  margin: 32rpx 16rpx;
  font-size: 21rpx;
  color: #a0aec0;
  text-align: center;
  line-height: 1.5;
}

/* 通用弹窗遮罩与面板 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.popup-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.popup-handle {
  width: 64rpx;
  height: 8rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
  margin: 16rpx auto 8rpx;
}

.popup-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f7fafc;
}

.popup-title-block {
  min-width: 0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
}

.popup-subtitle {
  font-size: 22rpx;
  color: #718096;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.close-button {
  background: transparent;
  color: #a0aec0;
  font-size: 40rpx;
  line-height: 1;
  padding: 0;
  margin: 0;
  font-weight: 300;
}

.popup-footer {
  display: flex;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
  border-top: 1rpx solid #f7fafc;
}

.footer-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 40rpx;
  text-align: center;
}

.footer-btn.primary-btn {
  background: #c62828;
  color: #ffffff;
}

.footer-btn.secondary-btn {
  background: #f7f9fc;
  color: #4a5568;
  border: 1rpx solid #cbd5e0;
}

/* 今日提醒弹窗内容 */
.reminder-panel {
  max-height: 85vh;
}

.reminder-scroll {
  flex: 1;
  max-height: 50vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.reminder-summary {
  font-size: 28rpx;
  color: #4a5568;
  margin: 16rpx 0 24rpx;
}

.highlight-count {
  color: #c62828;
  font-weight: 800;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.reminder-item {
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 20rpx;
  background: #f7f9fc;
}

.reminder-item.ongoing {
  border-color: #fca5a5;
  border-left: 8rpx solid #ef4444;
  background: #fff5f5;
}

.reminder-item.next {
  border-color: #fed7aa;
  border-left: 8rpx solid #f97316;
  background: #fff7ed;
}

.reminder-item.finished {
  opacity: 0.6;
}

.reminder-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.reminder-course-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #1a202c;
}

.reminder-status-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  color: #4a5568;
  font-weight: bold;
}

.reminder-status-badge.ongoing {
  background: #ef4444;
  color: #ffffff;
}

.reminder-status-badge.upcoming {
  background: #3b82f6;
  color: #ffffff;
}

.reminder-status-badge.finished {
  background: #cbd5e0;
  color: #718096;
}

.reminder-item-meta {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 6rpx;
}

.reminder-meta-col {
  display: flex;
  font-size: 22rpx;
}

.reminder-meta-label {
  color: #718096;
}

.reminder-meta-val {
  color: #4a5568;
  font-weight: bold;
}

.highlight-room {
  color: #dc2626;
}

/* 强制选择课表弹窗 */
.init-popup {
  align-items: center;
}

.init-panel {
  width: 85%;
  border-radius: 24rpx;
  padding: 40rpx;
}

.init-header {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.init-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
}

.init-brand-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
  margin-top: 16rpx;
}

.init-body {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.init-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d3748;
}

.init-subtitle {
  font-size: 22rpx;
  color: #718096;
  text-align: center;
  line-height: 1.5;
  margin: 16rpx 0 32rpx;
}

.init-btn {
  width: 100% !important;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.init-btn.primary-btn {
  background: #c62828;
  color: #ffffff;
}

.init-btn.secondary-btn {
  background: #f7f9fc;
  color: #4a5568;
  border: 1rpx solid #cbd5e0;
}

.init-sync-btn {
  background: transparent;
  color: #a0aec0;
  font-size: 20rpx;
  border: none;
  margin-top: 10rpx;
}

/* 更多菜单 */
.menu-popup {
  align-items: flex-end;
}

.menu-panel {
  width: 100%;
  background: #f7f9fa;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.menu-item {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  color: #2d3748;
  border-bottom: 1rpx solid #f1f5f7;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.menu-item.danger-item {
  color: #e53e3e;
}

.menu-cancel {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  color: #718096;
  margin-top: 12rpx;
}

/* 完整免责声明弹窗 */
.disclaimer-panel {
  width: 80%;
  align-self: center;
  border-radius: 24rpx;
  padding: 24rpx;
}

.disclaimer-scroll {
  max-height: 40vh;
  padding: 16rpx 0;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #4a5568;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
