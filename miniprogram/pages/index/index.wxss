.index-page {
  width: 100%;
  padding: 16rpx 16rpx calc(24rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.compact-header,
.schedule {
  width: 100%;
  overflow: hidden;
}

.compact-header {
  padding: 18rpx;
  border-radius: 14rpx;
}

.header-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-width: 0;
  min-height: 56rpx;
}

.brand {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.brand-logo {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #f1f4f8;
}

.fallback-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #c62828;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.brand-copy {
  min-width: 0;
}

.app-title {
  overflow: hidden;
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.week-badge {
  flex: 0 0 auto;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff1f1;
  color: #b4232a;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.class-line,
.date-line,
.today-line,
.source-line {
  overflow: hidden;
  color: #6b7688;
  font-size: 23rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.class-line {
  margin-top: 8rpx;
  color: #536174;
  font-weight: 700;
}

.date-line {
  margin-top: 6rpx;
}

.today-line {
  margin-top: 6rpx;
}

.source-line {
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 21rpx;
}

.disclaimer-line {
  margin-top: 8rpx;
  color: #9aa4b5;
  font-size: 21rpx;
  line-height: 1.45;
  white-space: normal;
}

.control-row,
.action-row {
  width: 100%;
  min-width: 0;
  margin-top: 14rpx;
}

.action-scroll {
  width: 100%;
  min-width: 0;
  white-space: nowrap;
}

.action-list {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 4rpx;
  vertical-align: top;
}

.chip-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 999rpx;
  background: #f7f9fc;
  color: #364358;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
}

.sync-chip {
  border-color: #f2c7c7;
  background: #fff6f6;
  color: #c62828;
}

.schedule {
  margin-top: 12rpx;
  border-radius: 14rpx;
}

.schedule-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-width: 0;
  padding: 16rpx 18rpx 12rpx;
}

.schedule-title-row .section-title {
  flex: 0 0 auto;
  font-size: 30rpx;
}

.schedule-hint {
  overflow: hidden;
  min-width: 0;
  color: #8a94a6;
  font-size: 21rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.table-shell {
  width: 100%;
  overflow: hidden;
  border-top: 1rpx solid #edf0f5;
  background: #ffffff;
}

.schedule-scroll-x {
  width: 100%;
  min-width: 0;
}

.schedule-grid {
  display: flex;
  min-width: 100%;
  background: #ffffff;
}

.time-axis {
  flex: 0 0 76rpx;
  width: 76rpx;
  border-right: 1rpx solid #edf0f5;
  background: #fbfcfe;
}

.time-head {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-bottom: 1rpx solid #edf0f5;
  color: #7a8494;
  font-size: 21rpx;
  font-weight: 700;
}

.time-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #edf0f5;
}

.section-no {
  color: #172033;
  font-size: 19rpx;
  font-weight: 800;
}

.time-text-single {
  margin-top: 4rpx;
  color: #8a94a6;
  font-size: 17rpx;
  line-height: 1.1;
  font-weight: 600;
}

.section-divider {
  border-bottom: 2rpx solid rgba(198, 40, 40, 0.25) !important;
}


.day-track {
  flex: 0 0 auto;
  min-width: 0;
}

.weekday-heads {
  display: flex;
  height: 64rpx;
  border-bottom: 1rpx solid #edf0f5;
  background: #fbfcfe;
}

.weekday-head {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #edf0f5;
  color: #4c586a;
  font-size: 22rpx;
  font-weight: 800;
}

.weekday-head:last-child {
  border-right: 0;
}

.weekday-head.is-today {
  color: #c62828;
  background: #fff7f7;
}

.weekday-date {
  margin-top: 2rpx;
  color: #9aa4b5;
  font-size: 17rpx;
  font-weight: 700;
}

.today-dot {
  position: absolute;
  bottom: 6rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #c62828;
}

.days-area {
  display: flex;
  position: relative;
}

.day-column {
  position: relative;
  flex: 0 0 auto;
  min-width: 0;
  border-right: 1rpx solid #edf0f5;
}

.day-column:last-child {
  border-right: 0;
}

.section-slot {
  border-bottom: 1rpx solid #edf0f5;
}

.day-column.is-today .section-slot {
  background: #fffafa;
}
