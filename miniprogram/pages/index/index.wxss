.index-page {
  width: 100%;
  padding: 16rpx 16rpx calc(24rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.compact-header,
.schedule {
  width: 100%;
  overflow: hidden;
}

.compact-header {
  padding: 18rpx;
  border-radius: 14rpx;
}

.header-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-width: 0;
  min-height: 56rpx;
}

.brand {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.brand-logo {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #f1f4f8;
}

.fallback-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #c62828;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.brand-copy {
  min-width: 0;
}

.app-title {
  overflow: hidden;
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.week-badge {
  flex: 0 0 auto;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff1f1;
  color: #b4232a;
  font-size: 23rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.header-edit-btn {
  flex: 0 0 auto;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #3654d4;
  font-size: 22rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.class-line,
.schedule-subtitle,
.date-line,
.today-line,
.source-line {
  overflow: hidden;
  color: #6b7688;
  font-size: 23rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.class-line {
  margin-top: 8rpx;
  color: #536174;
  font-weight: 700;
}

.schedule-subtitle {
  margin-top: 4rpx;
  color: #8a94a6;
  font-size: 21rpx;
  font-weight: 600;
}

.date-line {
  margin-top: 6rpx;
}

.today-line {
  margin-top: 6rpx;
}

.source-line {
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 21rpx;
}

.disclaimer-line {
  margin-top: 8rpx;
  color: #9aa4b5;
  font-size: 21rpx;
  line-height: 1.45;
  white-space: normal;
}

.control-row,
.action-row {
  width: 100%;
  min-width: 0;
  margin-top: 14rpx;
}

.action-scroll {
  width: 100%;
  min-width: 0;
  white-space: nowrap;
}

.action-list {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 4rpx;
  vertical-align: top;
}

.chip-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e1e7f0;
  border-radius: 999rpx;
  background: #f7f9fc;
  color: #364358;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
}

.sync-chip {
  border-color: #f2c7c7;
  background: #fff6f6;
  color: #c62828;
}

.schedule {
  margin-top: 12rpx;
  border-radius: 14rpx;
}

.schedule-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-width: 0;
  padding: 16rpx 18rpx 12rpx;
}

.schedule-title-row .section-title {
  flex: 0 0 auto;
  font-size: 30rpx;
}

.schedule-hint {
  overflow: hidden;
  min-width: 0;
  color: #8a94a6;
  font-size: 21rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.table-shell {
  width: 100%;
  overflow: hidden;
  border-top: 1rpx solid #edf0f5;
  background: #ffffff;
}

.schedule-scroll-x {
  flex: 1;
  width: auto;
  min-width: 0;
}

.schedule-grid-shell {
  display: flex;
  align-items: flex-start;
  width: 100%;
  background: #ffffff;
}

.time-axis-layer {
  position: relative;
  z-index: 60;
  flex: 0 0 76rpx;
  width: 76rpx;
  overflow: hidden;
  background: #fbfcfe;
}

.time-axis {
  width: 76rpx;
  border-right: 1rpx solid #edf0f5;
  background: #fbfcfe;
  position: relative;
  z-index: 60;
}

.time-head {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-bottom: 1rpx solid #edf0f5;
  color: #7a8494;
  font-size: 21rpx;
  font-weight: 700;
}

.time-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #edf0f5;
}

.section-no {
  color: #172033;
  font-size: 19rpx;
  font-weight: 800;
}

.time-text-single {
  margin-top: 4rpx;
  color: #8a94a6;
  font-size: 17rpx;
  line-height: 1.1;
  font-weight: 600;
}

.section-divider {
  border-bottom: 2rpx solid rgba(198, 40, 40, 0.25) !important;
}


.day-track {
  flex: 0 0 auto;
  min-width: 0;
}

.weekday-heads {
  display: flex;
  height: 64rpx;
  border-bottom: 1rpx solid #edf0f5;
  background: #fbfcfe;
  position: sticky;
  top: 0;
  z-index: 8;
}

.weekday-head {
  position: relative;
  display: flex;
  flex: 0 0 auto;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #edf0f5;
  color: #4c586a;
  font-size: 22rpx;
  font-weight: 800;
}

.weekday-head:last-child {
  border-right: 0;
}

.weekday-head.is-today {
  color: #c62828;
  background: #fff7f7;
}

.weekday-date {
  margin-top: 2rpx;
  color: #9aa4b5;
  font-size: 17rpx;
  font-weight: 700;
}

.today-dot {
  position: absolute;
  bottom: 6rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #c62828;
}

.days-area {
  display: flex;
  position: relative;
}

.day-column {
  position: relative;
  flex: 0 0 auto;
  min-width: 0;
  border-right: 1rpx solid #edf0f5;
}

.day-column:last-child {
  border-right: 0;
}

.section-slot {
  border-bottom: 1rpx solid #edf0f5;
}

.day-column.is-today .section-slot {
  background: #fffafa;
}

/* ================== 新增页面优化样式 ================== */

/* 顶部压缩信息区域 */
.info-grid {
  margin-top: 12rpx;
}

.class-line {
  font-size: 28rpx;
  color: #1a202c;
  font-weight: 800;
  line-height: 1.25;
}

.date-line {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #4a5568;
}

.separator {
  margin: 0 8rpx;
  color: #cbd5e0;
}

.today-tag {
  color: #c62828;
  font-weight: 800;
}

.source-line {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #718096;
}

.disclaimer-short {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a0aec0;
  display: flex;
  align-items: center;
}

.info-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #4a5568;
  font-size: 16rpx;
  margin-left: 6rpx;
  font-weight: bold;
}

.action-grid {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 56rpx;
  min-width: 0;
  padding: 0 8rpx;
  font-size: 23rpx;
  font-weight: 800;
  border: 1rpx solid #e1e7f0;
  border-radius: 12rpx;
  background: #f7f9fc;
  color: #364358;
  line-height: 1;
  white-space: nowrap;
}

.notice-strip {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 16rpx 58rpx 16rpx 18rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #eef4ff, #fbf8ff);
}

.notice-main {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 12rpx;
}

.notice-label {
  flex: 0 0 auto;
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 17rpx;
  background: #e8f1ff;
  color: #3654d4;
  font-size: 19rpx;
  font-weight: 900;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.notice-label.urgent {
  background: #fff0f3;
  color: #d94c6a;
}

.notice-label.important {
  background: #fff7e9;
  color: #c27c13;
}

.notice-title {
  overflow: hidden;
  color: #172033;
  font-size: 24rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-close {
  position: absolute;
  top: -2rpx;
  right: 0;
  width: 58rpx;
  height: 58rpx;
  background: transparent;
  color: #8a94a6;
  font-size: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  padding: 0;
}

.notice-close::after {
  border: 0;
}

.daily-knowledge {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  overflow: hidden;
  margin-top: 12rpx;
  padding: 20rpx 22rpx 20rpx 18rpx;
  border: 1rpx solid #dcebe6;
  border-radius: 16rpx;
  background: linear-gradient(116deg, #eff8f4 0%, #fffdf8 68%);
  box-shadow: 0 6rpx 18rpx rgba(36, 48, 66, 0.05);
}

.daily-knowledge::after {
  content: "";
  position: absolute;
  top: -48rpx;
  right: -34rpx;
  width: 132rpx;
  height: 132rpx;
  border: 18rpx solid rgba(18, 122, 104, 0.06);
  border-radius: 50%;
}

.daily-knowledge.warning {
  border-color: #f4ddc0;
  background: linear-gradient(116deg, #fff4e5 0%, #fffdf8 68%);
}

.daily-knowledge.warning::after {
  border-color: rgba(180, 83, 9, 0.07);
}

.daily-knowledge-art {
  position: relative;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.daily-knowledge-ring {
  position: absolute;
  inset: 0;
  border: 2rpx solid rgba(18, 122, 104, 0.24);
  border-radius: 22rpx 50% 22rpx 50%;
  transform: rotate(-8deg);
}

.daily-knowledge.warning .daily-knowledge-ring {
  border-color: rgba(180, 83, 9, 0.26);
}

.daily-knowledge.campus .daily-knowledge-ring {
  border-color: rgba(198, 40, 40, 0.24);
}

.daily-knowledge-mark {
  position: relative;
  z-index: 1;
  color: #127a68;
  font-size: 32rpx;
  font-weight: 900;
}

.daily-knowledge.warning .daily-knowledge-mark {
  color: #b45309;
}

.daily-knowledge.campus .daily-knowledge-mark {
  color: #c62828;
}

.daily-knowledge-main {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.daily-knowledge-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #127a68;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.daily-knowledge.warning .daily-knowledge-meta {
  color: #9a4d0b;
}

.daily-knowledge.campus .daily-knowledge-meta {
  color: #b42323;
}

.daily-knowledge-title {
  margin-top: 6rpx;
  color: #243042;
  font-size: 24rpx;
  font-weight: 900;
}

.daily-knowledge-content {
  margin-top: 6rpx;
  color: #586474;
  font-size: 21rpx;
  line-height: 1.55;
}

.ticker-strip {
  overflow: hidden;
  margin-top: 10rpx;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  background: #172033;
}

.ticker-text {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.action-btn.sync-btn {
  border-color: #fca5a5;
  background: #fef2f2;
  color: #dc2626;
}

.action-btn.ai-btn {
  border-color: #ffd7d7;
  background: #fff7f7;
  color: #b4232a;
}

.ai-entry-icon {
  flex: 0 0 auto;
  width: 28rpx;
  height: 28rpx;
}

.menu-icon-img {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
}

/* 空状态卡片 */
.empty-schedule-card {
  margin-top: 16rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 32rpx;
}

.empty-btn {
  height: 72rpx;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 36rpx;
  padding: 0 40rpx;
  background: #f7f9fc;
  color: #4a5568;
  border: 1rpx solid #cbd5e0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.empty-btn.primary {
  background: #c62828;
  color: #ffffff;
  border-color: #c62828;
  box-shadow: 0 4rpx 12rpx rgba(198, 40, 40, 0.2);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 周课表控制区 */
.schedule-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
}

.schedule-control-wrapper {
  flex: 1;
  max-width: 540rpx;
  min-width: 0;
}

.unplaced-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: 0 18rpx 14rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #fed7aa;
  border-radius: 12rpx;
  background: #fff7ed;
}

.unplaced-entry-main {
  flex: 1;
  min-width: 0;
}

.unplaced-entry-title,
.unplaced-entry-desc {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unplaced-entry-title {
  color: #9a3412;
  font-size: 23rpx;
  font-weight: 900;
}

.unplaced-entry-desc {
  margin-top: 4rpx;
  color: #b45309;
  font-size: 20rpx;
}

.unplaced-entry-arrow {
  flex: 0 0 auto;
  color: #c2410c;
  font-size: 32rpx;
  font-weight: 900;
}

.unplaced-panel {
  max-height: 78vh;
}

.unplaced-scroll {
  box-sizing: border-box;
  max-height: 48vh;
  padding: 18rpx 24rpx;
}

.unplaced-course-card {
  margin-bottom: 12rpx;
  padding: 18rpx;
  border: 1rpx solid #e5ebf3;
  border-radius: 14rpx;
  background: #fbfcfe;
}

.unplaced-course-card:last-child {
  margin-bottom: 0;
}

.unplaced-course-name {
  overflow: hidden;
  color: #172033;
  font-size: 25rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unplaced-course-meta,
.unplaced-course-reason {
  overflow: hidden;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 21rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unplaced-course-reason {
  color: #9a3412;
}

/* 底部免责声明 */
.footer-disclaimer {
  margin: 32rpx 16rpx;
  font-size: 21rpx;
  color: #a0aec0;
  text-align: center;
  line-height: 1.5;
}

/* 通用弹窗遮罩与面板 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.popup-panel {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.popup-handle {
  width: 64rpx;
  height: 8rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
  margin: 16rpx auto 8rpx;
}

.popup-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f7fafc;
}

.popup-title-block {
  min-width: 0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
}

.popup-subtitle {
  font-size: 22rpx;
  color: #718096;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.close-button {
  background: transparent;
  color: #a0aec0;
  font-size: 40rpx;
  line-height: 1;
  padding: 0;
  margin: 0;
  font-weight: 300;
}

.popup-footer {
  display: flex;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  gap: 16rpx;
  border-top: 1rpx solid #f7fafc;
}

.footer-btn {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 40rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.footer-btn.primary-btn {
  background: #c62828;
  color: #ffffff;
}

.footer-btn.secondary-btn {
  background: #f7f9fc;
  color: #4a5568;
  border: 1rpx solid #cbd5e0;
}

/* 今日提醒弹窗内容 */
.reminder-panel {
  max-height: 85vh;
  border-radius: 28rpx 28rpx 0 0 !important;
}

.popup-title-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.reminder-mini-logo {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #f1f4f8;
}

.reminder-scroll {
  flex: 1;
  max-height: 52vh;
  box-sizing: border-box;
}

.reminder-content {
  padding: 16rpx 32rpx 24rpx;
}

.reminder-meta-banner {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #edf0f2;
}

.reminder-meta-date {
  font-size: 24rpx;
  font-weight: 700;
  color: #2d3748;
}

.reminder-meta-class {
  font-size: 21rpx;
  color: #718096;
  margin-top: 4rpx;
}

/* 无课状态 */
.no-course-card {
  padding: 32rpx 24rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  text-align: center;
  margin-bottom: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(148, 163, 184, 0.05);
}

.no-course-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #2d3748;
}

.no-course-desc {
  font-size: 23rpx;
  color: #718096;
  margin-top: 10rpx;
}

/* 下一节课预告盒子 */
.next-course-preview-box {
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  background: #fff5f5;
  border: 1rpx solid #fca5a5;
  border-radius: 16rpx;
  text-align: left;
}

.preview-tag {
  display: inline-block;
  font-size: 18rpx;
  font-weight: 800;
  color: #c62828;
  background: #ffe3e3;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  margin-bottom: 8rpx;
}

.preview-course-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #1a202c;
}

.preview-course-detail {
  font-size: 21rpx;
  color: #4a5568;
  margin-top: 8rpx;
  font-weight: bold;
}

.preview-dot {
  margin: 0 8rpx;
  color: #cbd5e0;
}

.preview-room {
  color: #dc2626;
}

/* 有课状态 */
.has-course-container {
  display: flex;
  flex-direction: column;
}

.reminder-summary-line {
  font-size: 24rpx;
  color: #4a5568;
  margin-bottom: 16rpx;
}

.focus-course-card {
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(198, 40, 40, 0.08);
  border: 1rpx solid #e2e8f0;
}

.focus-course-card.ongoing {
  background: #fff5f5;
  border-color: #fca5a5;
}

.focus-course-card.upcoming {
  background: #fff7ed;
  border-color: #fed7aa;
}

.focus-course-card.finished {
  background: #f8fafc;
  border-color: #e2e8f0;
  box-shadow: none;
  opacity: 0.7;
}

.focus-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.focus-status-tag {
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.focus-course-card.ongoing .focus-status-tag {
  background: #ef4444;
  color: #ffffff;
}

.focus-course-card.upcoming .focus-status-tag {
  background: #f97316;
  color: #ffffff;
}

.focus-course-card.finished .focus-status-tag {
  background: #94a3b8;
  color: #ffffff;
}

.focus-time-label {
  font-size: 22rpx;
  color: #4a5568;
  font-weight: 700;
}

.focus-course-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #1a202c;
  margin-top: 18rpx;
  line-height: 1.3;
}

.focus-course-room {
  font-size: 24rpx;
  font-weight: 800;
  color: #dc2626;
  margin-top: 14rpx;
}

.other-courses-list {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 4rpx 20rpx;
  margin-bottom: 12rpx;
}

.other-course-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf0f5;
}

.other-course-item:last-child {
  border-bottom: none;
}

.other-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.other-section {
  font-size: 20rpx;
  color: #718096;
  background: #e2e8f0;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
  font-weight: bold;
}

.other-name {
  font-size: 24rpx;
  color: #2d3748;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.other-room {
  font-size: 22rpx;
  color: #4a5568;
  font-weight: bold;
  flex-shrink: 0;
}

.view-all-hint {
  text-align: center;
  font-size: 22rpx;
  color: #dc2626;
  font-weight: 800;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf0f5;
}

/* 强制选择课表弹窗 */
.init-popup {
  align-items: center;
}

.init-panel {
  width: 85%;
  border-radius: 24rpx;
  padding: 40rpx;
}

.init-header {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.init-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
}

.init-brand-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
  margin-top: 16rpx;
}

.init-body {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.init-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #2d3748;
}

.init-subtitle {
  font-size: 22rpx;
  color: #718096;
  text-align: center;
  line-height: 1.5;
  margin: 16rpx 0 32rpx;
}

.init-btn {
  width: 100% !important;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.init-btn.primary-btn {
  background: #c62828;
  color: #ffffff;
}

.init-btn.secondary-btn {
  background: #f7f9fc;
  color: #4a5568;
  border: 1rpx solid #cbd5e0;
}

.init-sync-btn {
  background: transparent;
  color: #a0aec0;
  font-size: 20rpx;
  border: none;
  margin-top: 10rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 更多菜单 */
.menu-popup {
  align-items: flex-end;
}

.menu-panel {
  width: 100%;
  background: #f7f9fa;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
}

.menu-item {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  color: #2d3748;
  border-bottom: 1rpx solid #f1f5f7;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.menu-item.danger-item {
  color: #e53e3e;
}

.menu-cancel {
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
  color: #718096;
  margin-top: 12rpx;
}

/* 完整免责声明弹窗 */
.disclaimer-panel {
  width: 80%;
  align-self: center;
  border-radius: 24rpx;
  padding: 24rpx;
}

.notice-detail-panel {
  width: 84%;
  align-self: center;
  border-radius: 24rpx;
  padding: 20rpx;
}

.app-notice-panel {
  width: 82%;
  align-self: center;
  align-items: center;
  padding: 42rpx 34rpx 34rpx;
  border-radius: 28rpx;
  text-align: center;
}

.notice-modal-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #edf4ff, #f4efff);
  color: #3654d4;
  font-size: 26rpx;
  font-weight: 900;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.notice-modal-title {
  margin-top: 22rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.notice-modal-content {
  margin-top: 16rpx;
  color: #536174;
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  text-align: left;
}

.notice-modal-btn {
  width: 100%;
  height: 76rpx;
  margin-top: 30rpx;
  border-radius: 38rpx;
  background: #3654d4;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.disclaimer-scroll {
  max-height: 40vh;
  padding: 16rpx 0;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #4a5568;
  line-height: 1.6;
  margin-bottom: 16rpx;
}
