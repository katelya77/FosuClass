<view class="page index-page">
  <view class="compact-header card">
    <view class="header-main">
      <view class="brand">
        <image
          wx:if="{{showLogo}}"
          class="brand-logo"
          src="{{logoPath}}"
          mode="aspectFill"
          binderror="onLogoError"
        />
        <view wx:else class="brand-logo fallback-logo">佛</view>
        <view class="brand-copy">
          <view class="app-title">{{appName}}</view>
        </view>
      </view>
      <view class="week-badge">第{{currentWeek}}周</view>
    </view>

    <view class="class-line">{{className}} · {{semester}}</view>
    <view class="date-line">{{weekRangeText}} · {{weekScopeText}}</view>
    <view class="today-line">今日：{{todayText}}</view>
    <view class="source-line">{{dataSourceText}}<text wx:if="{{lastSyncText}}"> · 上次同步：{{lastSyncText}}</text></view>

    <view class="control-row">
      <week-switcher
        current-week="{{currentWeek}}"
        total-weeks="{{totalWeeks}}"
        week-label="{{weekSwitcherLabel}}"
        bind:change="onWeekChange"
      />
    </view>
    <view class="action-row">
      <scroll-view class="action-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="action-list">
          <button class="chip-button" bindtap="goSchool">全校课表</button>
          <button class="chip-button" bindtap="goTimetable">作息时间</button>
          <button class="chip-button sync-chip" bindtap="goLogin">同步课表</button>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="schedule card">
    <view class="schedule-title-row">
      <view class="section-title">周课表</view>
      <view class="schedule-hint">{{showWeekend ? "周一至周日，可横向滑动" : "周一至周五"}}</view>
    </view>

    <view class="table-shell">
      <scroll-view
        class="schedule-scroll-x {{showWeekend ? 'has-weekend' : ''}}"
        scroll-x="{{showWeekend}}"
        enhanced
        show-scrollbar="{{false}}"
      >
        <view class="schedule-grid" style="width: {{gridWidth}}rpx;">
          <view class="time-axis">
            <view class="time-head">节次</view>
            <view
              wx:for="{{sections}}"
              wx:key="section"
              class="time-cell"
              style="height: {{sectionHeight}}rpx;"
            >
              <view class="section-no">{{item.section}}</view>
              <view class="time-text">{{item.start}}</view>
              <view class="time-text">{{item.end}}</view>
            </view>
          </view>

          <view class="day-track" style="width: {{dayTrackWidth}}rpx;">
            <view class="weekday-heads">
              <view
                wx:for="{{weekdays}}"
                wx:key="weekday"
                class="weekday-head {{item.isToday ? 'is-today' : ''}}"
                style="width: {{dayColumnWidth}}rpx;"
              >
                <view>{{item.label}}</view>
                <view class="weekday-date">{{item.dateLabel}}</view>
                <view wx:if="{{item.isToday}}" class="today-dot"></view>
              </view>
            </view>

            <view class="days-area" style="height: {{scheduleHeight}}rpx;">
            <view
              wx:for="{{dayColumns}}"
              wx:key="weekday"
              class="day-column {{item.isToday ? 'is-today' : ''}}"
              style="width: {{dayColumnWidth}}rpx;"
            >
              <view
                wx:for="{{sections}}"
                wx:for-item="section"
                wx:key="section"
                class="section-slot"
                style="height: {{sectionHeight}}rpx;"
              ></view>
              <course-card
                wx:for="{{item.courses}}"
                wx:for-item="course"
                wx:key="id"
                course="{{course}}"
                card-style="{{course.cardStyle}}"
                bind:tapcourse="onCourseTap"
              />
            </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <course-detail-popup
    visible="{{detailVisible}}"
    course="{{selectedCourse}}"
    bind:close="closeCourseDetail"
  />
</view>
