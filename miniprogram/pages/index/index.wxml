<view class="page index-page">
  <!-- 顶部压缩状态卡 -->
  <view class="compact-header card">
    <view class="header-main">
      <view class="brand">
        <image
          wx:if="{{showLogo}}"
          class="brand-logo"
          src="{{logoPath}}"
          mode="aspectFill"
          binderror="onLogoError"
        />
        <view wx:else class="brand-logo fallback-logo">课</view>
        <view class="brand-copy" bindtap="showTodayReminderManual">
          <view class="app-title">{{appName}}</view>
        </view>
      </view>
      <view class="week-badge">第{{currentWeek}}周</view>
    </view>

    <view class="info-grid">
      <view class="class-line">{{className}}</view>
      <view class="schedule-subtitle" wx:if="{{scheduleSubtitle}}">{{scheduleSubtitle}}</view>
      <view class="schedule-subtitle" wx:else>{{semester}}</view>
      <view class="date-line">
        <text>{{weekRangeText}}</text>
        <text class="separator">·</text>
        <text class="today-tag" bindtap="showTodayReminderManual">今日：{{todayText}}</text>
      </view>
      <view class="source-line" wx:if="{{lastSyncText}}">
        <text>{{dataSourceText}} · 更新于 {{lastSyncText}}</text>
      </view>
      <view class="source-line" wx:elif="{{dataVersionText}}">
        <text>{{dataVersionText}}</text>
      </view>
    </view>

    <!-- 操作按钮平铺排布 -->
    <view class="action-grid">
      <button class="action-btn" bindtap="goTimetable">作息时间</button>
      <button class="action-btn" bindtap="goCustomCourses">个性化</button>
      <button class="action-btn sync-btn" bindtap="goLogin">{{syncActionText}}</button>
      <button class="action-btn" bindtap="toggleMoreMenu">更多</button>
    </view>
  </view>

  <notice-ticker notices="{{appConfig.notices}}" page-key="home" max-count="1" />

  <view class="notice-strip card" wx:if="{{homeNotice}}" bindtap="showNotice" data-type="home">
    <view class="notice-main">
      <view class="notice-label {{homeNotice.priority}}">{{homeNotice.priority === 'urgent' ? '紧急' : (homeNotice.priority === 'important' ? '重要' : '公告')}}</view>
      <view class="notice-title">{{homeNotice.title}}</view>
    </view>
    <button wx:if="{{homeNotice.closable}}" class="notice-close" catchtap="dismissHomeNotice">×</button>
  </view>

  <!-- 如果未绑定课表，展示空状态卡片 -->
  <view class="empty-schedule-card card" wx:if="{{!hasBoundTarget}}">
    <empty-state
      title="请选择一个班级课表作为首页展示"
      desc="全校数据仅供参考，绑定后即可查看周课表、今日课程智能提醒和上课倒计时。"
    />
    <view class="empty-actions">
      <button class="empty-btn primary" bindtap="goSchool">选择课表</button>
      <button class="empty-btn" bindtap="goSchool">浏览全校</button>
    </view>
  </view>

  <!-- 如果已绑定课表，展示周课表网格 -->
  <view class="schedule card" wx:else>
    <view class="schedule-title-row">
      <view class="section-title">周课表</view>
      <view class="schedule-control-wrapper">
        <week-switcher
          current-week="{{currentWeek}}"
          total-weeks="{{totalWeeks}}"
          week-label="{{weekSwitcherLabel}}"
          bind:change="onWeekChange"
        />
      </view>
    </view>

    <view class="table-shell">
      <!-- 左右滑动查看周末提示 -->
      <view class="swipe-hint-bar" wx:if="{{showWeekend && weekendShowMode === 'detail'}}" style="background: #fff5f5; border-bottom: 1rpx solid #edf0f5; padding: 12rpx 24rpx; text-align: center;">
        <text class="swipe-hint-text" style="font-size: 20rpx; color: #c62828; font-weight: bold;">💡 左右滑动查看周末课表</text>
      </view>

      <scroll-view
        class="schedule-scroll-x {{showWeekend ? 'has-weekend' : ''}}"
        scroll-x="{{scrollX}}"
        enhanced
        show-scrollbar="{{false}}"
      >
        <view class="schedule-grid" style="width: {{gridWidth}}rpx;">
          <view class="time-axis">
            <view class="time-head">节次</view>
            <view
              wx:for="{{sections}}"
              wx:key="section"
              class="time-cell {{item.section === 5 || item.section === 10 ? 'section-divider' : ''}}"
              style="height: {{sectionHeight}}rpx;"
            >
              <view class="section-no">第{{item.section}}节</view>
              <view class="time-text-single">{{item.axisLabel}}</view>
            </view>
          </view>

          <view class="day-track" style="width: {{dayTrackWidth}}rpx;">
            <view class="weekday-heads">
              <view
                wx:for="{{weekdays}}"
                wx:key="weekday"
                class="weekday-head {{item.isToday ? 'is-today' : ''}}"
                style="width: {{dayColumnWidth}}rpx;"
              >
                <view>{{item.label}}</view>
                <view class="weekday-date">{{item.dateLabel}}</view>
                <view wx:if="{{item.isToday}}" class="today-dot"></view>
              </view>
            </view>

            <view class="days-area" style="height: {{scheduleHeight}}rpx;">
              <view
                wx:for="{{dayColumns}}"
                wx:key="weekday"
                class="day-column {{item.isToday ? 'is-today' : ''}}"
                style="width: {{dayColumnWidth}}rpx;"
              >
                <view
                  wx:for="{{sections}}"
                  wx:for-item="section"
                  wx:key="section"
                  class="section-slot {{section.section === 5 || section.section === 10 ? 'section-divider' : ''}}"
                  style="height: {{sectionHeight}}rpx;"
                ></view>
                <course-card
                  wx:for="{{item.courses}}"
                  wx:for-item="course"
                  wx:key="id"
                  course="{{course}}"
                  card-style="{{course.cardStyle}}"
                  layout="{{showWeekend && weekendShowMode === 'overview' ? 'overview' : 'grid'}}"
                  bind:tapcourse="onCourseTap"
                />
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 底部免责声明 -->
  <view class="footer-disclaimer" wx:if="{{hasBoundTarget}}">
    {{brand.disclaimer}}
  </view>

  <course-detail-popup
    visible="{{detailVisible}}"
    course="{{selectedCourse}}"
    bind:close="closeCourseDetail"
    bind:copycustom="onCopyCourseToCustom"
  />

  <!-- 今日课程提醒总览弹窗 -->
  <view class="popup-mask reminder-popup" wx:if="{{showTodayReminder}}" bindtap="closeTodayReminder">
    <view class="popup-panel reminder-panel" catchtap="noop">
      <view class="popup-handle"></view>
      
      <!-- 弹窗顶部：轻量图标 + 标题 + 右上角关闭 -->
      <view class="popup-header">
        <view class="popup-title-left">
          <image class="reminder-mini-logo" src="/assets/logo/favicon.png" mode="aspectFill" />
          <view class="popup-title">今日课程提醒</view>
        </view>
        <button class="close-button" bindtap="closeTodayReminder">×</button>
      </view>

      <scroll-view scroll-y class="reminder-scroll">
        <view class="reminder-content">
          <!-- 基础元信息区 -->
          <view class="reminder-meta-banner">
            <view class="reminder-meta-date">{{todayReminderData.dateText}} {{todayReminderData.weekdayText}} · 第{{todayReminderData.currentWeek}}周</view>
            <view class="reminder-meta-class" wx:if="{{todayReminderData.className}}">当前课表：{{todayReminderData.className}}</view>
            <view class="reminder-meta-class" wx:if="{{dataVersionText}}">{{dataVersionText}}</view>
          </view>

          <!-- 无课状态 -->
          <block wx:if="{{todayReminderData.courses.length === 0}}">
            <view class="no-course-card">
              <view class="no-course-title">今天没有课程安排</view>
              <view class="no-course-desc">好好休息，享受你的自由时光吧☕️</view>
              
              <!-- 下一节课预告 -->
              <view class="next-course-preview-box" wx:if="{{todayReminderData.nextCoursePreview}}">
                <view class="preview-tag">下堂课预告</view>
                <view class="preview-course-name">{{todayReminderData.nextCoursePreview.courseName}}</view>
                <view class="preview-course-detail">
                  <text class="preview-time">{{todayReminderData.nextCoursePreview.timeLabel}}</text>
                  <text class="preview-dot">·</text>
                  <text class="preview-room">{{todayReminderData.nextCoursePreview.classroom}}</text>
                </view>
              </view>
            </view>
          </block>

          <!-- 有课状态 -->
          <block wx:else>
            <view class="has-course-container">
              <view class="reminder-summary-line">
                今天共 <text class="highlight-count">{{todayReminderData.courses.length}}</text> 门课
              </view>
              
              <!-- 第一张重点卡：下一节课或正在上的课 -->
              <view class="focus-course-card {{todayReminderData.courses[0].status}}">
                <view class="focus-card-header">
                  <text class="focus-status-tag">{{todayReminderData.courses[0].statusText}}</text>
                  <text class="focus-time-label">{{todayReminderData.courses[0].timeText}} ({{todayReminderData.courses[0].sectionText}})</text>
                </view>
                <view class="focus-course-name">{{todayReminderData.courses[0].courseName}}</view>
                <view class="focus-course-room" wx:if="{{todayReminderData.courses[0].classroom}}">
                  📍 {{todayReminderData.courses[0].classroom}}
                </view>
              </view>

              <!-- 其他课程列表 (最多展示剩余的 2 条) -->
              <view class="other-courses-list" wx:if="{{todayReminderData.courses.length > 1}}">
                <view class="other-course-item" 
                      wx:for="{{todayReminderData.courses}}" 
                      wx:key="id" 
                      wx:if="{{index > 0 && index < 3}}"
                >
                  <view class="other-left">
                    <text class="other-section">{{item.sectionText}}</text>
                    <text class="other-name">{{item.courseName}}</text>
                  </view>
                  <text class="other-room">{{item.classroom || "待定"}}</text>
                </view>
                
                <!-- 超过 3 条显示“查看全部今日课程” -->
                <view class="view-all-hint" wx:if="{{todayReminderData.courses.length > 3}}" bindtap="goToTodayPage">
                  查看全部 {{todayReminderData.courses.length}} 门今日课程 ›
                </view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>

      <view class="popup-footer">
        <button class="footer-btn secondary-btn" bindtap="closeTodayReminder">知道了</button>
        <button class="footer-btn primary-btn" bindtap="goToTodayPage" wx:if="{{todayReminderData.courses.length > 0}}">查看今日课程</button>
      </view>
    </view>
  </view>

  <!-- 选择课表引导弹窗 -->
  <view class="popup-mask init-popup" wx:if="{{showInitModal}}">
    <view class="popup-panel init-panel">
      <view class="init-header">
        <image class="init-logo" src="{{logoPath}}" mode="aspectFill" />
        <view class="init-brand-title">{{brand.appName}}</view>
      </view>
      <view class="init-body">
        <view class="init-title">选择你的课表</view>
        <view class="init-subtitle">用于首页、今日课程和提醒展示；课程数据仅供时间管理与学习生活参考，具体安排以正式通知为准。</view>
        
        <button class="init-btn primary-btn" bindtap="goToSelectClass">去选择班级课表</button>
        <button class="init-btn secondary-btn" bindtap="skipSelect">先浏览全校课表</button>
        
        <button class="init-sync-btn" bindtap="goToSyncLogin">XLS 手动导入个人课表</button>
      </view>
    </view>
  </view>
 
  <!-- 更多菜单模态框 -->
  <view class="popup-mask menu-popup" wx:if="{{showMoreMenu}}" bindtap="hideMoreMenu">
    <view class="menu-panel" catchtap="noop">
      <view class="menu-item" bindtap="refreshData">
        <text class="menu-icon">↻</text>刷新课程数据
      </view>
      <view class="menu-item" bindtap="showDisclaimer">
        <text class="menu-icon">i</text>查看免责声明
      </view>
      <view class="menu-item" bindtap="goCustomCourses">
        <text class="menu-icon">+</text>个性化课程
      </view>
      <view class="menu-item danger-item" bindtap="clearLocalCache">
        <text class="menu-icon">🗑</text>清除本地缓存
      </view>
      <view class="menu-cancel" bindtap="hideMoreMenu">取消</view>
    </view>
  </view>
 
  <!-- 完整免责声明弹窗 -->
  <view class="popup-mask disclaimer-popup" wx:if="{{showDisclaimerPopup}}" bindtap="closeDisclaimer">
    <view class="popup-panel disclaimer-panel" catchtap="noop">
      <view class="popup-header">
        <view class="popup-title">免责声明</view>
        <button class="close-button" bindtap="closeDisclaimer">×</button>
      </view>
      <scroll-view scroll-y class="disclaimer-scroll">
        <view class="disclaimer-text">
          本程序（{{brand.appName}}）为个人开发的课程表查询与管理工具，非官方发布产品。
        </view>
        <view class="disclaimer-text">
          所有课表时间数据由开发者整理维护及用户反馈修正。因课程安排可能存在临时调度、调整或变更，本程序展示的课程安排仅供日常学习生活时间参考。
        </view>
        <view class="disclaimer-text">
          具体上课时间、地点、任课教师等，请务必以学校及任课教师发布的正式通知为准。
        </view>
      </scroll-view>
      <view class="popup-footer">
        <button class="footer-btn primary-btn" bindtap="closeDisclaimer">我已了解</button>
      </view>
    </view>
  </view>

  <view class="popup-mask notice-detail-popup" wx:if="{{showNoticeDetail}}" bindtap="closeNoticeDetail">
    <view class="popup-panel notice-detail-panel" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="popup-header">
        <view class="popup-title-block">
          <view class="popup-title">{{selectedNotice.title}}</view>
          <view class="popup-subtitle">{{selectedNotice.type}} · {{selectedNotice.priority}}</view>
        </view>
        <button class="close-button" bindtap="closeNoticeDetail">×</button>
      </view>
      <scroll-view scroll-y class="disclaimer-scroll">
        <view class="disclaimer-text">{{selectedNotice.content}}</view>
      </scroll-view>
      <view class="popup-footer">
        <button class="footer-btn primary-btn" bindtap="closeNoticeDetail">知道了</button>
      </view>
    </view>
  </view>

  <view class="popup-mask notice-detail-popup" wx:if="{{showAppNoticeModal}}" bindtap="closeAppNoticeModal">
    <view class="popup-panel app-notice-panel" catchtap="noop">
      <view class="notice-modal-icon">告</view>
      <view class="notice-modal-title">{{modalNotice.title}}</view>
      <view class="notice-modal-content">{{modalNotice.content}}</view>
      <button class="notice-modal-btn" bindtap="closeAppNoticeModal">我知道了</button>
    </view>
  </view>
</view>
