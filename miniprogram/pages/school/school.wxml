<view class="page school-page">
  <view class="page-header">
    <view class="title">查找课表</view>
    <view class="subtitle">{{dataVersionText || "可按班级、教师、教室或课程查看课程安排。"}} </view>
  </view>

  <notice-ticker notices="{{appConfig.notices}}" page-key="school" max-count="1" />

  <!-- 1. 全局加载中/骨架屏状态 -->
  <block wx:if="{{dataLoadState === 'loading' || dataLoadState === 'slow'}}">
    <view class="school-skeleton-global card" style="margin: 24rpx; padding: 60rpx 40rpx; text-align: center; border-radius: 16rpx; background: #ffffff;">
      <view class="skeleton-line wide" style="height: 40rpx; background: #f2f2f2; margin-bottom: 20rpx; border-radius: 8rpx; width: 60%; margin-left: auto; margin-right: auto;"></view>
      <view class="skeleton-line" style="height: 30rpx; background: #f2f2f2; margin-bottom: 20rpx; border-radius: 8rpx; width: 80%; margin-left: auto; margin-right: auto;"></view>
      <view class="skeleton-line short" style="height: 30rpx; background: #f2f2f2; border-radius: 8rpx; width: 40%; margin-left: auto; margin-right: auto;"></view>
      <view class="slow-loading-hint" wx:if="{{dataLoadState === 'slow'}}" style="margin-top: 40rpx; color: #888; font-size: 26rpx; display: flex; align-items: center; justify-content: center;">
        <text class="slow-loading-icon" style="margin-right: 10rpx; animation: spin 2s linear infinite;">⏳</text>网络较慢，数据正在加载，可点击重试
      </view>
    </view>
  </block>

  <!-- 2. 全局网络超时 -->
  <block wx:elif="{{dataLoadState === 'timeout'}}">
    <view class="error-retry-card card" style="margin: 24rpx; padding: 60rpx 40rpx; text-align: center; border-radius: 16rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);">
      <view class="error-retry-title" style="font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 16rpx;">网络请求超时</view>
      <view class="error-retry-desc" style="font-size: 26rpx; color: #666; margin-bottom: 30rpx;">由于服务器距离较远或网络波动，加载时间较长。</view>
      <button class="error-retry-btn" bindtap="onRetryLoading" style="background: #1890ff; color: #fff; border-radius: 8rpx; font-size: 28rpx; width: 240rpx;">重新加载</button>
    </view>
  </block>

  <!-- 3. 全局网络连接失败 -->
  <block wx:elif="{{dataLoadState === 'networkError'}}">
    <view class="error-retry-card card" style="margin: 24rpx; padding: 60rpx 40rpx; text-align: center; border-radius: 16rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);">
      <view class="error-retry-title" style="font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 16rpx;">课表索引加载失败</view>
      <view class="error-retry-desc" style="font-size: 26rpx; color: #666; margin-bottom: 30rpx;">无法连接到教务服务，请检查网络后重试。</view>
      <button class="error-retry-btn" bindtap="onRetryLoading" style="background: #1890ff; color: #fff; border-radius: 8rpx; font-size: 28rpx; width: 240rpx;">重新加载</button>
    </view>
  </block>

  <!-- 4. 全局未同步课程数据 -->
  <block wx:elif="{{dataLoadState === 'noRelease'}}">
    <view class="card" style="margin: 24rpx; padding: 60rpx 40rpx; text-align: center; border-radius: 16rpx; background: #ffffff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);">
      <empty-state
        title="暂未同步课程数据"
        desc="课程数据尚未同步，请稍后再试。"
      />
    </view>
  </block>

  <!-- 5. 页面加载成功，展示核心内容 -->
  <block wx:else>
    <!-- 缓存恢复状态小提示栏 -->
    <view class="restore-hint-bar" wx:if="{{restoreHint}}">
      <text class="restore-hint-icon">✓</text>
      <text class="restore-hint-text">{{restoreHint}}</text>
    </view>

    <view class="search-card card">
      <view class="search-row" wx:if="{{activeTab === 'teacher' || activeTab === 'classroom' || activeTab === 'course'}}">
        <text class="search-icon">⌕</text>
        <input
          class="search-input"
          value="{{keyword}}"
          placeholder="{{activeTab === 'teacher' ? TEACHER_SEARCH_PLACEHOLDER : (activeTab === 'classroom' ? CLASSROOM_SEARCH_PLACEHOLDER : COURSE_SEARCH_PLACEHOLDER)}}"
          placeholder-class="search-placeholder"
          confirm-type="search"
          bindinput="onKeywordInput"
        />
      </view>

      <view class="tabs">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          class="tab-item {{activeTab === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="onTabChange"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="school-notice" wx:if="{{schoolNotice}}">
      <text class="school-notice-tag">{{schoolNotice.priority === 'urgent' ? '紧急' : '公告'}}</text>
      <text class="school-notice-text">{{schoolNotice.title}}</text>
    </view>

    <view class="tool-entry-card card" bindtap="goEmptyRoom">
      <view class="tool-entry-main">
        <view class="tool-entry-title">空教室查询</view>
        <view class="tool-entry-desc">按日期、节次和教学楼查找当前 release 的可用教室</view>
      </view>
      <view class="tool-entry-action">去查询</view>
    </view>

    <block wx:if="{{activeTab === 'class'}}">
      <!-- 1. 班级 Tab -->
      <view class="tab-panel">
        <view class="filter-card card">
          <view class="filter-item">
            <text class="filter-label">学期：</text>
            <picker mode="selector" range="{{semesters}}" range-key="label" bindchange="onSemesterChange">
              <view class="filter-pill">{{semesters[selectedSemesterIndex].label || "选择学期"}}</view>
            </picker>
          </view>

          <view class="filter-item">
            <text class="filter-label">学院：</text>
            <picker mode="selector" range="{{colleges}}" range-key="name" bindchange="onCollegeChange">
              <view class="filter-pill">{{colleges[selectedCollegeIndex].name || "选择学院"}}</view>
            </picker>
          </view>

          <view class="filter-item">
            <text class="filter-label">年级：</text>
            <picker mode="selector" range="{{grades}}" bindchange="onGradeChange">
              <view class="filter-pill">{{grades[selectedGradeIndex] || "选择年级"}}</view>
            </picker>
          </view>

          <view class="filter-item">
            <text class="filter-label">专业：</text>
            <picker mode="selector" range="{{majors}}" range-key="name" bindchange="onMajorChange">
              <view class="filter-pill">{{majors[selectedMajorIndex].name || (selectedCollegeIndex >= 0 && selectedGradeIndex >= 0 ? (majors.length ? "选择专业" : "加载中或无专业") : "请先选择学院和年级")}}</view>
            </picker>
          </view>

          <view class="filter-item" wx:if="{{selectedMajorIndex >= 0}}">
            <text class="filter-label">班级：</text>
            <picker mode="selector" range="{{classesOptions}}" range-key="label" bindchange="onClassChange">
              <view class="filter-pill">{{classesOptions[selectedClassIndex].label || (classesOptions.length ? "选择班级 (可选)" : "无班级数据")}}</view>
            </picker>
          </view>

          <button class="primary-search-btn {{ (selectedCollegeIndex < 0 || selectedGradeIndex < 0 || selectedMajorIndex < 0) ? 'disabled' : '' }}" disabled="{{selectedCollegeIndex < 0 || selectedGradeIndex < 0 || selectedMajorIndex < 0}}" loading="{{loading}}" bindtap="searchClassSchedule">
            {{ (selectedCollegeIndex < 0 || selectedGradeIndex < 0 || selectedMajorIndex < 0) ? '请选择完整条件' : (selectedClassIndex >= 0 && classesOptions[selectedClassIndex] ? '查看 ' + classesOptions[selectedClassIndex].className + ' 课表' : '查看班级课表') }}
          </button>
          
          <button class="reset-filter-btn" bindtap="resetFilters">
            重置筛选
          </button>
        </view>

        <view class="recent-card card" wx:if="{{recentSchedules.length}}">
          <view class="result-group-head">
            <view class="result-group-title">最近查看课表</view>
            <view class="recent-actions" wx:if="{{recentSchedules.length > 0}}">
              <text class="result-group-count">{{recentSchedules.length}}项</text>
              <view class="clear-btn" bindtap="clearRecentSchedules">清空</view>
            </view>
          </view>
          <view
            wx:for="{{recentSchedules}}"
            wx:key="scheduleKey"
            class="recent-item"
            data-index="{{index}}"
            data-key="{{item.scheduleKey}}"
            bindtouchstart="onRecentTouchStart"
            bindtouchmove="onRecentTouchMove"
            bindtouchend="onRecentTouchEnd"
          >
            <view 
              class="recent-item-content {{openedRecentKey === item.scheduleKey ? 'opened' : ''}}"
              data-index="{{index}}"
              bindtap="goRecentSchedule"
            >
              <view class="recent-main">
                <view class="recent-title-row">
                  <view class="recent-title">{{item.title || '课表'}}</view>
                  <view class="old-version-badge" wx:if="{{item.isOldVersion}}">旧版本</view>
                </view>
                <view class="recent-meta">
                  <block wx:if="{{item.collegeName}}">{{item.collegeName}} · </block>
                  <block wx:if="{{item.grade}}">{{item.grade}}级 · </block>
                  <block>{{item.majorName || '暂无专业信息'}}</block>
                </view>
                <view class="recent-meta">{{item.updatedAt || '最近查看'}}</view>
              </view>
              <view class="recent-side">{{item.courseCount ? item.courseCount + '门课' : '课表'}}</view>
            </view>
            <view 
              class="recent-delete-btn"
              data-key="{{item.scheduleKey}}"
              catchtap="deleteRecentSchedule"
            >
              删除
            </view>
          </view>
        </view>

        <view class="updated-hint" wx:if="{{updatedAtText}}">
          {{updatedAtText}}
        </view>

        <!-- 骨架屏与慢网络提示 -->
        <block wx:if="{{loadingState === 'skeleton' || loadingState === 'slow'}}">
          <view class="school-skeleton">
            <view class="skeleton-line wide"></view>
            <view class="skeleton-line"></view>
            <view class="skeleton-line short"></view>
            <view class="slow-loading-hint" wx:if="{{loadingState === 'slow'}}">
              <text class="slow-loading-icon">⏳</text>网络较慢，正在继续加载...
            </view>
          </view>
        </block>

        <!-- 超时重试卡片 -->
        <block wx:if="{{loadingState === 'timeout' || loadingState === 'networkError'}}">
          <view class="error-retry-card card">
            <view class="error-retry-title">{{loadingState === 'timeout' ? '请求超时' : '请求失败'}}</view>
            <view class="error-retry-desc">{{loadingState === 'timeout' ? '网络较慢，数据正在加载，可点击重试' : '课表索引加载失败，请重试'}}</view>
            <button class="error-retry-btn" bindtap="onRetryLoading">重新加载</button>
          </view>
        </block>

        <view class="class-result-notice" wx:if="{{classNoticeText}}">
          {{classNoticeText}}
        </view>

        <view class="result-list" wx:if="{{classAdminResults.length || classAggregateResults.length}}">
          <view class="result-group" wx:if="{{classAdminResults.length}}">
            <view class="result-group-head">
              <view class="result-group-title">行政班级</view>
              <view class="result-group-count">{{classAdminResults.length}}个班</view>
            </view>
            <view
              wx:for="{{classAdminResults}}"
              wx:key="scheduleKey"
              class="result-card card"
              data-group="admin"
              data-index="{{index}}"
              bindtap="viewClassSchedule"
            >
              <view class="result-main">
                <view class="result-title">{{item.displayTitle || item.className}}</view>
                <view class="result-meta">{{item.displaySubtitle}}</view>
              </view>
              <view class="result-side">
                <view class="status ready">{{item.statusText || "行政班"}}</view>
              </view>
            </view>
          </view>

          <view class="result-group" wx:if="{{classAggregateResults.length}}">
            <view class="result-group-head" bindtap="toggleAggregate" style="cursor: pointer;">
              <view class="result-group-title">专业共享课表</view>
              <view class="result-group-count">{{classAggregateResults.length}}项 {{showAggregate ? '▼' : '▶'}}</view>
            </view>
            <view wx:if="{{showAggregate}}">
              <view
                wx:for="{{classAggregateResults}}"
                wx:key="scheduleKey"
                class="result-card card aggregate-card"
                data-group="aggregate"
                data-index="{{index}}"
                bindtap="viewClassSchedule"
              >
                <view class="result-main">
                  <view class="result-title">{{item.displayTitle || item.className}}</view>
                  <view class="result-meta">{{item.displaySubtitle}}</view>
                </view>
                <view class="result-side">
                  <view class="status ready aggregate">{{item.statusText || "专业聚合"}}</view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <empty-state
          wx:elif="{{!loading}}"
          title="{{classEmptyTitle}}"
          desc="{{classEmptyDesc}}"
        />
      </view>
    </block>

    <block wx:elif="{{activeTab === 'teacher'}}">
      <!-- 2. 教师 Tab -->
      <view class="tab-panel">
        <view class="filter-card card">
          <view class="filter-item">
            <text class="filter-label">学期：</text>
            <picker mode="selector" range="{{semesters}}" range-key="label" bindchange="onSemesterChange">
              <view class="filter-pill">{{semesters[selectedSemesterIndex].label || "选择学期"}}</view>
            </picker>
          </view>

          <view class="filter-item">
            <text class="filter-label">院系：</text>
            <picker mode="selector" range="{{colleges}}" range-key="name" bindchange="onCollegeChange">
              <view class="filter-pill">{{colleges[selectedCollegeIndex].name || "所有学院 (可选)"}}</view>
            </picker>
          </view>

          <view class="filter-item">
            <text class="filter-label">职称：</text>
            <picker mode="selector" range="{{titleOptions}}" bindchange="onTitleChange">
              <view class="filter-pill">{{titleOptions[selectedTitleIndex] || "所有职称 (可选)"}}</view>
            </picker>
          </view>

          <button class="primary-search-btn" loading="{{loading}}" bindtap="searchTeacherSchedule">
            搜索教师课表
          </button>
        </view>

        <view class="updated-hint" wx:if="{{updatedAtText}}">
          {{updatedAtText}}
        </view>

        <!-- 骨架屏与慢网络提示 -->
        <block wx:if="{{loadingState === 'skeleton' || loadingState === 'slow'}}">
          <view class="school-skeleton">
            <view class="skeleton-line wide"></view>
            <view class="skeleton-line"></view>
            <view class="skeleton-line short"></view>
            <view class="slow-loading-hint" wx:if="{{loadingState === 'slow'}}">
              <text class="slow-loading-icon">⏳</text>网络较慢，正在继续加载...
            </view>
          </view>
        </block>

        <!-- 超时重试卡片 -->
        <block wx:if="{{loadingState === 'timeout' || loadingState === 'networkError'}}">
          <view class="error-retry-card card">
            <view class="error-retry-title">{{loadingState === 'timeout' ? '请求超时' : '请求失败'}}</view>
            <view class="error-retry-desc">{{loadingState === 'timeout' ? '网络较慢，数据正在加载，可点击重试' : '课表索引加载失败，请重试'}}</view>
            <button class="error-retry-btn" bindtap="onRetryLoading">重新加载</button>
          </view>
        </block>

        <view class="result-list" wx:if="{{teachersResult.length}}">
          <view
            wx:for="{{teachersResult}}"
            wx:key="teacherName"
            class="result-card card"
            data-index="{{index}}"
            bindtap="viewTeacherSchedule"
          >
            <view class="result-main">
              <view class="result-title">{{item.teacherName}} 老师</view>
              <view class="result-meta">{{item.college}} · 课程数据</view>
            </view>
            <view class="result-side">
              <view class="status ready">课程数据</view>
              <view class="count" wx:if="{{item.courseCount || item.courses.length}}">{{item.courseCount || item.courses.length}}门课</view>
            </view>
          </view>
        </view>

        <empty-state
          wx:elif="{{!loading}}"
          title="输入教师姓名，例如：张三"
          desc="可任选学院、职称作为辅佐筛选项，查询教师当前排课。"
        />
      </view>
    </block>

    <block wx:elif="{{activeTab === 'classroom'}}">
      <!-- 3. 教室 Tab -->
      <view class="tab-panel">
        <view class="filter-card card">
          <view class="filter-item">
            <text class="filter-label">学期：</text>
            <picker mode="selector" range="{{semesters}}" range-key="label" bindchange="onSemesterChange">
              <view class="filter-pill">{{semesters[selectedSemesterIndex].label || "选择学期"}}</view>
            </picker>
          </view>

          <view class="filter-item">
            <text class="filter-label">校区：</text>
            <picker mode="selector" range="{{campusOptions}}" bindchange="onCampusChange">
              <view class="filter-pill">{{campusOptions[selectedCampusIndex] || "所有校区 (可选)"}}</view>
            </picker>
          </view>

          <button class="primary-search-btn" loading="{{loading}}" bindtap="searchClassroomSchedule">
            查询教室占用
          </button>
        </view>

        <view class="updated-hint" wx:if="{{updatedAtText}}">
          {{updatedAtText}}
        </view>

        <!-- 骨架屏与慢网络提示 -->
        <block wx:if="{{loadingState === 'skeleton' || loadingState === 'slow'}}">
          <view class="school-skeleton">
            <view class="skeleton-line wide"></view>
            <view class="skeleton-line"></view>
            <view class="skeleton-line short"></view>
            <view class="slow-loading-hint" wx:if="{{loadingState === 'slow'}}">
              <text class="slow-loading-icon">⏳</text>网络较慢，正在继续加载...
            </view>
          </view>
        </block>

        <!-- 超时重试卡片 -->
        <block wx:if="{{loadingState === 'timeout' || loadingState === 'networkError'}}">
          <view class="error-retry-card card">
            <view class="error-retry-title">{{loadingState === 'timeout' ? '请求超时' : '请求失败'}}</view>
            <view class="error-retry-desc">{{loadingState === 'timeout' ? '网络较慢，数据正在加载，可点击重试' : '课表索引加载失败，请重试'}}</view>
            <button class="error-retry-btn" bindtap="onRetryLoading">重新加载</button>
          </view>
        </block>

        <view class="result-list" wx:if="{{classroomsResult.length}}">
          <view
            wx:for="{{classroomsResult}}"
            wx:key="roomName"
            class="result-card card"
            data-index="{{index}}"
            bindtap="viewClassroomSchedule"
          >
            <view class="result-main">
              <view class="result-title">{{item.roomName}} 教室</view>
              <view class="result-meta">课程数据 · 可点击查看该教室排课占用</view>
            </view>
            <view class="result-side">
              <view class="status ready">课程数据</view>
              <view class="count" wx:if="{{item.courseCount || item.courses.length}}">{{item.courseCount || item.courses.length}}课次</view>
            </view>
          </view>
        </view>

        <empty-state
          wx:elif="{{!loading}}"
          title="输入教室名称并查询"
          desc="例如输入 C7-305，即可获取教室的周课表安排。"
        />
      </view>
    </block>

    <block wx:else>
      <!-- 4. 课程 Tab -->
      <view class="tab-panel">
        <view class="filter-card card">
          <view class="filter-item">
            <text class="filter-label">学期：</text>
            <picker mode="selector" range="{{semesters}}" range-key="label" bindchange="onSemesterChange">
              <view class="filter-pill">{{semesters[selectedSemesterIndex].label || "选择学期"}}</view>
            </picker>
          </view>

          <button class="primary-search-btn" loading="{{loading}}" bindtap="searchCourseSchedule">
            查询课程安排
          </button>
        </view>

        <view class="updated-hint" wx:if="{{updatedAtText}}">
          {{updatedAtText}}
        </view>

        <!-- 骨架屏与慢网络提示 -->
        <block wx:if="{{loadingState === 'skeleton' || loadingState === 'slow'}}">
          <view class="school-skeleton">
            <view class="skeleton-line wide"></view>
            <view class="skeleton-line"></view>
            <view class="skeleton-line short"></view>
            <view class="slow-loading-hint" wx:if="{{loadingState === 'slow'}}">
              <text class="slow-loading-icon">⏳</text>网络较慢，正在继续加载...
            </view>
          </view>
        </block>

        <!-- 超时重试卡片 -->
        <block wx:if="{{loadingState === 'timeout' || loadingState === 'networkError'}}">
          <view class="error-retry-card card">
            <view class="error-retry-title">{{loadingState === 'timeout' ? '请求超时' : '请求失败'}}</view>
            <view class="error-retry-desc">{{loadingState === 'timeout' ? '网络较慢，数据正在加载，可点击重试' : '课表索引加载失败，请重试'}}</view>
            <button class="error-retry-btn" bindtap="onRetryLoading">重新加载</button>
          </view>
        </block>

        <view class="result-list" wx:if="{{coursesResult.length}}">
          <view
            wx:for="{{coursesResult}}"
            wx:key="courseName"
            class="result-card card"
            data-index="{{index}}"
            bindtap="viewCourseSchedule"
          >
            <view class="result-main">
              <view class="result-title">{{item.courseName}}</view>
              <view class="result-meta">课程数据 · 点击查看该课程在全校的排课分布</view>
            </view>
            <view class="result-side">
              <view class="status ready">课程数据</view>
              <view class="count" wx:if="{{item.courseCount || item.courses.length}}">{{item.courseCount || item.courses.length}}次排课</view>
            </view>
          </view>
        </view>

        <empty-state
          wx:elif="{{!loading}}"
          title="输入课程名并查询"
          desc="输入如：动物解剖学、有机化学，查看该门课程的开课详情。"
        />
      </view>
    </block>
    <view class="school-footer-disclaimer">{{runtimeDisclaimer}}</view>


  </block>
</view>
