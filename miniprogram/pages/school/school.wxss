.school-page {
  width: 100%;
  padding: 16rpx 16rpx calc(24rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.page-header {
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.title {
  color: #172033;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
}

.subtitle {
  margin-top: 10rpx;
  color: #778297;
  font-size: 24rpx;
  line-height: 1.45;
}

.search-card {
  padding: 16rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(162, 178, 201, 0.08);
}

.search-row {
  display: flex;
  align-items: center;
  min-height: 82rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #f2f5f9;
}

.search-icon {
  margin-right: 12rpx;
  color: #7a8494;
  font-size: 34rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #172033;
  font-size: 28rpx;
}

.search-placeholder {
  color: #a5adba;
}

.tabs {
  display: flex;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #f6f8fb;
}

.tab-item {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  border-radius: 10rpx;
  color: #687386;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 58rpx;
  text-align: center;
}

.tab-item.active {
  background: #ffffff;
  color: #c62828;
  box-shadow: 0 8rpx 18rpx rgba(16, 31, 55, 0.06);
}

.tab-panel {
  margin-top: 20rpx;
}

/* 过滤面板卡片 */
.filter-card {
  padding: 24rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(162, 178, 201, 0.08);
  margin-bottom: 20rpx;
}

.filter-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f5f9;
  padding-bottom: 16rpx;
}

.filter-item:last-of-type {
  margin-bottom: 24rpx;
}

.filter-label {
  flex: 0 0 120rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #3e4e68;
}

picker {
  flex: 1;
  min-width: 0;
}

.filter-pill {
  font-size: 26rpx;
  color: #172033;
  padding: 4rpx 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary-search-btn {
  width: 100% !important;
  height: 80rpx;
  border-radius: 40rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(198, 40, 40, 0.2);
}

.primary-search-btn:active {
  transform: scale(0.98);
}

.updated-hint {
  font-size: 22rpx;
  color: #778297;
  padding: 8rpx 12rpx;
  margin-bottom: 12rpx;
  background: #f1f4f8;
  border-radius: 8rpx;
  display: inline-block;
}

/* 结果列表与卡片 */
.result-list {
  margin-top: 10rpx;
}

.class-result-notice {
  margin: 8rpx 0 16rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #dfe7f3;
  border-radius: 12rpx;
  background: #f8fbff;
  color: #536174;
  font-size: 24rpx;
  line-height: 1.45;
}

.result-group {
  margin-bottom: 24rpx;
}

.result-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 6rpx 4rpx 14rpx;
}

.result-group-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.result-group-count {
  color: #8a94a6;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.result-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(162, 178, 201, 0.08);
}

.aggregate-card {
  border: 1rpx solid #e5eaff;
}

.result-card:active {
  background: #f8fafc;
}

.result-main {
  min-width: 0;
  flex: 1;
}

.result-title {
  overflow: hidden;
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-meta {
  margin-top: 8rpx;
  color: #778297;
  font-size: 24rpx;
  line-height: 1.35;
}

.result-side {
  flex: 0 0 auto;
  text-align: right;
}

.status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 48rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.status.ready {
  background: #e9f8f1;
  color: #16a36b;
}

.status.aggregate {
  background: #eef2ff;
  color: #3b5bdb;
}

.count {
  margin-top: 8rpx;
  color: #9aa4b5;
  font-size: 22rpx;
}

.restore-hint-bar {
  display: flex;
  align-items: center;
  background-color: #f0fdf4;
  border: 1rpx solid #bbf7d0;
  color: #166534;
  padding: 12rpx 20rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}

.restore-hint-icon {
  margin-right: 8rpx;
  font-weight: bold;
}

.restore-hint-text {
  flex: 1;
}

.reset-filter-btn {
  margin-top: 16rpx;
  width: 100% !important;
  height: 72rpx;
  border-radius: 36rpx;
  background: #f1f4f8;
  color: #5c687e;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reset-filter-btn:active {
  background: #e2e8f0;
}
