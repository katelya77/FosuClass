@import "../index/index.wxss";

page { height: 100vh; overflow: hidden; background: #ffffff; }
.fullscreen-page { height: 100vh; overflow: hidden; box-sizing: border-box; background: #ffffff; }
.fullscreen-toolbar {
  position: relative;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #edf0f4;
  background: #ffffff;
}
.fullscreen-back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 112rpx;
  height: 60rpx;
  color: #475569;
  font-size: 22rpx;
}
.fullscreen-back-icon { font-size: 42rpx; line-height: 1; }
.fullscreen-toolbar-title {
  position: absolute;
  left: 150rpx;
  right: 150rpx;
  overflow: hidden;
  color: #172033;
  font-size: 27rpx;
  font-weight: 800;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.fullscreen-controls { background: #ffffff; }
.fullscreen-weekbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 4rpx 20rpx 0;
}
.fullscreen-arrow {
  flex: 0 0 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  background: #f4f6f9;
  color: #465267;
  font-size: 36rpx;
  line-height: 1;
}
.fullscreen-arrow.is-disabled { opacity: .35; }
.fullscreen-week-summary {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.fullscreen-week { color: #172033; font-size: 27rpx; font-weight: 800; line-height: 1.15; }
.fullscreen-range { overflow: hidden; max-width: 100%; color: #8490a3; font-size: 21rpx; line-height: 1.1; text-overflow: ellipsis; white-space: nowrap; }
.fullscreen-subbar { display: flex; align-items: center; gap: 10rpx; min-height: 66rpx; padding: 0 20rpx 12rpx; }
.fullscreen-target { flex: 1; min-width: 0; overflow: hidden; color: #6b7688; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.fullscreen-action { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; height: 48rpx; padding: 0 14rpx; border-radius: 12rpx; background: #f4f6f9; color: #566276; font-size: 20rpx; }
.fullscreen-zoom { background: #fff1f1; color: #a82026; }
.fullscreen-zoom.is-zoomed { background: #f4f6f9; color: #566276; }
.fullscreen-page .table-shell { width: 100%; margin: 0; border-radius: 0; }
.fullscreen-page .schedule-grid-shell { width: 100%; }
