.contribute-page {
  padding: 30rpx;
  background-color: #f6f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片通用样式 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
}

.header-card {
  background: linear-gradient(135deg, #e53935, #b71c1c);
  color: #ffffff;
}

.header-card .title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.header-card .desc {
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.9;
}

/* 表单输入卡片 */
.group-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 20rpx;
  display: block;
}

.group-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.template-btn {
  background-color: #f1f3f5 !important;
  color: #c62828 !important;
  font-size: 22rpx !important;
  font-weight: 500 !important;
  border-radius: 10rpx !important;
  padding: 6rpx 16rpx !important;
  margin: 0 !important;
  line-height: 1.5 !important;
}

.form-item {
  border-bottom: 1rpx solid #f1f3f5;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-item:last-child {
  border-bottom: none;
  padding-bottom: 10rpx;
}

.form-item .label {
  font-size: 28rpx;
  color: #34495e;
  width: 160rpx;
}

.form-item input {
  flex: 1;
  font-size: 28rpx;
  color: #2c3e50;
  text-align: right;
}

.picker-value {
  font-size: 28rpx;
  color: #2c3e50;
  display: flex;
  align-items: center;
}

.picker-value .arrow {
  margin-left: 10rpx;
  color: #bdc3c7;
  font-size: 32rpx;
}

.placeholder {
  color: #bdc3c7;
  text-align: right;
}

/* 文本域粘贴区 */
.textarea-container {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx;
}

.textarea-container textarea {
  width: 100%;
  height: 280rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.5;
  font-family: monospace;
}

/* 隐私安全卡片 */
.privacy-card {
  background-color: #fdf2f2;
  border: 1rpx solid #fde2e2;
}

.privacy-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #c62828;
  margin-bottom: 16rpx;
}

.privacy-item {
  font-size: 24rpx;
  color: #c62828;
  line-height: 1.6;
  margin-bottom: 10rpx;
  opacity: 0.9;
}
.privacy-item:last-child {
  margin-bottom: 0;
}

/* 提交按钮 */
.submit-btn {
  background: linear-gradient(135deg, #e53935, #c62828) !important;
  color: #ffffff !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  border-radius: 44rpx !important;
  padding: 24rpx 0 !important;
  margin-top: 40rpx !important;
  margin-bottom: 80rpx !important;
  box-shadow: 0 8rpx 30rpx rgba(198, 40, 40, 0.2);
}

.submit-btn::after {
  border: none;
}
