<view class="page calendar-page">
  <view class="calendar-header card">
    <view class="calendar-title">{{title}}</view>
    <view class="calendar-subtitle">当前高亮：第{{currentWeek}}周</view>
  </view>

  <view class="week-list">
    <view
      wx:for="{{weeks}}"
      wx:key="week"
      class="week-card card {{item.active ? 'active' : ''}}"
    >
      <view class="week-index">第{{item.week}}周</view>
      <view class="week-info">
        <view class="week-date">{{item.startDate}} 至 {{item.endDate}}</view>
        <view class="week-note">{{item.note}}</view>
      </view>
    </view>
  </view>
</view>
