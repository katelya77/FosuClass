<view class="page calendar-page">
  <view class="calendar-header card">
    <view class="calendar-title">{{title}}</view>
    <view class="calendar-subtitle">当前高亮：{{currentWeekText}}</view>
  </view>

  <view class="week-list">
    <view
      wx:for="{{weeks}}"
      wx:key="weekNo"
      class="week-card card {{item.active ? 'active' : ''}}"
    >
      <view class="week-index">第{{item.weekNo}}周</view>
      <view class="week-info">
        <view class="week-date">{{item.rangeText}}</view>
        <view class="week-note">{{item.notes}}</view>
      </view>
    </view>
  </view>
</view>
