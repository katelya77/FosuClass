<page-meta page-style="{{formVisible ? 'overflow: hidden;' : ''}}" />
<view class="page custom-page">
  <view class="custom-hero card">
    <view>
      <view class="hero-kicker">个性化课程</view>
      <view class="hero-title">调整你的专属课表</view>
      <view class="hero-desc">当前绑定：{{targetLabel}}</view>
    </view>
    <button class="hero-btn" bindtap="showAddForm">添加课程</button>
  </view>

  <view class="source-section card" wx:if="{{sourceCount}}">
    <view class="source-section-head">
      <view>
        <view class="group-title">原课表课程</view>
        <view class="source-section-subtitle">{{sourceCount}} 门课程 · {{overrideCount}} 门已调整</view>
      </view>
      <view class="source-section-badge">可编辑</view>
    </view>
    <view class="source-section-tip">调整保存在本机，仅应用于当前课表；课表来源更新后，未修改的信息会继续同步。</view>
    <view class="source-search"><text>查找</text><input value="{{sourceQuery}}" placeholder="课程名、教师或教室" confirm-type="search" bindinput="onSourceSearch" /></view>
    <view class="source-search-empty" wx:if="{{sourceQuery && !visibleSourceCourses.length}}">没有找到相关课程，请换个关键词。</view>
    <view class="source-course-row" wx:for="{{visibleSourceCourses}}" wx:key="sourceIndex">
      <view class="source-course-mark {{item.personalized ? 'changed' : ''}}"></view>
      <view class="source-course-main">
        <view class="source-course-heading">
          <text class="source-course-name">{{item.courseName}}</text>
          <text class="source-course-status {{item.personalized ? 'changed' : ''}}">{{item.personalized ? '已调整' : '原课程'}}</text>
        </view>
        <view class="source-course-meta">{{item.weekdayText}} · 第{{item.startSection}}-{{item.endSection}}节 · {{item.weekText}}</view>
        <view class="source-course-meta">{{item.teacherName || '教师待补充'}} · {{item.classroom || '教室待补充'}}</view>
        <view class="source-course-actions">
          <button data-index="{{item.sourceIndex}}" bindtap="editSourceCourse">{{item.personalized ? '继续调整' : '编辑课程'}}</button>
          <button wx:if="{{item.personalized}}" class="restore-course-btn" data-index="{{item.sourceIndex}}" bindtap="restoreSourceCourse">恢复原信息</button>
        </view>
      </view>
    </view>
  </view>

  <view class="import-card card">
    <view class="group-title" bindtap="toggleImportTools" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
      <text>导入 / 导出工具</text>
      <text class="collapse-icon" style="font-size: 24rpx; color: #8a94a6;">{{importToolsCollapsed ? '▼ 展开' : '▲ 收起'}}</text>
    </view>
    <view class="import-grid" wx:if="{{!importToolsCollapsed}}">
      <button class="import-btn import-xls-btn" bindtap="importXls">100网 xls 导入</button>
      <button class="import-btn" bindtap="exportJson">导出新增课程 JSON</button>
      <button class="import-btn" bindtap="importJson">导入新增课程 JSON</button>
      <button class="import-btn disabled" disabled>WakeUp (即将支持)</button>
      <button class="import-btn disabled" disabled>ICS (即将支持)</button>
      <button class="import-btn disabled" disabled>粘贴文本 (即将支持)</button>
    </view>
  </view>

  <view class="added-section-title">自行添加的课程 <text>{{courses.length}}</text></view>

  <view wx:if="{{courses.length}}" class="course-list">
    <view wx:for="{{courses}}" wx:key="id" class="custom-course-card card">
      <view class="course-top">
        <view class="course-main">
          <view class="course-title">{{item.courseName}}</view>
          <view class="course-meta">{{weekdayOptions[item.weekday - 1] || weekdayOptions[item.weekDay - 1]}} · 第{{item.startSection}}-{{item.endSection}}节 · {{item.weekText}}</view>
          <view class="course-meta">{{item.teacherName || "教师待补充"}} · {{item.classroom || "教室待补充"}}</view>
        </view>
        <switch checked="{{item.enabled}}" color="#3654d4" data-id="{{item.id}}" bindchange="toggleCourse" />
      </view>
      <view class="course-note" wx:if="{{item.note}}">{{item.note}}</view>
      <view class="course-actions">
        <button data-id="{{item.id}}" bindtap="editCourse">编辑</button>
        <button class="danger" data-id="{{item.id}}" bindtap="deleteCourse">删除</button>
      </view>
    </view>
  </view>

  <empty-state
    wx:else
    title="还没有添加课程"
    desc="原课表课程可以直接在上方编辑；实验课、选修课等新安排可点击「添加课程」。"
    symbol="课"
  />

  <view wx:if="{{formVisible}}" class="popup-mask" bindtap="hideForm" catchtouchmove="noop">
    <view class="popup-panel" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="popup-header">
        <view>
          <view class="popup-title">{{formTitle}}</view>
          <view class="popup-subtitle">{{formMode === 'override' ? '仅调整当前课表的显示，可随时恢复原信息' : '保存后立即应用到首页和今日课程'}}</view>
        </view>
        <button class="close-button" bindtap="hideForm">×</button>
      </view>

      <scroll-view scroll-y enhanced bounces="{{false}}" class="form-scroll">
        <view class="form-grid">
          <view class="field full">
            <view class="label">课程名</view>
            <input value="{{form.courseName}}" data-key="courseName" placeholder="例如：大学英语" bindinput="onInput" />
          </view>
          <view class="field">
            <view class="label">教师</view>
            <input value="{{form.teacherName}}" data-key="teacherName" placeholder="例如：张老师 (选填)" bindinput="onInput" />
          </view>
          <view class="field">
            <view class="label">教室</view>
            <input value="{{form.classroom}}" data-key="classroom" placeholder="例如：A1-101 (选填)" bindinput="onInput" />
          </view>
          <view class="field">
            <view class="label">星期</view>
            <picker range="{{weekdayOptions}}" value="{{form.weekdayIndex}}" data-key="weekdayIndex" bindchange="onPickerChange">
              <view class="picker-value">{{weekdayOptions[form.weekdayIndex]}}</view>
            </picker>
          </view>
          <view class="field">
            <view class="label">开始节次</view>
            <picker range="{{sectionOptions}}" value="{{form.startSectionIndex}}" data-key="startSectionIndex" bindchange="onPickerChange">
              <view class="picker-value">{{sectionOptions[form.startSectionIndex]}}</view>
            </picker>
          </view>
          <view class="field">
            <view class="label">结束节次</view>
            <picker range="{{sectionOptions}}" value="{{form.endSectionIndex}}" data-key="endSectionIndex" bindchange="onPickerChange">
              <view class="picker-value">{{sectionOptions[form.endSectionIndex]}}</view>
            </picker>
          </view>
          <view class="field full" wx:if="{{formMode !== 'override'}}">
            <view class="label">选择卡片颜色</view>
            <view class="color-picker-grid" style="display: flex; gap: 16rpx; flex-wrap: wrap; margin-top: 10rpx;">
              <view 
                wx:for="{{predefinedColors}}" 
                wx:key="*this" 
                class="color-dot {{form.color === item ? 'active' : ''}}" 
                style="width: 54rpx; height: 54rpx; border-radius: 50%; background: {{item}}; box-sizing: border-box; border: 4rpx solid {{form.color === item ? '#ffffff' : 'transparent'}}; box-shadow: {{form.color === item ? '0 0 0 4rpx ' + item : '0 4rpx 10rpx rgba(0,0,0,0.06)'}};" 
                data-color="{{item}}" 
                bindtap="selectColor"
              ></view>
            </view>
          </view>
          <view class="field full">
            <view class="label">周次</view>
            <input value="{{form.weekText}}" data-key="weekText" placeholder="例如：1-8,10-15周" bindinput="onInput" />
          </view>
          <view class="field pointer full">
            <view class="label">备注</view>
            <textarea value="{{form.note}}" data-key="note" placeholder="例如：第12周周二临时调课到周四（选填）" bindinput="onInput" />
          </view>
          <view class="field switch-field" wx:if="{{formMode !== 'override'}}">
            <view>
              <view class="label">启用课程</view>
              <view class="hint">关闭后保留数据但不显示</view>
            </view>
            <switch checked="{{form.enabled}}" color="#3654d4" bindchange="onEnabledChange" />
          </view>
        </view>
      </scroll-view>

      <view class="popup-footer">
        <button class="footer-btn secondary" bindtap="hideForm">取消</button>
        <button class="footer-btn primary" bindtap="saveCourse">保存</button>
      </view>
    </view>
  </view>
  <xiaofu-float />
</view>
