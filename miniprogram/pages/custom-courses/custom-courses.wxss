.custom-page {
  width: 100%;
  padding: 18rpx 18rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.custom-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #eef4ff, #f8f6ff);
}

.hero-kicker {
  color: #3654d4;
  font-size: 22rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 6rpx;
  color: #172033;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 8rpx;
  color: #3654d4;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  opacity: 0.95;
}

.hero-btn {
  flex: 0 0 auto;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  background: #3654d4;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: 0 4rpx 12rpx rgba(54, 84, 212, 0.2);
}

.import-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.group-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.import-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.import-grid button {
  width: 100% !important;
  height: 68rpx;
  border-radius: 34rpx;
  background: #f1f5ff;
  color: #3654d4;
  font-size: 24rpx;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.import-grid button.disabled {
  background: #f0f3f6 !important;
  color: #8a94a6 !important;
  opacity: 0.8;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.custom-course-card {
  padding: 22rpx;
  border-radius: 16rpx;
}

.course-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.course-main {
  min-width: 0;
  flex: 1;
}

.course-title {
  overflow: hidden;
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta,
.course-note {
  margin-top: 8rpx;
  color: #66718a;
  font-size: 23rpx;
  line-height: 1.45;
}

.course-note {
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #f7f9fc;
}

.course-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.course-actions button {
  flex: 1;
  height: 64rpx;
  border-radius: 32rpx;
  background: #f1f5ff;
  color: #3654d4;
  font-size: 24rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.course-actions button.danger {
  background: #fff0f3;
  color: #d94c6a;
}

.popup-mask {
  position: fixed;
  z-index: 999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 24, 40, 0.46);
}

.popup-panel {
  width: 100%;
  max-height: 88vh;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  overflow: hidden;
}

.popup-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 16rpx auto 8rpx;
  border-radius: 999rpx;
  background: #d9dee8;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.popup-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
}

.popup-subtitle {
  margin-top: 4rpx;
  color: #7a8494;
  font-size: 22rpx;
}

.close-button {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f3f7;
  color: #687386;
  font-size: 38rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.form-scroll {
  max-height: 60vh;
}

.form-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 22rpx 28rpx;
}

.field {
  width: calc(50% - 8rpx);
  min-width: 0;
}

.field.full,
.switch-field {
  width: 100%;
}

.label {
  margin-bottom: 8rpx;
  color: #66718a;
  font-size: 22rpx;
  font-weight: 800;
}

.hint {
  margin-top: 4rpx;
  color: #9aa4b5;
  font-size: 21rpx;
}

input,
textarea,
.picker-value {
  width: 100%;
  height: 76rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #172033;
  font-size: 25rpx;
  box-sizing: border-box;
}

.picker-value {
  display: flex;
  align-items: center;
  line-height: 1;
}

textarea {
  min-height: 130rpx;
  padding-top: 16rpx;
  line-height: 1.5;
}

.switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.popup-footer {
  display: flex;
  gap: 16rpx;
  padding: 22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #edf0f5;
}

.footer-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 900;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.footer-btn.primary {
  background: #3654d4;
  color: #ffffff;
}

.footer-btn.secondary {
  background: #f7f9fc;
  color: #536174;
}

/* 颜色选择色块动效 */
.color-dot {
  transition: all 0.2s ease;
}
.color-dot:active {
  transform: scale(0.9);
}
.color-dot.active {
  transform: scale(1.1);
}

/* 覆盖空状态图标样式 */
.empty-state .empty-symbol {
  background: #eef2ff !important;
  color: #3654d4 !important;
  font-size: 42rpx !important;
}

.import-xls-btn {
  background: #ffebee !important;
  color: #c62828 !important;
  box-shadow: 0 4rpx 10rpx rgba(198, 40, 40, 0.08) !important;
  font-weight: 800 !important;
}

.import-xls-btn:active {
  background: #ffcdd2 !important;
}
