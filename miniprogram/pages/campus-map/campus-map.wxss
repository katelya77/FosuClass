.campus-map-page {
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.campus-map-page button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.campus-map-page button::after {
  border: 0;
}

.campus-tabs {
  display: grid;
  width: 100%;
  box-sizing: border-box;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  overflow: hidden;
}

.campus-tab,
.area-tab {
  box-sizing: border-box;
  min-width: 0;
  height: 64rpx;
  border-radius: 12rpx;
  background: #ffffff;
  color: #536174;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.campus-tab.active,
.area-tab.active {
  background: #c62828;
  color: #ffffff;
}

.area-tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.area-tab {
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(31, 41, 55, 0.06);
}

.search-card {
  margin-top: 18rpx;
  padding: 0 22rpx;
}

.search-input {
  height: 78rpx;
  color: #172033;
  font-size: 28rpx;
}

.map-card {
  margin-top: 18rpx;
  padding: 22rpx;
}

.map-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.map-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.map-subtitle {
  margin-top: 6rpx;
  color: #778297;
  font-size: 22rpx;
}

.map-preview-btn {
  flex: 0 0 auto;
  width: 88rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #f1f3f7;
  color: #536174;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.map-image-wrap {
  position: relative;
  overflow: hidden;
  height: 430rpx;
  max-height: 46vh;
  border-radius: 12rpx;
  background: #f4f7fb;
}

.campus-map-image {
  display: block;
  width: 100%;
  height: 100%;
}

.map-placeholder,
.map-error {
  position: absolute;
  top: 50%;
  left: 0;
  z-index: 1;
  width: 100%;
  transform: translateY(-50%);
  color: #778297;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.map-error {
  color: #8a4b4b;
}

.map-retry-btn,
.preview-retry-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 48rpx;
  margin-top: 14rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 48rpx;
}

.map-marker {
  position: absolute;
  z-index: 2;
  border: 4rpx solid #c62828;
  border-radius: 10rpx;
  background: rgba(198, 40, 40, 0.08);
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.9);
  pointer-events: none;
}

.result-section {
  margin-top: 22rpx;
}

.section-title-small {
  margin: 0 4rpx 12rpx;
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
}

.place-card {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-bottom: 14rpx;
  padding: 20rpx;
}

.place-card.selected {
  border-color: rgba(198, 40, 40, 0.38);
  background: #fff7f7;
}

.place-main {
  flex: 1;
  min-width: 0;
}

.place-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.place-meta {
  margin-top: 6rpx;
  color: #778297;
  font-size: 22rpx;
  line-height: 1.35;
}

.place-desc {
  margin-top: 8rpx;
  color: #536174;
  font-size: 24rpx;
  line-height: 1.45;
}

.place-review {
  margin-top: 8rpx;
  color: #9a5b08;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.35;
}

.place-code {
  flex: 0 0 auto;
  min-width: 64rpx;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #eef3fb;
  color: #536174;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}

.selected-actions {
  margin-top: 20rpx;
}

.query-btn {
  width: 100%;
  height: 78rpx;
  border-radius: 14rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.map-note {
  margin-top: 24rpx;
  color: #98a2b3;
  font-size: 21rpx;
  line-height: 1.45;
  text-align: center;
}

.preview-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  background: rgba(17, 24, 39, 0.94);
}

.preview-toolbar {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding: calc(18rpx + env(safe-area-inset-top)) 18rpx 14rpx;
}

.preview-tool-btn {
  width: auto;
  min-width: 112rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: center;
}

.preview-area {
  flex: 1;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.preview-movable {
  width: 100%;
  min-height: 100%;
}

.preview-image {
  display: block;
  width: 100%;
}

.preview-loading,
.preview-error {
  position: absolute;
  top: 44%;
  left: 0;
  z-index: 1;
  width: 100%;
  color: rgba(255, 255, 255, 0.76);
  font-size: 25rpx;
  font-weight: 800;
  text-align: center;
}

.preview-error {
  color: #ffffff;
}
