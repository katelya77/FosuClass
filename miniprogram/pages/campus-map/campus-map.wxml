<view class="page campus-map-page">
  <view class="campus-tabs card">
    <view
      wx:for="{{campusTabs}}"
      wx:key="key"
      role="button"
      aria-label="切换到{{item.label}}校区"
      class="campus-tab {{activeCampus === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onCampusTap"
    >{{item.label}}</view>
  </view>

  <view class="area-tabs" wx:if="{{activeCampus === 'xianxi'}}">
    <view
      wx:for="{{xianxiAreas}}"
      wx:key="key"
      role="button"
      aria-label="切换到仙溪{{item.label}}"
      class="area-tab {{activeXianxiArea === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onAreaTap"
    >{{item.label}}</view>
  </view>

  <view class="search-card card">
    <view class="search-row">
      <input
        class="search-input"
        value="{{query}}"
        placeholder="搜索楼栋代码或地点名"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <button wx:if="{{query}}" class="search-clear-btn" bindtap="clearSearch" aria-label="清除搜索">×</button>
      <button class="search-submit-btn" loading="{{searchState === 'loading'}}" bindtap="onSearchTap">搜索</button>
    </view>
  </view>

  <view class="map-card card">
    <view class="map-head">
      <view>
        <view class="map-title">{{mapInfo.title}}</view>
        <view class="map-subtitle">点击后只预览当前地图</view>
      </view>
      <button class="map-preview-btn" bindtap="previewMap">大图</button>
    </view>
    <view class="map-image-wrap">
      <view class="map-placeholder" wx:if="{{!imageLoaded && !imageError}}">地图加载中</view>
      <view class="map-error" wx:if="{{imageError}}">
        <view>地图暂时无法加载</view>
        <button class="map-retry-btn" bindtap="retryMapImage">重试</button>
      </view>
      <image
        class="campus-map-image"
        src="{{mapInfo.asset}}"
        mode="aspectFit"
        bindtap="previewMap"
        bindload="onMapImageLoad"
        binderror="onMapImageError"
      />
    </view>
  </view>

  <view class="result-section" wx:if="{{searchState === 'loading'}}">
    <view class="section-title-small">搜索结果</view>
    <view class="search-state-card card">正在搜索...</view>
  </view>

  <view class="result-section" wx:elif="{{searchState === 'empty'}}">
    <view class="section-title-small">搜索结果</view>
    <view class="search-state-card card">没有找到“{{searchedQuery}}”，可以换楼栋代码或地点名再试。</view>
  </view>

  <view class="result-section" wx:elif="{{searchState === 'error'}}">
    <view class="section-title-small">搜索结果</view>
    <view class="search-state-card card error">{{searchError || "搜索失败，请稍后重试"}}</view>
  </view>

  <view class="result-section" wx:elif="{{results.length}}">
    <view class="section-title-small">搜索结果</view>
    <view
      wx:for="{{results}}"
      wx:key="id"
      class="place-card card {{selectedPlace && selectedPlace.id === item.id ? 'selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="onPlaceTap"
    >
      <view class="place-main">
        <view class="place-title">{{item.name}}</view>
        <view class="place-meta">{{item.campus}} · {{item.area}} · 参考位置</view>
        <view class="place-desc">{{item.description}}</view>
      </view>
      <view class="place-code" wx:if="{{item.code}}">{{item.code}}</view>
    </view>
  </view>

  <view class="result-section">
    <view class="section-title-small">主要地点</view>
    <view
      wx:for="{{places}}"
      wx:key="id"
      class="place-card card {{selectedPlace && selectedPlace.id === item.id ? 'selected' : ''}}"
      data-id="{{item.id}}"
      bindtap="onPlaceTap"
    >
      <view class="place-main">
        <view class="place-title">{{item.name}}</view>
        <view class="place-meta">{{item.campus}} · {{item.area}} · 参考位置</view>
        <view class="place-desc">{{item.description}}</view>
      </view>
      <view class="place-code" wx:if="{{item.code}}">{{item.code}}</view>
    </view>
  </view>

  <view class="selected-actions" wx:if="{{selectedPlace && selectedPlace.type === 'teaching_building'}}">
    <button class="query-btn" bindtap="openSchoolQuery">查询该楼栋教室课表</button>
  </view>

  <view class="map-note">{{note}}</view>

  <view class="preview-layer" wx:if="{{previewVisible}}">
    <view class="preview-toolbar">
      <button class="preview-tool-btn" bindtap="closeCustomPreview">关闭</button>
      <button class="preview-tool-btn" bindtap="resetCustomPreviewScale">恢复比例</button>
    </view>
    <movable-area class="preview-area">
      <movable-view
        class="preview-movable"
        direction="all"
        scale="{{true}}"
        scale-min="1"
        scale-max="4"
        scale-value="{{previewScale}}"
      >
        <view class="preview-loading" wx:if="{{!previewImageLoaded && !previewImageError}}">大图加载中</view>
        <view class="preview-error" wx:if="{{previewImageError}}">
          <view>大图加载失败</view>
          <button class="preview-retry-btn" bindtap="retryPreviewImage">重试</button>
        </view>
        <image
          class="preview-image"
          src="{{previewImagePath}}"
          mode="widthFix"
          bindload="onPreviewImageLoad"
          binderror="onPreviewImageError"
        />
      </movable-view>
    </movable-area>
  </view>
</view>
