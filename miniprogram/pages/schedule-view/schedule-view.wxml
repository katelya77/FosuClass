<view class="page schedule-view-page">
  <!-- 分享来源预览提示条 -->
  <view class="share-preview-bar" wx:if="{{isFromShare && !isCurrentTarget}}">
    <view class="share-preview-text">这是同学分享的课表，是否设为你的当前课表？</view>
    <button class="share-bind-btn" bindtap="toggleBindTarget">设为我的课表</button>
  </view>

  <view class="view-header card">
    <view class="header-top">
      <view class="target-info">
        <view class="target-title">{{title}}</view>
        <view class="target-subtitle">{{semester}} · {{scheduleKindText}}</view>
      </view>
      <button 
        class="bind-button {{isCurrentTarget ? 'active' : ''}}" 
        bindtap="toggleBindTarget"
      >
        {{isCurrentTarget ? "已设为当前课表" : "设为当前课表"}}
      </button>
    </view>
    
    <view class="date-line" wx:if="{{weekRangeText}}">
      {{weekRangeText}} · {{weekScopeText}}
    </view>
    <view class="disclaimer-line">{{brand.disclaimer}}</view>

    <view class="control-row">
      <week-switcher
        current-week="{{currentWeek}}"
        total-weeks="{{totalWeeks}}"
        week-label="{{weekSwitcherLabel}}"
        bind:change="onWeekChange"
      />
    </view>
  </view>

  <view class="schedule card">
    <view class="schedule-title-row">
      <view class="section-title">周课表</view>
      <view class="schedule-hint">{{showWeekend ? "周一至周日，可横向滑动" : "周一至周五"}}</view>
    </view>

    <view class="table-shell" wx:if="{{allCourses && allCourses.length && hasVisibleWeekCourses}}">
      <!-- 左右滑动查看周末提示 -->
      <view class="swipe-hint-bar" wx:if="{{showWeekend && weekendShowMode === 'detail'}}" style="background: #fff5f5; border-bottom: 1rpx solid #edf0f5; padding: 12rpx 24rpx; text-align: center;">
        <text class="swipe-hint-text" style="font-size: 20rpx; color: #c62828; font-weight: bold;">💡 左右滑动查看周末课表</text>
      </view>

      <view class="schedule-grid-shell">
        <view class="time-axis-layer">
          <view class="time-axis">
            <view class="time-head">节次</view>
            <view
              wx:for="{{sections}}"
              wx:key="section"
              class="time-cell {{item.section === 5 || item.section === 10 ? 'section-divider' : ''}}"
              style="height: {{sectionHeight}}rpx;"
            >
              <view class="section-no">第{{item.section}}节</view>
              <view class="time-text-single">{{item.axisLabel}}</view>
            </view>
          </view>
        </view>

        <scroll-view
          class="schedule-scroll-x {{showWeekend ? 'has-weekend' : ''}}"
          scroll-x="{{scrollX}}"
          enhanced
          show-scrollbar="{{false}}"
        >
          <view class="day-track" style="width: {{dayTrackWidth}}rpx;">
            <view class="weekday-heads">
              <view
                wx:for="{{weekdays}}"
                wx:key="weekday"
                class="weekday-head {{item.isToday ? 'is-today' : ''}}"
                style="width: {{dayColumnWidth}}rpx;"
              >
                <view>{{item.label}}</view>
                <view class="weekday-date">{{item.dateLabel}}</view>
                <view wx:if="{{item.isToday}}" class="today-dot"></view>
              </view>
            </view>

            <view class="days-area" style="height: {{scheduleHeight}}rpx;">
              <view
                wx:for="{{dayColumns}}"
                wx:key="weekday"
                class="day-column {{item.isToday ? 'is-today' : ''}}"
                style="width: {{dayColumnWidth}}rpx;"
              >
                <view
                  wx:for="{{sections}}"
                  wx:for-item="section"
                  wx:key="section"
                  class="section-slot {{section.section === 5 || section.section === 10 ? 'section-divider' : ''}}"
                  style="height: {{sectionHeight}}rpx;"
                ></view>
                <course-card
                  wx:for="{{item.courses}}"
                  wx:for-item="course"
                  wx:key="id"
                  course="{{course}}"
                  card-style="{{course.cardStyle}}"
                  layout="{{showWeekend && weekendShowMode === 'overview' ? 'overview' : 'grid'}}"
                  bind:tapcourse="onCourseTap"
                />
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>

    <view class="empty-week-wrap" wx:elif="{{allCourses && allCourses.length}}">
      <view class="empty-week-title">本周暂无课程</view>
      <view class="empty-week-desc">该课表共有 {{allCourses.length}} 门课，可切换周次查看，或查看下方课程总览。</view>
    </view>
    
    <view class="empty-wrap" wx:else>
      <image class="empty-icon" src="/images/icons/business.png" style="opacity: 0.15; width: 120rpx; height: 120rpx; margin-bottom: 20rpx;" />
      <view class="empty-text">该课表暂无课程数据</view>
    </view>
  </view>

  <view class="course-overview card" wx:if="{{allCourses && allCourses.length}}">
    <view class="overview-head" bindtap="toggleOverview">
      <view>
        <view class="section-title">课程总览</view>
        <view class="overview-subtitle">全部 {{allCourses.length}} 门课</view>
      </view>
      <view class="overview-toggle">{{overviewExpanded ? "收起" : "展开"}}</view>
    </view>

    <view class="overview-list" wx:if="{{overviewExpanded}}">
      <view
        wx:for="{{overviewCourses}}"
        wx:key="overviewKey"
        class="overview-item"
        data-index="{{index}}"
        bindtap="onOverviewCourseTap"
      >
        <view class="overview-course-title">{{item.displayCourseName || item.canonicalCourseName || item.courseName}}</view>
        <view class="overview-meta-row">
          <text>{{item.displayTeacherName || item.canonicalTeacherName || item.teacherName || "教师待补充"}}</text>
          <text>{{item.displayClassroom || item.canonicalClassroom || item.classroom || "教室待补充"}}</text>
        </view>
        <view class="overview-meta-row muted">
          <text>{{item.weekText || "周次待补充"}}</text>
          <text>{{item.weekdayText}} · {{item.sectionText}}</text>
        </view>
      </view>
    </view>
  </view>

  <course-detail-popup
    visible="{{detailVisible}}"
    course="{{selectedCourse}}"
    bind:close="closeCourseDetail"
    bind:copycustom="onCopyCourseToCustom"
  />
  <xiaofu-float />
</view>
