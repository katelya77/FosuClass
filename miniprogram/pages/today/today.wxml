<page-meta page-style="{{detailVisible ? 'overflow: hidden;' : ''}}" />
<view class="page today-page">
  <view class="today-hero card">
    <view class="hero-topline">
      <view class="date-text">{{dateText}}</view>
      <view class="source-pill">{{dataSourceText}}</view>
    </view>
    <view class="today-title">{{todayTitle}}</view>
    <view class="today-subtitle">{{className}}</view>
    <view class="today-count">{{courseCountText}}</view>
    <view class="today-version" wx:if="{{dataVersionText}}">{{dataVersionText}}</view>
    <view class="disclaimer-line">{{brand.disclaimer}}</view>
  </view>

  <notice-ticker notices="{{appConfig.notices}}" page-key="today" max-count="1" />

  <view class="today-alert urgent" wx:if="{{urgentNotice}}">
    <view class="alert-title">{{urgentNotice.title}}</view>
    <view class="alert-content">{{urgentNotice.content}}</view>
  </view>

  <view class="campus-service card">
    <view class="campus-service-title">校园服务</view>
    <view class="campus-service-grid">
      <view class="campus-service-btn" bindtap="goEmptyRoom">
        <view class="service-icon">⌕</view>
        <view class="service-copy">
          <view class="service-title">找空教室</view>
          <view class="service-desc">当前时间</view>
        </view>
      </view>
      <view class="campus-service-btn" bindtap="goCampusMap">
        <view class="service-icon">⌖</view>
        <view class="service-copy">
          <view class="service-title">校园地图</view>
          <view class="service-desc">{{nextBuildingCode ? nextBuildingCode : "校区地图"}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="quick-empty-card ai-today-card card" bindtap="goAiAssistant">
    <image class="quick-empty-icon" src="/assets/icons/ai-campus-butler.png" mode="aspectFit" />
    <view class="quick-empty-main">
      <view class="quick-empty-title">查询今日安排</view>
      <view class="quick-empty-desc">结合当前课表给出下一节课、空档和后续建议</view>
    </view>
    <view class="quick-empty-action">分析</view>
  </view>

  <view wx:if="{{courses.length}}" class="today-list">
    <course-card
      wx:for="{{courses}}"
      wx:key="id"
      course="{{item}}"
      layout="list"
      bind:tapcourse="onCourseTap"
    />
  </view>

  <empty-state
    wx:else
    title="{{emptyTitle || '今天没有课程，好好休息'}}"
    desc="{{emptyDesc || '这里会根据当前班级、教学周和星期自动筛选课程。'}}"
  />

  <course-detail-popup
    visible="{{detailVisible}}"
    course="{{selectedCourse}}"
    bind:close="closeCourseDetail"
    bind:copycustom="onCopyCourseToCustom"
    bind:editcourse="onEditExistingCourse"
    editable="{{selectedCourse.source !== 'custom' && selectedCourse.sourceType !== 'custom'}}"
  />
  <xiaofu-float />
</view>
