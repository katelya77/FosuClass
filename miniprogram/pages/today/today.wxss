.today-page {
  padding-top: 22rpx;
}

.today-hero {
  padding: 28rpx;
  border-color: #f0e4e4;
  background: linear-gradient(135deg, #fffafa 0%, #ffffff 48%, #f3f8ff 100%);
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.date-text {
  min-width: 0;
  color: #778297;
  font-size: 26rpx;
  font-weight: 600;
}

.source-pill {
  flex: 0 0 auto;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff1f1;
  color: #b4232a;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.today-title {
  margin-top: 16rpx;
  color: #172033;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.15;
}

.today-subtitle {
  margin-top: 12rpx;
  color: #536174;
  font-size: 27rpx;
  font-weight: 700;
}

.today-count {
  display: inline-flex;
  align-items: center;
  min-height: 46rpx;
  margin-top: 18rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #172033;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 800;
}

.today-version {
  margin-top: 12rpx;
  color: #66718a;
  font-size: 22rpx;
  font-weight: 700;
}

.today-alert {
  margin: 16rpx 0 4rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #dbe4ff;
  border-radius: 16rpx;
  background: #f3f6ff;
}

.today-alert.urgent {
  border-color: #ffd0dc;
  background: #fff4f7;
}

.alert-title {
  color: #172033;
  font-size: 25rpx;
  font-weight: 900;
}

.alert-content {
  margin-top: 8rpx;
  color: #536174;
  font-size: 23rpx;
  line-height: 1.5;
}

.quick-empty-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 18rpx 0 4rpx;
  padding: 22rpx 24rpx;
  border-color: #f0e4e4;
  background: #ffffff;
}

.campus-service {
  margin: 18rpx 0 4rpx;
  padding: 20rpx;
  border-color: #f0e4e4;
  background: #ffffff;
}

.campus-service-title {
  margin-bottom: 14rpx;
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
}

.campus-service-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.campus-service-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  min-height: 76rpx;
  padding: 14rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}

.campus-service-btn:active {
  background: #fff1f1;
}

.service-icon {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: #fff1f1;
  color: #c62828;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 40rpx;
  text-align: center;
}

.service-copy {
  min-width: 0;
}

.service-title {
  overflow: hidden;
  color: #172033;
  font-size: 24rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-desc {
  overflow: hidden;
  margin-top: 4rpx;
  color: #778297;
  font-size: 20rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-empty-main {
  flex: 1;
  min-width: 0;
}

.quick-empty-icon {
  flex: 0 0 auto;
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  background: #fff4f4;
}

.quick-empty-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.quick-empty-desc {
  margin-top: 6rpx;
  color: #778297;
  font-size: 23rpx;
}

.quick-empty-action {
  flex: 0 0 auto;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  background: #fff1f1;
  color: #c62828;
  font-size: 23rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-today-card {
  border-color: #ffd7d7;
  background: #fffafa;
}

.disclaimer-line {
  margin-top: 16rpx;
  color: #8a94a6;
  font-size: 22rpx;
  line-height: 1.45;
}

.today-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}
