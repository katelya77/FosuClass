<view class="page personal-sync-page">
  <block wx:if="{{activeImportMethod == 'method'}}">
    <view class="sync-hero">
      <view class="sync-title">个人课表同步</view>
      <view class="sync-desc">同步学校最新课程安排</view>
    </view>

    <view class="card student-form-card">
      <view class="form-group">
        <text class="form-label">学号</text>
        <input class="form-input" type="number" maxlength="20" placeholder="请输入学号" value="{{studentForm.studentId}}" bindinput="onStudentIdInput" adjust-position="{{true}}" cursor-spacing="120" />
      </view>
      <view class="form-group">
        <text class="form-label">学校账号密码</text>
        <view class="password-field">
          <input class="form-input password-input" password="{{!passwordVisible}}" placeholder="{{hasSavedPassword && !studentForm.password ? '已保存密码，无需重新输入' : '学校账号密码'}}" value="{{studentForm.password}}" bindinput="onStudentPasswordInput" adjust-position="{{true}}" cursor-spacing="120" />
          <view class="password-eye {{passwordVisible ? 'is-open' : ''}}" catchtap="togglePasswordVisible" aria-role="button" aria-label="{{passwordVisible ? '隐藏密码' : '显示密码'}}">
            <view class="eye-glyph">
              <view class="eye-shape"></view>
              <view class="eye-pupil" wx:if="{{passwordVisible}}"></view>
              <view class="eye-slash" wx:if="{{!passwordVisible}}"></view>
            </view>
          </view>
        </view>
      </view>
      <view class="saved-account" wx:if="{{hasSavedPassword}}">
        <text>已记住账号</text>
        <text class="saved-account-clear" bindtap="confirmClearSavedCredential">清除账号密码</text>
      </view>
      <checkbox-group wx:if="{{!hasSavedPassword || studentForm.password}}" bindchange="onStudentPrivacyChange">
        <label class="privacy-row">
          <checkbox value="confirmed" checked="{{studentForm.privacyConfirmed}}" color="#c62828" />
          <text>账号密码仅用于课表同步，并保存在本机用于快捷重新同步，可随时清除。</text>
        </label>
      </checkbox-group>
      <view class="sync-civility" wx:else>账号密码仅用于课表同步，并保存在本机用于快捷重新同步，可随时清除。不会作为课表数据长期保存到服务器，也不会写入运行日志。</view>
      <button class="btn-primary" loading="{{studentImportLoading}}" disabled="{{studentImportLoading || !studentImportEnabled}}" bindtap="validateAndPreviewStudentImport">同步最新课表</button>
      <view class="sync-civility">请勿恶意或高频重复同步。系统会限制异常频繁请求，仅在课表发生变化时重新同步即可。</view>
      <view class="campus-status campus-status-{{syncServiceStatus}}">
        <view class="campus-dot"></view>
        <view class="campus-copy">
          <text class="campus-title">{{syncServiceTitle}}</text>
          <text class="campus-hint">{{syncServiceHint}}</text>
        </view>
      </view>
      <button class="btn-text" wx:if="{{enableCampusAgentSync && campusLinkStatus == 'offline'}}" bindtap="tryRemoteSync">尝试远程同步</button>
    </view>

    <view class="recent-sync" wx:if="{{recentStudentImport}}">
      <view class="recent-sync-copy">
        <text class="recent-sync-title">最近同步</text>
        <text class="recent-sync-time">{{recentStudentImport.importedAtText}}</text>
      </view>
      <view class="recent-sync-actions">
        <button class="recent-import-btn" bindtap="useRecentStudentImport">直接使用</button>
        <button class="recent-import-btn" loading="{{studentImportLoading}}" disabled="{{studentImportLoading}}" bindtap="resyncStudentImport">重新同步</button>
        <button class="recent-import-btn" bindtap="openRecentStudentImportEditor">查看调整</button>
      </view>
    </view>

    <view class="other-imports">
      <view class="other-imports-title">其他导入方式</view>
      <view class="other-import-row" data-method="xls" bindtap="selectImportMethod">XLS 文件导入</view>
      <view class="other-import-row" data-method="class" bindtap="selectImportMethod">班级课表</view>
      <view class="other-import-row" data-method="custom" bindtap="selectImportMethod">手动添加课程</view>
    </view>
  </block>

  <block wx:elif="{{activeImportMethod == 'student'}}">
    <view class="card identity-card" wx:if="{{studentImportStage == 'identity-confirm'}}">
      <view class="identity-kicker">账号验证成功</view>
      <view class="identity-title">请确认这是你的课表</view>
      <view class="profile-row">
        <text class="profile-label">姓名</text>
        <text class="profile-value">{{identityNameMissing ? '未读取到' : identityStudentName}}</text>
      </view>
      <view class="profile-row" wx:if="{{identityClassName}}">
        <text class="profile-label">班级</text>
        <text class="profile-value">{{identityClassName}}</text>
      </view>
      <view class="profile-row">
        <text class="profile-label">学号</text>
        <text class="profile-value identity-id">{{identityStudentId}}</text>
      </view>
      <view class="identity-note" wx:if="{{identityNameMissing}}">学校页面暂未提供可识别的姓名，请确认学号无误后继续。</view>
      <view class="identity-note" wx:else>确认后将继续整理并展示本学期课表。</view>
      <button class="btn-primary" bindtap="confirmStudentIdentity">确认，是我的课表</button>
      <button class="btn-text" bindtap="reenterStudentIdentity">重新输入</button>
    </view>

    <view class="card sync-status-card" wx:if="{{studentImportStage == 'loading'}}">
      <view class="sync-status-title">{{studentImportStatusMessage || '正在读取个人课表'}}</view>
      <view class="sync-status-hint">通常只需几秒，请勿重复点击。</view>
      <view class="loading-progress-track">
        <view class="loading-progress-fill" style="{{studentLoadingProgressStyle}}"></view>
      </view>
      <view class="slow-note" wx:if="{{studentImportSlow}}">学校系统响应较慢，仍在尝试。</view>
    </view>

    <view class="student-preview-page" wx:if="{{studentImportStage == 'preview' && studentPreviewResult}}">
      <view class="student-success-panel">
        <view class="success-mark">✓</view>
        <view class="success-copy">
          <view class="success-title">课表读取完成</view>
          <view class="success-subtitle">确认后即可用作当前课表</view>
        </view>
      </view>

      <view class="student-profile-panel">
        <view class="profile-row" wx:if="{{studentProfileName}}">
          <text class="profile-label">姓名</text>
          <text class="profile-value">{{studentProfileName}}</text>
        </view>
        <view class="profile-row" wx:if="{{studentProfileClass}}">
          <text class="profile-label">班级</text>
          <text class="profile-value">{{studentProfileClass}}</text>
        </view>
        <view class="profile-row">
          <text class="profile-label">学号</text>
          <text class="profile-value identity-id">{{studentPreviewResult.displayStudentId || studentPreviewResult.profile.studentId || studentPreviewResult.maskedStudentId}}</text>
        </view>
      </view>
      <view class="student-class-warning" wx:if="{{studentClassConfidenceWarning}}">{{studentClassConfidenceWarning}}</view>

      <view class="student-metric-row">
        <view class="student-metric">
          <text class="metric-value">{{studentRecommendedCount}}</text>
          <text class="metric-label">推荐导入</text>
        </view>
        <view class="student-metric">
          <text class="metric-value">{{studentPendingCount}}</text>
          <text class="metric-label">待处理</text>
        </view>
        <view class="student-metric">
          <text class="metric-value">{{studentConflictCount}}</text>
          <text class="metric-label">时间重叠</text>
        </view>
      </view>

      <view class="student-soft-tip" wx:if="{{studentPreviewNotice}}">{{studentPreviewNotice}}</view>

      <view class="card remark-card" wx:if="{{pageRemarkView.visible}}">
        <view class="remark-title">课表备注</view>
        <view class="remark-caption">来自学校课表页面，仅供参考</view>
        <text class="remark-body {{pageRemarkView.expanded || !pageRemarkView.canToggle ? '' : 'is-clamped'}}">{{pageRemarkView.text}}</text>
        <button class="btn-text" wx:if="{{pageRemarkView.canToggle}}" bindtap="togglePageRemarks">{{pageRemarkView.expanded ? '收起' : '展开全部'}}</button>
      </view>

      <view class="preview-card student-preview-card">
        <view class="preview-card-head">
          <view>
            <view class="student-preview-title">推荐课表预览</view>
        <view class="student-preview-caption">{{studentPreviewMeta || '显示当前周课程，包含周六和周日。'}}</view>
          </view>
        </view>
        <view class="week-switcher week-switcher-row">
          <button class="week-btn" data-delta="-1" bindtap="onStudentPreviewWeekShift" disabled="{{studentPreviewWeek <= 1}}">‹</button>
          <text class="week-label">第{{studentPreviewWeek}}周</text>
          <button class="week-btn" data-delta="1" bindtap="onStudentPreviewWeekShift" disabled="{{studentPreviewWeek >= 19}}">›</button>
        </view>
        <view class="grid-shell">
          <schedule-preview-grid grid="{{studentPreviewGrid}}" section-height="66" day-column-width="96" day-count="7" bind:course="onStudentPreviewCourseTap" />
        </view>
      </view>

      <view class="student-advanced-panel" wx:if="{{studentAdvancedMode}}">
        <scroll-view class="student-tabs-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="student-tabs">
            <view wx:for="{{studentAdvancedTabs}}" wx:key="key" class="student-tab {{item.active ? 'active' : ''}}" data-key="{{item.key}}" bindtap="onStudentBucketTabTap">
              <text class="student-tab-label">{{item.title}}</text>
              <text class="student-tab-count">{{item.countText}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="advanced-help">{{studentActiveBucketHelp}}</view>
        <view class="bulk-selection-bar">
          <view class="selection-copy">
            <text class="selection-title">多选操作</text>
            <text class="selection-subtitle">当前已选 {{studentSelectedCount}} 项，可按分组快速筛选。</text>
          </view>
          <view class="bulk-action-list">
            <button class="bulk-action-btn bulk-action-primary" bindtap="selectAllStudentActiveBucket">全选本栏</button>
            <button class="bulk-action-btn" bindtap="clearStudentActiveBucketSelection">清空本栏</button>
            <button class="bulk-action-btn" bindtap="resetStudentRecommendedSelection">只选推荐</button>
          </view>
        </view>
        <view class="advanced-empty" wx:if="{{!studentActiveBucketGroups.length}}">这里没有需要处理的课程。</view>
        <view class="student-group-card" wx:for="{{studentActiveBucketGroups}}" wx:key="viewKey" wx:for-item="group">
          <view class="student-group-head" data-key="{{group.viewKey}}" data-bucket="{{group.bucketKey}}" bindtap="toggleStudentGroup">
            <view class="student-group-main">
              <view class="student-group-title">{{group.displayCourseName || group.courseName}}</view>
              <view class="student-group-meta">{{group.countText}}</view>
            </view>
            <text class="group-arrow">{{group.expanded ? '收起' : '展开'}}</text>
          </view>
          <view class="student-group-body" wx:if="{{group.expanded}}">
            <view class="arrangement-row" wx:for="{{group.arrangements}}" wx:key="arrangementId" wx:for-item="arrangement">
              <view wx:if="{{!arrangement.needsTimeCompletion}}" class="selection-dot {{arrangement.selected ? 'selected' : ''}}" data-id="{{arrangement.arrangementId}}" bindtap="toggleStudentArrangement">{{arrangement.selected ? '✓' : ''}}</view>
              <view wx:else class="selection-dot disabled"></view>
              <view class="arrangement-main">
                <view class="arrangement-line">
                  <text class="arrangement-time">{{arrangement.timeText}}</text>
                  <text class="arrangement-status {{arrangement.statusClass}}">{{arrangement.statusText}}</text>
                </view>
                <view class="arrangement-meta">{{arrangement.metaText}}</view>
                <view class="arrangement-scope-reason {{arrangement.classScopeClass}}" wx:if="{{arrangement.classScopeReasonText}}">{{arrangement.classScopeReasonText}}</view>
                <view
                  class="arrangement-class-line {{arrangement.classNameExpanded ? 'expanded' : ''}}"
                  wx:if="{{arrangement.classNamePreviewText}}"
                  data-id="{{arrangement.arrangementId}}"
                  bindtap="toggleStudentClassNameRaw"
                >班级：{{arrangement.classNamePreviewText}}</view>
                <view
                  class="arrangement-class-more"
                  wx:if="{{arrangement.classNameTruncated}}"
                  data-id="{{arrangement.arrangementId}}"
                  bindtap="toggleStudentClassNameRaw"
                >{{arrangement.classNameExpanded ? '收起班级' : '查看完整班级'}}</view>
                <view class="arrangement-conflict-tip" wx:if="{{arrangement.conflictText}}">{{arrangement.conflictText}}</view>
              </view>
              <view class="arrangement-tools">
                <switch class="arrangement-switch" wx:if="{{!arrangement.needsTimeCompletion}}" color="#2f855a" checked="{{arrangement.selected}}" data-id="{{arrangement.arrangementId}}" bindchange="toggleStudentArrangementSwitch" />
                <button class="edit-arrangement-btn" wx:if="{{arrangement.needsTimeCompletion}}" data-id="{{arrangement.arrangementId}}" bindtap="startEditStudentArrangement">补充时间</button>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="preview-actions student-bottom-actions">
        <view class="student-apply-status" wx:if="{{studentImportConfirming}}">正在应用课表…</view>
        <button class="btn-bind" loading="{{studentImportConfirming}}" disabled="{{studentImportConfirming || !studentSelectedCount}}" bindtap="confirmStudentImport">确认并设为当前课表</button>
        <button class="btn-cancel" disabled="{{studentImportConfirming}}" bindtap="toggleStudentAdvancedMode">{{studentAdvancedMode ? '完成调整' : '调整导入内容'}}</button>
      </view>

      <view class="edit-panel-mask" wx:if="{{studentEditingArrangement}}">
        <view class="edit-panel">
          <view class="edit-panel-title">补充课程安排</view>
          <view class="edit-course-name">{{studentEditingArrangement.displayCourseName || studentEditingArrangement.courseName}}</view>
          <view class="edit-grid">
            <view class="edit-field">
              <text class="form-label">星期</text>
              <picker mode="selector" range="{{editWeekdayLabels}}" value="{{editWeekdayIndex}}" bindchange="onEditWeekdayChange">
                <view class="picker-selector compact-picker">{{editWeekdayLabels[editWeekdayIndex]}}</view>
              </picker>
            </view>
            <view class="edit-field">
              <text class="form-label">开始节次</text>
              <picker mode="selector" range="{{editSectionLabels}}" value="{{editStartIndex}}" bindchange="onEditStartSectionChange">
                <view class="picker-selector compact-picker">{{editSectionLabels[editStartIndex]}}</view>
              </picker>
            </view>
            <view class="edit-field">
              <text class="form-label">结束节次</text>
              <picker mode="selector" range="{{editSectionLabels}}" value="{{editEndIndex}}" bindchange="onEditEndSectionChange">
                <view class="picker-selector compact-picker">{{editSectionLabels[editEndIndex]}}</view>
              </picker>
            </view>
          </view>
          <view class="form-group">
            <text class="form-label">周次</text>
            <input class="form-input" placeholder="例如 1-16周" value="{{editWeekText}}" bindinput="onEditWeekTextInput" />
          </view>
          <view class="form-group">
            <text class="form-label">地点</text>
            <input class="form-input" placeholder="未注明可留空" value="{{editRoomName}}" bindinput="onEditRoomInput" />
          </view>
          <view class="edit-actions">
            <button class="btn-secondary" bindtap="cancelStudentArrangementEdit">取消</button>
            <button class="btn-bind" bindtap="saveStudentArrangementEdit">保存并加入课表</button>
          </view>
        </view>
      </view>
    </view>

    <view class="card result-card" wx:if="{{studentImportStage == 'done'}}">
      <view class="preview-header">
        <icon type="success" size="30" color="#2e7d32" />
        <view class="preview-title-box">
          <view class="preview-title">导入成功</view>
          <view class="preview-subtitle">已同步到个人课表</view>
        </view>
      </view>
      <button class="btn-bind" bindtap="viewImportedSchedule">查看我的课表</button>
    </view>
  </block>

  <block wx:elif="{{activeImportMethod == 'xls'}}">
    <view class="sync-hero" wx:if="{{!syncSuccess}}">
      <view class="sync-title">XLS 导入个人课表</view>
      <view class="sync-desc">仅解析课程名、教师、教室、星期、节次和教学周。无需输入学号或密码。</view>
    </view>

    <view class="card guide-card" wx:if="{{!syncSuccess}}">
      <view class="section-title">导入步骤</view>
      <view class="step-row"><text class="step-num">1</text><text class="step-text">在 100 网打开“我的课表 - 学期理论课表”。</text></view>
      <view class="step-row"><text class="step-num">2</text><text class="step-text">选择新学期后点击打印，下载 xls/xlsx 文件；HTML 表格也可导入。</text></view>
      <view class="step-row"><text class="step-num">3</text><text class="step-text">把文件转存到微信文件传输助手，再从小程序选择导入。</text></view>
      <view class="safe-note">导入结果只保存在本机缓存；课表摘要默认关闭，可在小序页面单独开启。</view>
    </view>

    <view class="card upload-card" wx:if="{{!syncSuccess}}">
      <view class="form-group">
        <text class="form-label">目标学期</text>
        <picker mode="selector" range="{{semesterOptionLabels}}" value="{{semesterIndex}}" disabled="{{!semesterPickerEnabled}}" bindchange="onSemesterChange">
          <view class="picker-selector">
            <text>{{semesterOptionLabels[semesterIndex] || semesterOptions[semesterIndex]}}</text>
            <text class="picker-arrow" wx:if="{{semesterPickerEnabled}}">⌄</text>
          </view>
        </picker>
        <view class="term-status-text" wx:if="{{selectedTermStatusText}}">{{selectedTermStatusText}}</view>
      </view>

      <view class="selected-file-box" wx:if="{{selectedFile}}">
        <view class="file-mark">XLS</view>
        <view class="file-details">
          <view class="file-name">{{selectedFile.name}}</view>
          <view class="file-meta">{{selectedFile.sizeStr}}</view>
        </view>
        <button class="file-remove" bindtap="clearSelectedFile">移除</button>
      </view>

      <button class="btn-primary" loading="{{loadingXls}}" disabled="{{loadingXls}}" bindtap="onXlsBtnTap">
        {{selectedFile ? '确认解析课表' : '选择 xls / xlsx / html 文件'}}
      </button>
      <button class="btn-secondary" wx:if="{{selectedFile}}" bindtap="clearSelectedFile">重新选择</button>
      <button class="btn-secondary" wx:else bindtap="backToImportMethods">返回导入方式</button>
    </view>

    <view class="card result-card" wx:if="{{syncSuccess}}">
      <view class="preview-header">
        <icon type="success" size="30" color="#2e7d32" />
        <view class="preview-title-box">
          <view class="preview-title">表格解析成功</view>
          <view class="preview-subtitle">{{syncResult.displayInfo.subtitle || syncResult.filename}}</view>
        </view>
      </view>

      <view class="preview-stats">
        <view class="stat-item">
          <text class="stat-label">识别学期</text>
          <text class="stat-value">{{syncResult.term}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">课程总数</text>
          <text class="stat-value">{{syncResult.courseCount}} 门</text>
        </view>
      </view>

      <view class="metadata-card" wx:if="{{syncResult.metadata}}">
        <view class="metadata-title">{{syncResult.displayInfo.title || '个人课表'}}</view>
        <view class="metadata-row" wx:if="{{syncResult.metadata.className}}">班级：{{syncResult.metadata.className}}</view>
        <view class="metadata-row" wx:if="{{syncResult.metadata.studentName}}">学生：{{syncResult.metadata.studentName}}</view>
        <view class="metadata-row" wx:if="{{syncResult.metadata.collegeName}}">学院：{{syncResult.metadata.collegeName}}</view>
        <view class="metadata-row" wx:if="{{syncResult.metadata.printDate}}">打印日期：{{syncResult.metadata.printDate}}</view>
        <view class="metadata-row">来源：{{syncResult.displayInfo.sourceText || '100网 XLS 手动导入'}}</view>
      </view>

      <view class="preview-filter-bar">
        <input class="preview-search" placeholder="搜索课程、教师或教室" value="{{previewSearchKey}}" bindinput="onPreviewSearch" />
        <scroll-view class="weekday-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="weekday-bar">
            <button wx:for="{{weekdayTabs}}" wx:key="label" class="weekday-tab {{previewDayFilter == item.value ? 'active' : ''}}" data-day="{{item.value}}" bindtap="onPreviewDayFilterTap">{{item.label}}</button>
          </view>
        </scroll-view>
      </view>

      <scroll-view class="preview-course-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="empty-preview" wx:if="{{!filteredCourses.length}}">没有找到匹配的课程记录</view>
        <view class="preview-course-card" wx:for="{{filteredCourses}}" wx:key="previewKey">
          <view class="course-card-head">
            <text class="course-card-title">{{item.courseName}}</text>
            <text class="course-card-badge">{{item.displayTime}}</text>
          </view>
          <view class="course-card-row">
            <text class="row-label">教师</text>
            <text class="row-value">{{item.teacherName || '未标明'}}</text>
          </view>
          <view class="course-card-row">
            <text class="row-label">教室</text>
            <text class="row-value">{{item.classroom || item.roomName || '未安排'}}</text>
          </view>
          <view class="course-card-row">
            <text class="row-label">周次</text>
            <text class="row-value">{{item.displayWeekText || '周次待确认'}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="preview-actions">
        <button class="btn-bind" bindtap="bindToLocal">确认导入并设为当前课表</button>
        <button class="btn-cancel" bindtap="cancelImport">放弃并重新选择</button>
      </view>
    </view>
  </block>
  <view class="sync-ad-slot {{syncAdVisible ? '' : 'is-empty'}}" wx:if="{{syncAdUnitId}}">
    <ad unit-id="{{syncAdUnitId}}" binderror="onSyncAdError" bindload="onSyncAdLoad"></ad>
  </view>
  <xiaofu-float />
</view>
