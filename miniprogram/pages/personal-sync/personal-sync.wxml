<view class="page personal-sync-page">
  <block wx:if="{{activeImportMethod == 'method'}}">
    <view class="sync-hero">
      <view class="sync-title">个人课表同步</view>
      <view class="sync-desc">选择一种适合你的方式同步本人课程安排。</view>
    </view>

    <view class="method-card primary-method" data-method="student" bindtap="selectImportMethod">
      <view class="method-main">
        <view class="method-title-row">
          <view class="method-title">学号导入个人课表</view>
          <view class="method-badges">
            <text class="method-badge recommend">推荐</text>
            <text class="method-badge">个人课表</text>
            <text class="method-badge">不保存密码</text>
          </view>
        </view>
        <view class="method-desc">登录学校账号读取本人课表数据。</view>
        <view class="method-safe">本人授权 · 本次登录读取 · 导入后清除临时状态</view>
      </view>
      <button class="method-action" data-method="student" bindtap="selectImportMethod" disabled="{{!studentImportEnabled}}">{{studentImportEnabled ? '开始导入' : '暂未开放'}}</button>
    </view>

    <view class="method-card" data-method="xls" bindtap="selectImportMethod">
      <view class="method-main">
        <view class="method-title">导入 XLS</view>
        <view class="method-desc">上传学校导出的课表文件。</view>
      </view>
      <button class="method-action light" data-method="xls" bindtap="selectImportMethod">选择文件</button>
    </view>

    <view class="method-card" data-method="class" bindtap="selectImportMethod">
      <view class="method-main">
        <view class="method-title">选择班级课表</view>
        <view class="method-desc">从已收录班级课表中选择。</view>
      </view>
      <button class="method-action light" data-method="class" bindtap="selectImportMethod">去选择</button>
    </view>

    <view class="method-card" data-method="custom" bindtap="selectImportMethod">
      <view class="method-main">
        <view class="method-title">手动编辑</view>
        <view class="method-desc">自行添加或调整课程。</view>
      </view>
      <button class="method-action light" data-method="custom" bindtap="selectImportMethod">去编辑</button>
    </view>
  </block>

  <block wx:elif="{{activeImportMethod == 'student'}}">
    <view class="sync-hero" wx:if="{{studentImportStage == 'form'}}">
      <view class="sync-title">学号导入个人课表</view>
      <view class="sync-desc">仅用于本次登录学校课表系统并读取本人课表数据。</view>
    </view>

    <view class="card student-form-card" wx:if="{{studentImportStage == 'form'}}">
      <view class="form-group">
        <text class="form-label">学号</text>
        <input class="form-input" type="number" maxlength="20" placeholder="请输入本人学号" value="{{studentForm.studentId}}" bindinput="onStudentIdInput" />
      </view>

      <view class="form-group">
        <text class="form-label">学校账号密码</text>
        <input class="form-input" password placeholder="仅用于本次读取，不会保存" value="{{studentForm.password}}" bindinput="onStudentPasswordInput" />
      </view>

      <view class="safe-note strong-note">密码仅用于本次登录学校课表系统并读取本人课表数据，系统不会保存密码，导入完成后会清除临时状态。</view>

      <checkbox-group bindchange="onStudentPrivacyChange">
        <label class="privacy-row">
          <checkbox value="confirmed" checked="{{studentForm.privacyConfirmed}}" color="#c62828" />
          <text>我确认导入的是本人课表，并同意本次登录学校课表系统读取本人课表数据。系统不会保存密码，导入完成后将立即清除临时状态。</text>
        </label>
      </checkbox-group>

      <button class="btn-primary" loading="{{studentImportLoading}}" disabled="{{studentImportLoading || !studentImportEnabled}}" bindtap="validateAndPreviewStudentImport">验证并读取课表</button>
      <button class="btn-secondary" bindtap="backToImportMethods">返回导入方式</button>
    </view>

    <view class="card loading-card" wx:if="{{studentImportStage == 'loading'}}">
      <view class="preview-title">正在读取课表</view>
      <view class="loading-steps">
        <view wx:for="{{studentImportSteps}}" wx:key="*this" class="loading-step {{index < studentLoadingStepIndex ? 'done' : ''}} {{index == studentLoadingStepIndex ? 'active' : ''}}">
          <view class="step-dot">{{index + 1}}</view>
          <view class="step-copy">{{item}}</view>
        </view>
      </view>
      <view class="safe-note">若学校系统需要额外验证，系统会停止自动导入并提示改用其他方式。</view>
    </view>

    <view class="card result-card" wx:if="{{studentImportStage == 'preview' && studentPreviewResult}}">
      <view class="preview-header">
        <icon type="success" size="30" color="#2e7d32" />
        <view class="preview-title-box">
          <view class="preview-title">验证成功</view>
          <view class="preview-subtitle">请确认后再导入到个人课表</view>
        </view>
      </view>

      <view class="metadata-card">
        <view class="metadata-title">{{studentPreviewResult.displayInfo.title}}</view>
        <view class="metadata-row">姓名：{{studentPreviewResult.profile.studentName || '未识别'}}</view>
        <view class="metadata-row">学号：{{studentPreviewResult.maskedStudentId}}</view>
        <view class="metadata-row">班级：{{studentPreviewResult.profile.className || '班级未能自动确认'}}</view>
        <view class="metadata-row">数据来源：学校课表系统</view>
      </view>

      <view class="preview-stats student-stats-grid">
        <view class="stat-item">
          <text class="stat-label">原始记录</text>
          <text class="stat-value">{{studentPreviewResult.summary.rawRowCount || 0}} 条</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">推荐导入</text>
          <text class="stat-value">{{studentPreviewResult.summary.arrangementAutoIncludeCount || studentPreviewResult.summary.scheduledCourseCount || 0}} 个</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">待确认</text>
          <text class="stat-value">{{studentPreviewResult.summary.needsConfirmCount || 0}} 个</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">疑似非本班</text>
          <text class="stat-value">{{studentPreviewResult.summary.suspectedNotMineCount || 0}} 个</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">冲突</text>
          <text class="stat-value">{{studentPreviewResult.summary.conflictCount || 0}} 个</text>
        </view>
      </view>

      <view class="safe-note warning-note" wx:if="{{studentPreviewResult.summary.needsConfirmCount || studentPreviewResult.summary.unscheduledCount || studentPreviewResult.summary.conflictCount}}">
        部分课程需要确认，导入后也可以继续编辑。冲突课程已在预览中标记。
      </view>

      <view class="student-grid-section">
        <view class="student-section-head">
          <view>
            <view class="student-preview-title">推荐导入课表预览</view>
            <view class="student-preview-caption">只显示当前周有效课程，可左右切换周次。</view>
          </view>
          <view class="week-switcher">
            <button class="week-btn" data-delta="-1" bindtap="onStudentPreviewWeekShift" disabled="{{studentPreviewWeek <= 1}}">‹</button>
            <text class="week-label">第{{studentPreviewWeek}}周</text>
            <button class="week-btn" data-delta="1" bindtap="onStudentPreviewWeekShift" disabled="{{studentPreviewWeek >= 19}}">›</button>
          </view>
        </view>
        <schedule-preview-grid grid="{{studentPreviewGrid}}" bind:course="onStudentPreviewCourseTap" />
      </view>

      <view class="selection-bar">
        <view class="selection-copy">
          <text class="selection-title">{{studentSelectionMode ? '自定义选择中' : '已按推荐勾选'}}</text>
          <text class="selection-subtitle">当前选择 {{studentSelectedCount}} 项</text>
        </view>
        <button class="selection-toggle" bindtap="toggleStudentSelectionMode">{{studentSelectionMode ? '完成' : '自定义选择'}}</button>
      </view>

      <view class="student-preview-buckets">
        <block wx:for="{{studentPreviewBuckets}}" wx:key="key">
          <view class="student-bucket" wx:if="{{item.arrangementCount}}">
            <view class="student-bucket-head" data-section="{{item.key}}" bindtap="toggleStudentSection">
              <view class="bucket-title-box">
                <text class="student-preview-title">{{item.title}}</text>
                <text class="bucket-summary">{{item.summaryText}}</text>
              </view>
              <text class="bucket-arrow">{{item.expanded ? '收起' : '展开'}}</text>
            </view>
            <view class="student-bucket-body" wx:if="{{item.expanded}}">
              <view class="preview-course-card compact" wx:for="{{item.groups}}" wx:key="courseGroupId" wx:for-item="group">
                <view class="course-card-head">
                  <text class="course-card-title">{{group.displayCourseName}}</text>
                  <text class="course-card-badge">{{group.countText}}</text>
                </view>
                <view class="arrangement-row" wx:for="{{group.arrangements}}" wx:key="arrangementId" wx:for-item="arrangement">
                  <view class="arrangement-main">
                    <view class="arrangement-line">
                      <text class="selection-dot {{arrangement.selected ? 'selected' : ''}}" wx:if="{{studentSelectionMode}}" data-id="{{arrangement.arrangementId}}" bindtap="toggleStudentArrangement">{{arrangement.selected ? '✓' : ''}}</text>
                      <text class="arrangement-time">{{arrangement.timeText}}</text>
                      <text class="arrangement-status {{arrangement.statusClass}}">{{arrangement.statusText}}</text>
                    </view>
                    <view class="arrangement-meta">{{arrangement.roomText}} · {{arrangement.weekText || '周次待确认'}}</view>
                    <view class="arrangement-reason">{{arrangement.reasonText}}</view>
                  </view>
                  <button class="edit-arrangement-btn" wx:if="{{studentSelectionMode && arrangement.canEdit}}" data-id="{{arrangement.arrangementId}}" bindtap="startEditStudentArrangement">编辑后加入</button>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>

      <view class="preview-actions student-bottom-actions">
        <button class="btn-bind" loading="{{studentImportConfirming}}" disabled="{{studentImportConfirming || !studentSelectedCount}}" bindtap="confirmStudentImport">{{studentPreviewResult.uiHints.defaultConfirmText || '确认导入推荐课程'}}</button>
        <button class="btn-cancel" disabled="{{studentImportConfirming}}" bindtap="cancelStudentImport">取消</button>
      </view>

      <view class="edit-panel-mask" wx:if="{{studentEditingArrangement}}">
        <view class="edit-panel">
          <view class="edit-panel-title">编辑后加入</view>
          <view class="edit-course-name">{{studentEditingArrangement.displayCourseName || studentEditingArrangement.courseName}}</view>
          <view class="edit-grid">
            <view class="edit-field">
              <text class="form-label">星期</text>
              <picker mode="selector" range="{{editWeekdayLabels}}" value="{{editWeekdayIndex}}" bindchange="onEditWeekdayChange">
                <view class="picker-selector compact-picker">{{editWeekdayLabels[editWeekdayIndex]}}</view>
              </picker>
            </view>
            <view class="edit-field">
              <text class="form-label">开始节次</text>
              <picker mode="selector" range="{{editSectionLabels}}" value="{{editStartIndex}}" bindchange="onEditStartSectionChange">
                <view class="picker-selector compact-picker">{{editSectionLabels[editStartIndex]}}</view>
              </picker>
            </view>
            <view class="edit-field">
              <text class="form-label">结束节次</text>
              <picker mode="selector" range="{{editSectionLabels}}" value="{{editEndIndex}}" bindchange="onEditEndSectionChange">
                <view class="picker-selector compact-picker">{{editSectionLabels[editEndIndex]}}</view>
              </picker>
            </view>
          </view>
          <view class="form-group">
            <text class="form-label">周次</text>
            <input class="form-input" placeholder="例如 1-16周" value="{{editWeekText}}" bindinput="onEditWeekTextInput" />
          </view>
          <view class="form-group">
            <text class="form-label">地点</text>
            <input class="form-input" placeholder="未注明可留空" value="{{editRoomName}}" bindinput="onEditRoomInput" />
          </view>
          <view class="edit-actions">
            <button class="btn-secondary" bindtap="cancelStudentArrangementEdit">取消</button>
            <button class="btn-bind" bindtap="saveStudentArrangementEdit">保存并加入</button>
          </view>
        </view>
      </view>
    </view>

    <view class="card result-card" wx:if="{{studentImportStage == 'done'}}">
      <view class="preview-header">
        <icon type="success" size="30" color="#2e7d32" />
        <view class="preview-title-box">
          <view class="preview-title">导入成功</view>
          <view class="preview-subtitle">已同步到个人课表</view>
        </view>
      </view>
      <button class="btn-bind" bindtap="viewImportedSchedule">查看我的课表</button>
    </view>
  </block>

  <block wx:elif="{{activeImportMethod == 'xls'}}">
    <view class="sync-hero" wx:if="{{!syncSuccess}}">
      <view class="sync-title">XLS 导入个人课表</view>
      <view class="sync-desc">仅解析课程名、教师、教室、星期、节次和教学周。无需输入学号或密码。</view>
    </view>

    <view class="card guide-card" wx:if="{{!syncSuccess}}">
      <view class="section-title">导入步骤</view>
      <view class="step-row"><text class="step-num">1</text><text class="step-text">在 100 网打开“我的课表 - 学期理论课表”。</text></view>
      <view class="step-row"><text class="step-num">2</text><text class="step-text">选择新学期后点击打印，下载 xls/xlsx 文件。</text></view>
      <view class="step-row"><text class="step-num">3</text><text class="step-text">把文件发送到微信文件传输助手，再从小程序选择导入。</text></view>
      <view class="safe-note">导入结果只保存在本机缓存；AI 摘要默认关闭，可在小佛页面单独开启。</view>
    </view>

    <view class="card upload-card" wx:if="{{!syncSuccess}}">
      <view class="form-group">
        <text class="form-label">目标学期</text>
        <picker mode="selector" range="{{semesterOptionLabels}}" value="{{semesterIndex}}" disabled="{{!semesterPickerEnabled}}" bindchange="onSemesterChange">
          <view class="picker-selector">
            <text>{{semesterOptionLabels[semesterIndex] || semesterOptions[semesterIndex]}}</text>
            <text class="picker-arrow" wx:if="{{semesterPickerEnabled}}">⌄</text>
          </view>
        </picker>
        <view class="term-status-text" wx:if="{{selectedTermStatusText}}">{{selectedTermStatusText}}</view>
      </view>

      <view class="selected-file-box" wx:if="{{selectedFile}}">
        <view class="file-mark">XLS</view>
        <view class="file-details">
          <view class="file-name">{{selectedFile.name}}</view>
          <view class="file-meta">{{selectedFile.sizeStr}}</view>
        </view>
        <button class="file-remove" bindtap="clearSelectedFile">移除</button>
      </view>

      <button class="btn-primary" loading="{{loadingXls}}" disabled="{{loadingXls}}" bindtap="onXlsBtnTap">
        {{selectedFile ? '确认解析课表' : '选择 xls / xlsx 文件'}}
      </button>
      <button class="btn-secondary" wx:if="{{selectedFile}}" bindtap="clearSelectedFile">重新选择</button>
      <button class="btn-secondary" wx:else bindtap="backToImportMethods">返回导入方式</button>
    </view>

    <view class="card result-card" wx:if="{{syncSuccess}}">
      <view class="preview-header">
        <icon type="success" size="30" color="#2e7d32" />
        <view class="preview-title-box">
          <view class="preview-title">表格解析成功</view>
          <view class="preview-subtitle">{{syncResult.displayInfo.subtitle || syncResult.filename}}</view>
        </view>
      </view>

      <view class="preview-stats">
        <view class="stat-item">
          <text class="stat-label">识别学期</text>
          <text class="stat-value">{{syncResult.term}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">课程总数</text>
          <text class="stat-value">{{syncResult.courseCount}} 门</text>
        </view>
      </view>

      <view class="metadata-card" wx:if="{{syncResult.metadata}}">
        <view class="metadata-title">{{syncResult.displayInfo.title || '个人课表'}}</view>
        <view class="metadata-row" wx:if="{{syncResult.metadata.className}}">班级：{{syncResult.metadata.className}}</view>
        <view class="metadata-row" wx:if="{{syncResult.metadata.studentName}}">学生：{{syncResult.metadata.studentName}}</view>
        <view class="metadata-row" wx:if="{{syncResult.metadata.collegeName}}">学院：{{syncResult.metadata.collegeName}}</view>
        <view class="metadata-row" wx:if="{{syncResult.metadata.printDate}}">打印日期：{{syncResult.metadata.printDate}}</view>
        <view class="metadata-row">来源：100网 XLS 手动导入</view>
      </view>

      <view class="preview-filter-bar">
        <input class="preview-search" placeholder="搜索课程、教师或教室" value="{{previewSearchKey}}" bindinput="onPreviewSearch" />
        <scroll-view class="weekday-scroll" scroll-x enhanced show-scrollbar="{{false}}">
          <view class="weekday-bar">
            <button wx:for="{{weekdayTabs}}" wx:key="label" class="weekday-tab {{previewDayFilter == item.value ? 'active' : ''}}" data-day="{{item.value}}" bindtap="onPreviewDayFilterTap">{{item.label}}</button>
          </view>
        </scroll-view>
      </view>

      <scroll-view class="preview-course-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="empty-preview" wx:if="{{!filteredCourses.length}}">没有找到匹配的课程记录</view>
        <view class="preview-course-card" wx:for="{{filteredCourses}}" wx:key="previewKey">
          <view class="course-card-head">
            <text class="course-card-title">{{item.courseName}}</text>
            <text class="course-card-badge">{{item.displayTime}}</text>
          </view>
          <view class="course-card-row">
            <text class="row-label">教师</text>
            <text class="row-value">{{item.teacherName || '未标明'}}</text>
          </view>
          <view class="course-card-row">
            <text class="row-label">教室</text>
            <text class="row-value">{{item.classroom || item.roomName || '未安排'}}</text>
          </view>
          <view class="course-card-row">
            <text class="row-label">周次</text>
            <text class="row-value">{{item.weekText || '未标明'}}</text>
          </view>
        </view>
      </scroll-view>

      <view class="preview-actions">
        <button class="btn-bind" bindtap="bindToLocal">确认导入并设为当前课表</button>
        <button class="btn-cancel" bindtap="cancelImport">放弃并重新选择</button>
      </view>
    </view>
  </block>
</view>
