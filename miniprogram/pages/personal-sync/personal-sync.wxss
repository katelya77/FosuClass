.personal-sync-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #f5f7fb;
}

.sync-hero {
  padding: 6rpx 4rpx 20rpx;
}

.sync-title {
  overflow: hidden;
  color: #142033;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card {
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e5ebf3;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(18, 27, 43, 0.05);
}

.section-title {
  color: #142033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.step-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  min-width: 0;
}

.step-num {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #fff0f0;
  color: #c62828;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-align: center;
}

.step-text {
  flex: 1;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.48;
}

.safe-note {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #f7f4ef;
  color: #6b5a45;
  font-size: 22rpx;
  line-height: 1.45;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  color: #596579;
  font-size: 23rpx;
  font-weight: 800;
}

.picker-selector {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 78rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #142033;
  font-size: 25rpx;
  font-weight: 800;
}

.term-status-text {
  margin-top: 10rpx;
  color: #778297;
  font-size: 24rpx;
  line-height: 1.4;
}

.picker-arrow {
  color: #98a2b3;
  font-size: 24rpx;
}

.selected-file-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  margin: 6rpx 0 20rpx;
  padding: 16rpx;
  border: 1rpx solid #e1e7ef;
  border-radius: 14rpx;
  background: #f8fafc;
}

.file-mark {
  flex: 0 0 auto;
  width: 64rpx;
  height: 48rpx;
  border-radius: 10rpx;
  background: #edf4ff;
  color: #2254a5;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.file-details {
  flex: 1;
  min-width: 0;
}

.file-name {
  overflow: hidden;
  color: #142033;
  font-size: 24rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-meta {
  margin-top: 4rpx;
  color: #778297;
  font-size: 20rpx;
}

.file-remove {
  flex: 0 0 auto;
  width: 76rpx;
  height: 44rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #eef2f6;
  color: #596579;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.btn-primary,
.btn-secondary,
.btn-bind,
.btn-cancel {
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.btn-primary {
  background: #c62828;
  color: #ffffff;
}

.btn-primary[disabled] {
  background: #cbd5e1 !important;
  color: #64748b !important;
}

.btn-secondary,
.btn-cancel {
  margin-top: 14rpx;
  border: 1rpx solid #dbe3ee;
  background: #ffffff;
  color: #596579;
}

.preview-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.preview-title-box {
  flex: 1;
  min-width: 0;
}

.preview-title {
  overflow: hidden;
  color: #142033;
  font-size: 30rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-subtitle {
  overflow: hidden;
  margin-top: 5rpx;
  color: #667085;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.stat-item {
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  text-align: center;
}

.stat-label {
  display: block;
  color: #778297;
  font-size: 20rpx;
  font-weight: 800;
}

.stat-value {
  display: block;
  overflow: hidden;
  margin-top: 6rpx;
  color: #142033;
  font-size: 26rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metadata-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f7f4ef;
}

.metadata-title {
  overflow: hidden;
  color: #142033;
  font-size: 25rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metadata-row {
  overflow: hidden;
  margin-top: 7rpx;
  color: #667085;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-filter-bar {
  margin-top: 20rpx;
}

.preview-search {
  box-sizing: border-box;
  width: 100%;
  height: 72rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #142033;
  font-size: 24rpx;
}

.weekday-scroll {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.weekday-bar {
  display: inline-flex;
  gap: 10rpx;
  padding-bottom: 4rpx;
}

.weekday-tab {
  width: auto;
  min-width: 84rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #eef2f6;
  color: #596579;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.weekday-tab.active {
  background: #c62828;
  color: #ffffff;
}

.preview-course-list {
  box-sizing: border-box;
  max-height: 48vh;
  min-height: 300rpx;
  margin-top: 18rpx;
  padding: 12rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 14rpx;
  background: #f8fafc;
}

.empty-preview {
  padding: 80rpx 0;
  color: #98a2b3;
  font-size: 24rpx;
  text-align: center;
}

.preview-course-card {
  margin-bottom: 10rpx;
  padding: 16rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 12rpx;
  background: #ffffff;
}

.preview-course-card:last-child {
  margin-bottom: 0;
}

.course-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.course-card-title {
  flex: 1;
  overflow: hidden;
  color: #142033;
  font-size: 25rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-card-badge {
  flex: 0 0 auto;
  max-width: 190rpx;
  overflow: hidden;
  color: #c62828;
  font-size: 20rpx;
  font-weight: 900;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-card-row {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
  min-width: 0;
}

.row-label {
  flex: 0 0 56rpx;
  color: #98a2b3;
  font-size: 21rpx;
}

.row-value {
  flex: 1;
  overflow: hidden;
  color: #596579;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-actions {
  margin-top: 18rpx;
}

.btn-bind {
  background: #2f855a;
  color: #ffffff;
}

.method-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e5ebf3;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(18, 27, 43, 0.05);
}

.primary-method {
  border-color: #f1b8b8;
  background: linear-gradient(180deg, #ffffff 0%, #fff8f8 100%);
}

.method-main {
  flex: 1;
  min-width: 0;
}

.method-title-row {
  min-width: 0;
}

.method-title {
  overflow: hidden;
  color: #142033;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.28;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.method-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.method-safe {
  margin-top: 10rpx;
  color: #8a4b4b;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.4;
}

.method-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.method-badge {
  padding: 5rpx 10rpx;
  border-radius: 10rpx;
  background: #eef2f6;
  color: #596579;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.2;
}

.method-badge.recommend {
  background: #c62828;
  color: #ffffff;
}

.method-action {
  flex: 0 0 auto;
  width: 142rpx;
  height: 58rpx;
  padding: 0;
  border-radius: 12rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.method-action.light {
  border: 1rpx solid #dbe3ee;
  background: #ffffff;
  color: #596579;
}

.method-action[disabled] {
  background: #cbd5e1 !important;
  color: #64748b !important;
}

.form-input {
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #142033;
  font-size: 25rpx;
  font-weight: 800;
}

.strong-note {
  background: #fff8f0;
  color: #7a4d1f;
}

.warning-note {
  background: #fff7ed;
  color: #9a3412;
}

.privacy-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 20rpx 0;
  color: #596579;
  font-size: 22rpx;
  line-height: 1.5;
}

.privacy-row checkbox {
  flex: 0 0 auto;
  transform: scale(0.82);
  transform-origin: left top;
}

.loading-card {
  margin-top: 12rpx;
}

.loading-steps {
  margin-top: 24rpx;
}

.loading-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 56rpx;
  color: #98a2b3;
  font-size: 24rpx;
  font-weight: 800;
}

.step-dot {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #eef2f6;
  color: #778297;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 36rpx;
  text-align: center;
}

.loading-step.active {
  color: #142033;
}

.loading-step.active .step-dot {
  background: #c62828;
  color: #ffffff;
}

.loading-step.done {
  color: #2f855a;
}

.loading-step.done .step-dot {
  background: #dcfce7;
  color: #2f855a;
}

.step-copy {
  flex: 1;
  min-width: 0;
}

.three-cols {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.student-preview-list {
  margin-top: 20rpx;
}

.student-preview-title {
  margin-bottom: 12rpx;
  color: #142033;
  font-size: 24rpx;
  font-weight: 900;
}

.preview-course-card.compact {
  margin-bottom: 10rpx;
}

.muted-card {
  background: #fbfcfe;
}
