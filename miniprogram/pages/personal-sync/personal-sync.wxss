.personal-sync-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #f5f7fb;
}

.sync-hero {
  padding: 6rpx 4rpx 20rpx;
}

.sync-title {
  overflow: hidden;
  color: #142033;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sync-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card {
  box-sizing: border-box;
  margin-bottom: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e5ebf3;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(18, 27, 43, 0.05);
}

.section-title {
  color: #142033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.step-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  min-width: 0;
}

.step-num {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #fff0f0;
  color: #c62828;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-align: center;
}

.step-text {
  flex: 1;
  color: #4b5563;
  font-size: 24rpx;
  line-height: 1.48;
}

.safe-note {
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #f7f4ef;
  color: #6b5a45;
  font-size: 22rpx;
  line-height: 1.45;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  color: #596579;
  font-size: 23rpx;
  font-weight: 800;
}

.picker-selector {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 78rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #142033;
  font-size: 25rpx;
  font-weight: 800;
}

.term-status-text {
  margin-top: 10rpx;
  color: #778297;
  font-size: 24rpx;
  line-height: 1.4;
}

.picker-arrow {
  color: #98a2b3;
  font-size: 24rpx;
}

.selected-file-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  margin: 6rpx 0 20rpx;
  padding: 16rpx;
  border: 1rpx solid #e1e7ef;
  border-radius: 14rpx;
  background: #f8fafc;
}

.file-mark {
  flex: 0 0 auto;
  width: 64rpx;
  height: 48rpx;
  border-radius: 10rpx;
  background: #edf4ff;
  color: #2254a5;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.file-details {
  flex: 1;
  min-width: 0;
}

.file-name {
  overflow: hidden;
  color: #142033;
  font-size: 24rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-meta {
  margin-top: 4rpx;
  color: #778297;
  font-size: 20rpx;
}

.file-remove {
  flex: 0 0 auto;
  width: 76rpx;
  height: 44rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #eef2f6;
  color: #596579;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.btn-primary,
.btn-secondary,
.btn-bind,
.btn-cancel {
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.btn-primary {
  background: #c62828;
  color: #ffffff;
}

.btn-primary[disabled] {
  background: #cbd5e1 !important;
  color: #64748b !important;
}

.btn-secondary,
.btn-cancel {
  margin-top: 14rpx;
  border: 1rpx solid #dbe3ee;
  background: #ffffff;
  color: #596579;
}

.preview-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #edf0f5;
}

.preview-title-box {
  flex: 1;
  min-width: 0;
}

.preview-title {
  overflow: hidden;
  color: #142033;
  font-size: 30rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-subtitle {
  overflow: hidden;
  margin-top: 5rpx;
  color: #667085;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.stat-item {
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  text-align: center;
}

.stat-label {
  display: block;
  color: #778297;
  font-size: 20rpx;
  font-weight: 800;
}

.stat-value {
  display: block;
  overflow: hidden;
  margin-top: 6rpx;
  color: #142033;
  font-size: 26rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metadata-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f7f4ef;
}

.metadata-title {
  overflow: hidden;
  color: #142033;
  font-size: 25rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metadata-row {
  overflow: hidden;
  margin-top: 7rpx;
  color: #667085;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-filter-bar {
  margin-top: 20rpx;
}

.preview-search {
  box-sizing: border-box;
  width: 100%;
  height: 72rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #142033;
  font-size: 24rpx;
}

.weekday-scroll {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.weekday-bar {
  display: inline-flex;
  gap: 10rpx;
  padding-bottom: 4rpx;
}

.weekday-tab {
  width: auto;
  min-width: 84rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #eef2f6;
  color: #596579;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.weekday-tab.active {
  background: #c62828;
  color: #ffffff;
}

.preview-course-list {
  box-sizing: border-box;
  max-height: 48vh;
  min-height: 300rpx;
  margin-top: 18rpx;
  padding: 12rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 14rpx;
  background: #f8fafc;
}

.empty-preview {
  padding: 80rpx 0;
  color: #98a2b3;
  font-size: 24rpx;
  text-align: center;
}

.preview-course-card {
  margin-bottom: 10rpx;
  padding: 16rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 12rpx;
  background: #ffffff;
}

.preview-course-card:last-child {
  margin-bottom: 0;
}

.course-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.course-card-title {
  flex: 1;
  overflow: hidden;
  color: #142033;
  font-size: 25rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-card-badge {
  flex: 0 0 auto;
  max-width: 190rpx;
  overflow: hidden;
  color: #c62828;
  font-size: 20rpx;
  font-weight: 900;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-card-row {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
  min-width: 0;
}

.row-label {
  flex: 0 0 56rpx;
  color: #98a2b3;
  font-size: 21rpx;
}

.row-value {
  flex: 1;
  overflow: hidden;
  color: #596579;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-actions {
  margin-top: 18rpx;
}

.btn-bind {
  background: #2f855a;
  color: #ffffff;
}

.method-card {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #e5ebf3;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(18, 27, 43, 0.05);
}

.primary-method {
  border-color: #f1b8b8;
  background: linear-gradient(180deg, #ffffff 0%, #fff8f8 100%);
}

.method-main {
  flex: 1;
  min-width: 0;
}

.method-title-row {
  min-width: 0;
}

.method-title {
  overflow: hidden;
  color: #142033;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.28;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.method-desc {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.method-safe {
  margin-top: 10rpx;
  color: #8a4b4b;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.4;
}

.method-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.method-badge {
  padding: 5rpx 10rpx;
  border-radius: 10rpx;
  background: #eef2f6;
  color: #596579;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.2;
}

.method-badge.recommend {
  background: #c62828;
  color: #ffffff;
}

.method-action {
  flex: 0 0 auto;
  width: 142rpx;
  height: 58rpx;
  padding: 0;
  border-radius: 12rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.method-action.light {
  border: 1rpx solid #dbe3ee;
  background: #ffffff;
  color: #596579;
}

.method-action[disabled] {
  background: #cbd5e1 !important;
  color: #64748b !important;
}

.form-input {
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #142033;
  font-size: 25rpx;
  font-weight: 800;
}

.strong-note {
  background: #fff8f0;
  color: #7a4d1f;
}

.warning-note {
  background: #fff7ed;
  color: #9a3412;
}

.privacy-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 20rpx 0;
  color: #596579;
  font-size: 22rpx;
  line-height: 1.5;
}

.privacy-row checkbox {
  flex: 0 0 auto;
  transform: scale(0.82);
  transform-origin: left top;
}

.loading-card {
  margin-top: 12rpx;
}

.loading-steps {
  margin-top: 24rpx;
}

.loading-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 56rpx;
  color: #98a2b3;
  font-size: 24rpx;
  font-weight: 800;
}

.step-dot {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #eef2f6;
  color: #778297;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 36rpx;
  text-align: center;
}

.loading-step.active {
  color: #142033;
}

.loading-step.active .step-dot {
  background: #c62828;
  color: #ffffff;
}

.loading-step.done {
  color: #2f855a;
}

.loading-step.done .step-dot {
  background: #dcfce7;
  color: #2f855a;
}

.step-copy {
  flex: 1;
  min-width: 0;
}

.three-cols {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.student-preview-list {
  margin-top: 20rpx;
}

.student-preview-title {
  margin-bottom: 12rpx;
  color: #142033;
  font-size: 24rpx;
  font-weight: 900;
}

.preview-course-card.compact {
  margin-bottom: 10rpx;
}

.muted-card {
  background: #fbfcfe;
}

.student-stats-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.student-grid-section {
  margin-top: 22rpx;
}

.student-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
  margin-bottom: 12rpx;
}

.student-preview-caption {
  margin-top: 4rpx;
  color: #778297;
  font-size: 21rpx;
  line-height: 1.35;
}

.week-switcher {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #f1f5f9;
}

.week-btn {
  width: 48rpx;
  height: 44rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #ffffff;
  color: #142033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.week-btn[disabled] {
  color: #cbd5e1 !important;
}

.week-label {
  min-width: 92rpx;
  color: #142033;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
}

.selection-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 16rpx;
  border: 1rpx solid #e3e8f0;
  border-radius: 14rpx;
  background: #fbfcfe;
}

.selection-copy {
  flex: 1;
  min-width: 0;
}

.selection-title,
.selection-subtitle {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selection-title {
  color: #142033;
  font-size: 24rpx;
  font-weight: 900;
}

.selection-subtitle {
  margin-top: 4rpx;
  color: #778297;
  font-size: 21rpx;
}

.selection-toggle {
  flex: 0 0 auto;
  width: 150rpx;
  height: 54rpx;
  padding: 0;
  border-radius: 12rpx;
  background: #142033;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 54rpx;
}

.student-preview-buckets {
  margin-top: 18rpx;
  padding-bottom: 176rpx;
}

.student-bucket {
  overflow: hidden;
  margin-bottom: 12rpx;
  border: 1rpx solid #e5ebf3;
  border-radius: 14rpx;
  background: #ffffff;
}

.student-bucket-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx;
}

.bucket-title-box {
  flex: 1;
  min-width: 0;
}

.bucket-summary {
  display: block;
  margin-top: 4rpx;
  color: #778297;
  font-size: 20rpx;
  font-weight: 800;
}

.bucket-arrow {
  flex: 0 0 auto;
  color: #c62828;
  font-size: 21rpx;
  font-weight: 900;
}

.student-bucket-body {
  padding: 0 14rpx 14rpx;
}

.arrangement-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #edf1f6;
}

.arrangement-main {
  flex: 1;
  min-width: 0;
}

.arrangement-line {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.selection-dot {
  flex: 0 0 auto;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 50%;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 32rpx;
  text-align: center;
}

.selection-dot.selected {
  border-color: #2f855a;
  background: #2f855a;
}

.arrangement-time {
  flex: 1;
  overflow: hidden;
  color: #142033;
  font-size: 23rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrangement-status {
  flex: 0 0 auto;
  max-width: 150rpx;
  overflow: hidden;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-auto {
  background: #dcfce7;
  color: #166534;
}

.status-confirm {
  background: #fff7ed;
  color: #9a3412;
}

.status-suspect {
  background: #eef2f6;
  color: #475569;
}

.status-unscheduled {
  background: #fef3c7;
  color: #92400e;
}

.status-muted {
  background: #f1f5f9;
  color: #94a3b8;
}

.arrangement-meta,
.arrangement-reason {
  overflow: hidden;
  margin-top: 6rpx;
  color: #667085;
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrangement-reason {
  color: #8a94a6;
}

.edit-arrangement-btn {
  flex: 0 0 auto;
  width: 132rpx;
  height: 50rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 50rpx;
}

.student-bottom-actions {
  position: fixed;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 20;
  box-sizing: border-box;
  margin-top: 0;
  padding: 16rpx;
  border: 1rpx solid #e5ebf3;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 30rpx rgba(18, 27, 43, 0.11);
}

.edit-panel-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  padding: 24rpx;
  background: rgba(15, 23, 42, 0.34);
}

.edit-panel {
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx;
  border-radius: 18rpx 18rpx 0 0;
  background: #ffffff;
}

.edit-panel-title {
  color: #142033;
  font-size: 28rpx;
  font-weight: 900;
}

.edit-course-name {
  overflow: hidden;
  margin-top: 8rpx;
  color: #667085;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.compact-picker {
  height: 64rpx;
  padding: 0 12rpx;
  font-size: 22rpx;
  line-height: 64rpx;
}

.edit-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 12rpx;
  margin-top: 10rpx;
}

.edit-actions .btn-secondary,
.edit-actions .btn-bind {
  margin-top: 0;
}

.enhanced-loading {
  padding: 30rpx;
}

.loading-kicker {
  color: #c62828;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.2;
}

.loading-title {
  margin-top: 10rpx;
  color: #142033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.24;
}

.loading-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.42;
}

.loading-progress-track {
  overflow: hidden;
  height: 12rpx;
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #edf2f7;
}

.loading-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #c62828 0%, #2f855a 100%);
  transition: width 260ms ease;
}

.enhanced-loading .loading-steps {
  margin-top: 22rpx;
}

.enhanced-loading .loading-step {
  min-height: 64rpx;
}

.enhanced-loading .step-dot {
  position: relative;
  overflow: visible;
}

.step-pulse {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  left: -8rpx;
  border-radius: 50%;
  background: rgba(198, 40, 40, 0.16);
  animation: importPulse 1.2s ease-in-out infinite;
}

.step-dot text {
  position: relative;
  z-index: 1;
}

.slow-note {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.loading-skeleton {
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}

.skeleton-line,
.skeleton-cell {
  overflow: hidden;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #eef2f7 0%, #f8fafc 50%, #eef2f7 100%);
  background-size: 240% 100%;
  animation: skeletonMove 1.4s ease-in-out infinite;
}

.skeleton-line {
  width: 70%;
  height: 24rpx;
}

.skeleton-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.skeleton-cell {
  height: 70rpx;
}

.student-preview-page {
  box-sizing: border-box;
  padding-bottom: 188rpx;
  max-width: 100%;
}

.student-success-panel,
.student-profile-panel,
.preview-card,
.student-advanced-panel {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 18rpx;
  border: 1rpx solid #e5ebf3;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(18, 27, 43, 0.05);
}

.student-success-panel {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
}

.success-mark {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #dcfce7;
  color: #166534;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: center;
}

.success-copy {
  flex: 1;
  min-width: 0;
}

.success-title {
  color: #142033;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.24;
}

.success-subtitle {
  overflow: hidden;
  margin-top: 4rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-profile-panel {
  padding: 8rpx 22rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  min-width: 0;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf1f6;
}

.profile-row:last-child {
  border-bottom: 0;
}

.profile-label {
  flex: 0 0 96rpx;
  color: #778297;
  font-size: 22rpx;
  font-weight: 800;
}

.profile-value {
  flex: 1;
  overflow: hidden;
  color: #142033;
  font-size: 25rpx;
  font-weight: 900;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-metric-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.student-metric {
  min-width: 0;
  padding: 18rpx 10rpx;
  border: 1rpx solid #e5ebf3;
  border-radius: 14rpx;
  background: #ffffff;
  text-align: center;
}

.metric-value,
.metric-label {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-value {
  color: #142033;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.15;
}

.metric-label {
  margin-top: 6rpx;
  color: #667085;
  font-size: 20rpx;
  font-weight: 800;
}

.student-soft-tip {
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.student-preview-card {
  padding: 18rpx;
}

.preview-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.preview-card-head .student-preview-title {
  margin-bottom: 0;
  font-size: 27rpx;
}

.week-switcher-row {
  justify-content: center;
  margin-top: 14rpx;
}

.grid-shell {
  overflow: hidden;
  margin-top: 14rpx;
  border-radius: 14rpx;
}

.student-advanced-panel {
  padding: 18rpx;
}

.student-tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

.student-tabs {
  display: inline-flex;
  gap: 10rpx;
  padding-bottom: 4rpx;
}

.student-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-width: 120rpx;
  height: 54rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #eef2f6;
  color: #596579;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 54rpx;
}

.student-tab.active {
  background: #142033;
  color: #ffffff;
}

.student-tab-count {
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.74);
  color: #142033;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
}

.student-tab.active .student-tab-count {
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
}

.advanced-help {
  margin: 14rpx 0;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
}

.advanced-empty {
  padding: 44rpx 0;
  color: #98a2b3;
  font-size: 23rpx;
  text-align: center;
}

.student-group-card {
  overflow: hidden;
  margin-top: 12rpx;
  border: 1rpx solid #e5ebf3;
  border-radius: 14rpx;
  background: #ffffff;
}

.student-group-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx;
}

.student-group-main {
  flex: 1;
  min-width: 0;
}

.student-group-title {
  overflow: hidden;
  color: #142033;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.student-group-meta {
  margin-top: 4rpx;
  color: #778297;
  font-size: 20rpx;
  font-weight: 800;
}

.group-arrow {
  flex: 0 0 auto;
  color: #c62828;
  font-size: 21rpx;
  font-weight: 900;
}

.student-group-body {
  padding: 0 16rpx 16rpx;
}

.arrangement-tools {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.arrangement-switch {
  transform: scale(0.82);
  transform-origin: right center;
}

.student-bottom-actions {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
  gap: 12rpx;
  padding: 14rpx;
}

.student-bottom-actions .btn-bind,
.student-bottom-actions .btn-cancel {
  margin-top: 0;
  min-width: 0;
}

.student-bottom-actions .btn-cancel {
  background: #142033;
  color: #ffffff;
}

@keyframes importPulse {
  0% {
    transform: scale(0.8);
    opacity: 0.75;
  }
  70% {
    transform: scale(1.18);
    opacity: 0;
  }
  100% {
    transform: scale(1.18);
    opacity: 0;
  }
}

@keyframes skeletonMove {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: -100% 0;
  }
}
