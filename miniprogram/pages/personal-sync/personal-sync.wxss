/* 页面整体样式 */
.personal-sync-page {
  padding: 30rpx;
  background-color: #f6f8fa;
  min-height: 100vh;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
}

/* 卡片通用高端设计 (Glassmorphism & Card shadows) */
.card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(198, 40, 40, 0.04), 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
}

/* 头部引导卡片 */
.intro-card {
  background: linear-gradient(135deg, #fff3f3 0%, #ffffff 100%);
  border-left: 10rpx solid #c62828;
}

.intro-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #c62828;
}

.intro-icon {
  margin-right: 16rpx;
}

.intro-content {
  font-size: 26rpx;
  color: #5a6474;
  line-height: 1.6;
}

.intro-item {
  margin-bottom: 12rpx;
}

.intro-item:last-child {
  margin-bottom: 0;
}

.highlight {
  color: #c62828;
  font-weight: 600;
}

/* 表单卡片 */
.form-card {
  position: relative;
}

.form-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b303b;
  margin-bottom: 40rpx;
  border-left: 6rpx solid #c62828;
  padding-left: 16rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #7a8494;
  margin-bottom: 12rpx;
}

.form-input {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 16rpx;
  height: 90rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #2b303b;
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #c62828;
  background: #ffffff;
  box-shadow: 0 0 12rpx rgba(198, 40, 40, 0.15);
}

.input-placeholder {
  color: #a0aec0;
}

/* Picker 样式 */
.picker-selector {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 16rpx;
  height: 90rpx;
  padding: 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #2b303b;
  box-sizing: border-box;
}

.picker-arrow {
  font-size: 20rpx;
  color: #a0aec0;
}

/* 按钮设计 */
.btn-submit {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #d32f2f 0%, #b71c1c 100%);
  color: #ffffff;
  border-radius: 50rpx;
  height: 100rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 20rpx rgba(198, 40, 40, 0.2);
  border: none;
  transition: all 0.2s ease;
}

.btn-submit[disabled] {
  background: #e2e8f0 !important;
  color: #a0aec0 !important;
  box-shadow: none !important;
}

.btn-submit:active {
  transform: scale(0.98);
}

/* 结果卡片 */
.result-card {
  text-align: center;
}

.success-header {
  margin: 20rpx 0 40rpx;
}

.success-icon {
  margin-bottom: 24rpx;
}

.success-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2e7d32;
}

.result-details {
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 30rpx 40rpx;
  margin-bottom: 40rpx;
  text-align: left;
}

.result-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #edf2f7;
}

.result-row:last-child {
  border-bottom: none;
}

.result-label {
  color: #7a8494;
}

.result-value {
  color: #2b303b;
  font-weight: 600;
}

.btn-bind {
  background: linear-gradient(135deg, #2e7d32 0%, #1b5e20 100%);
  color: #ffffff;
  border-radius: 50rpx;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(46, 125, 50, 0.2);
  margin-bottom: 24rpx;
  border: none;
}

.btn-back {
  background: #ffffff;
  color: #5a6474;
  border: 2rpx solid #cbd5e0;
  border-radius: 50rpx;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 滑块验证弹窗样式 */
.captcha-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.captcha-modal.visible {
  opacity: 1;
  pointer-events: auto;
}

.captcha-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(8rpx);
}

.captcha-container-box {
  position: relative;
  width: 680rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  z-index: 10000;
  box-sizing: border-box;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.captcha-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin-bottom: 30rpx;
}

.captcha-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2b303b;
}

.captcha-close {
  font-size: 44rpx;
  color: #a0aec0;
  cursor: pointer;
  line-height: 40rpx;
  padding: 10rpx;
}

.captcha-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.captcha-tip-text {
  font-size: 26rpx;
  color: #7a8494;
  margin-bottom: 24rpx;
  text-align: center;
}

/* 验证码图片区 */
.captcha-image-area {
  position: relative;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  background-color: #e2e8f0;
}

.captcha-big-img {
  display: block;
}

.captcha-small-img {
  position: absolute;
  z-index: 10;
  box-shadow: 2rpx 0 10rpx rgba(0, 0, 0, 0.3);
}

/* 拖拽滑道 */
.slider-track-area {
  position: relative;
  width: 340px;
  height: 48px;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  border-radius: 50rpx;
  margin-top: 30rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.slider-track-bg {
  font-size: 24rpx;
  color: #94a3b8;
  z-index: 1;
}

.slider-track-progress {
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  background: rgba(198, 40, 40, 0.1);
  border-radius: 50rpx 0 0 50rpx;
}

.slider-handle {
  position: absolute;
  top: 1px;
  width: 46px;
  height: 46px;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
  cursor: grab;
}

.slider-handle:active {
  cursor: grabbing;
  background: #c62828;
}

.slider-handle:active .slider-icon {
  color: #ffffff;
}

.slider-icon {
  font-size: 28rpx;
  color: #64748b;
  font-weight: bold;
}

/* 验证状态展示区 */
.verify-status-msg {
  margin-top: 30rpx;
  height: 40rpx;
  font-size: 26rpx;
  text-align: center;
  font-weight: 600;
  transition: color 0.3s;
}

.verify-status-msg.verifying {
  color: #d97706;
}

.verify-status-msg.success {
  color: #16a34a;
}

.verify-status-msg.fail {
  color: #dc2626;
}

/* 微动效 */
.animated {
  animation-duration: 0.4s;
  animation-fill-mode: both;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translate3d(0, 10%, 0);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

.fadeIn {
  animation-name: fadeIn;
}

@keyframes scaleUp {
  from {
    transform: scale(0.9);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.animate-scale {
  animation: scaleUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

/* 环境检测状态样式 */
.env-status-box {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid #e2e8f0;
}

.env-status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.status-label {
  font-size: 28rpx;
  color: #5a6474;
}

.status-value {
  font-size: 28rpx;
  font-weight: 700;
}

.status-pending {
  color: #94a3b8;
}

.status-ok {
  color: #16a34a;
}

.status-err {
  color: #dc2626;
}

.env-diagnose-desc {
  font-size: 24rpx;
  color: #7a8494;
  line-height: 1.5;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #cbd5e0;
}

/* 辅助与次级按钮 */
.btn-secondary {
  margin-top: 24rpx;
  background: #ffffff;
  color: #5a6474;
  border: 2rpx solid #cbd5e0;
  border-radius: 50rpx;
  height: 100rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn-secondary:active {
  background: #f8fafc;
}

.form-footer-links {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
}

.link-recheck {
  font-size: 26rpx;
  color: #c62828;
  text-decoration: underline;
  padding: 10rpx 20rpx;
}

/* ========================================================
 * 任务三新增：Tab 切换与 XLS 导入专属样式
 * ======================================================== */

/* 顶部 Tab 切换 */
.tab-nav {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid #e2e8f0;
}

.tab-nav-item {
  flex: 1;
  text-align: center;
  font-size: 25rpx;
  color: #64748b;
  padding: 18rpx 10rpx;
  border-radius: 12rpx;
  transition: all 0.25s ease;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.25;
}

.tab-nav-item.active {
  background: #c62828;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(198, 40, 40, 0.15);
}

/* 步骤操作指导 */
.intro-step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #475569;
}

.step-num {
  background: #ffebee;
  color: #c62828;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: bold;
  margin-right: 16rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.intro-tip-box {
  margin-top: 30rpx;
  background: #f8fafc;
  border: 1rpx dashed #cbd5e0;
  border-radius: 16rpx;
  padding: 24rpx;
}

.intro-tip-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.intro-tip-text {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.6;
}

.server-network-card {
  margin-bottom: 30rpx;
  padding: 28rpx 30rpx;
  border: 1rpx solid #dbe7ff;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
}

.server-network-title {
  color: #17315f;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.server-network-desc {
  color: #4f6384;
  font-size: 24rpx;
  line-height: 1.6;
}

.env-diagnose-note {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  line-height: 1.5;
}

/* 已选文件卡片 */
.selected-file-box {
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  margin-top: 20rpx;
  margin-bottom: 30rpx;
}

.metadata-card {
  margin: 0 0 28rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  background: #f8fafc;
}

.metadata-title {
  color: #1e293b;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.metadata-row {
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.65;
}

.file-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.file-details {
  flex: 1;
  overflow: hidden;
}

.file-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  margin-bottom: 4rpx;
}

.file-meta {
  font-size: 22rpx;
  color: #64748b;
}

.btn-remove-file {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #64748b;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-left: 20rpx;
  transition: background 0.2s;
}

.btn-remove-file:active {
  background: #cbd5e0;
  color: #1e293b;
}

/* ========================================================
 * 预览页面布局
 * ======================================================== */
.xls-preview-wrapper {
  text-align: left;
}

.preview-header {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
  margin-bottom: 24rpx;
}

.preview-icon {
  margin-right: 20rpx;
}

.preview-title-box {
  flex: 1;
  overflow: hidden;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.preview-subtitle {
  font-size: 22rpx;
  color: #64748b;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.preview-stats {
  display: flex;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.stat-item:first-child {
  border-right: 1rpx solid #e2e8f0;
}

.stat-lbl {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 6rpx;
}

.stat-val {
  font-size: 30rpx;
  font-weight: bold;
  color: #1e293b;
}

/* 过滤搜索条 */
.preview-filter-bar {
  margin-bottom: 24rpx;
}

.preview-search {
  background: #f1f5f9;
  border-radius: 50rpx;
  height: 80rpx;
  padding: 0 36rpx;
  font-size: 26rpx;
  color: #1e293b;
  margin-bottom: 20rpx;
  border: 1rpx solid #e2e8f0;
}

.weekday-scroll {
  white-space: nowrap;
  width: 100%;
}

.weekday-bar {
  display: inline-flex;
  padding: 4rpx 0;
}

.weekday-tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  font-size: 24rpx;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 30rpx;
  margin-right: 16rpx;
  transition: all 0.2s ease;
  font-weight: 500;
}

.weekday-tab.active {
  background: #c62828;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(198, 40, 40, 0.15);
}

/* 课程卡片列表预览 */
.preview-course-list {
  max-height: 48vh;
  min-height: 300rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #e2e8f0;
  margin-bottom: 30rpx;
}

.empty-preview {
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
  padding: 80rpx 0;
}

.preview-course-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid #f1f5f9;
}

.preview-course-card:last-child {
  margin-bottom: 0;
}

.course-card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
  border-bottom: 1rpx dashed #f1f5f9;
  padding-bottom: 12rpx;
}

.course-card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #1e293b;
  flex: 1;
  margin-right: 16rpx;
}

.course-card-badge {
  font-size: 20rpx;
  color: #c62828;
  background: #ffebee;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.course-card-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.course-card-row:last-child {
  margin-bottom: 0;
}

.row-icon {
  margin-right: 10rpx;
  font-size: 24rpx;
  width: 30rpx;
  text-align: center;
}

.row-label {
  color: #94a3b8;
  width: 76rpx;
  flex-shrink: 0;
}

.row-value {
  color: #475569;
  font-weight: 500;
}

.note-value {
  color: #d97706;
}

/* 底部操作区 */
.preview-actions {
  display: flex;
  flex-direction: column;
}

.btn-cancel {
  background: #ffffff;
  color: #64748b;
  border: 2rpx solid #cbd5e0;
  border-radius: 50rpx;
  height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-sizing: border-box;
}
