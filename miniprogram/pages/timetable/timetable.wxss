.header {
  padding: 30rpx;
}

.title {
  color: #172033;
  font-size: 40rpx;
  font-weight: 900;
}

.subtitle {
  margin-top: 10rpx;
  color: #778297;
  font-size: 25rpx;
  line-height: 1.45;
}

.time-group {
  margin-top: 20rpx;
  padding: 24rpx;
}

.group-title {
  margin-bottom: 12rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
}

.time-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  border-bottom: 1rpx solid #eef1f6;
}

.time-row:last-child {
  border-bottom: 0;
}

.section-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #eef3fb;
  color: #536174;
  font-size: 23rpx;
  font-weight: 800;
}

.time-range {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
}
