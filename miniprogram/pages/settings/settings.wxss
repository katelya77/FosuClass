.settings-page {
  padding: 20rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #f7f8fa;
}

.settings-overview {
  padding: 28rpx 24rpx 24rpx;
  border: 1rpx solid #eceff2;
  border-radius: 18rpx;
  background: #ffffff;
}

.overview-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.overview-title {
  overflow: hidden;
  margin-top: 8rpx;
  color: #1f2329;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-title.muted {
  color: #8a8f98;
}

.overview-term {
  overflow: hidden;
  margin-top: 6rpx;
  color: #8a8f98;
  font-size: 22rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.overview-action {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  border: 1rpx solid #e1e4e8;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #3d424a;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.overview-action.primary {
  border-color: #c62828;
  background: #c62828;
  color: #ffffff;
}

.settings-section {
  margin-top: 32rpx;
}

.group-title {
  margin: 0 8rpx 12rpx;
  color: #626872;
  font-size: 24rpx;
  font-weight: 600;
}

.settings-list {
  overflow: hidden;
  border: 1rpx solid #eceff2;
  border-radius: 16rpx;
  background: #ffffff;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid #eef0f2;
}

.setting-row-button {
  width: 100%;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.setting-row-button::after {
  border: 0;
}

.setting-row:last-child {
  border-bottom: 0;
}

.row-copy {
  flex: 1;
  min-width: 0;
  padding: 18rpx 0;
}

.row-title {
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.row-desc {
  margin-top: 6rpx;
  color: #8a8f98;
  font-size: 22rpx;
  line-height: 1.4;
}

.row-desc.subtle {
  color: #9aa4b5;
  font-size: 21rpx;
  line-height: 1.45;
}

.row-arrow {
  color: #b3b7bd;
  font-size: 40rpx;
  line-height: 1;
}

.row-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #747a83;
  font-size: 24rpx;
}

.danger .row-title {
  color: #c62828;
}

.more-settings-panel {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.more-settings-list {
  flex: 0 0 auto;
}

.compact-popup-header {
  align-items: center;
  margin-bottom: 22rpx;
}

/* 弹窗遮罩 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(16, 24, 40, 0.42);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

/* 弹窗面板 */
.popup-panel {
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 40rpx calc(30rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.popup-handle {
  width: 80rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin: 0 auto 20rpx;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.popup-title-block {
  display: flex;
  flex-direction: column;
}

.popup-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #172033;
}

.popup-subtitle {
  font-size: 22rpx;
  color: #8a94a6;
  margin-top: 4rpx;
}

.close-button {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f3f7;
  color: #8a94a6;
  font-size: 40rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 可滚动列表 */
.detail-scroll {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 20rpx;
  max-height: 50vh;
}

.detail-grid {
  display: flex;
  flex-direction: column;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.detail-label {
  font-size: 26rpx;
  color: #536174;
}

.detail-value {
  max-width: 390rpx;
  font-size: 26rpx;
  color: #172033;
  font-weight: bold;
  line-height: 1.35;
  text-align: right;
  word-break: break-all;
}

.detail-divider {
  height: 20rpx;
}

.popup-footer {
  padding-top: 20rpx;
}

.footer-btn {
  background: #c62828;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feedback-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feedback-field {
  padding: 20rpx 22rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 14rpx;
  background: #f8fafc;
}

.feedback-label {
  margin-bottom: 12rpx;
  color: #536174;
  font-size: 24rpx;
  font-weight: 700;
}

.feedback-picker,
.feedback-input {
  min-height: 44rpx;
  color: #172033;
  font-size: 28rpx;
}

.feedback-placeholder {
  color: #a5adba;
}

.feedback-content-field {
  padding-bottom: 16rpx;
}

.feedback-textarea {
  width: 100%;
  min-height: 180rpx;
  color: #172033;
  font-size: 28rpx;
  line-height: 1.5;
}

.settings-logo {
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: #f1f4f8;
}

.settings-brand-info {
  flex: 1;
  min-width: 0;
}

.settings-app-title {
  color: #1f2329;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.2;
}

.detail-section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #172033;
  padding: 16rpx 0 8rpx;
  border-bottom: 2rpx solid #eef1f6;
  margin-top: 24rpx;
}

.diagnose-btn {
  margin: 30rpx 0 10rpx !important;
  background: #c62828 !important;
  color: #ffffff !important;
  font-size: 26rpx;
  font-weight: bold;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  padding: 0 !important;
}

.diagnose-btn.secondary {
  margin-top: 16rpx !important;
  border: 1rpx solid #dce4ef;
  background: #ffffff !important;
  color: #536174 !important;
}

.diagnose-btn:active {
  background: #b71c1c !important;
}

.diagnose-btn.secondary:active {
  background: #f1f4f8 !important;
}
