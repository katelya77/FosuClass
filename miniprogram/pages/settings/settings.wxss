.profile,
.settings-card,
.settings-overview {
  padding: 26rpx;
}

.profile-title {
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
}

.profile-subtitle {
  margin-top: 10rpx;
  color: #778297;
  font-size: 25rpx;
}

.settings-card {
  margin-top: 22rpx;
}

.settings-overview {
  border: 1rpx solid rgba(231, 237, 245, 0.92);
  background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
  box-shadow: 0 14rpx 38rpx rgba(16, 31, 55, 0.07);
}

.overview-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.overview-schedule {
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #edf1f6;
  border-radius: 16rpx;
  background: #ffffff;
}

.overview-label {
  color: #8a94a6;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.2;
}

.overview-title {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.28;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.overview-title.muted {
  color: #7a8494;
}

.overview-meta {
  overflow: hidden;
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.term-summary {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.term-summary-item {
  min-width: 0;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f7f9fc;
}

.term-summary-label {
  color: #8a94a6;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.term-summary-value {
  overflow: hidden;
  margin-top: 6rpx;
  color: #172033;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.overview-action {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  border: 1rpx solid #dfe6ef;
  border-radius: 14rpx;
  background: #ffffff;
  color: #3f4c5f;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 64rpx;
  text-align: center;
}

.overview-action.primary {
  border-color: #c62828;
  background: #c62828;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(198, 40, 40, 0.16);
}

.group-title {
  margin-bottom: 10rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 96rpx;
  border-bottom: 1rpx solid #eef1f6;
}

.setting-row-button {
  width: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.setting-row-button::after {
  border: 0;
}

.setting-row:last-child {
  border-bottom: 0;
}

.row-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.row-desc {
  margin-top: 8rpx;
  color: #8a94a6;
  font-size: 23rpx;
}

.row-desc.subtle,
.settings-app-current-meta {
  color: #9aa4b5;
  font-size: 21rpx;
  line-height: 1.45;
}

.row-arrow {
  color: #a4afbf;
  font-size: 46rpx;
  line-height: 1;
}

.danger .row-title {
  color: #c62828;
}

/* 弹窗遮罩 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(16, 24, 40, 0.42);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

/* 弹窗面板 */
.popup-panel {
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 40rpx calc(30rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.popup-handle {
  width: 80rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin: 0 auto 20rpx;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.popup-title-block {
  display: flex;
  flex-direction: column;
}

.popup-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #172033;
}

.popup-subtitle {
  font-size: 22rpx;
  color: #8a94a6;
  margin-top: 4rpx;
}

.close-button {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f3f7;
  color: #8a94a6;
  font-size: 40rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 可滚动列表 */
.detail-scroll {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 20rpx;
  max-height: 50vh;
}

.detail-grid {
  display: flex;
  flex-direction: column;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.detail-label {
  font-size: 26rpx;
  color: #536174;
}

.detail-value {
  max-width: 390rpx;
  font-size: 26rpx;
  color: #172033;
  font-weight: bold;
  line-height: 1.35;
  text-align: right;
  word-break: break-all;
}

.detail-divider {
  height: 20rpx;
}

.popup-footer {
  padding-top: 20rpx;
}

.footer-btn {
  background: #c62828;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feedback-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feedback-field {
  padding: 20rpx 22rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 14rpx;
  background: #f8fafc;
}

.feedback-label {
  margin-bottom: 12rpx;
  color: #536174;
  font-size: 24rpx;
  font-weight: 700;
}

.feedback-picker,
.feedback-input {
  min-height: 44rpx;
  color: #172033;
  font-size: 28rpx;
}

.feedback-placeholder {
  color: #a5adba;
}

.feedback-content-field {
  padding-bottom: 16rpx;
}

.feedback-textarea {
  width: 100%;
  min-height: 180rpx;
  color: #172033;
  font-size: 28rpx;
  line-height: 1.5;
}

.news-item {
  margin: 0 24rpx 18rpx;
  padding: 20rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 14rpx;
  background: #f8fafc;
}

.news-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.news-meta {
  margin-top: 8rpx;
  color: #7a8494;
  font-size: 22rpx;
}

.news-summary {
  margin-top: 12rpx;
  color: #536174;
  font-size: 24rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.modal-empty {
  padding: 52rpx 24rpx;
  color: #9aa4b5;
  font-size: 25rpx;
  text-align: center;
}

/* 设置页 Logo 区域 */
.settings-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 26rpx;
}

.settings-logo {
  width: 108rpx;
  height: 108rpx;
  border-radius: 24rpx;
  background: #f1f4f8;
  box-shadow: 0 8rpx 20rpx rgba(16, 31, 55, 0.08);
}

.settings-brand-info {
  flex: 1;
  min-width: 0;
}

.settings-app-title {
  color: #172033;
  font-size: 36rpx;
  font-weight: 900;
}

.settings-app-version {
  font-size: 21rpx;
  color: #8a94a6;
  margin-top: 4rpx;
}

.settings-app-current {
  font-size: 23rpx;
  color: #536174;
  margin-top: 8rpx;
  font-weight: 700;
}

.detail-section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #172033;
  padding: 16rpx 0 8rpx;
  border-bottom: 2rpx solid #eef1f6;
  margin-top: 24rpx;
}

.diagnose-btn {
  margin: 30rpx 0 10rpx !important;
  background: #c62828 !important;
  color: #ffffff !important;
  font-size: 26rpx;
  font-weight: bold;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  padding: 0 !important;
}

.diagnose-btn.secondary {
  margin-top: 16rpx !important;
  border: 1rpx solid #dce4ef;
  background: #ffffff !important;
  color: #536174 !important;
}

.diagnose-btn:active {
  background: #b71c1c !important;
}

.diagnose-btn.secondary:active {
  background: #f1f4f8 !important;
}
