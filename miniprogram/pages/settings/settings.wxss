.profile,
.settings-card {
  padding: 26rpx;
}

.profile-title {
  color: #172033;
  font-size: 42rpx;
  font-weight: 900;
}

.profile-subtitle {
  margin-top: 10rpx;
  color: #778297;
  font-size: 25rpx;
}

.settings-card {
  margin-top: 22rpx;
}

.group-title {
  margin-bottom: 10rpx;
  color: #172033;
  font-size: 30rpx;
  font-weight: 800;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 96rpx;
  border-bottom: 1rpx solid #eef1f6;
}

.setting-row-button {
  width: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.setting-row-button::after {
  border: 0;
}

.setting-row:last-child {
  border-bottom: 0;
}

.row-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.row-desc {
  margin-top: 8rpx;
  color: #8a94a6;
  font-size: 23rpx;
}

.row-arrow {
  color: #a4afbf;
  font-size: 46rpx;
  line-height: 1;
}

.danger .row-title {
  color: #c62828;
}

/* 弹窗遮罩 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(16, 24, 40, 0.42);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

/* 弹窗面板 */
.popup-panel {
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 40rpx calc(30rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.popup-handle {
  width: 80rpx;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
  margin: 0 auto 20rpx;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.popup-title-block {
  display: flex;
  flex-direction: column;
}

.popup-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #172033;
}

.popup-subtitle {
  font-size: 22rpx;
  color: #8a94a6;
  margin-top: 4rpx;
}

.close-button {
  font-size: 40rpx;
  color: #8a94a6;
  padding: 0;
  margin: 0;
  line-height: 1;
}

/* 可滚动列表 */
.detail-scroll {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 20rpx;
  max-height: 50vh;
}

.detail-grid {
  display: flex;
  flex-direction: column;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.detail-label {
  font-size: 26rpx;
  color: #536174;
}

.detail-value {
  max-width: 390rpx;
  font-size: 26rpx;
  color: #172033;
  font-weight: bold;
  line-height: 1.35;
  text-align: right;
  word-break: break-all;
}

.detail-divider {
  height: 20rpx;
}

.popup-footer {
  padding-top: 20rpx;
}

.footer-btn {
  background: #c62828;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feedback-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feedback-field {
  padding: 20rpx 22rpx;
  border: 1rpx solid #eef1f6;
  border-radius: 14rpx;
  background: #f8fafc;
}

.feedback-label {
  margin-bottom: 12rpx;
  color: #536174;
  font-size: 24rpx;
  font-weight: 700;
}

.feedback-picker,
.feedback-input {
  min-height: 44rpx;
  color: #172033;
  font-size: 28rpx;
}

.feedback-placeholder {
  color: #a5adba;
}

.feedback-content-field {
  padding-bottom: 16rpx;
}

.feedback-textarea {
  width: 100%;
  min-height: 180rpx;
  color: #172033;
  font-size: 28rpx;
  line-height: 1.5;
}

.news-item {
  margin: 0 24rpx 18rpx;
  padding: 20rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 14rpx;
  background: #f8fafc;
}

.news-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.news-meta {
  margin-top: 8rpx;
  color: #7a8494;
  font-size: 22rpx;
}

.news-summary {
  margin-top: 12rpx;
  color: #536174;
  font-size: 24rpx;
  line-height: 1.55;
  white-space: pre-wrap;
}

.modal-empty {
  padding: 52rpx 24rpx;
  color: #9aa4b5;
  font-size: 25rpx;
  text-align: center;
}

/* 设置页 Logo 区域 */
.settings-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx 26rpx;
}

.settings-logo {
  width: 108rpx;
  height: 108rpx;
  border-radius: 24rpx;
  background: #f1f4f8;
  box-shadow: 0 8rpx 20rpx rgba(16, 31, 55, 0.08);
}

.settings-brand-info {
  flex: 1;
  min-width: 0;
}

.settings-app-title {
  color: #172033;
  font-size: 36rpx;
  font-weight: 900;
}

.settings-app-version {
  font-size: 21rpx;
  color: #8a94a6;
  margin-top: 4rpx;
}

.settings-app-current {
  font-size: 23rpx;
  color: #536174;
  margin-top: 8rpx;
  font-weight: 700;
}
