<view class="page settings-page">
  <view class="profile card">
    <view class="profile-title">佛大课表</view>
    <view class="profile-subtitle">{{settings.className}} · {{settings.semester}}</view>
  </view>

  <view class="settings-card card">
    <view class="group-title">课表设置</view>
    <view class="setting-row" bindtap="goSchool">
      <view>
        <view class="row-title">当前班级</view>
        <view class="row-desc">{{settings.className}}</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="setting-row">
      <view>
        <view class="row-title">当前学期</view>
        <view class="row-desc">{{settings.semester}}</view>
      </view>
    </view>
    <view class="setting-row">
      <view>
        <view class="row-title">当前教学周</view>
        <view class="row-desc">{{teachingInfo.rangeText}} · 第{{teachingInfo.weekNo}}周</view>
      </view>
    </view>
    <view class="setting-row">
      <view>
        <view class="row-title">当前日期对应周次</view>
        <view class="row-desc">{{teachingInfo.dateLabel}} {{teachingInfo.weekdayLabel}} · 第{{teachingInfo.weekNo}}周</view>
      </view>
    </view>
    <view class="setting-row">
      <view>
        <view class="row-title">开学日期</view>
        <view class="row-desc">{{termStartDate}} · 周一</view>
      </view>
    </view>
    <picker mode="selector" range="{{weekOptions}}" value="{{settings.currentWeek - 1}}" bindchange="onWeekChange">
      <view class="setting-row">
        <view>
          <view class="row-title">手动修正当前周</view>
          <view class="row-desc">第{{settings.currentWeek}}周<text wx:if="{{settings.manualWeekOverride}}"> · 已手动覆盖</text><text wx:else> · 自动计算</text></view>
        </view>
        <view class="row-arrow">›</view>
      </view>
    </picker>
    <view wx:if="{{settings.manualWeekOverride}}" class="setting-row" bindtap="restoreAutoWeek">
      <view>
        <view class="row-title">恢复自动周次</view>
        <view class="row-desc">重新按教学日历和当前日期计算</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="setting-row">
      <view>
        <view class="row-title">隐藏非当前周课程</view>
        <view class="row-desc">关闭时会灰显未上课课程</view>
      </view>
      <switch
        checked="{{settings.hideInactiveCourses}}"
        color="#c62828"
        data-key="hideInactiveCourses"
        bindchange="onSwitchChange"
      />
    </view>
    <view class="setting-row">
      <view>
        <view class="row-title">显示周末</view>
        <view class="row-desc">关闭后首页只显示周一到周五</view>
      </view>
      <switch
        checked="{{settings.showWeekend}}"
        color="#c62828"
        data-key="showWeekend"
        bindchange="onSwitchChange"
      />
    </view>
    <view class="setting-row">
      <view>
        <view class="row-title">显示历史年级</view>
        <view class="row-desc">开启后将在学校查找中显示毕业历史年级</view>
      </view>
      <switch
        checked="{{settings.showHistoricalGrades}}"
        color="#c62828"
        data-key="showHistoricalGrades"
        bindchange="onSwitchChange"
      />
    </view>
  </view>

  <view class="settings-card card">
    <view class="group-title">入口</view>
    <view class="setting-row" bindtap="goTimetable">
      <view class="row-title">作息时间表</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="setting-row" bindtap="goLogin">
      <view class="row-title">登录同步个人课表</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="setting-row" bindtap="goContribute">
      <view class="row-title">贡献班级课表</view>
      <view class="row-arrow">›</view>
    </view>
    <!--
    <view class="setting-row" bindtap="showDeveloperApi">
      <view>
        <view class="row-title">开发者接口接入</view>
        <view class="row-desc">查看强智接口路径和抓包脱敏提醒</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    -->
  </view>

  <view class="settings-card card">
    <view class="group-title">反馈与分享</view>
    <view class="setting-row" bindtap="showFeedback">
      <view>
        <view class="row-title">问题反馈 / 建议反馈</view>
        <view class="row-desc">课表错误、数据过期、页面问题都可以告诉我们</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <button class="setting-row setting-row-button" open-type="contact" binderror="showContactFallback">
      <view>
        <view class="row-title">联系开发者</view>
        <view class="row-desc">优先使用微信小程序客服，无法打开时可查看备用方式</view>
      </view>
      <view class="row-arrow">›</view>
    </button>
    <view class="setting-row" bindtap="showContactFallback">
      <view>
        <view class="row-title">备用联系方式</view>
        <view class="row-desc">邮箱：katelya77@protonmail.com</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <button class="setting-row setting-row-button" open-type="share">
      <view>
        <view class="row-title">分享给同学</view>
        <view class="row-desc">会尽量带上当前选择的班级课表</view>
      </view>
      <view class="row-arrow">›</view>
    </button>
  </view>

  <view class="settings-card card">
    <view class="group-title">数据状态</view>
    <view class="setting-row" bindtap="showDataVersionDetail">
      <view>
        <view class="row-title">数据版本详情</view>
        <view class="row-desc">{{selectedScheduleText}}</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="setting-row" bindtap="refreshBootstrapData">
      <view>
        <view class="row-title">手动刷新数据</view>
        <view class="row-desc">清理本地 bootstrap / catalog / schedule 缓存后重新拉取</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
    <view class="setting-row danger" bindtap="clearLocalSelectionOnly">
      <view>
        <view class="row-title">清除本地选择</view>
        <view class="row-desc">清空当前课表选择和全校页筛选缓存</view>
      </view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <view class="settings-card card">
    <view class="group-title">其他</view>
    <view class="setting-row" bindtap="showPrivacy">
      <view class="row-title">隐私说明</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="setting-row" bindtap="showAbout">
      <view class="row-title">关于佛大课表</view>
      <view class="row-arrow">›</view>
    </view>
    <view class="setting-row danger" bindtap="clearCache">
      <view class="row-title">清除缓存</view>
      <view class="row-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{versionDetailVisible}}" class="popup-mask" bindtap="hideDataVersionDetail">
    <view class="popup-panel" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="popup-header">
        <view class="popup-title-block">
          <view class="popup-title">数据版本详情</view>
          <view class="popup-subtitle">本地及服务器运行状态监控</view>
        </view>
        <button class="close-button" bindtap="hideDataVersionDetail">×</button>
      </view>

      <scroll-view scroll-y class="detail-scroll">
        <view class="detail-grid">
          <view class="detail-row">
            <view class="detail-label">应用版本</view>
            <view class="detail-value">{{versionData.appVersion}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">基础库版本</view>
            <view class="detail-value">{{versionData.sdkVersion}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">作息时间版本</view>
            <view class="detail-value">{{versionData.courseTimesVersion}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">作息更新时间</view>
            <view class="detail-value">{{versionData.courseTimesUpdatedAt}}</view>
          </view>
          
          <view class="detail-divider"></view>
          
          <view class="detail-row">
            <view class="detail-label">快照版本</view>
            <view class="detail-value">{{versionData.snapshotVersion}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">当前学期</view>
            <view class="detail-value">{{versionData.semester}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">课表数据更新时间</view>
            <view class="detail-value">{{versionData.syncTimeText}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">catalogUpdatedAt</view>
            <view class="detail-value">{{versionData.catalogUpdatedAt}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">majorsUpdatedAt</view>
            <view class="detail-value">{{versionData.majorsUpdatedAt}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">classSchedulesUpdatedAt</view>
            <view class="detail-value">{{versionData.classSchedulesUpdatedAt}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">学院数量</view>
            <view class="detail-value">{{versionData.collegesCount}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">专业数量</view>
            <view class="detail-value">{{versionData.majorsCount}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">班级课表数量</view>
            <view class="detail-value">{{versionData.classScheduleCount}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">教师课表数量</view>
            <view class="detail-value">{{versionData.teacherScheduleCount}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">教室课表数量</view>
            <view class="detail-value">{{versionData.classroomScheduleCount}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">课程课表数量</view>
            <view class="detail-value">{{versionData.courseScheduleCount}}</view>
          </view>
          
          <view class="detail-divider"></view>
          
          <view class="detail-row">
            <view class="detail-label">数据来源</view>
            <view class="detail-value">{{versionData.dataSource}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">当前选择课表</view>
            <view class="detail-value">{{versionData.selectedScheduleText}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">说明</view>
            <view class="detail-value" style="font-size: 24rpx; color: #757575;">{{versionData.disclaimer}}</view>
          </view>
        </view>
      </scroll-view>

      <view class="popup-footer">
        <button class="footer-btn" bindtap="hideDataVersionDetail">知道了</button>
      </view>
    </view>
  </view>

  <view wx:if="{{feedbackVisible}}" class="popup-mask" bindtap="hideFeedback">
    <view class="popup-panel" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="popup-header">
        <view class="popup-title-block">
          <view class="popup-title">问题反馈</view>
          <view class="popup-subtitle">会自动附带当前课表和数据版本</view>
        </view>
        <button class="close-button" bindtap="hideFeedback">×</button>
      </view>

      <view class="feedback-form">
        <picker mode="selector" range="{{feedbackTypes}}" value="{{feedbackForm.typeIndex}}" bindchange="onFeedbackTypeChange">
          <view class="feedback-field">
            <view class="feedback-label">反馈类型</view>
            <view class="feedback-picker">{{feedbackTypes[feedbackForm.typeIndex]}}</view>
          </view>
        </picker>

        <view class="feedback-field">
          <view class="feedback-label">联系方式（选填）</view>
          <input
            class="feedback-input"
            value="{{feedbackForm.contact}}"
            placeholder="微信号 / 邮箱"
            placeholder-class="feedback-placeholder"
            bindinput="onFeedbackContactInput"
          />
        </view>

        <view class="feedback-field feedback-content-field">
          <view class="feedback-label">反馈内容</view>
          <textarea
            class="feedback-textarea"
            value="{{feedbackForm.content}}"
            maxlength="3000"
            placeholder="请描述你遇到的问题或建议"
            placeholder-class="feedback-placeholder"
            bindinput="onFeedbackContentInput"
          />
        </view>
      </view>

      <view class="popup-footer">
        <button class="footer-btn" loading="{{feedbackSubmitting}}" bindtap="submitFeedback">提交反馈</button>
      </view>
    </view>
  </view>
</view>
