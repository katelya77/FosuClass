<view class="page settings-page">
  <view class="settings-overview">
    <view class="overview-head">
      <image class="settings-logo" src="/assets/logo/favicon.png" mode="aspectFill" />
      <view class="settings-brand-info">
        <view class="settings-app-title">{{brand.appName}}</view>
        <view class="overview-title {{selectedScheduleText === '未绑定课表' ? 'muted' : ''}}">{{selectedScheduleText}}</view>
        <view class="overview-term">{{semesterDisplayText || "学期待同步"}} · {{teachingPeriodText}}</view>
      </view>
    </view>

    <view class="overview-actions">
      <button class="overview-action primary" bindtap="goSchool">切换课表</button>
      <button class="overview-action" bindtap="goImportXls">同步课表</button>
    </view>
  </view>

  <notice-ticker notices="{{appConfig.notices}}" page-key="settings" max-count="1" />

  <view class="settings-section">
    <view class="group-title">课表显示</view>
    <view class="settings-list">
      <view class="setting-row">
        <view class="row-copy">
          <view class="row-title">隐藏非本周课程</view>
          <view class="row-desc">只显示本周实际上课的课程</view>
        </view>
        <switch
          checked="{{settings.hideInactiveCourses}}"
          color="#c62828"
          data-key="hideInactiveCourses"
          bindchange="onSwitchChange"
        />
      </view>
      <view class="setting-row">
        <view class="row-copy">
          <view class="row-title">显示完整一周</view>
          <view class="row-desc">显示周一至周日</view>
        </view>
        <switch
          checked="{{settings.showWeekend}}"
          color="#c62828"
          data-key="showWeekend"
          bindchange="onSwitchChange"
        />
      </view>
      <view class="setting-row" bindtap="showMoreSettings" role="button">
        <view class="row-copy">
          <view class="row-title">更多显示设置</view>
          <view class="row-desc">当前周次与七天显示方式</view>
        </view>
        <view class="row-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="settings-section">
    <view class="group-title">课程提醒</view>
    <view class="settings-list">
      <view class="setting-row" bindtap="goSmartCourseReminders" role="button" aria-label="打开课程提醒设置">
        <view class="row-copy">
          <view class="row-title">课程提醒</view>
          <view class="row-desc">上课前提醒、微信通知</view>
        </view>
        <view class="row-arrow">›</view>
      </view>
      <view class="setting-row">
        <view class="row-copy">
          <view class="row-title">打开小程序时显示今日课程</view>
        </view>
        <switch
          checked="{{settings.enableTodayStartupReminder}}"
          color="#c62828"
          data-key="enableTodayStartupReminder"
          bindchange="onSwitchChange"
        />
      </view>
    </view>
  </view>

  <view class="settings-section">
    <view class="group-title">常用工具</view>
    <view class="settings-list">
      <view class="setting-row">
        <view class="row-copy">
          <view class="row-title">{{assistantBrand.assistantName}}浮窗</view>
          <view class="row-desc">{{xiaofuFloatEnabledText}}</view>
        </view>
        <switch
          checked="{{xiaofuFloatEnabled}}"
          color="#c62828"
          bindchange="onXiaofuFloatToggle"
        />
      </view>
      <view class="setting-row" bindtap="goCampusMap">
        <view class="row-copy">
          <view class="row-title">校园地图</view>
          <view class="row-desc">查看校区与教学楼</view>
        </view>
        <view class="row-arrow">›</view>
      </view>
    </view>
  </view>

  <view class="settings-section">
    <view class="group-title">帮助与关于</view>
    <view class="settings-list">
      <view class="setting-row" bindtap="showFeedback">
        <view class="row-title">问题反馈</view>
        <view class="row-arrow">›</view>
      </view>
      <button wx:if="{{!isMultiEndApp}}" class="setting-row setting-row-button" open-type="contact" binderror="showContactFallback">
        <view class="row-title">联系客服</view>
        <view class="row-arrow">›</view>
      </button>
      <button wx:else class="setting-row setting-row-button" bindtap="showContactFallback">
        <view class="row-title">联系开发者</view>
        <view class="row-arrow">›</view>
      </button>
      <view class="setting-row" bindtap="showPrivacy">
        <view class="row-title">隐私说明</view>
        <view class="row-arrow">›</view>
      </view>
      <view class="setting-row" bindtap="showAbout">
        <view class="row-title">关于{{brand.appName}}</view>
        <view class="row-arrow">›</view>
      </view>
      <button wx:if="{{!isMultiEndApp}}" class="setting-row setting-row-button" open-type="share">
        <view class="row-title">分享给同学</view>
        <view class="row-arrow">›</view>
      </button>
      <button wx:else class="setting-row setting-row-button" bindtap="shareWithClassmates">
        <view class="row-title">分享到微信</view>
        <view class="row-arrow">›</view>
      </button>
    </view>
  </view>

  <view wx:if="{{moreSettingsVisible}}" class="popup-mask" bindtap="hideMoreSettings">
    <view class="popup-panel more-settings-panel" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="popup-header compact-popup-header">
        <view class="popup-title">更多设置</view>
        <button class="close-button" bindtap="hideMoreSettings">×</button>
      </view>
      <view class="settings-list more-settings-list">
        <picker mode="selector" range="{{weekOptions}}" value="{{settings.currentWeek - 1}}" bindchange="onWeekChange">
          <view class="setting-row">
            <view class="row-title">当前周次</view>
            <view class="row-value">{{settings.manualWeekOverride ? "第" + settings.currentWeek + "周" : "跟随当前日期"}} <text class="row-arrow">›</text></view>
          </view>
        </picker>
        <view wx:if="{{settings.manualWeekOverride}}" class="setting-row" bindtap="restoreAutoWeek">
          <view class="row-title">跟随当前日期</view>
          <view class="row-arrow">›</view>
        </view>
        <picker wx:if="{{settings.showWeekend}}" mode="selector" range="{{['七天概览', '七天详细']}}" value="{{settings.weekendShowMode === 'detail' ? 1 : 0}}" bindchange="onWeekendModeChange">
          <view class="setting-row">
            <view class="row-title">课表显示方式</view>
            <view class="row-value">{{settings.weekendShowMode === 'detail' ? '七天详细' : '七天概览'}} <text class="row-arrow">›</text></view>
          </view>
        </picker>
        <view class="setting-row danger" bindtap="clearCache">
          <view class="row-title">恢复默认设置</view>
          <view class="row-arrow">›</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{versionDetailVisible}}" class="popup-mask" bindtap="hideDataVersionDetail">
    <view class="popup-panel" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="popup-header">
        <view class="popup-title-block">
          <view class="popup-title">数据与诊断</view>
          <view class="popup-subtitle">仅用于排查课表问题</view>
        </view>
        <button class="close-button" bindtap="hideDataVersionDetail">×</button>
      </view>

      <scroll-view scroll-y class="detail-scroll">
        <view class="detail-grid">
          <view class="detail-row">
            <view class="detail-label">应用版本</view>
            <view class="detail-value">{{versionData.appVersion}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">基础库版本</view>
            <view class="detail-value">{{versionData.sdkVersion}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">运行平台</view>
            <view class="detail-value">{{versionData.runtimePlatform}} · {{versionData.envVersion}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">作息时间版本</view>
            <view class="detail-value">{{versionData.courseTimesVersion}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">作息更新时间</view>
            <view class="detail-value">{{versionData.courseTimesUpdatedAt}}</view>
          </view>
          
          <view class="detail-divider"></view>
          
          <view class="detail-row">
            <view class="detail-label">快照版本</view>
            <view class="detail-value">{{versionData.snapshotVersion}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">当前学期</view>
            <view class="detail-value">{{versionData.semester}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">课表数据更新时间</view>
            <view class="detail-value">{{versionData.syncTimeText}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">catalogUpdatedAt</view>
            <view class="detail-value">{{versionData.catalogUpdatedAt}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">majorsUpdatedAt</view>
            <view class="detail-value">{{versionData.majorsUpdatedAt}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">classSchedulesUpdatedAt</view>
            <view class="detail-value">{{versionData.classSchedulesUpdatedAt}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">学院数量</view>
            <view class="detail-value">{{versionData.collegesCount}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">专业数量</view>
            <view class="detail-value">{{versionData.majorsCount}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">班级课表数量</view>
            <view class="detail-value">{{versionData.classScheduleCount}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">教师课表数量</view>
            <view class="detail-value">{{versionData.teacherScheduleCount}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">教室课表数量</view>
            <view class="detail-value">{{versionData.classroomScheduleCount}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">课程课表数量</view>
            <view class="detail-value">{{versionData.courseScheduleCount}}</view>
          </view>
          
          <view class="detail-divider"></view>
          
          <view class="detail-row">
            <view class="detail-label">数据来源</view>
            <view class="detail-value">{{versionData.dataSource}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">当前选择课表</view>
            <view class="detail-value">{{versionData.selectedScheduleText}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">说明</view>
            <view class="detail-value" style="font-size: 24rpx; color: #757575;">{{versionData.disclaimer}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">当前课表静态源</view>
            <view class="detail-value">{{versionData.publicStaticSourceLabel || '本地缓存'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">高速静态源</view>
            <view class="detail-value">{{versionData.publicCloudbaseStatus || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">备用静态源</view>
            <view class="detail-value">{{versionData.publicOracleStatus || '-'}}</view>
          </view>

          <view class="detail-divider"></view>
          <view class="detail-section-title">数据诊断</view>
          <button class="diagnose-btn secondary" bindtap="toggleAdvancedDiagnosis">{{diagnosisExpanded ? "收起高级诊断" : "高级诊断"}}</button>
          <view wx:if="{{diagnosisExpanded}}" class="diagnosis-block">
          
          <view class="detail-row">
            <view class="detail-label">当前正式版本</view>
            <view class="detail-value">{{versionData.remoteReleaseVersion || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">当前正式学期</view>
            <view class="detail-value">{{versionData.remoteTerm || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">课表数据更新时间</view>
            <view class="detail-value">{{versionData.remoteScheduleUpdatedAt || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">catalogUpdatedAt</view>
            <view class="detail-value">{{versionData.remoteCatalogUpdatedAt || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">本地缓存版本</view>
            <view class="detail-value">{{versionData.localReleaseVersion || '未感知'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">本地缓存学期</view>
            <view class="detail-value">{{versionData.localTerm || '未感知'}}</view>
          </view>
          
          <view class="detail-row">
            <view class="detail-label">班级索引缓存数</view>
            <view class="detail-value">{{versionData.classIndexCount || 0}} 项</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">教师索引缓存数</view>
            <view class="detail-value">{{versionData.teacherIndexCount || 0}} 项</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">教室索引缓存数</view>
            <view class="detail-value">{{versionData.classroomIndexCount || 0}} 项</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">课程索引缓存数</view>
            <view class="detail-value">{{versionData.courseIndexCount || 0}} 项</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">appConfig releaseVersion</view>
            <view class="detail-value">{{versionData.appConfigReleaseVersion || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">manifest releaseVersion</view>
            <view class="detail-value">{{versionData.manifestReleaseVersion || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">staticOrigin</view>
            <view class="detail-value">{{versionData.staticOrigin || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">staticOriginLabel</view>
            <view class="detail-value">{{versionData.staticOriginLabel || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">staticOriginUrl</view>
            <view class="detail-value">{{versionData.staticOriginUrl || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">manifestStatus</view>
            <view class="detail-value">{{versionData.manifestStatus || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">pointer source</view>
            <view class="detail-value">{{versionData.pointerSource || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">CloudBase last success</view>
            <view class="detail-value">{{versionData.recentCloudbaseSuccessAt || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">Oracle fallback</view>
            <view class="detail-value">{{versionData.recentOracleFallbackAt || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">freshnessStatus</view>
            <view class="detail-value">{{versionData.freshnessStatus || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">freshness checkedAt</view>
            <view class="detail-value">{{versionData.freshnessCheckedAt || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">CloudBase release</view>
            <view class="detail-value">{{versionData.cloudbaseReleaseVersion || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">Oracle release</view>
            <view class="detail-value">{{versionData.oracleReleaseVersion || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">last-good releaseVersion</view>
            <view class="detail-value">{{versionData.lastGoodReleaseVersion || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">cacheEpoch</view>
            <view class="detail-value">{{versionData.cacheEpoch || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">forceRefreshToken</view>
            <view class="detail-value">{{versionData.forceRefreshToken || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">empty-room cache</view>
            <view class="detail-value">{{versionData.emptyRoomCacheText || 'no'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">最近网络错误</view>
            <view class="detail-value">{{versionData.lastNetworkErrorText || '-'}}</view>
          </view>
          <view class="detail-row">
            <view class="detail-label">最近成功请求</view>
            <view class="detail-value">{{versionData.lastSuccessElapsedText || '-'}}</view>
          </view>
          
          <button class="diagnose-btn" bindtap="safeRefreshReleaseData">安全刷新数据</button>
          <button class="diagnose-btn secondary" bindtap="refreshReleaseManifestOnly">重新拉取 manifest</button>
          <button class="diagnose-btn secondary" bindtap="warmupReleaseIndexes">重新预热 index</button>
          <button class="diagnose-btn secondary" bindtap="cleanupOldReleaseCaches">清理旧版本缓存</button>
          <button class="diagnose-btn secondary" bindtap="exportDiagnosisLog">导出诊断日志</button>
          <button class="diagnose-btn" bindtap="diagnoseClearAllCaches">清理全校缓存并重新加载</button>
          </view>
        </view>
      </scroll-view>

      <view class="popup-footer">
        <button class="footer-btn" bindtap="hideDataVersionDetail">知道了</button>
      </view>
    </view>
  </view>

  <view wx:if="{{feedbackVisible}}" class="popup-mask" bindtap="hideFeedback">
    <view class="popup-panel" catchtap="noop">
      <view class="popup-handle"></view>
      <view class="popup-header">
        <view class="popup-title-block">
          <view class="popup-title">问题反馈</view>
          <view class="popup-subtitle">反馈将仅用于定位课表数据问题，不收集用户联系方式。</view>
        </view>
        <button class="close-button" bindtap="hideFeedback">×</button>
      </view>

      <view class="feedback-form">
        <picker mode="selector" range="{{feedbackTypes}}" value="{{feedbackForm.typeIndex}}" bindchange="onFeedbackTypeChange">
          <view class="feedback-field">
            <view class="feedback-label">反馈类型</view>
            <view class="feedback-picker">{{feedbackTypes[feedbackForm.typeIndex]}}</view>
          </view>
        </picker>

        <view class="feedback-field feedback-content-field">
          <view class="feedback-label">反馈内容</view>
          <textarea
            class="feedback-textarea"
            value="{{feedbackForm.content}}"
            maxlength="3000"
            placeholder="请描述你遇到的问题或建议"
            placeholder-class="feedback-placeholder"
            bindinput="onFeedbackContentInput"
          />
        </view>
      </view>

      <view class="popup-footer">
        <button class="footer-btn" loading="{{feedbackSubmitting}}" bindtap="submitFeedback">提交反馈</button>
      </view>
    </view>
  </view>
  <xiaofu-float hidden="{{!xiaofuFloatEnabled}}" />
</view>
