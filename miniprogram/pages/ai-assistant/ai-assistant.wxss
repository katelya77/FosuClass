.ai-page {
  box-sizing: border-box;
  display: flex;
  min-height: 100vh;
  height: 100vh;
  flex-direction: column;
  overflow: hidden;
  padding: 18rpx 18rpx 176rpx;
  background: #f5f7fb;
}

.assistant-hero {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf4;
  box-shadow: 0 16rpx 42rpx rgba(18, 27, 43, 0.06);
}

.hero-main {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 16rpx;
}

.hero-logo,
.hero-mark {
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
}

.hero-logo {
  background: #fff4f4;
}

.hero-mark {
  background: #c62828;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-copy {
  min-width: 0;
}

.hero-title {
  color: #142033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
}

.hero-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.provider-pill {
  max-width: 188rpx;
  min-height: 42rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #eef6f0;
  color: #247247;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 42rpx;
  text-align: center;
}

.history-clear {
  flex: 0 0 auto;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f2f5f9;
  color: #596579;
  font-size: 22rpx;
  font-weight: 800;
}

.privacy-tip {
  flex: 0 0 auto;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-color: #f2ded2;
  background: #fffaf7;
}

.privacy-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.privacy-title {
  color: #9f2a1f;
  font-size: 25rpx;
  font-weight: 900;
}

.privacy-desc {
  margin-top: 8rpx;
  color: #5f6b7c;
  font-size: 22rpx;
  line-height: 1.55;
}

.privacy-switch {
  flex: 0 0 auto;
  transform: scale(0.82);
  transform-origin: right center;
}

.privacy-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
  color: #8a4b37;
  font-size: 21rpx;
  font-weight: 800;
}

.privacy-btn {
  flex: 0 0 auto;
  height: 48rpx;
  min-width: 112rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
}

.quick-scroll {
  flex: 0 0 auto;
  width: 100%;
  margin-top: 14rpx;
  white-space: nowrap;
}

.quick-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 4rpx 6rpx;
}

.quick-chip {
  height: 58rpx;
  padding: 0 22rpx;
  border: 1rpx solid #ecd2d2;
  border-radius: 12rpx;
  background: #ffffff;
  color: #9f1f25;
  font-size: 23rpx;
  font-weight: 800;
  white-space: nowrap;
  box-shadow: 0 8rpx 20rpx rgba(90, 27, 31, 0.04);
}

.message-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 12rpx;
  padding-bottom: 28rpx;
}

.empty-welcome {
  padding: 72rpx 28rpx 96rpx;
  text-align: center;
}

.empty-orbit {
  display: flex;
  justify-content: center;
  margin-bottom: 22rpx;
}

.empty-logo,
.empty-logo-text {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 48rpx rgba(18, 27, 43, 0.08);
}

.empty-logo-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c62828;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-title {
  color: #142033;
  font-size: 31rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 14rpx;
  color: #778297;
  font-size: 24rpx;
  line-height: 1.6;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 26rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.assistant-avatar {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf4;
  color: #c62828;
  font-size: 18rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(18, 27, 43, 0.06);
}

.avatar-logo {
  width: 42rpx;
  height: 42rpx;
}

.message-body {
  max-width: 88%;
  min-width: 0;
}

.message-row.user .message-body {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.message-bubble {
  max-width: 100%;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf4;
  box-shadow: 0 12rpx 30rpx rgba(18, 27, 43, 0.05);
}

.message-row.assistant .message-bubble {
  border-top-left-radius: 8rpx;
}

.message-row.user .message-bubble {
  border-top-right-radius: 8rpx;
  background: #c62828;
  border-color: #c62828;
  color: #ffffff;
}

.message-content {
  color: #142033;
  font-size: 26rpx;
  line-height: 1.58;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-row.user .message-content {
  color: #ffffff;
}

.message-meta {
  margin-top: 8rpx;
  color: #98a2b3;
  font-size: 19rpx;
}

.message-row.user .message-meta {
  color: rgba(255, 255, 255, 0.78);
}

.tool-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 10rpx 2rpx 0;
}

.tool-chip {
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #edf4ff;
  color: #2d5db3;
  font-size: 18rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
}

.tool-chip.failed {
  background: #fff1f1;
  color: #c62828;
}

.tool-chip.skipped {
  background: #eef2f6;
  color: #667085;
}

.ai-card-list {
  width: 100%;
  margin-top: 12rpx;
}

.ai-result-card {
  margin-top: 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  border-color: #e8edf4;
  box-shadow: 0 10rpx 28rpx rgba(18, 27, 43, 0.05);
}

.card-type-empty_room {
  border-color: #f1c6c6;
}

.card-type-schedule {
  border-color: #c8dcf6;
}

.card-type-diagnosis {
  border-color: #dce3ec;
}

.card-header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title-block {
  min-width: 0;
  flex: 1;
}

.card-title {
  color: #142033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.3;
}

.card-subtitle {
  margin-top: 6rpx;
  color: #667085;
  font-size: 22rpx;
  line-height: 1.45;
}

.card-type {
  flex: 0 0 auto;
  max-width: 176rpx;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: #f3f6fa;
  color: #64748b;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  word-break: break-word;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.badge {
  min-height: 34rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: #fff2f2;
  color: #a5242b;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.2;
}

.card-items {
  margin-top: 14rpx;
  border-top: 1rpx solid #edf0f5;
}

.card-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.card-item:last-child {
  border-bottom: 0;
}

.item-main {
  min-width: 0;
  flex: 1;
}

.item-title {
  overflow: hidden;
  color: #142033;
  font-size: 25rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-subtitle {
  margin-top: 4rpx;
  color: #778297;
  font-size: 21rpx;
  line-height: 1.35;
}

.item-value {
  flex: 0 0 auto;
  max-width: 210rpx;
  color: #c62828;
  font-size: 22rpx;
  font-weight: 900;
  text-align: right;
  line-height: 1.25;
  word-break: break-word;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.card-action {
  min-width: 168rpx;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
}

.suggestion-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.suggestion-chip {
  min-height: 50rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #eef2f6;
  color: #4b5563;
  font-size: 22rpx;
  font-weight: 800;
}

.slow-tip {
  margin: 10rpx 0 18rpx 64rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #b45309;
  font-size: 22rpx;
  line-height: 1.45;
}

.sending-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 0 18rpx 64rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 700;
}

.sending-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c62828;
  animation: aiPulse 1s ease-in-out infinite;
}

@keyframes aiPulse {
  0%, 100% {
    opacity: 0.35;
    transform: scale(0.82);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  box-sizing: border-box;
  padding: 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(245, 247, 251, 0.96);
  border-top: 1rpx solid #e1e7ef;
  box-shadow: 0 -18rpx 48rpx rgba(18, 27, 43, 0.08);
}

.composer-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.composer-input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 16rpx;
  background: #ffffff;
  color: #142033;
  font-size: 25rpx;
  box-shadow: 0 8rpx 24rpx rgba(18, 27, 43, 0.04);
}

.composer-placeholder {
  color: #a5adba;
}

.send-btn {
  flex: 0 0 auto;
  width: 132rpx;
  height: 78rpx;
  border-radius: 16rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
}

.send-btn.disabled {
  background: #cbd5e1;
  color: #64748b;
}

.composer-note {
  margin-top: 8rpx;
  color: #7a8494;
  font-size: 20rpx;
  font-weight: 700;
  text-align: center;
}
