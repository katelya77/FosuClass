.ai-page {
  box-sizing: border-box;
  display: flex;
  height: 100vh;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  padding: 12rpx 16rpx 218rpx;
  padding-bottom: 218rpx;
  background: #f5f7fb;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid #e7edf5;
  border-radius: 8rpx;
  background: #ffffff;
}

.top-status-bar {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 12rpx;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0 10rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 8rpx;
  background: #ffffff;
}

.status-left {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.status-logo-wrap {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  overflow: hidden;
  border: 1rpx solid #edf0f5;
  border-radius: 8rpx;
  background: #ffffff;
}

.status-logo,
.status-mark {
  width: 36rpx;
  height: 36rpx;
  border-radius: 6rpx;
}

.status-mark {
  background: #c62828;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 900;
  line-height: 36rpx;
  text-align: center;
}

.status-name {
  max-width: 72rpx;
  overflow: hidden;
  color: #142033;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-copy {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  color: #667085;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.25;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-clear {
  flex: 0 0 auto;
  width: 66rpx;
  height: 40rpx;
  padding: 0;
  border: 1rpx solid #dfe6f0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #596579;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.ability-row {
  display: flex;
  flex: 0 0 auto;
  gap: 8rpx;
  margin-top: 8rpx;
}

.ability-chip-button {
  width: auto;
  height: 40rpx;
  padding: 0 14rpx;
  border: 1rpx solid #dfe6f0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #4b5563;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.assistant-hero {
  flex: 0 0 auto;
  padding: 10rpx 12rpx;
  box-shadow: none;
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.hero-logo-wrap {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 10rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(198, 40, 40, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.hero-logo,
.hero-mark {
  width: 52rpx;
  height: 52rpx;
  border-radius: 8rpx;
}

.hero-mark {
  background: #c62828;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.hero-title {
  overflow: hidden;
  color: #142033;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.22;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 3rpx;
  color: #667085;
  font-size: 19rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.hero-clear-mini {
  flex: 0 0 auto;
  width: 72rpx;
  height: 40rpx;
  padding: 0;
  border: 1rpx solid #dfe6f0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #596579;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 40rpx;
}

.hero-meta-row {
  display: flex;
  flex-wrap: nowrap;
  gap: 6rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

.hero-status-chip {
  box-sizing: border-box;
  max-width: 140rpx;
  height: 30rpx;
  padding: 0 9rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f3f6fa;
  color: #4b5563;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ability-chip {
  max-width: 100%;
  color: #4b5563;
  background: #f3f6fa;
}

.privacy-tip,
.privacy-compact,
.quick-scroll {
  flex: 0 0 auto;
}

.privacy-tip {
  margin-top: 8rpx;
  border-color: #e4e9f1;
}

.privacy-tip-full {
  padding: 12rpx 14rpx;
  background: #ffffff;
}

.privacy-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.privacy-copy {
  flex: 1;
  min-width: 0;
}

.privacy-title {
  color: #374151;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.25;
}

.privacy-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: #5f6b7c;
  font-size: 19rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.privacy-switch {
  flex: 0 0 auto;
  transform: scale(0.78);
  transform-origin: right center;
}

.privacy-switch.compact {
  transform: scale(0.72);
}

.privacy-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 10rpx;
  color: #667085;
  font-size: 18rpx;
  font-weight: 800;
}

.privacy-footer text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.privacy-btn {
  flex: 0 0 auto;
  height: 44rpx;
  min-width: 96rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.privacy-btn.secondary {
  background: #edf2f7;
  color: #4b5563;
}

.privacy-compact {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  min-height: 50rpx;
  margin-top: 8rpx;
  padding: 5rpx 10rpx 5rpx 12rpx;
  border: 1rpx solid #e4e9f1;
  border-radius: 8rpx;
}

.privacy-compact.disabled {
  background: #f7f4ef;
}

.privacy-compact.enabled {
  background: #f0fbf4;
  border-color: #cdebd6;
}

.privacy-compact-main {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 8rpx;
}

.privacy-dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #a0aec0;
}

.privacy-compact.enabled .privacy-dot {
  background: #2f855a;
}

.privacy-compact-text {
  overflow: hidden;
  color: #4b5563;
  font-size: 21rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.privacy-compact-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.privacy-link {
  width: 68rpx;
  height: 42rpx;
  padding: 0;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #596579;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.quick-scroll {
  width: 100%;
  margin-top: 8rpx;
  white-space: nowrap;
}

.quick-list {
  display: inline-flex;
  gap: 10rpx;
  padding: 2rpx 4rpx 5rpx;
}

.quick-chip {
  flex: 0 0 auto;
  height: 44rpx;
  padding: 0 14rpx;
  border: 1rpx solid #dfe6f0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #4b5563;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 44rpx;
  white-space: nowrap;
}

.task-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.task-panel-title {
  flex: 0 0 auto;
  color: #142033;
  font-size: 24rpx;
  font-weight: 900;
}

.task-panel-subtitle {
  flex: 1;
  overflow: hidden;
  color: #778297;
  font-size: 19rpx;
  font-weight: 700;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.task-item {
  box-sizing: border-box;
  min-width: 0;
  height: 80rpx;
  padding: 9rpx 12rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 8rpx;
  background: #f8fafc;
  text-align: left;
}

.task-label,
.task-desc,
.item-title,
.card-title,
.course-title {
  overflow: hidden;
  text-overflow: ellipsis;
}

.task-label {
  color: #374151;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.25;
  white-space: nowrap;
}

.task-desc {
  margin-top: 5rpx;
  color: #667085;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
}

.message-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 10rpx;
  padding-bottom: 28rpx;
}

.empty-welcome {
  padding: 34rpx 24rpx 48rpx;
  text-align: center;
}

.empty-orbit {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}

.empty-logo,
.empty-logo-text {
  width: 84rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(18, 27, 43, 0.08);
}

.empty-logo-text {
  color: #c62828;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 84rpx;
}

.empty-title {
  color: #142033;
  font-size: 29rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 10rpx;
  color: #778297;
  font-size: 23rpx;
  line-height: 1.5;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.assistant-avatar {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  border: 1rpx solid #e8edf4;
  border-radius: 14rpx;
  background: #ffffff;
  color: #c62828;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
}

.avatar-logo {
  width: 42rpx;
  height: 42rpx;
  margin: 5rpx;
}

.message-body {
  min-width: 0;
}

.message-row.assistant .message-body {
  width: calc(100% - 64rpx);
  max-width: calc(100% - 64rpx);
}

.message-row.user .message-body {
  display: flex;
  max-width: 78%;
  flex-direction: column;
  align-items: flex-end;
}

.message-bubble {
  box-sizing: border-box;
  max-width: 100%;
  padding: 15rpx 18rpx;
  border: 1rpx solid #e8edf4;
  border-radius: 16rpx;
  background: #ffffff;
}

.message-row.assistant .message-bubble {
  border-top-left-radius: 8rpx;
}

.message-row.user .message-bubble {
  border-color: #c62828;
  border-top-right-radius: 8rpx;
  background: #c62828;
}

.message-content {
  color: #142033;
  font-size: 25rpx;
  line-height: 1.56;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-row.user .message-content {
  color: #ffffff;
}

.message-meta {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 7rpx;
  color: #98a2b3;
  font-size: 19rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.message-row.user .message-meta {
  color: rgba(255, 255, 255, 0.78);
}

.tool-strip {
  display: flex;
  flex-wrap: nowrap;
  gap: 7rpx;
  margin: 8rpx 2rpx 0;
  overflow: hidden;
}

.tool-chip {
  max-width: 100%;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #eef2f6;
  color: #4b5563;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-chip.failed {
  background: #fff1f1;
  color: #c62828;
}

.tool-chip.skipped {
  background: #eef2f6;
  color: #667085;
}

.tool-chip.running {
  background: #fff7e8;
  color: #b45309;
}

.ai-card-list {
  width: 100%;
  margin-top: 10rpx;
}

.ai-result-card {
  margin-top: 10rpx;
  padding: 16rpx;
  border-color: #e8edf4;
  box-shadow: none;
}

.card-type-empty-room {
  border-color: #e8edf4;
}

.card-type-schedule {
  border-color: #e8edf4;
}

.card-type-diagnosis {
  border-color: #dce3ec;
}

.card-type-guide {
  border-color: #e8edf4;
}

.card-header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.card-title-block {
  min-width: 0;
  flex: 1;
}

.card-title {
  display: -webkit-box;
  color: #142033;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.32;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-subtitle {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 5rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-type {
  flex: 0 0 auto;
  box-sizing: border-box;
  max-width: 96rpx;
  padding: 6rpx 9rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f3f6fa;
  color: #64748b;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 11rpx;
}

.badge {
  max-width: 190rpx;
  min-height: 32rpx;
  padding: 3rpx 9rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #eef2f6;
  color: #4b5563;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-items {
  margin-top: 12rpx;
  border-top: 1rpx solid #edf0f5;
}

.card-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.card-item:last-child {
  border-bottom: 0;
}

.item-main {
  min-width: 0;
  flex: 1;
}

.item-title {
  color: #142033;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}

.item-subtitle {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 4rpx;
  color: #778297;
  font-size: 20rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.item-value {
  flex: 0 0 auto;
  max-width: 170rpx;
  overflow: hidden;
  color: #4b5563;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-overflow {
  width: 100%;
  height: 46rpx;
  margin-top: 6rpx;
  padding: 0;
  border-radius: 10rpx;
  background: #f3f6fa;
  color: #5d6b82;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 46rpx;
}

.card-overflow.expanded {
  color: #4b5563;
  background: #eef2f6;
}

.card-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.card-actions.one-action .card-action {
  width: 100%;
}

.card-actions.two-actions .card-action {
  flex: 1;
}

.card-action {
  min-width: 0;
  height: 54rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #c62828;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 54rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.secondary-action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.secondary-action {
  width: auto;
  max-width: 220rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #eef2f6;
  color: #4b5563;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filtered-hint {
  margin-top: 10rpx;
  color: #98a2b3;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
}

.card-disclaimer {
  margin-top: 11rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #e1e7ef;
  color: #98a2b3;
  font-size: 17rpx;
  line-height: 1.35;
}

.suggestion-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.suggestion-chip {
  width: auto;
  max-width: 300rpx;
  min-height: 46rpx;
  padding: 0 15rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #eef2f6;
  color: #4b5563;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 46rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slow-tip {
  margin: 10rpx 0 18rpx 64rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #b45309;
  font-size: 21rpx;
  line-height: 1.45;
}

.sending-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 0 18rpx 64rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 700;
}

.sending-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c62828;
  animation: aiPulse 1s ease-in-out infinite;
}

@keyframes aiPulse {
  0%, 100% {
    opacity: 0.35;
    transform: scale(0.82);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  box-sizing: border-box;
  padding: 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e1e7ef;
  background: rgba(245, 247, 251, 0.98);
  box-shadow: 0 -14rpx 40rpx rgba(18, 27, 43, 0.08);
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 38;
  background: rgba(20, 32, 51, 0.18);
}

.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  box-sizing: border-box;
  max-height: 64vh;
  padding: 12rpx 16rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e1e7ef;
  border-radius: 8rpx 8rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 42rpx rgba(18, 27, 43, 0.14);
}

.sheet-handle {
  width: 54rpx;
  height: 6rpx;
  margin: 0 auto 12rpx;
  border-radius: 999rpx;
  background: #d8dee8;
}

.sheet-close {
  width: 76rpx;
  height: 42rpx;
  padding: 0;
  border: 1rpx solid #dfe6f0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #596579;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.privacy-sheet {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.composer-inner {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.composer-input {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  max-height: 154rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 16rpx;
  background: #ffffff;
  color: #142033;
  font-size: 24rpx;
  line-height: 1.45;
}

.composer-placeholder {
  color: #a5adba;
}

.send-btn {
  flex: 0 0 auto;
  width: 112rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 72rpx;
}

.send-btn.disabled {
  background: #cbd5e1;
  color: #64748b;
}

.composer-note {
  display: block;
  width: 100%;
  height: 32rpx;
  padding: 0;
  border: 0;
  background: transparent;
  overflow: hidden;
  margin-top: 6rpx;
  color: #7a8494;
  font-size: 18rpx;
  font-weight: 700;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 32rpx;
}

@media (max-width: 360px) {
  .ai-page {
    padding-left: 12rpx;
    padding-right: 12rpx;
  }

  .status-logo-wrap {
    width: 60rpx;
    height: 60rpx;
    flex-basis: 60rpx;
  }

  .status-logo,
  .status-mark {
    width: 56rpx;
    height: 56rpx;
  }

  .status-mark {
    line-height: 56rpx;
  }

  .status-clear {
    width: 78rpx;
  }

  .message-row.user .message-body {
    max-width: 84%;
  }

  .send-btn {
    width: 104rpx;
  }
}
