.ai-page {
  box-sizing: border-box;
  display: flex;
  height: 100vh;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  padding: 14rpx 16rpx 218rpx;
  padding-bottom: 218rpx;
  background: linear-gradient(180deg, #f7f8fb 0%, #fff7f5 56%, #f8fafc 100%);
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: inherit;
}

button::after {
  border: 0;
}

.card {
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #ffffff;
}

.xiaofu-header {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 14rpx;
  height: 84rpx;
  min-height: 84rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(255, 242, 239, 0.86));
  box-shadow: 0 10rpx 30rpx rgba(142, 36, 36, 0.08);
}

.xiaofu-avatar-wrap {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(198, 40, 40, 0.12);
}

.xiaofu-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
}

.xiaofu-avatar-text {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.xiaofu-title-block {
  flex: 1;
  min-width: 0;
}

.xiaofu-title {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.1;
}

.xiaofu-subtitle {
  overflow: hidden;
  margin-top: 5rpx;
  color: #6b7280;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xiaofu-clear {
  flex: 0 0 auto;
  width: 72rpx;
  height: 48rpx;
  color: #8a4b4b;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
}

.quick-task-row {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
}

.quick-action-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.quick-action-list {
  display: inline-flex;
  gap: 10rpx;
  padding: 2rpx 2rpx 6rpx;
}

.quick-action-pill {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 168rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #374151;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 58rpx;
  box-shadow: 0 8rpx 22rpx rgba(31, 41, 55, 0.07);
}

.quick-action-pill.today {
  color: #1f5f8b;
}

.quick-action-pill.room {
  color: #2f6f4e;
}

.quick-action-pill.teacher {
  color: #8a4b4b;
}

.quick-action-pill.xls {
  color: #6b4d16;
}

.quick-action-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #f5f7fa;
  color: inherit;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-align: center;
}

.quick-action-label {
  max-width: 94rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-more-button {
  flex: 0 0 auto;
  width: 84rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #5f6b7c;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 58rpx;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(31, 41, 55, 0.06);
}

.history-trim-tip {
  flex: 0 0 auto;
  margin: 6rpx 4rpx 0;
  color: #8a6f64;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.message-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 10rpx;
  padding: 4rpx 0 28rpx;
}

.empty-welcome {
  box-sizing: border-box;
  max-height: 352rpx;
  margin: 8rpx 2rpx 18rpx;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 36rpx rgba(31, 41, 55, 0.08);
}

.empty-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.empty-desc {
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.empty-example-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
}

.empty-example {
  width: 100%;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #f7f8fb;
  color: #374151;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: left;
}

.empty-safe-note {
  margin-top: 14rpx;
  color: #98a2b3;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.3;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.assistant-avatar,
.assistant-avatar-spacer {
  flex: 0 0 auto;
  width: 46rpx;
  height: 46rpx;
}

.assistant-avatar {
  border-radius: 14rpx;
  background: #ffffff;
  color: #c62828;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(31, 41, 55, 0.07);
}

.assistant-avatar-spacer {
  opacity: 0;
}

.avatar-logo {
  width: 38rpx;
  height: 38rpx;
  margin: 4rpx;
  border-radius: 12rpx;
}

.message-body {
  min-width: 0;
}

.message-row.assistant .message-body {
  width: calc(100% - 56rpx);
  max-width: calc(100% - 56rpx);
}

.message-row.user .message-body {
  display: flex;
  max-width: 78%;
  flex-direction: column;
  align-items: flex-end;
}

.message-bubble {
  box-sizing: border-box;
  max-width: 100%;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.07);
}

.message-row.assistant .message-bubble {
  border: 1rpx solid rgba(231, 237, 245, 0.92);
  border-top-left-radius: 8rpx;
}

.message-row.user .message-bubble {
  border-top-right-radius: 8rpx;
  background: #c62828;
  box-shadow: 0 10rpx 24rpx rgba(198, 40, 40, 0.22);
}

.message-content {
  color: #1f2937;
  font-size: 25rpx;
  line-height: 1.58;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-row.user .message-content {
  color: #ffffff;
}

.message-meta {
  overflow: hidden;
  margin-top: 7rpx;
  color: #98a2b3;
  font-size: 18rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-row.user .message-meta {
  color: rgba(255, 255, 255, 0.78);
}

.tool-strip {
  display: flex;
  flex-wrap: nowrap;
  gap: 7rpx;
  margin: 8rpx 2rpx 0;
  overflow: hidden;
}

.tool-chip {
  max-width: 100%;
  height: 30rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #eef7ff;
  color: #25658f;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-chip.success {
  background: #edf8f1;
  color: #2f6f4e;
}

.tool-chip.failed {
  background: #fff1f1;
  color: #c62828;
}

.tool-chip.skipped {
  background: #f2f4f7;
  color: #667085;
}

.tool-chip.running {
  background: #fff7e8;
  color: #9a5b08;
}

.ai-card-list {
  width: 100%;
  margin-top: 10rpx;
}

.ai-result-card {
  margin-top: 10rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(231, 237, 245, 0.96);
  box-shadow: 0 12rpx 32rpx rgba(31, 41, 55, 0.08);
}

.ai-result-card.card-error {
  border-color: #fde2e2;
  background: #fffafa;
}

.card-header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.card-title-block {
  min-width: 0;
  flex: 1;
}

.card-title {
  display: -webkit-box;
  overflow: hidden;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.32;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-subtitle {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 21rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-type {
  flex: 0 0 auto;
  max-width: 112rpx;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f4f6f8;
  color: #6b7280;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 12rpx;
}

.badge {
  max-width: 190rpx;
  min-height: 30rpx;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f2f7ff;
  color: #356b93;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-items {
  margin-top: 12rpx;
  border-top: 1rpx solid #edf0f5;
}

.card-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 62rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.card-item:last-child {
  border-bottom: 0;
}

.item-main {
  min-width: 0;
  flex: 1;
}

.item-title {
  overflow: hidden;
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-type-empty-room .item-title {
  font-size: 26rpx;
}

.item-subtitle {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 5rpx;
  color: #7a8494;
  font-size: 20rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.item-value {
  flex: 0 0 auto;
  max-width: 172rpx;
  overflow: hidden;
  color: #4b5563;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-type-empty-room .item-value {
  color: #c62828;
}

.card-overflow {
  width: 100%;
  height: 46rpx;
  margin-top: 8rpx;
  border-radius: 12rpx;
  background: #f4f6f8;
  color: #5f6b7c;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-align: center;
}

.card-overflow.expanded {
  background: #eef2f6;
  color: #374151;
}

.card-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
}

.card-actions.one-action .card-action-primary {
  width: 100%;
}

.card-actions.two-actions .card-action-primary {
  flex: 1;
}

.card-action-primary {
  min-width: 0;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #c62828;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.secondary-action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.card-action-secondary {
  width: auto;
  max-width: 240rpx;
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f1f3f6;
  color: #4b5563;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 46rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filtered-hint {
  margin-top: 10rpx;
  color: #98a2b3;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
}

.card-disclaimer {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #e5eaf1;
  color: #98a2b3;
  font-size: 17rpx;
  line-height: 1.35;
}

.suggestion-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.suggestion-chip {
  width: auto;
  max-width: 300rpx;
  min-height: 46rpx;
  padding: 0 15rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  color: #4b5563;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 46rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow: 0 6rpx 18rpx rgba(31, 41, 55, 0.06);
}

.slow-tip {
  margin: 10rpx 0 18rpx 56rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #fff7ed;
  color: #9a5b08;
  font-size: 21rpx;
  line-height: 1.45;
}

.sending-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 0 18rpx 56rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 700;
}

.sending-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c62828;
  animation: aiPulse 1s ease-in-out infinite;
}

@keyframes aiPulse {
  0%, 100% {
    opacity: 0.35;
    transform: scale(0.82);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 38;
  background: rgba(31, 41, 55, 0.22);
}

.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  box-sizing: border-box;
  max-height: 72vh;
  padding: 12rpx 18rpx calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 48rpx rgba(31, 41, 55, 0.16);
}

.sheet-handle {
  width: 58rpx;
  height: 6rpx;
  margin: 0 auto 14rpx;
  border-radius: 999rpx;
  background: #d9e0ea;
}

.task-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
  margin-bottom: 12rpx;
}

.panel-title-wrap {
  flex: 1;
  min-width: 0;
}

.task-panel-title {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.task-panel-subtitle {
  overflow: hidden;
  margin-top: 5rpx;
  color: #7a8494;
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-close {
  flex: 0 0 auto;
  width: 78rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #f3f5f7;
  color: #596579;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}

.task-section-scroll {
  box-sizing: border-box;
  max-height: calc(72vh - 124rpx - env(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.task-section {
  margin-bottom: 16rpx;
}

.task-section:last-child {
  margin-bottom: 0;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
}

.task-section-title {
  margin: 4rpx 2rpx 8rpx;
  color: #8a4b4b;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.25;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  min-height: 82rpx;
  margin-top: 8rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  text-align: left;
}

.task-icon {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: #fff1ef;
  color: #c62828;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: center;
}

.task-copy {
  flex: 1;
  min-width: 0;
}

.task-label,
.task-desc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-label {
  color: #1f2937;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.25;
}

.task-desc {
  margin-top: 5rpx;
  color: #6b7280;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.25;
}

.privacy-sheet {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.privacy-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.privacy-copy {
  flex: 1;
  min-width: 0;
}

.privacy-title {
  color: #1f2937;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
}

.privacy-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 7rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.privacy-switch {
  flex: 0 0 auto;
  transform: scale(0.82);
  transform-origin: right center;
}

.privacy-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 16rpx;
  color: #667085;
  font-size: 20rpx;
  font-weight: 800;
}

.privacy-footer text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.privacy-btn {
  flex: 0 0 auto;
  height: 46rpx;
  min-width: 98rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-align: center;
}

.privacy-btn.secondary {
  background: #f1f3f6;
  color: #4b5563;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  box-sizing: border-box;
  padding: 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(229, 234, 241, 0.92);
  background: rgba(255, 250, 248, 0.98);
  box-shadow: 0 -14rpx 40rpx rgba(31, 41, 55, 0.08);
}

.composer-inner {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.composer-input {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  max-height: 154rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 18rpx;
  background: #ffffff;
  color: #1f2937;
  font-size: 24rpx;
  line-height: 1.45;
}

.composer-placeholder {
  color: #a5adba;
}

.send-btn {
  flex: 0 0 auto;
  width: 112rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
}

.send-btn.disabled {
  background: #d1d7e0;
  color: #64748b;
}

.composer-note {
  display: block;
  width: 100%;
  height: 32rpx;
  overflow: hidden;
  margin-top: 6rpx;
  color: #7a8494;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (max-width: 360px) {
  .ai-page {
    padding-left: 12rpx;
    padding-right: 12rpx;
  }

  .quick-action-pill {
    width: 154rpx;
  }

  .quick-action-label {
    max-width: 86rpx;
  }

  .message-row.user .message-body {
    max-width: 84%;
  }

  .send-btn {
    width: 104rpx;
  }
}
