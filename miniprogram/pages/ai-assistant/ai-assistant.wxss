.ai-page {
  box-sizing: border-box;
  display: flex;
  min-height: 100vh;
  height: 100vh;
  flex-direction: column;
  overflow: hidden;
  padding: 16rpx 16rpx 210rpx;
  background: #f5f7fb;
}

.assistant-hero {
  flex: 0 0 auto;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e7edf5;
  box-shadow: 0 12rpx 32rpx rgba(17, 24, 39, 0.06);
}

.hero-top {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.hero-logo-wrap {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(198, 40, 40, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.hero-logo,
.hero-mark {
  flex: 0 0 auto;
  width: 68rpx;
  height: 68rpx;
  border-radius: 16rpx;
}

.hero-mark {
  background: #c62828;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.hero-title {
  overflow: hidden;
  color: #142033;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.22;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 5rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hero-clear-mini {
  flex: 0 0 auto;
  width: 88rpx;
  max-width: 96rpx;
  height: 48rpx;
  padding: 0;
  border: 1rpx solid #dfe6f0;
  border-radius: 12rpx;
  background: #ffffff;
  color: #596579;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.hero-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.hero-status-chip {
  box-sizing: border-box;
  max-width: 220rpx;
  min-height: 36rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #36506c;
  background: #eef3f9;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.provider-status-chip {
  color: #155e3b;
  background: #eaf7ef;
}

.grounded-chip {
  color: #2254a5;
  background: #edf4ff;
}

.data-source-chip {
  color: #8a4b12;
  background: #fff7e8;
}

.ability-chip {
  max-width: 100%;
  color: #5b456a;
  background: #f3eff8;
}

.demo-chip {
  color: #8f2d22;
  background: #fff0ea;
}

.privacy-tip {
  flex: 0 0 auto;
  margin-top: 10rpx;
  border-color: #ecded3;
}

.privacy-tip-full {
  padding: 16rpx 18rpx;
  background: #fffaf5;
}

.privacy-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.privacy-copy {
  flex: 1;
  min-width: 0;
}

.privacy-title {
  color: #8f2d22;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
}

.privacy-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: #5f6b7c;
  font-size: 21rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.privacy-switch {
  flex: 0 0 auto;
  transform: scale(0.78);
  transform-origin: right center;
}

.privacy-switch.compact {
  transform: scale(0.72);
}

.privacy-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 10rpx;
  color: #8a4b37;
  font-size: 20rpx;
  font-weight: 800;
}

.privacy-btn {
  flex: 0 0 auto;
  height: 44rpx;
  min-width: 104rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.privacy-btn.secondary {
  background: #edf2f7;
  color: #4b5563;
}

.privacy-compact {
  flex: 0 0 auto;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 56rpx;
  max-height: 64rpx;
  margin-top: 10rpx;
  padding: 8rpx 12rpx 8rpx 16rpx;
  border: 1rpx solid #e4e9f1;
  border-radius: 12rpx;
}

.privacy-compact.disabled {
  background: #f7f4ef;
}

.privacy-compact.enabled {
  background: #f0fbf4;
  border-color: #cdebd6;
}

.privacy-compact-main {
  display: flex;
  align-items: center;
  min-width: 0;
  gap: 8rpx;
}

.privacy-dot {
  flex: 0 0 auto;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #a0aec0;
}

.privacy-compact.enabled .privacy-dot {
  background: #2f855a;
}

.privacy-compact-text {
  overflow: hidden;
  color: #4b5563;
  font-size: 21rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.privacy-compact-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.privacy-link {
  width: 70rpx;
  height: 42rpx;
  padding: 0;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #596579;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.quick-scroll {
  flex: 0 0 auto;
  width: 100%;
  margin-top: 10rpx;
  white-space: nowrap;
}

.quick-list {
  display: inline-flex;
  gap: 10rpx;
  padding: 2rpx 4rpx 5rpx;
  vertical-align: top;
}

.quick-chip {
  flex: 0 0 auto;
  height: 52rpx;
  padding: 0 18rpx;
  border: 1rpx solid #ecd2d2;
  border-radius: 12rpx;
  background: #ffffff;
  color: #9f1f25;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
  white-space: nowrap;
  box-shadow: 0 7rpx 18rpx rgba(90, 27, 31, 0.04);
}

.task-panel {
  flex: 0 0 auto;
  margin-top: 8rpx;
  padding: 14rpx;
  border: 1rpx solid #e7edf5;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(18, 27, 43, 0.05);
}

.task-panel-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.task-panel-title {
  flex: 0 0 auto;
  color: #142033;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.task-panel-subtitle {
  flex: 1;
  overflow: hidden;
  color: #778297;
  font-size: 19rpx;
  font-weight: 700;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.task-item {
  box-sizing: border-box;
  min-width: 0;
  height: 84rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 12rpx;
  background: #f8fafc;
  text-align: left;
}

.task-label {
  overflow: hidden;
  color: #9f1f25;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-desc {
  overflow: hidden;
  margin-top: 5rpx;
  color: #667085;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 10rpx;
  padding-bottom: 28rpx;
}

.empty-welcome {
  padding: 34rpx 24rpx 48rpx;
  text-align: center;
}

.empty-orbit {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
}

.empty-logo,
.empty-logo-text {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(18, 27, 43, 0.08);
}

.empty-logo-text {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c62828;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-title {
  color: #142033;
  font-size: 29rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 10rpx;
  color: #778297;
  font-size: 23rpx;
  line-height: 1.5;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.assistant-avatar {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf4;
  color: #c62828;
  font-size: 18rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(18, 27, 43, 0.06);
}

.avatar-logo {
  width: 42rpx;
  height: 42rpx;
}

.message-body {
  min-width: 0;
}

.message-row.assistant .message-body {
  width: calc(100% - 64rpx);
  max-width: calc(100% - 64rpx);
}

.message-row.user .message-body {
  display: flex;
  max-width: 78%;
  flex-direction: column;
  align-items: flex-end;
}

.message-bubble {
  box-sizing: border-box;
  max-width: 100%;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e8edf4;
  box-shadow: 0 10rpx 26rpx rgba(18, 27, 43, 0.05);
}

.message-row.assistant .message-bubble {
  border-top-left-radius: 8rpx;
}

.message-row.user .message-bubble {
  border-top-right-radius: 8rpx;
  background: #c62828;
  border-color: #c62828;
  color: #ffffff;
}

.message-content {
  color: #142033;
  font-size: 25rpx;
  line-height: 1.56;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-row.user .message-content {
  color: #ffffff;
}

.message-meta {
  margin-top: 7rpx;
  color: #98a2b3;
  font-size: 19rpx;
}

.message-row.user .message-meta {
  color: rgba(255, 255, 255, 0.78);
}

.tool-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 9rpx 2rpx 0;
}

.tool-chip {
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #edf4ff;
  color: #2d5db3;
  font-size: 18rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
}

.tool-chip.failed {
  background: #fff1f1;
  color: #c62828;
}

.tool-chip.skipped {
  background: #eef2f6;
  color: #667085;
}

.tool-chip.running {
  background: #fff7e8;
  color: #b45309;
}

.ai-card-list {
  width: 100%;
  margin-top: 10rpx;
}

.ai-result-card {
  margin-top: 10rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  border-color: #e8edf4;
  box-shadow: 0 9rpx 24rpx rgba(18, 27, 43, 0.05);
}

.card-type-empty-room {
  border-color: #f0c9c9;
}

.card-type-schedule {
  border-color: #c8dcf6;
}

.card-type-diagnosis {
  border-color: #dce3ec;
}

.card-type-guide {
  border-color: #d8d0ea;
}

.card-header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.card-title-block {
  min-width: 0;
  flex: 1;
}

.card-title {
  display: -webkit-box;
  overflow: hidden;
  color: #142033;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.32;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-subtitle {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 5rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-type {
  flex: 0 0 auto;
  box-sizing: border-box;
  max-width: 96rpx;
  padding: 6rpx 9rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f3f6fa;
  color: #64748b;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 12rpx;
}

.badge {
  min-height: 32rpx;
  padding: 3rpx 9rpx;
  border-radius: 8rpx;
  background: #fff2f2;
  color: #a5242b;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.25;
}

.card-items {
  margin-top: 12rpx;
  border-top: 1rpx solid #edf0f5;
}

.card-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.card-item:last-child {
  border-bottom: 0;
}

.item-main {
  min-width: 0;
  flex: 1;
}

.item-title {
  overflow: hidden;
  color: #142033;
  font-size: 24rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-subtitle {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 4rpx;
  color: #778297;
  font-size: 20rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.item-value {
  flex: 0 0 auto;
  max-width: 178rpx;
  color: #c62828;
  font-size: 21rpx;
  font-weight: 900;
  text-align: right;
  line-height: 1.25;
  word-break: break-word;
}

.card-overflow {
  padding: 12rpx 0 2rpx;
  color: #5d6b82;
  font-size: 20rpx;
  font-weight: 800;
  text-align: center;
}

.card-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.card-actions.one-action .card-action {
  width: 100%;
}

.card-actions.two-actions .card-action {
  flex: 1;
}

.card-action {
  min-width: 0;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.secondary-action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.secondary-action {
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #eef2f6;
  color: #4b5563;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 46rpx;
}

.card-disclaimer {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #e1e7ef;
  color: #98a2b3;
  font-size: 19rpx;
  line-height: 1.35;
}

.suggestion-row {
  display: flex;
  flex-wrap: wrap;
  gap: 9rpx;
  margin-top: 10rpx;
}

.suggestion-chip {
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #eef2f6;
  color: #4b5563;
  font-size: 21rpx;
  font-weight: 800;
}

.slow-tip {
  margin: 10rpx 0 18rpx 64rpx;
  padding: 15rpx 18rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #b45309;
  font-size: 21rpx;
  line-height: 1.45;
}

.sending-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 0 18rpx 64rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 700;
}

.sending-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c62828;
  animation: aiPulse 1s ease-in-out infinite;
}

@keyframes aiPulse {
  0%, 100% {
    opacity: 0.35;
    transform: scale(0.82);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  box-sizing: border-box;
  padding: 14rpx 16rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(245, 247, 251, 0.97);
  border-top: 1rpx solid #e1e7ef;
  box-shadow: 0 -16rpx 44rpx rgba(18, 27, 43, 0.08);
}

.composer-inner {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.composer-input {
  flex: 1;
  min-width: 0;
  height: 74rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 16rpx;
  background: #ffffff;
  color: #142033;
  font-size: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(18, 27, 43, 0.04);
}

.composer-placeholder {
  color: #a5adba;
}

.send-btn {
  flex: 0 0 auto;
  width: 116rpx;
  max-width: 120rpx;
  height: 74rpx;
  border-radius: 16rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 74rpx;
}

.send-btn.disabled {
  background: #cbd5e1;
  color: #64748b;
}

.composer-note {
  margin-top: 7rpx;
  color: #7a8494;
  font-size: 19rpx;
  font-weight: 700;
  text-align: center;
}
