.ai-page {
  box-sizing: border-box;
  display: flex;
  height: 100vh;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  padding: calc(14rpx + env(safe-area-inset-top)) 16rpx 218rpx;
  padding-bottom: 218rpx;
  background: linear-gradient(180deg, #f7f8fb 0%, #fff7f5 56%, #f8fafc 100%);
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: inherit;
}

button::after {
  border: 0;
}

.card {
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #ffffff;
}

.xiaofu-header {
  box-sizing: border-box;
  position: relative;
  z-index: 30;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 12rpx;
  height: 84rpx;
  min-height: 84rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.86);
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(255, 242, 239, 0.86));
  box-shadow: 0 10rpx 30rpx rgba(142, 36, 36, 0.08);
}

.xiaofu-avatar-wrap {
  flex: 0 0 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(198, 40, 40, 0.12);
}

.xiaofu-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
}

.xiaofu-avatar-text {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.xiaofu-title-block {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
  overflow: hidden;
}

.xiaofu-title-line {
  display: flex;
  align-items: center;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  line-height: 1;
}

.xiaofu-capability {
  max-width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  color: #667085;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xiaofu-title {
  flex: 0 0 auto;
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.xiaofu-dot {
  flex: 0 0 auto;
  padding: 0 6rpx;
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.xiaofu-status {
  display: inline-flex;
  align-items: center;
  flex: 0 1 auto;
  gap: 6rpx;
  min-width: 0;
  overflow: hidden;
  color: #2f6f4e;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.xiaofu-status::before {
  content: "";
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #2f6f4e;
}

.xiaofu-actions {
  flex: 0 0 110rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  width: 110rpx;
  min-width: 110rpx;
}

.xiaofu-icon-btn {
  flex: 0 0 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  min-width: 52rpx;
  max-width: 52rpx;
  min-height: 52rpx;
  padding: 0;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #374151;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
}

.ai-mode-row {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  margin-top: 12rpx;
  padding: 0 8rpx;
}

.quick-action-scroll {
  flex: 0 0 auto;
  width: 100%;
  min-width: 0;
  height: 60rpx;
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
}

.quick-action-list {
  display: inline-flex;
  gap: 8rpx;
  padding: 1rpx 10rpx 5rpx 2rpx;
}

.quick-action-pill {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 156rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #374151;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 52rpx;
  box-shadow: 0 6rpx 18rpx rgba(31, 41, 55, 0.05);
}

.quick-action-pill.today {
  color: #1f5f8b;
}

.quick-action-pill.room {
  color: #2f6f4e;
}

.quick-action-pill.classroom {
  color: #7a4f28;
}

.quick-action-pill.teacher {
  color: #8a4b4b;
}

.quick-action-pill.xls {
  color: #6b4d16;
}

.quick-action-icon {
  flex: 0 0 auto;
  width: 31rpx;
  height: 31rpx;
}

.quick-action-label {
  max-width: 94rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-nav-segment {
  box-sizing: border-box;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 186rpx;
  max-width: 60vw;
  height: 42rpx;
  padding: 3rpx;
  overflow: hidden;
  border: 1rpx solid rgba(214, 222, 232, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 4rpx 12rpx rgba(31, 41, 55, 0.035);
}

.quick-nav-option {
  box-sizing: border-box;
  flex: 1 1 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: 34rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #5f6b7c;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-align: center;
  box-shadow: none;
}

.quick-nav-option.active {
  background: #f2faf5;
  color: #2f6f4e;
  box-shadow: 0 3rpx 10rpx rgba(47, 111, 78, 0.08);
}

.quick-nav-option text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-trim-tip {
  flex: 0 0 auto;
  margin: 6rpx 4rpx 0;
  color: #8a6f64;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.message-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 10rpx;
  padding: 4rpx 0 28rpx;
}

.message-bottom-anchor {
  width: 1rpx;
  height: 20rpx;
}

.empty-welcome {
  box-sizing: border-box;
  max-height: none;
  margin: 8rpx 2rpx 18rpx;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 36rpx rgba(31, 41, 55, 0.08);
}

.empty-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.empty-desc {
  margin-top: 10rpx;
  color: #667085;
  font-size: 23rpx;
  line-height: 1.45;
}

.empty-example-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
}

.empty-example {
  width: 100%;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  background: #f7f8fb;
  color: #374151;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: left;
}

.empty-safe-note {
  margin-top: 14rpx;
  color: #98a2b3;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.3;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-bottom: 22rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.assistant-avatar,
.assistant-avatar-spacer {
  flex: 0 0 auto;
  width: 46rpx;
  height: 46rpx;
}

.assistant-avatar {
  border-radius: 14rpx;
  background: #ffffff;
  color: #c62828;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(31, 41, 55, 0.07);
}

.assistant-avatar-spacer {
  opacity: 0;
}

.avatar-logo {
  width: 38rpx;
  height: 38rpx;
  margin: 4rpx;
  border-radius: 12rpx;
}

.message-body {
  min-width: 0;
}

.message-row.assistant .message-body {
  width: calc(100% - 56rpx);
  max-width: calc(100% - 56rpx);
}

.message-row.user .message-body {
  display: flex;
  max-width: 78%;
  flex-direction: column;
  align-items: flex-end;
}

.message-bubble {
  box-sizing: border-box;
  max-width: 100%;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(31, 41, 55, 0.07);
}

.message-row.assistant .message-bubble {
  border: 1rpx solid rgba(231, 237, 245, 0.92);
  border-top-left-radius: 8rpx;
}

.message-row.user .message-bubble {
  border-top-right-radius: 8rpx;
  background: #c62828;
  box-shadow: 0 10rpx 24rpx rgba(198, 40, 40, 0.22);
}

.message-content {
  color: #1f2937;
  font-size: 25rpx;
  line-height: 1.58;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-row.user .message-content {
  color: #ffffff;
}

.message-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 7rpx;
  color: #98a2b3;
  font-size: 18rpx;
  line-height: 1.35;
}

.message-meta-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-row.user .message-meta {
  color: rgba(255, 255, 255, 0.78);
}

.message-copy-btn {
  flex: 0 0 auto;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #f4f6f8;
  color: #667085;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 34rpx;
  text-align: center;
}

.tool-strip {
  display: flex;
  flex-wrap: nowrap;
  gap: 7rpx;
  margin: 8rpx 2rpx 0;
  overflow: hidden;
}

.tool-chip {
  max-width: 100%;
  height: 30rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #eef7ff;
  color: #25658f;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 30rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-chip.success {
  background: #edf8f1;
  color: #2f6f4e;
}

.tool-chip.failed {
  background: #fff1f1;
  color: #c62828;
}

.tool-chip.skipped {
  background: #f2f4f7;
  color: #667085;
}

.tool-chip.running {
  background: #fff7e8;
  color: #9a5b08;
}

.evidence-strip {
  margin: 8rpx 2rpx 0;
  max-width: 92%;
  overflow: hidden;
  color: #6b7280;
  font-size: 21rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-card-list {
  width: 100%;
  margin-top: 10rpx;
}

.ai-result-card {
  margin-top: 10rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(231, 237, 245, 0.96);
  box-shadow: 0 12rpx 32rpx rgba(31, 41, 55, 0.08);
}

.ai-result-card.card-error {
  border-color: #fde2e2;
  background: #fffafa;
}

.card-header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.card-title-block {
  min-width: 0;
  flex: 1;
}

.card-title {
  display: -webkit-box;
  overflow: hidden;
  color: #1f2937;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.32;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-subtitle {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 21rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-type {
  flex: 0 0 auto;
  max-width: 112rpx;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f4f6f8;
  color: #6b7280;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 7rpx;
  margin-top: 12rpx;
}

.badge {
  max-width: 190rpx;
  min-height: 30rpx;
  padding: 3rpx 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f2f7ff;
  color: #356b93;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-items {
  margin-top: 12rpx;
  border-top: 1rpx solid #edf0f5;
}

.card-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-height: 62rpx;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.card-item:last-child {
  border-bottom: 0;
}

.item-main {
  min-width: 0;
  flex: 1;
}

.item-title {
  overflow: hidden;
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-type-empty-room .item-title {
  font-size: 26rpx;
}

.item-subtitle {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 5rpx;
  color: #7a8494;
  font-size: 20rpx;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.item-value {
  flex: 0 0 auto;
  max-width: 172rpx;
  overflow: hidden;
  color: #4b5563;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-type-empty-room .item-value {
  color: #c62828;
}

.card-overflow {
  width: 100%;
  height: 46rpx;
  margin-top: 8rpx;
  border-radius: 12rpx;
  background: #f4f6f8;
  color: #5f6b7c;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-align: center;
}

.card-overflow.expanded {
  background: #eef2f6;
  color: #374151;
}

.card-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
}

.card-actions.one-action .card-action-primary {
  width: 100%;
}

.card-actions.two-actions .card-action-primary {
  flex: 1;
}

.card-action-primary {
  min-width: 0;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #c62828;
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-type-school-knowledge .card-action-primary,
.card-type-navigation .card-action-primary,
.card-type-schedule-candidate .card-action-primary,
.card-type-schedule-status .card-action-primary,
.card-type-guide .card-action-primary {
  background: #eef6f1;
  color: #2f6f4e;
}

.secondary-action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.card-action-secondary {
  width: auto;
  max-width: 240rpx;
  height: 46rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f1f3f6;
  color: #4b5563;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 46rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filtered-hint {
  margin-top: 10rpx;
  color: #98a2b3;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
}

.card-disclaimer {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed #e5eaf1;
  color: #98a2b3;
  font-size: 17rpx;
  line-height: 1.35;
}

.weather-card {
  position: relative;
  overflow: hidden;
  padding: 18rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fffafa 0%, #ffffff 54%, #eef8f2 100%);
  border: 1rpx solid rgba(231, 237, 245, 0.96);
}

.weather-card-head,
.weather-main,
.weather-metrics,
.weather-timeline {
  position: relative;
  z-index: 1;
}

.weather-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.weather-campus {
  color: #1f2937;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.25;
}

.weather-status,
.weather-updated {
  margin-top: 5rpx;
  color: #667085;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.35;
}

.weather-updated {
  max-width: 248rpx;
  margin-top: 0;
  text-align: right;
}

.weather-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
}

.weather-temp {
  color: #172033;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
}

.weather-temp.missing {
  max-width: 210rpx;
  font-size: 30rpx;
  line-height: 1.25;
}

.weather-temp text {
  font-size: 30rpx;
}

.weather-facts {
  flex: 1;
  min-width: 0;
  color: #536174;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.6;
}

.weather-icon {
  position: relative;
  flex: 0 0 auto;
  width: 88rpx;
  height: 74rpx;
}

.sun-core {
  position: absolute;
  right: 14rpx;
  top: 10rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(245, 158, 11, 0.25);
  animation: weatherBreath 3.8s ease-in-out infinite;
}

.cloud {
  position: absolute;
  display: none;
  height: 28rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.55);
}

.cloud-a {
  left: 8rpx;
  top: 26rpx;
  width: 64rpx;
  animation: weatherCloud 4.8s ease-in-out infinite;
}

.cloud-b {
  left: 28rpx;
  top: 12rpx;
  width: 44rpx;
  opacity: 0.72;
  animation: weatherCloud 5.6s ease-in-out infinite reverse;
}

.drop {
  position: absolute;
  display: none;
  top: 46rpx;
  width: 6rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.5);
  animation: weatherDrop 1.8s ease-in-out infinite;
}

.drop-a { left: 30rpx; }
.drop-b { left: 48rpx; animation-delay: 0.2s; }
.drop-c { left: 66rpx; animation-delay: 0.4s; }

.card-weather-cloud .sun-core {
  opacity: 0.4;
}

.card-weather-cloud .cloud,
.card-weather-rain .cloud,
.card-weather-rain .drop {
  display: block;
}

.card-weather-rain .sun-core {
  display: none;
}

.weather-metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 18rpx;
}

.weather-metric {
  min-width: 0;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.7);
  text-align: center;
}

.weather-metric text {
  color: #7a8494;
  font-size: 18rpx;
  font-weight: 800;
}

.weather-metric view {
  margin-top: 6rpx;
  color: #172033;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

.weather-timeline {
  display: flex;
  gap: 8rpx;
  margin-top: 14rpx;
  overflow: hidden;
}

.weather-hour {
  flex: 1;
  min-width: 0;
  padding: 10rpx 6rpx;
  border-radius: 10rpx;
  background: rgba(248, 250, 252, 0.9);
  color: #536174;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.weather-hour text {
  display: block;
  margin-top: 4rpx;
}

.weather-advice {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(203, 213, 225, 0.9);
  color: #4b5563;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.45;
}

.weather-source {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  color: #8a94a6;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.35;
}

@keyframes weatherBreath {
  0%, 100% { opacity: 0.45; transform: scale(0.92); }
  50% { opacity: 0.8; transform: scale(1.08); }
}

@keyframes weatherCloud {
  0%, 100% { transform: translateX(-4rpx); }
  50% { transform: translateX(5rpx); }
}

@keyframes weatherDrop {
  0% { opacity: 0; transform: translateY(-8rpx); }
  45% { opacity: 0.8; }
  100% { opacity: 0; transform: translateY(14rpx); }
}

.suggestion-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.suggestion-chip {
  width: auto;
  max-width: 300rpx;
  min-height: 46rpx;
  padding: 0 15rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.9);
  color: #4b5563;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 46rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow: 0 6rpx 18rpx rgba(31, 41, 55, 0.06);
}

.slow-tip {
  margin: 10rpx 0 18rpx 56rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  background: #fff7ed;
  color: #9a5b08;
  font-size: 21rpx;
  line-height: 1.45;
}

.sending-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 12rpx 0 18rpx 56rpx;
  color: #667085;
  font-size: 22rpx;
  font-weight: 700;
}

.sending-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c62828;
  animation: aiPulse 1s ease-in-out infinite;
}

@keyframes aiPulse {
  0%, 100% {
    opacity: 0.35;
    transform: scale(0.82);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 38;
  background: rgba(31, 41, 55, 0.22);
}

.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  box-sizing: border-box;
  max-height: 72vh;
  padding: 12rpx 18rpx calc(18rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 48rpx rgba(31, 41, 55, 0.16);
}

.sheet-handle {
  width: 58rpx;
  height: 6rpx;
  margin: 0 auto 14rpx;
  border-radius: 999rpx;
  background: #d9e0ea;
}

.task-panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
  margin-bottom: 12rpx;
}

.panel-title-wrap {
  flex: 1;
  min-width: 0;
}

.task-panel-title {
  color: #1f2937;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.task-panel-subtitle {
  overflow: hidden;
  margin-top: 5rpx;
  color: #7a8494;
  font-size: 20rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-close {
  flex: 0 0 auto;
  width: 78rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #f3f5f7;
  color: #596579;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 44rpx;
  text-align: center;
}

.task-section-scroll {
  box-sizing: border-box;
  max-height: calc(72vh - 124rpx - env(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.task-section {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.task-section:last-child {
  margin-bottom: 0;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
}

.task-section-title {
  grid-column: 1 / -1;
  margin: 6rpx 2rpx 0;
  color: #8a4b4b;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.25;
}

.task-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  width: 100%;
  min-height: 108rpx;
  margin-top: 0;
  padding: 14rpx 12rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  text-align: left;
}

.task-icon {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
}

.task-copy {
  flex: 1;
  min-width: 0;
}

.task-label,
.task-desc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-label {
  color: #1f2937;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.25;
}

.task-desc {
  margin-top: 5rpx;
  color: #6b7280;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.25;
}

.task-section-loading {
  height: 220rpx;
  color: #8a94a6;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 220rpx;
  text-align: center;
}

.header-menu-sheet {
  max-height: 36vh;
}

.conversation-sheet {
  max-height: 78vh;
}

.conversation-new-btn {
  width: 100%;
  height: 66rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  background: #2f6f4e;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 66rpx;
  text-align: center;
}

.conversation-scroll {
  box-sizing: border-box;
  max-height: calc(78vh - 206rpx - env(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.conversation-item {
  position: relative;
  display: flex;
  align-items: stretch;
  gap: 10rpx;
  width: 100%;
  min-height: 108rpx;
  margin-bottom: 10rpx;
  padding: 12rpx;
  border: 1rpx solid #edf1f5;
  border-radius: 16rpx;
  background: #f8fafc;
}

.conversation-item.active {
  border-color: rgba(47, 111, 78, 0.25);
  background: #f1f8f4;
}

.conversation-item.active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 6rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #2f6f4e;
}

.conversation-main {
  flex: 1;
  min-width: 0;
  padding-left: 4rpx;
  text-align: left;
}

.conversation-title {
  overflow: hidden;
  color: #1f2937;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-meta {
  margin-top: 8rpx;
  overflow: hidden;
  color: #7a8494;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-actions {
  flex: 0 0 132rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: 132rpx;
}

.conversation-actions button {
  width: 132rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #eef2f6;
  color: #566174;
  font-size: 17rpx;
  font-weight: 800;
  line-height: 28rpx;
  text-align: center;
}

.conversation-actions .danger {
  background: #f8fafc;
  color: #9b2c2c;
}

.header-menu-item {
  width: 100%;
  height: 72rpx;
  margin-top: 10rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  color: #374151;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
}

.header-menu-item.float-toggle {
  height: 92rpx;
  padding: 12rpx 18rpx;
  line-height: 1.25;
  text-align: left;
}

.header-menu-item.float-toggle.warning {
  background: #fff8ed;
  color: #a15c00;
}

.header-menu-title {
  color: inherit;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.35;
}

.header-menu-desc {
  margin-top: 4rpx;
  color: #7a8494;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.3;
}

.header-menu-item.danger {
  background: #fff1f1;
  color: #c62828;
}

.capability-sheet {
  max-height: 76vh;
}

.capability-scroll {
  box-sizing: border-box;
  max-height: calc(76vh - 124rpx - env(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.capability-section {
  margin-bottom: 20rpx;
}

.capability-title {
  margin: 0 2rpx 10rpx;
  color: #8a4b4b;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.25;
}

.capability-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.capability-chip {
  max-width: 100%;
  min-height: 54rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  color: #374151;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-align: left;
}

.capability-map-btn {
  width: 100%;
  height: 68rpx;
  margin-top: 4rpx;
  border-radius: 14rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 68rpx;
  text-align: center;
}

.privacy-sheet {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.privacy-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.privacy-copy {
  flex: 1;
  min-width: 0;
}

.privacy-title {
  color: #1f2937;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
}

.privacy-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 7rpx;
  color: #667085;
  font-size: 21rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}

.privacy-switch {
  flex: 0 0 auto;
  transform: scale(0.82);
  transform-origin: right center;
}

.privacy-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 16rpx;
  color: #667085;
  font-size: 20rpx;
  font-weight: 800;
}

.privacy-footer text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.privacy-btn {
  flex: 0 0 auto;
  height: 46rpx;
  min-width: 98rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-align: center;
}

.privacy-btn.secondary {
  background: #f1f3f6;
  color: #4b5563;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  box-sizing: border-box;
  padding: 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(229, 234, 241, 0.92);
  background: rgba(255, 250, 248, 0.98);
  box-shadow: 0 -14rpx 40rpx rgba(31, 41, 55, 0.08);
}

.composer-inner {
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.voice-btn,
.newline-btn {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #dbe3ee;
  color: #334155;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
}

.voice-btn.recording {
  background: #fee2e2;
  border-color: #ef4444;
  color: #b91c1c;
}

.voice-btn.disabled,
.newline-btn[disabled] {
  background: #eef2f7;
  color: #94a3b8;
}

.composer-input-wrap {
  position: relative;
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  max-height: 154rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 18rpx;
  background: #ffffff;
}

.composer-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  max-height: 154rpx;
  padding: 17rpx 18rpx;
  border: 0;
  border-radius: 18rpx;
  background: transparent;
  color: #1f2937;
  font-size: 24rpx;
  line-height: 1.45;
}

.composer-custom-placeholder {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 50%;
  z-index: 1;
  overflow: hidden;
  color: #a5adba;
  font-size: 24rpx;
  line-height: 1.2;
  pointer-events: none;
  text-overflow: ellipsis;
  transform: translateY(-50%);
  white-space: nowrap;
}

.composer-placeholder {
  color: #a5adba;
}

.voice-status {
  height: 30rpx;
  margin-top: 6rpx;
  color: #64748b;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}

.send-btn {
  flex: 0 0 auto;
  width: 112rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
}

.send-btn.disabled {
  background: #d1d7e0;
  color: #64748b;
}

.composer-note {
  display: block;
  width: 100%;
  height: 32rpx;
  overflow: hidden;
  margin-top: 6rpx;
  color: #7a8494;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 32rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (max-width: 360px) {
  .ai-page {
    padding-left: 12rpx;
    padding-right: 12rpx;
  }

  .quick-action-pill {
    width: 154rpx;
  }

  .xiaofu-header {
    gap: 8rpx;
    padding-left: 10rpx;
    padding-right: 10rpx;
  }

  .xiaofu-avatar-wrap {
    width: 52rpx;
    height: 52rpx;
  }

  .xiaofu-title {
    font-size: 28rpx;
  }

  .xiaofu-status {
    font-size: 21rpx;
  }

  .xiaofu-actions {
    flex-basis: 104rpx;
    width: 104rpx;
    min-width: 104rpx;
    gap: 4rpx;
  }

  .xiaofu-icon-btn {
    flex-basis: 50rpx;
    width: 50rpx;
    height: 50rpx;
    min-width: 50rpx;
    max-width: 50rpx;
    min-height: 50rpx;
    line-height: 50rpx;
  }

  .quick-action-label {
    max-width: 86rpx;
  }

  .message-row.user .message-body {
    max-width: 84%;
  }

  .send-btn {
    width: 104rpx;
  }
}
