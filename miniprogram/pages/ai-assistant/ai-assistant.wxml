<view class="page ai-page">
  <!-- Compact status bar: system nav already shows 小佛助手; avoid repeating large title -->
  <view class="xiaofu-header xiaofu-header-compact">
    <view class="xiaofu-avatar-wrap">
      <image wx:if="{{hasHeroLogo}}" class="xiaofu-avatar" src="/assets/icons/ai-campus-butler.png" mode="aspectFit" binderror="onHeroLogoError" />
      <view wx:else class="xiaofu-avatar-text">佛</view>
    </view>
    <view class="xiaofu-title-block">
      <!-- Visually compact: conversation title is primary; product name stays for a11y/tests without large duplicate branding -->
      <view class="xiaofu-title-line xiaofu-title-sr">
        <text class="xiaofu-title">小佛助手</text>
      </view>
      <view class="xiaofu-conversation-sub xiaofu-conversation-primary">{{activeConversationTitle || conversationTitle || '新对话'}}</view>
      <view class="xiaofu-chip-row">
        <text wx:for="{{statusChips}}" wx:key="*this" class="xiaofu-chip status-{{connectionStatusClass}}">{{item}}</text>
        <text class="xiaofu-chip soft" wx:if="{{memoryChipText}}">{{memoryChipText}}</text>
      </view>
    </view>
    <view class="xiaofu-actions">
      <button class="xiaofu-icon-btn" bindtap="openConversationSheet" aria-label="对话列表">对话</button>
      <button class="xiaofu-icon-btn" bindtap="openCapabilityGuide" aria-label="小佛助手说明">?</button>
      <button class="xiaofu-icon-btn" bindtap="openHeaderMenu" aria-label="更多操作">⋯</button>
    </view>
  </view>

  <view class="ai-mode-row ai-mode-row-slim">
    <view class="quick-nav-segment" aria-label="任务入口">
      <view class="quick-nav-option quick-more-button" bindtap="openTaskPanel"><text>任务工具</text></view>
    </view>
  </view>

  <scroll-view class="quick-action-scroll" scroll-x enhanced enable-flex="{{true}}" scroll-with-animation="{{false}}" show-scrollbar="{{false}}">
    <view class="quick-action-list">
      <button
        wx:for="{{quickActions}}"
        wx:key="id"
        class="quick-action-pill {{item.className}}"
        data-action-id="{{item.id}}"
        bindtap="onQuickAction"
      >
        <image class="quick-action-icon" src="{{item.iconPath}}" mode="aspectFit" />
        <text class="quick-action-label">{{item.label}}</text>
      </button>
    </view>
  </scroll-view>

  <view class="history-trim-tip" wx:if="{{historyTrimNotice}}">已仅保留最近 20 条</view>

  <scroll-view class="message-scroll" scroll-y scroll-top="{{scrollTop}}" scroll-into-view="{{scrollIntoView}}" scroll-with-animation="{{scrollWithAnimation}}" scroll-anchoring="{{true}}" enhanced show-scrollbar="{{false}}" lower-threshold="80">
    <view class="empty-welcome" wx:if="{{!messages.length}}">
      <view class="empty-title">今天想让小佛帮你完成什么？</view>
      <view class="empty-desc">选一个校园任务，小佛会调用权威工具给出可核验结果。</view>
      <view class="task-card-grid">
        <button
          wx:for="{{welcomeTaskCards}}"
          wx:key="id"
          class="task-entry-card"
          data-question="{{item.question}}"
          bindtap="onWelcomeExampleTap"
        >
          <view class="task-entry-title">{{item.title}}</view>
          <view class="task-entry-desc">{{item.desc}}</view>
        </button>
      </view>
      <view class="empty-safe-note">请勿输入学号、密码、验证码等敏感信息。</view>
    </view>

    <view
      wx:for="{{messages}}"
      wx:for-item="message"
      wx:for-index="messageIndex"
      wx:key="id"
      class="message-row {{message.role}} {{message.showAvatar ? '' : 'no-avatar'}}"
    >
      <view wx:if="{{message.role == 'assistant' && message.showAvatar}}" class="assistant-avatar">
        <image wx:if="{{hasHeroLogo}}" class="avatar-logo" src="/assets/icons/ai-campus-butler.png" mode="aspectFit" />
        <text wx:else>佛</text>
      </view>
      <view wx:elif="{{message.role == 'assistant'}}" class="assistant-avatar-spacer"></view>

      <view class="message-body">
        <view class="message-bubble" wx:if="{{message.content}}">
            <view class="message-content">
              <text
                class="message-content-text"
                selectable="{{message.role == 'assistant'}}"
                user-select="{{message.role == 'assistant'}}"
              >{{message.content}}</text>
            </view>
          <view class="message-meta">
            <view class="message-meta-text">
              <text>{{message.timeText}}</text>
              <text wx:if="{{message.displaySafety && message.displaySafety.text}}"> · {{message.displaySafety.text}}</text>
            </view>
          </view>
        </view>

        <view class="fallback-banner" wx:if="{{message.fallbackBanner}}">{{message.fallbackBanner}}</view>
        <view
          class="run-compact"
          wx:if="{{message.role == 'assistant' && message.hasCollapsedRun && message.runCompactText}}"
          data-message-id="{{message.id}}"
          bindtap="onToggleRunDetails"
        >{{message.runCompactText}} · 详情</view>
        <xiaofu-agent-run
          wx:if="{{message.role == 'assistant' && message.displaySteps.length}}"
          steps="{{message.displaySteps}}"
          taskSteps="{{message.taskSteps}}"
          evidenceText=""
          fallback="{{message.fallback}}"
          status="{{message.runStatus}}"
        />
        <view class="tool-strip" wx:if="{{message.displayToolCalls.length && !message.displaySteps.length}}">
          <view
            wx:for="{{message.displayToolCalls}}"
            wx:for-item="tool"
            wx:key="key"
            class="tool-chip {{tool.statusClass}}"
          >{{tool.displayText}}</view>
        </view>
        <view
          class="evidence-strip evidence-collapsed"
          wx:if="{{message.evidenceText && !message.evidenceExpanded}}"
          data-message-id="{{message.id}}"
          bindtap="onToggleEvidence"
        >{{message.evidenceCompact || message.evidenceText}}</view>
        <view class="evidence-strip evidence-expanded" wx:if="{{message.evidenceText && message.evidenceExpanded}}">
          <view>{{message.evidenceText}}</view>
          <view class="evidence-collapse" data-message-id="{{message.id}}" bindtap="onToggleEvidence">收起来源</view>
        </view>
        <view class="feedback-row feedback-compact" wx:if="{{message.role == 'assistant' && message.content && !message.isStreaming}}">
          <button class="feedback-icon-btn" data-message-id="{{message.id}}" data-feedback="helpful" bindtap="onMessageFeedback" aria-label="有帮助">👍</button>
          <button class="feedback-icon-btn" data-message-id="{{message.id}}" data-feedback="unresolved" bindtap="onMessageFeedback" aria-label="没帮助">👎</button>
          <button class="feedback-icon-btn" data-message-id="{{message.id}}" data-feedback="more" bindtap="onFeedbackMore" aria-label="更多反馈">···</button>
        </view>
        <view class="feedback-detail-row" wx:if="{{message.feedbackOpen}}">
          <button class="feedback-btn" data-message-id="{{message.id}}" data-feedback="unresolved" bindtap="onMessageFeedback">没解决</button>
          <button class="feedback-btn" data-message-id="{{message.id}}" data-feedback="stale" bindtap="onMessageFeedback">结果过时</button>
          <button class="feedback-btn" data-message-id="{{message.id}}" data-feedback="misunderstood" bindtap="onMessageFeedback">理解错误</button>
        </view>

        <view class="ai-card-list" wx:if="{{message.displayCards.length}}">
          <view
            wx:for="{{message.displayCards}}"
            wx:for-item="card"
            wx:for-index="cardIndex"
            wx:key="key"
            class="ai-result-card card card-type-{{card.typeClass}} {{card.errorClass}}"
          >
            <view wx:if="{{card.typeClass === 'weather'}}" class="weather-card card-weather-{{card.weatherIconClass}}">
              <view class="weather-card-head">
                <view>
                  <view class="weather-campus">{{card.weather.campus}}</view>
                  <view class="weather-status">{{card.weather.weatherText}}</view>
                </view>
                <view class="weather-updated">{{card.weather.cachedText}}<text wx:if="{{card.weather.updatedLabel}}"> · {{card.weather.updatedLabel}}</text></view>
              </view>
              <view class="weather-main">
                <view class="weather-temp {{card.weather.temperatureText === '暂无该项数据' ? 'missing' : ''}}">{{card.weather.temperatureText}}</view>
                <view class="weather-facts">
                  <view>体感 {{card.weather.apparentTemperatureText}}</view>
                  <view>{{card.weather.targetLabel}} {{card.weather.lowText}} / {{card.weather.highText}}</view>
                </view>
                <view class="weather-icon">
                  <view class="sun-core"></view>
                  <view class="cloud cloud-a"></view>
                  <view class="cloud cloud-b"></view>
                  <view class="drop drop-a"></view>
                  <view class="drop drop-b"></view>
                  <view class="drop drop-c"></view>
                </view>
              </view>
              <view class="weather-metrics">
                <view class="weather-metric"><text>湿度</text><view>{{card.weather.humidityText}}</view></view>
                <view class="weather-metric"><text>风速</text><view>{{card.weather.windSpeedText}}</view></view>
                <view class="weather-metric"><text>降水</text><view>{{card.weather.precipitationText}}</view></view>
                <view class="weather-metric"><text>降雨</text><view>{{card.weather.rainProbabilityText}}</view></view>
              </view>
              <view class="weather-timeline" wx:if="{{card.weather.next6Hours.length}}">
                <view wx:for="{{card.weather.next6Hours}}" wx:for-item="hour" wx:key="key" class="weather-hour">
                  <view>{{hour.time}}</view>
                  <text>{{hour.temperatureText}}</text>
                  <text>{{hour.rainProbabilityText}}</text>
                </view>
              </view>
              <view class="weather-advice">{{card.weather.advice}}</view>
              <view class="weather-source" wx:if="{{card.weather.sourceText}}">数据来源：{{card.weather.sourceText}}</view>
              <view class="card-actions {{card.actionLayoutClass}}" wx:if="{{card.primaryActions.length}}">
                <button
                  wx:for="{{card.primaryActions}}"
                  wx:for-item="action"
                  wx:key="label"
                  class="card-action card-action-primary"
                  data-message-index="{{messageIndex}}"
                  data-card-index="{{cardIndex}}"
                  data-action-index="{{action.originalIndex}}"
                  bindtap="onCardAction"
                >{{action.label}}</button>
              </view>
              <view class="secondary-action-row" wx:if="{{card.secondaryActions.length}}">
                <button
                  wx:for="{{card.secondaryActions}}"
                  wx:for-item="action"
                  wx:key="label"
                  class="card-action-secondary"
                  data-message-index="{{messageIndex}}"
                  data-card-index="{{cardIndex}}"
                  data-action-index="{{action.originalIndex}}"
                  bindtap="onCardAction"
                >{{action.label}}</button>
              </view>
            </view>

            <block wx:else>
            <view class="card-header-row">
              <view class="card-title-block">
                <view class="card-title">{{card.title}}</view>
                <view class="card-subtitle" wx:if="{{card.subtitle}}">{{card.subtitle}}</view>
              </view>
              <view class="card-type">{{card.typeLabel}}</view>
            </view>

            <view class="badge-row" wx:if="{{card.badges.length}}">
              <text wx:for="{{card.badges}}" wx:key="*this" class="badge">{{item}}</text>
            </view>

            <view class="card-items" wx:if="{{card.visibleItems.length}}">
              <view
                wx:for="{{card.visibleItems}}"
                wx:for-item="cardItem"
                wx:key="key"
                class="card-item"
              >
                <view class="item-main">
                  <view class="item-title">{{cardItem.title}}</view>
                  <view class="item-subtitle" wx:if="{{cardItem.subtitle}}">{{cardItem.subtitle}}</view>
                </view>
                <view class="item-value" wx:if="{{cardItem.value}}">{{cardItem.value}}</view>
              </view>
              <button
                class="card-overflow {{card.overflowExpanded ? 'expanded' : ''}}"
                wx:if="{{card.hiddenItemCount || card.overflowExpanded}}"
                data-card-key="{{card.key}}"
                bindtap="onCardOverflow"
              >{{card.overflowText}}</button>
            </view>

            <view class="card-actions {{card.actionLayoutClass}}" wx:if="{{card.primaryActions.length}}">
              <button
                wx:for="{{card.primaryActions}}"
                wx:for-item="action"
                wx:key="label"
                class="card-action card-action-primary"
                data-message-index="{{messageIndex}}"
                data-card-index="{{cardIndex}}"
                data-action-index="{{action.originalIndex}}"
                bindtap="onCardAction"
              >{{action.label}}</button>
            </view>

            <view class="secondary-action-row" wx:if="{{card.secondaryActions.length}}">
              <button
                wx:for="{{card.secondaryActions}}"
                wx:for-item="action"
                wx:key="label"
                class="card-action-secondary"
                data-message-index="{{messageIndex}}"
                data-card-index="{{cardIndex}}"
                data-action-index="{{action.originalIndex}}"
                bindtap="onCardAction"
              >{{action.label}}</button>
            </view>

            <view class="filtered-hint" wx:if="{{card.filteredHint}}">{{card.filteredHint}}</view>
            <view class="card-disclaimer">{{card.disclaimer}}</view>
            </block>
          </view>
        </view>

        <view class="suggestion-row" wx:if="{{message.suggestions.length}}">
          <button
            wx:for="{{message.suggestions}}"
            wx:key="*this"
            class="suggestion-chip"
            data-suggestion="{{item}}"
            bindtap="onSuggestionTap"
          >{{item}}</button>
        </view>
      </view>
    </view>

    <view class="slow-tip" wx:if="{{slowRequest}}">网络较慢，正在继续等待查询结果...</view>
    <xiaofu-live-run
      visible="{{sending && liveRunVisible}}"
      events="{{liveRunEvents}}"
      statusText="{{sendingStatusText}}"
      expanded="{{liveRunExpanded}}"
      bind:toggleexpand="onToggleLiveRunExpand"
    />
    <view class="sending-row" wx:if="{{sending && !liveRunVisible}}">
      <view class="sending-dot"></view>
      <view class="sending-text">{{sendingStatusText}}</view>
    </view>
    <view id="message-bottom-anchor" class="message-bottom-anchor"></view>
  </scroll-view>

  <view class="sheet-mask" wx:if="{{showTaskPanel || showConversationSheet || showCapabilityGuide || showPrivacySheet || showHeaderMenu || showMemorySheet}}" bindtap="closeSheets"></view>

  <xiaofu-conversation-sheet
    visible="{{showConversationSheet}}"
    conversations="{{conversations}}"
    bind:close="closeConversationSheet"
    bind:create="createNewConversation"
    bind:select="onConversationSheetSelect"
    bind:rename="onConversationSheetRename"
    bind:clear="onConversationSheetClear"
    bind:delete="onConversationSheetDelete"
  />

  <xiaofu-memory-sheet
    visible="{{showMemorySheet}}"
    mode="{{memoryMode}}"
    bind:close="closeMemorySheet"
    bind:change="onMemoryModeChange"
    bind:clearlocal="onClearLocalMemory"
    bind:clearcurrent="onClearCurrentMemory"
    bind:clearall="onClearAllMemory"
  />

  <view class="bottom-sheet header-menu-sheet header-menu-sheet-full" wx:if="{{showHeaderMenu}}">
    <view class="sheet-handle"></view>
    <view class="task-panel-head">
      <view class="panel-title-wrap">
        <view class="task-panel-title">更多操作</view>
      </view>
      <button class="sheet-close" bindtap="closeHeaderMenu">关闭</button>
    </view>
    <view class="header-menu-list">
      <button class="header-menu-row" bindtap="openMemorySheet">
        <text class="header-menu-row-title">记忆设置</text>
        <text class="header-menu-row-meta">{{memoryStatusText || '本地记忆'}}</text>
        <text class="header-menu-row-arrow">›</text>
      </button>
      <button class="header-menu-row" bindtap="toggleXiaofuFloat">
        <text class="header-menu-row-title">{{xiaofuFloatToggleText}}</text>
        <text class="header-menu-row-meta"></text>
        <text class="header-menu-row-arrow">›</text>
      </button>
      <button class="header-menu-row danger" bindtap="clearHistory">
        <text class="header-menu-row-title">清空当前对话</text>
        <text class="header-menu-row-meta"></text>
        <text class="header-menu-row-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="bottom-sheet task-sheet" wx:if="{{showTaskPanel}}">
    <view class="sheet-handle"></view>
    <view class="task-panel-head">
      <view class="panel-title-wrap">
        <view class="task-panel-title">校园工具</view>
        <view class="task-panel-subtitle">课表、校园信息和常用入口</view>
      </view>
      <button class="sheet-close" bindtap="closeTaskPanel">关闭</button>
    </view>
    <scroll-view wx:if="{{taskPanelReady}}" class="task-section-scroll" scroll-y enhanced scroll-with-animation="{{false}}" show-scrollbar="{{false}}">
      <view
        wx:for="{{taskPanelGroups}}"
        wx:for-item="group"
        wx:for-index="groupIndex"
        wx:key="title"
        class="task-section"
      >
        <view class="task-section-title">{{group.title}}</view>
        <button
          wx:for="{{group.items}}"
          wx:for-item="task"
          wx:for-index="taskIndex"
          wx:key="label"
          class="task-item"
          data-group-index="{{groupIndex}}"
          data-task-index="{{taskIndex}}"
          bindtap="onTaskPanelItemTap"
        >
          <image class="task-icon" src="{{task.iconPath}}" mode="aspectFit" />
          <view class="task-copy">
            <view class="task-label">{{task.label}}</view>
            <view class="task-desc">{{task.desc}}</view>
          </view>
        </button>
      </view>
    </scroll-view>
    <view wx:else class="task-section-loading">加载中</view>
  </view>

  <view class="bottom-sheet capability-sheet" wx:if="{{showCapabilityGuide}}">
    <view class="sheet-handle"></view>
    <view class="task-panel-head">
      <view class="panel-title-wrap">
        <view class="task-panel-title">小佛助手可以帮你完成什么？</view>
        <view class="task-panel-subtitle">选择示例后，会在当前对话中整理结果</view>
      </view>
      <button class="sheet-close" bindtap="closeCapabilityGuide">关闭</button>
    </view>
    <scroll-view class="capability-scroll" scroll-y enhanced scroll-with-animation="{{false}}" show-scrollbar="{{false}}">
      <view
        wx:for="{{capabilityGuideGroups}}"
        wx:for-item="group"
        wx:key="title"
        class="capability-section"
      >
        <view class="capability-title">{{group.title}}</view>
        <view class="capability-list">
          <button
            wx:for="{{group.items}}"
            wx:for-item="example"
            wx:key="*this"
            class="capability-chip"
            data-text="{{example}}"
            bindtap="onCapabilityExampleTap"
          >{{example}}</button>
        </view>
      </view>
      <button class="capability-map-btn" bindtap="openCampusMapFromGuide">查看校园地图</button>
    </scroll-view>
  </view>

  <view class="bottom-sheet privacy-sheet" wx:if="{{showPrivacySheet}}">
    <view class="sheet-handle"></view>
    <view class="privacy-head">
      <view class="privacy-copy">
        <view class="privacy-title">课表摘要</view>
        <view class="privacy-desc">{{privacyText}}</view>
      </view>
      <switch
        class="privacy-switch"
        checked="{{allowPersonalContext}}"
        color="#2f855a"
        bindchange="onPersonalContextToggle"
      />
    </view>
    <view class="privacy-footer">
      <text>{{privacyStatusText}}</text>
      <button wx:if="{{showPrivacyTip}}" class="privacy-btn" bindtap="dismissPrivacyTip">{{privacyActionLabel}}</button>
      <button wx:else class="privacy-btn secondary" bindtap="closePrivacySheet">关闭</button>
    </view>
  </view>

  <view class="composer">
    <view class="composer-inner">
      <button
        wx:if="{{voiceInputVisible}}"
        class="voice-btn {{voiceRecording ? 'recording' : ''}} {{voiceRecognizing || sending ? 'disabled' : ''}}"
        bindtap="onVoiceTap"
        disabled="{{voiceRecognizing || sending}}"
        aria-label="语音输入"
      >
        {{voiceRecording ? "停" : "麦"}}
      </button>
      <view class="composer-input-wrap">
        <view wx:if="{{!inputValue}}" class="composer-custom-placeholder">告诉小佛你想完成的校园任务</view>
        <textarea
          class="composer-input"
          value="{{inputValue}}"
          placeholder=""
          auto-height="{{true}}"
          maxlength="600"
          fixed="{{true}}"
          cursor-spacing="16"
          focus="{{inputFocus}}"
          confirm-type="search"
          confirm-hold="{{false}}"
          show-confirm-bar="{{false}}"
          bindinput="onInput"
          bindconfirm="onComposerConfirm"
          bindcompositionstart="onCompositionStart"
          bindcompositionend="onCompositionEnd"
          disabled="{{sending}}"
        />
      </view>
      <button class="newline-btn" bindtap="onInsertNewline" disabled="{{sending}}" aria-label="换行">↵</button>
      <button
        class="send-btn icon-send {{!sending && !inputValue ? 'disabled' : ''}} {{sending ? 'cancel' : ''}}"
        bindtap="onSubmit"
        disabled="{{!sending && !inputValue}}"
        aria-label="{{sending ? '停止' : '发送'}}"
      >
        {{sending ? "■" : "➤"}}
      </button>
    </view>
    <view wx:if="{{voiceStatusText}}" class="voice-status">{{voiceStatusText}}</view>
    <button class="composer-note" bindtap="openPrivacySheet">{{composerNote}}</button>
  </view>
  <xiaofu-float />
</view>
