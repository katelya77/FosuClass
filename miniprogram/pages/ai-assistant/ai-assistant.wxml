<view class="page ai-page">
  <view class="xiaofu-header">
    <view class="xiaofu-avatar-wrap">
      <image wx:if="{{hasHeroLogo}}" class="xiaofu-avatar" src="/assets/icons/ai-campus-butler.png" mode="aspectFit" binderror="onHeroLogoError" />
      <view wx:else class="xiaofu-avatar-text">佛</view>
    </view>
    <view class="xiaofu-title-block">
      <view class="xiaofu-title">小佛</view>
      <view class="xiaofu-subtitle">{{headerSubtitle}}</view>
    </view>
    <button class="xiaofu-clear" bindtap="clearHistory">清空</button>
  </view>

  <view class="quick-task-row">
    <scroll-view class="quick-action-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="quick-action-list">
        <button
          wx:for="{{quickActions}}"
          wx:key="id"
          class="quick-action-pill {{item.className}}"
          data-action-id="{{item.id}}"
          bindtap="onQuickAction"
        >
          <text class="quick-action-icon">{{item.icon}}</text>
          <text class="quick-action-label">{{item.label}}</text>
        </button>
      </view>
    </scroll-view>
    <button class="quick-more-button" bindtap="openTaskPanel">更多</button>
  </view>

  <view class="history-trim-tip" wx:if="{{historyTrimNotice}}">已仅保留最近 20 条</view>

  <scroll-view class="message-scroll" scroll-y scroll-top="{{scrollTop}}" enhanced show-scrollbar="{{false}}">
    <view class="empty-welcome" wx:if="{{!messages.length}}">
      <view class="empty-title">今天想做什么？</view>
      <view class="empty-desc">我可以查课、找空教室、看今日安排，也能解释 FosuClass 的功能。</view>
      <view class="empty-example-list">
        <button
          wx:for="{{welcomeExamples}}"
          wx:key="*this"
          class="empty-example"
          data-question="{{item}}"
          bindtap="onWelcomeExampleTap"
        >{{item}}</button>
      </view>
      <view class="empty-safe-note">不要输入学号、密码或 Cookie。</view>
    </view>

    <view
      wx:for="{{messages}}"
      wx:for-item="message"
      wx:for-index="messageIndex"
      wx:key="id"
      class="message-row {{message.role}} {{message.showAvatar ? '' : 'no-avatar'}}"
    >
      <view wx:if="{{message.role == 'assistant' && message.showAvatar}}" class="assistant-avatar">
        <image wx:if="{{hasHeroLogo}}" class="avatar-logo" src="/assets/icons/ai-campus-butler.png" mode="aspectFit" />
        <text wx:else>佛</text>
      </view>
      <view wx:elif="{{message.role == 'assistant'}}" class="assistant-avatar-spacer"></view>

      <view class="message-body">
        <view class="message-bubble" wx:if="{{message.content}}">
          <view class="message-content">{{message.content}}</view>
          <view class="message-meta">
            <text>{{message.timeText}}</text>
            <text wx:if="{{message.displaySafety && message.displaySafety.text}}"> · {{message.displaySafety.text}}</text>
          </view>
        </view>

        <view class="tool-strip" wx:if="{{message.displayToolCalls.length}}">
          <view
            wx:for="{{message.displayToolCalls}}"
            wx:for-item="tool"
            wx:key="key"
            class="tool-chip {{tool.statusClass}}"
          >{{tool.displayText}}</view>
        </view>
        <view class="evidence-strip" wx:if="{{message.evidenceText}}">{{message.evidenceText}}</view>

        <view class="ai-card-list" wx:if="{{message.displayCards.length}}">
          <view
            wx:for="{{message.displayCards}}"
            wx:for-item="card"
            wx:for-index="cardIndex"
            wx:key="key"
            class="ai-result-card card card-type-{{card.typeClass}} {{card.errorClass}}"
          >
            <view class="card-header-row">
              <view class="card-title-block">
                <view class="card-title">{{card.title}}</view>
                <view class="card-subtitle" wx:if="{{card.subtitle}}">{{card.subtitle}}</view>
              </view>
              <view class="card-type">{{card.typeLabel}}</view>
            </view>

            <view class="badge-row" wx:if="{{card.badges.length}}">
              <text wx:for="{{card.badges}}" wx:key="*this" class="badge">{{item}}</text>
            </view>

            <view class="card-items" wx:if="{{card.visibleItems.length}}">
              <view
                wx:for="{{card.visibleItems}}"
                wx:for-item="cardItem"
                wx:key="key"
                class="card-item"
              >
                <view class="item-main">
                  <view class="item-title">{{cardItem.title}}</view>
                  <view class="item-subtitle" wx:if="{{cardItem.subtitle}}">{{cardItem.subtitle}}</view>
                </view>
                <view class="item-value" wx:if="{{cardItem.value}}">{{cardItem.value}}</view>
              </view>
              <button
                class="card-overflow {{card.overflowExpanded ? 'expanded' : ''}}"
                wx:if="{{card.hiddenItemCount || card.overflowExpanded}}"
                data-card-key="{{card.key}}"
                bindtap="onCardOverflow"
              >{{card.overflowText}}</button>
            </view>

            <view class="card-actions {{card.actionLayoutClass}}" wx:if="{{card.primaryActions.length}}">
              <button
                wx:for="{{card.primaryActions}}"
                wx:for-item="action"
                wx:key="label"
                class="card-action card-action-primary"
                data-message-index="{{messageIndex}}"
                data-card-index="{{cardIndex}}"
                data-action-index="{{action.originalIndex}}"
                bindtap="onCardAction"
              >{{action.label}}</button>
            </view>

            <view class="secondary-action-row" wx:if="{{card.secondaryActions.length}}">
              <button
                wx:for="{{card.secondaryActions}}"
                wx:for-item="action"
                wx:key="label"
                class="card-action-secondary"
                data-message-index="{{messageIndex}}"
                data-card-index="{{cardIndex}}"
                data-action-index="{{action.originalIndex}}"
                bindtap="onCardAction"
              >{{action.label}}</button>
            </view>

            <view class="filtered-hint" wx:if="{{card.filteredHint}}">{{card.filteredHint}}</view>
            <view class="card-disclaimer">仅供参考，以教务数据为准</view>
          </view>
        </view>

        <view class="suggestion-row" wx:if="{{message.suggestions.length}}">
          <button
            wx:for="{{message.suggestions}}"
            wx:key="*this"
            class="suggestion-chip"
            data-suggestion="{{item}}"
            bindtap="onSuggestionTap"
          >{{item}}</button>
        </view>
      </view>
    </view>

    <view class="slow-tip" wx:if="{{slowRequest}}">网络较慢，正在继续等待小佛返回结果...</view>
    <view class="sending-row" wx:if="{{sending}}">
      <view class="sending-dot"></view>
      <view class="sending-text">正在调用校园工具并生成卡片</view>
    </view>
  </scroll-view>

  <view class="sheet-mask" wx:if="{{showTaskPanel || showPrivacySheet}}" bindtap="closeSheets"></view>

  <view class="bottom-sheet task-sheet" wx:if="{{showTaskPanel}}">
    <view class="sheet-handle"></view>
    <view class="task-panel-head">
      <view class="panel-title-wrap">
        <view class="task-panel-title">更多任务</view>
        <view class="task-panel-subtitle">按场景选择，小佛会先调用工具核验</view>
      </view>
      <button class="sheet-close" bindtap="closeTaskPanel">关闭</button>
    </view>
    <scroll-view class="task-section-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{taskPanelGroups}}"
        wx:for-item="group"
        wx:for-index="groupIndex"
        wx:key="title"
        class="task-section"
      >
        <view class="task-section-title">{{group.title}}</view>
        <button
          wx:for="{{group.items}}"
          wx:for-item="task"
          wx:for-index="taskIndex"
          wx:key="label"
          class="task-item"
          data-group-index="{{groupIndex}}"
          data-task-index="{{taskIndex}}"
          bindtap="onTaskPanelItemTap"
        >
          <view class="task-icon">{{task.icon}}</view>
          <view class="task-copy">
            <view class="task-label">{{task.label}}</view>
            <view class="task-desc">{{task.desc}}</view>
          </view>
        </button>
      </view>
    </scroll-view>
  </view>

  <view class="bottom-sheet privacy-sheet" wx:if="{{showPrivacySheet}}">
    <view class="sheet-handle"></view>
    <view class="privacy-head">
      <view class="privacy-copy">
        <view class="privacy-title">课表摘要</view>
        <view class="privacy-desc">{{privacyText}}</view>
      </view>
      <switch
        class="privacy-switch"
        checked="{{allowPersonalContext}}"
        color="#2f855a"
        bindchange="onPersonalContextToggle"
      />
    </view>
    <view class="privacy-footer">
      <text>{{privacyStatusText}}</text>
      <button wx:if="{{showPrivacyTip}}" class="privacy-btn" bindtap="dismissPrivacyTip">{{privacyActionLabel}}</button>
      <button wx:else class="privacy-btn secondary" bindtap="closePrivacySheet">关闭</button>
    </view>
  </view>

  <view class="composer">
    <view class="composer-inner">
      <textarea
        class="composer-input"
        value="{{inputValue}}"
        placeholder="输入校园任务，不填密码学号"
        placeholder-class="composer-placeholder"
        auto-height="{{true}}"
        maxlength="600"
        fixed="{{true}}"
        cursor-spacing="16"
        focus="{{inputFocus}}"
        bindinput="onInput"
        disabled="{{sending}}"
      />
      <button class="send-btn {{sending || !inputValue ? 'disabled' : ''}}" bindtap="onSubmit" disabled="{{sending || !inputValue}}">
        {{sending ? "发送中" : "发送"}}
      </button>
    </view>
    <button class="composer-note" bindtap="openPrivacySheet">{{composerNote}}</button>
  </view>
</view>
