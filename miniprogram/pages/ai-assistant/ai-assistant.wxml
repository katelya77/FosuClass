<view class="page ai-page">
  <view class="assistant-hero card">
    <view class="hero-top">
      <view class="hero-logo-wrap">
        <image
          wx:if="{{hasHeroLogo}}"
          class="hero-logo"
          src="/assets/icons/ai-campus-butler.png"
          mode="aspectFit"
          binderror="onHeroLogoError"
        />
        <view wx:else class="hero-mark">AI</view>
      </view>
      <view class="hero-copy">
        <view class="hero-title">{{welcome.title}}</view>
        <view class="hero-desc">{{welcome.desc}}</view>
      </view>
      <button class="hero-clear-mini" bindtap="clearHistory">清空</button>
    </view>

    <view class="hero-meta-row">
      <view class="hero-status-chip provider-status-chip">{{providerLabel}}</view>
      <view class="hero-status-chip grounded-chip">{{providerModeLabel}}</view>
      <view class="hero-status-chip data-source-chip">{{privacyActionText}}</view>
      <view class="hero-status-chip ability-chip">可查课 / 找空教室 / 今日安排 / 数据诊断</view>
    </view>
  </view>

  <view class="privacy-tip privacy-tip-full card" wx:if="{{privacyExpanded}}">
    <view class="privacy-head">
      <view class="privacy-copy">
        <view class="privacy-title">隐私与课表摘要</view>
        <view class="privacy-desc">{{privacyText}}</view>
      </view>
      <switch
        class="privacy-switch"
        checked="{{allowPersonalContext}}"
        color="#2f855a"
        bindchange="onPersonalContextToggle"
      />
    </view>
    <view class="privacy-footer">
      <text>{{privacyStatusText}}</text>
      <button wx:if="{{showPrivacyTip}}" class="privacy-btn" bindtap="dismissPrivacyTip">知道了</button>
      <button wx:else class="privacy-btn secondary" bindtap="dismissPrivacyTip">收起</button>
    </view>
  </view>

  <view class="privacy-compact {{privacyCompactClass}}" wx:else>
    <view class="privacy-compact-main">
      <text class="privacy-dot"></text>
      <text class="privacy-compact-text">{{privacyStatusText}}</text>
    </view>
    <view class="privacy-compact-actions">
      <button class="privacy-link" bindtap="expandPrivacyTip">说明</button>
      <switch
        class="privacy-switch compact"
        checked="{{allowPersonalContext}}"
        color="#2f855a"
        bindchange="onPersonalContextToggle"
      />
    </view>
  </view>

  <scroll-view class="quick-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="quick-list">
      <button
        wx:for="{{quickQuestions}}"
        wx:key="*this"
        class="quick-chip"
        data-question="{{item}}"
        bindtap="onQuickQuestion"
      >{{item}}</button>
    </view>
  </scroll-view>

  <scroll-view class="message-scroll" scroll-y scroll-top="{{scrollTop}}" enhanced show-scrollbar="{{false}}">
    <view class="empty-welcome" wx:if="{{!messages.length}}">
      <view class="empty-orbit">
        <image wx:if="{{hasHeroLogo}}" class="empty-logo" src="/assets/icons/ai-campus-butler.png" mode="aspectFit" />
        <view wx:else class="empty-logo-text">AI</view>
      </view>
      <view class="empty-title">直接说一个校园任务</view>
      <view class="empty-desc">找 C7 附近空教室、分析今天课程、查老师课表，或排查数据加载失败。</view>
    </view>

    <view
      wx:for="{{messages}}"
      wx:for-item="message"
      wx:for-index="messageIndex"
      wx:key="id"
      class="message-row {{message.role}}"
    >
      <view wx:if="{{message.role == 'assistant'}}" class="assistant-avatar">
        <image wx:if="{{hasHeroLogo}}" class="avatar-logo" src="/assets/icons/ai-campus-butler.png" mode="aspectFit" />
        <text wx:else>AI</text>
      </view>

      <view class="message-body">
        <view class="message-bubble">
          <view class="message-content">{{message.content}}</view>
          <view class="message-meta">
            <text>{{message.timeText}}</text>
            <text wx:if="{{message.displaySafety && message.displaySafety.text}}"> · {{message.displaySafety.text}}</text>
          </view>
        </view>

        <view class="tool-strip" wx:if="{{message.displayToolCalls.length}}">
          <view
            wx:for="{{message.displayToolCalls}}"
            wx:for-item="tool"
            wx:key="displayText"
            class="tool-chip {{tool.statusClass}}"
          >{{tool.displayText}}</view>
        </view>

        <view class="ai-card-list" wx:if="{{message.displayCards.length}}">
          <view
            wx:for="{{message.displayCards}}"
            wx:for-item="card"
            wx:for-index="cardIndex"
            wx:key="title"
            class="ai-result-card card card-type-{{card.typeClass}}"
          >
            <view class="card-header-row">
              <view class="card-title-block">
                <view class="card-title">{{card.title}}</view>
                <view class="card-subtitle" wx:if="{{card.subtitle}}">{{card.subtitle}}</view>
              </view>
              <view class="card-type">{{card.typeLabel}}</view>
            </view>

            <view class="badge-row" wx:if="{{card.badges.length}}">
              <text
                wx:for="{{card.badges}}"
                wx:key="*this"
                class="badge"
              >{{item}}</text>
            </view>

            <view class="card-items" wx:if="{{card.visibleItems.length}}">
              <view
                wx:for="{{card.visibleItems}}"
                wx:for-item="cardItem"
                wx:key="title"
                class="card-item"
              >
                <view class="item-main">
                  <view class="item-title">{{cardItem.title}}</view>
                  <view class="item-subtitle" wx:if="{{cardItem.subtitle}}">{{cardItem.subtitle}}</view>
                </view>
                <view class="item-value" wx:if="{{cardItem.value}}">{{cardItem.value}}</view>
              </view>
              <view
                class="card-overflow"
                wx:if="{{card.hiddenItemCount}}"
                bindtap="onCardOverflow"
              >还有 {{card.hiddenItemCount}} 条，点击查看详情</view>
            </view>

            <view class="card-actions {{card.actionLayoutClass}}" wx:if="{{card.primaryActions.length}}">
              <button
                wx:for="{{card.primaryActions}}"
                wx:for-item="action"
                wx:key="label"
                class="card-action primary"
                data-message-index="{{messageIndex}}"
                data-card-index="{{cardIndex}}"
                data-action-index="{{action.originalIndex}}"
                bindtap="onCardAction"
              >{{action.label}}</button>
            </view>

            <view class="secondary-action-row" wx:if="{{card.secondaryActions.length}}">
              <button
                wx:for="{{card.secondaryActions}}"
                wx:for-item="action"
                wx:key="label"
                class="secondary-action"
                data-message-index="{{messageIndex}}"
                data-card-index="{{cardIndex}}"
                data-action-index="{{action.originalIndex}}"
                bindtap="onCardAction"
              >{{action.label}}</button>
            </view>

            <view class="card-disclaimer">仅供参考，以教务数据为准</view>
          </view>
        </view>

        <view class="suggestion-row" wx:if="{{message.suggestions.length}}">
          <button
            wx:for="{{message.suggestions}}"
            wx:key="*this"
            class="suggestion-chip"
            data-suggestion="{{item}}"
            bindtap="onSuggestionTap"
          >{{item}}</button>
        </view>
      </view>
    </view>

    <view class="slow-tip" wx:if="{{slowRequest}}">网络较慢，正在继续等待 AI 校园管家返回结果...</view>
    <view class="sending-row" wx:if="{{sending}}">
      <view class="sending-dot"></view>
      <view class="sending-text">正在调用校园工具并生成卡片</view>
    </view>
  </scroll-view>

  <view class="composer">
    <view class="composer-inner">
      <input
        class="composer-input"
        value="{{inputValue}}"
        placeholder="输入校园任务，不填密码学号"
        placeholder-class="composer-placeholder"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="onSubmit"
        disabled="{{sending}}"
      />
      <button class="send-btn {{sending || !inputValue ? 'disabled' : ''}}" bindtap="onSubmit" disabled="{{sending || !inputValue}}">
        {{sending ? "发送中" : "发送"}}
      </button>
    </view>
    <view class="composer-note">{{composerNote}}</view>
  </view>
</view>
