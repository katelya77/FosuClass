.empty-room-page {
  width: 100%;
  padding: 16rpx 16rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.page-header {
  margin-bottom: 12rpx;
  padding: 0 8rpx;
}

.title {
  color: #172033;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.2;
}

.subtitle {
  margin-top: 6rpx;
  color: #778297;
  font-size: 24rpx;
  line-height: 1.45;
}

.muted {
  color: #8a94a6;
}

.filter-card,
.summary-card,
.room-card,
.skeleton-card,
.room-detail,
.filter-sheet {
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(162, 178, 201, 0.08);
}

.filter-card {
  padding: 24rpx 20rpx;
  margin-bottom: 18rpx;
}

.compact-filter-card {
  padding: 20rpx 18rpx;
}

.status-panel {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f2f5f9;
}

.status-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.status-subtitle {
  margin-top: 8rpx;
  color: #778297;
  font-size: 22rpx;
  line-height: 1.4;
}

.date-picker-btn {
  flex: 0 0 auto;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 28rpx;
  background: #fff1f1;
  color: #c62828;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 56rpx;
  white-space: nowrap;
}

.status-panel picker {
  flex: 0 0 auto;
}

.chip-section {
  padding: 20rpx 0 0;
}

.chip-section.compact {
  padding-top: 0;
  margin-bottom: 18rpx;
}

.chip-title {
  margin-bottom: 12rpx;
  color: #3e4e68;
  font-size: 24rpx;
  font-weight: 900;
}

.chip-scroll {
  width: 100%;
  white-space: nowrap;
}

.chip-row {
  display: flex;
  gap: 12rpx;
}

.date-row,
.time-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.time-row {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.chip-row.nowrap {
  display: inline-flex;
}

.filter-chip,
.preset-chip,
.building-chip {
  flex: 0 0 auto;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: #f1f4f8;
  color: #536174;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 56rpx;
  white-space: nowrap;
}

.time-row .filter-chip {
  min-width: 0;
  padding: 0 8rpx;
  text-align: center;
}

.filter-chip.active,
.building-chip.active {
  background: #c62828;
  color: #ffffff;
}

.date-chip {
  flex: 0 0 auto;
  min-width: 138rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: #f6f8fb;
  color: #172033;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.2;
}

.date-chip.compact {
  min-width: 0;
  padding: 12rpx 10rpx;
}

.picker-chip {
  text-align: center;
}

.date-chip.active {
  background: #fff1f1;
  color: #c62828;
}

.date-chip-sub {
  display: block;
  margin-top: 6rpx;
  color: #8a94a6;
  font-size: 19rpx;
  font-weight: 700;
}

.building-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0 0;
  border-top: 1rpx solid #f2f5f9;
}

.building-summary-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.building-summary-sub {
  margin-top: 6rpx;
  color: #778297;
  font-size: 22rpx;
  line-height: 1.35;
}

.more-filter-btn {
  flex: 0 0 auto;
  height: 58rpx;
  min-width: 126rpx;
  padding: 0 18rpx;
  border-radius: 29rpx;
  background: #f1f4f8;
  color: #536174;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.preset-row,
.building-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.section-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
  margin-top: 14rpx;
}

.section-chip {
  height: 56rpx;
  border-radius: 16rpx;
  background: #f1f4f8;
  color: #536174;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 56rpx;
  text-align: center;
}

.section-chip.active,
.preset-chip:active {
  background: #c62828;
  color: #ffffff;
}

.building-chip.ghost {
  border: 1rpx dashed #cbd5e1;
  background: #ffffff;
  color: #64748b;
}

.filter-row {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  border-bottom: 1rpx solid #f2f5f9;
}

.filter-label {
  flex: 0 0 140rpx;
  color: #3e4e68;
  font-size: 26rpx;
  font-weight: 800;
}

picker {
  flex: 1;
  min-width: 0;
}

.filter-pill {
  min-width: 0;
  color: #172033;
  font-size: 26rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.building-fav-btn {
  flex: 0 0 auto;
  height: 52rpx;
  min-width: 108rpx;
  margin-left: 14rpx;
  padding: 0 16rpx;
  border-radius: 26rpx;
  background: #f1f4f8;
  color: #536174;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.building-fav-btn.active {
  background: #fff1f1;
  color: #c62828;
}

.week-input,
.custom-input {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f6f8fb;
  color: #172033;
  font-size: 26rpx;
}

.filter-tail {
  margin-left: 12rpx;
  color: #778297;
  font-size: 24rpx;
  font-weight: 700;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f5f9;
}

.switch-copy {
  min-width: 0;
}

.switch-title {
  color: #172033;
  font-size: 26rpx;
  font-weight: 800;
}

.switch-desc {
  margin-top: 4rpx;
  color: #8a94a6;
  font-size: 22rpx;
}

.primary-search-btn {
  width: 100% !important;
  height: 80rpx;
  margin-top: 22rpx;
  border-radius: 40rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(198, 40, 40, 0.2);
}

.primary-search-btn.compact {
  flex: 1;
  margin-top: 0;
  height: 72rpx;
  font-size: 26rpx;
}

.secondary-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  background: #f1f4f8;
  color: #536174;
  font-size: 26rpx;
  font-weight: 800;
}

.restore-hint-bar {
  margin-bottom: 14rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid #bbf7d0;
  border-radius: 10rpx;
  background: #f0fdf4;
  color: #166534;
  font-size: 24rpx;
}

.summary-card {
  margin-bottom: 16rpx;
  padding: 22rpx;
}

.summary-title {
  color: #172033;
  font-size: 28rpx;
  font-weight: 900;
}

.summary-subtitle {
  margin-top: 8rpx;
  color: #778297;
  font-size: 22rpx;
  line-height: 1.45;
}

.skeleton-card {
  padding: 28rpx 22rpx;
}

.skeleton-line {
  width: 64%;
  height: 24rpx;
  margin-top: 18rpx;
  border-radius: 12rpx;
  background: #eef2f7;
}

.skeleton-line:first-child {
  margin-top: 0;
}

.skeleton-line.wide {
  width: 86%;
}

.skeleton-line.short {
  width: 38%;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-list.grouped {
  gap: 22rpx;
}

.building-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.building-group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
  color: #3e4e68;
  font-size: 24rpx;
  font-weight: 900;
}

.room-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx;
}

.room-card:active {
  background: #f8fafc;
}

.room-main {
  flex: 1;
  min-width: 0;
}

.room-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.room-meta,
.room-next {
  margin-top: 8rpx;
  color: #778297;
  font-size: 23rpx;
  line-height: 1.4;
}

.room-next {
  color: #9a6b16;
}

.room-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.room-section-chip {
  height: 36rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: #eef5ff;
  color: #2563a8;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 36rpx;
}

.room-actions {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.room-actions.slim {
  gap: 0;
}

.room-schedule-badge {
  max-width: 136rpx;
  min-height: 40rpx;
  padding: 0 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 40rpx;
  text-align: center;
  white-space: normal;
}

.room-schedule-badge.ready {
  background: #e9f8f1;
  color: #168957;
}

.room-schedule-badge.partial {
  background: #fff7e6;
  color: #9a6b16;
}

.mini-btn {
  min-width: 104rpx;
  height: 48rpx;
  padding: 0 14rpx;
  border-radius: 24rpx;
  background: #f1f4f8;
  color: #536174;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.mini-btn.strong {
  background: #fff1f1;
  color: #c62828;
}

.mini-btn.active {
  background: #c62828;
  color: #ffffff;
}

.load-more-hint {
  padding: 10rpx 0 20rpx;
  color: #8a94a6;
  font-size: 22rpx;
  text-align: center;
}

.detail-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(15, 23, 42, 0.32);
}

.room-detail {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 21;
  padding: 26rpx 24rpx;
  max-height: 76vh;
  overflow-y: auto;
}

.filter-sheet {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 21;
  padding: 24rpx;
  max-height: 82vh;
}

.filter-sheet-scroll {
  max-height: 58vh;
  padding-bottom: 12rpx;
}

.filter-sheet-actions {
  display: flex;
  gap: 14rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f2f5f9;
}

.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f2f5f9;
}

.detail-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
}

.detail-subtitle {
  margin-top: 6rpx;
  color: #778297;
  font-size: 23rpx;
}

.detail-close {
  flex: 0 0 auto;
  color: #c62828;
  font-size: 24rpx;
  font-weight: 800;
}

.detail-section {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f5f9;
}

.detail-label {
  color: #172033;
  font-size: 26rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.detail-value {
  color: #536174;
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-value.muted {
  color: #8a94a6;
}

.occupied-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
}

.occupied-time {
  flex: 0 0 130rpx;
  color: #c62828;
  font-size: 23rpx;
  font-weight: 900;
}

.occupied-name {
  min-width: 0;
  color: #536174;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding-top: 22rpx;
}

.detail-actions .secondary-btn {
  min-width: 190rpx;
}

.detail-actions .primary-search-btn.compact {
  min-width: 240rpx;
}
