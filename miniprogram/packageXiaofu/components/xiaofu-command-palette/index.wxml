<view class="command-panel" wx:if="{{visible}}" role="menu" aria-label="校园查询命令">
  <view class="command-head">
    <view>
      <view class="command-kicker">COMMANDS</view>
      <view class="command-title">选择一个校园命令</view>
    </view>
    <view class="command-mode">{{publicMode ? '正式版 · 本地规则' : '智能理解 · 工具核验'}}</view>
  </view>
  <scroll-view class="command-list" scroll-y show-scrollbar="{{false}}" wx:if="{{items.length}}">
    <button
      wx:for="{{items}}"
      wx:key="name"
      class="command-item"
      data-index="{{index}}"
      bindtap="onSelect"
      role="menuitem"
      aria-label="{{item.command}} {{item.label}}"
    >
      <view class="command-mark">/</view>
      <view class="command-copy">
        <view class="command-row">
          <text class="command-name">{{item.command}}</text>
          <text class="command-label">{{item.label}}</text>
          <text class="command-recent" wx:if="{{item.recent}}">最近</text>
          <text class="command-match" wx:if="{{item.matchKind === 'fuzzy'}}">拼写建议</text>
          <text class="command-match" wx:elif="{{item.matchKind === 'alias'}}">别名</text>
        </view>
        <view class="command-desc">{{item.description}}</view>
        <view class="command-example">示例 · {{item.example}}</view>
      </view>
      <view class="command-chevron">›</view>
    </button>
  </scroll-view>
  <view class="command-empty" wx:else>没有可靠匹配。删除关键词查看完整列表，或输入 /help。</view>
  <view class="command-hint" wx:if="{{hint}}">{{hint}}</view>
</view>
