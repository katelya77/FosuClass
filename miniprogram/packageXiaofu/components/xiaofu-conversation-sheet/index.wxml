<view class="conversation-sheet" wx:if="{{visible}}">
  <view class="sheet-handle"></view>
  <view class="task-panel-head">
    <view class="panel-title-wrap">
      <view class="task-panel-title">对话</view>
      <view class="task-panel-subtitle">管理本机对话；开启同步后可合并云端记录</view>
    </view>
    <button class="sheet-close-icon" bindtap="onClose" aria-label="关闭">✕</button>
  </view>
  <view class="conversation-toolbar">
    <input
      class="conversation-search"
      value="{{searchQuery}}"
      placeholder="搜索对话"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <button class="conversation-new-btn" bindtap="onCreate">新建</button>
  </view>
  <scroll-view class="conversation-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{filteredConversations}}"
      wx:key="conversationId"
      class="conversation-item {{item.active ? 'active' : ''}}"
    >
      <view class="conversation-top">
        <button
          class="conversation-main"
          data-conversation-id="{{item.conversationId}}"
          bindtap="onSelect"
        >
          <view class="conversation-title-row">
            <view class="conversation-title">{{item.title}}</view>
            <text class="conversation-current" wx:if="{{item.active}}">当前</text>
          </view>
          <view class="conversation-preview" wx:if="{{item.preview}}">{{item.preview}}</view>
        </button>
        <button
          class="conversation-more"
          data-conversation-id="{{item.conversationId}}"
          catchtap="onMore"
        >···</button>
      </view>
      <view class="conversation-meta">
        <text>{{item.updatedAtText}}</text>
      </view>
      <view class="conversation-actions" wx:if="{{menuConversationId === item.conversationId}}">
        <button catchtap="onRename" data-conversation-id="{{item.conversationId}}">重命名</button>
        <button catchtap="onPin" data-conversation-id="{{item.conversationId}}">{{item.pinned ? '取消置顶' : '置顶'}}</button>
        <button catchtap="onClear" data-conversation-id="{{item.conversationId}}">清空</button>
        <button catchtap="onDelete" data-conversation-id="{{item.conversationId}}" class="danger">删除</button>
      </view>
    </view>
    <view class="conversation-empty" wx:if="{{!filteredConversations.length}}">暂无对话</view>
  </scroll-view>
</view>
