@import "../../styles/xiaofu-tokens.wxss";

.conversation-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  max-height: 78vh;
  padding: 10rpx 20rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fbfaf8;
  box-shadow: 0 -8rpx 40rpx rgba(40, 36, 32, 0.12);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 6rpx auto 14rpx;
  border-radius: 999rpx;
  background: rgba(40, 36, 32, 0.12);
}

.task-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.panel-title-wrap {
  min-width: 0;
  flex: 1;
}

.task-panel-title {
  font-size: 32rpx;
  font-weight: 650;
  color: #2d2925;
}

.task-panel-subtitle {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8a8178;
  line-height: 1.35;
}

.sheet-close-icon {
  margin: 0;
  width: 60rpx;
  height: 60rpx;
  min-width: 60rpx;
  padding: 0;
  border-radius: 30rpx;
  background: #efece7;
  color: #6b635a;
  font-size: 26rpx;
  line-height: 60rpx;
  text-align: center;
  flex-shrink: 0;
}

.sheet-close-icon::after,
.conversation-new-btn::after,
.conversation-main::after,
.rail-btn::after {
  border: none;
}

.conversation-toolbar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.conversation-search {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 1rpx solid rgba(40, 36, 32, 0.08);
  font-size: 26rpx;
  color: #2d2925;
}

.conversation-new-btn {
  margin: 0;
  flex: 0 0 auto;
  min-width: 112rpx;
  height: 68rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #c0392b;
  color: #fff;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 68rpx;
  text-align: center;
}

.conversation-scroll {
  flex: 1;
  max-height: 54vh;
  min-height: 0;
}

.conversation-swipe {
  position: relative;
  margin-bottom: 10rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff5f5;
}

.conversation-item {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: stretch;
  padding: 0;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid rgba(40, 36, 32, 0.06);
  box-sizing: border-box;
  transform: translateX(0);
  transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.conversation-swipe.active .conversation-item {
  border-color: rgba(196, 48, 43, 0.28);
  background: #fff8f7;
}

.conversation-swipe.open .conversation-item {
  transform: translateX(-420rpx);
}

.conversation-actions-rail {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: flex;
  align-items: stretch;
  width: 420rpx;
}

.rail-btn {
  margin: 0;
  flex: 1;
  min-width: 0;
  padding: 0 4rpx;
  border-radius: 0;
  color: #fff;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rail-btn.pin { background: #6b635a; }
.rail-btn.clear { background: #b45309; }
.rail-btn.rename { background: #3d7a5a; }
.rail-btn.danger { background: #c0392b; }

.conversation-main {
  margin: 0;
  padding: 16rpx 18rpx;
  flex: 1;
  min-width: 0;
  text-align: left;
  background: transparent;
  line-height: 1.35;
}

.conversation-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.conversation-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2d2925;
  font-weight: 650;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-current,
.conversation-pin {
  flex-shrink: 0;
  font-size: 18rpx;
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
  line-height: 1.3;
}

.conversation-current {
  color: #c4302b;
  background: rgba(196, 48, 43, 0.08);
}

.conversation-pin {
  color: #6b635a;
  background: #f3f0eb;
}

.conversation-meta-row {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.conversation-time {
  flex: 0 0 auto;
  font-size: 20rpx;
  color: #9a9188;
}

.conversation-preview {
  flex: 1;
  min-width: 0;
  color: #9a9188;
  font-size: 22rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conversation-empty {
  padding: 36rpx 12rpx;
  text-align: center;
  color: #9a9188;
  font-size: 24rpx;
}

@media (prefers-reduced-motion: reduce) {
  .conversation-item { transition: none; }
}


/* Right-edge affordance: soft shadow so users notice left-swipe actions */
.conversation-swipe-edge {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  width: 36rpx;
  pointer-events: none;
  border-radius: 0 16rpx 16rpx 0;
  box-shadow: inset -14rpx 0 18rpx -8rpx rgba(42, 38, 34, 0.18);
  background: linear-gradient(90deg, rgba(42, 38, 34, 0), rgba(42, 38, 34, 0.06));
}

.conversation-item::after {
  content: "";
  position: absolute;
  top: 8rpx;
  right: 0;
  bottom: 8rpx;
  width: 6rpx;
  pointer-events: none;
  border-radius: 999rpx 0 0 999rpx;
  background: rgba(196, 48, 43, 0.22);
}

.conversation-swipe.open .conversation-swipe-edge,
.conversation-swipe.open .conversation-item::after {
  opacity: 0;
}

.conversation-swipe-hint {
  position: absolute;
  right: 10rpx;
  top: 50%;
  z-index: 4;
  transform: translateY(-50%);
  color: rgba(106, 99, 90, 0.62);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: -4rpx;
  pointer-events: none;
  line-height: 1;
}

.conversation-swipe.open .conversation-swipe-hint {
  opacity: 0;
}

.conversation-swipe.active .conversation-item::after {
  background: rgba(196, 48, 43, 0.38);
}
