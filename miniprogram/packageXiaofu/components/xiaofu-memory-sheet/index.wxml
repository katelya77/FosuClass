<view class="memory-sheet" wx:if="{{visible}}">
  <view class="sheet-handle"></view>
  <view class="memory-head">
    <view class="memory-head-text">
      <view class="memory-title">记忆</view>
      <view class="memory-subtitle">选择小佛在后续对话中保留哪些上下文。</view>
    </view>
    <button class="sheet-close-icon" bindtap="onClose" aria-label="关闭">✕</button>
  </view>

  <scroll-view class="memory-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="memory-mode-list">
      <view
        class="memory-mode-item {{mode === 'local_only' ? 'active' : ''}}"
        data-mode="local_only"
        bindtap="onSelectMode"
      >
        <view class="memory-mode-row">
          <view class="memory-mode-check {{mode === 'local_only' ? 'on' : ''}}"></view>
          <view class="memory-mode-title">仅保存在本机</view>
        </view>
        <view class="memory-mode-desc">完整消息只留在当前设备。</view>
      </view>
      <view
        class="memory-mode-item {{mode === 'session_state' ? 'active' : ''}}"
        data-mode="session_state"
        bindtap="onSelectMode"
      >
        <view class="memory-mode-row">
          <view class="memory-mode-check {{mode === 'session_state' ? 'on' : ''}}"></view>
          <view class="memory-mode-title">保存任务状态</view>
        </view>
        <view class="memory-mode-desc">保存班级、教师、教室等必要信息，便于连续追问。</view>
      </view>
      <view
        class="memory-mode-item {{mode === 'cloud_sync' ? 'active' : ''}}"
        data-mode="cloud_sync"
        bindtap="onSelectMode"
      >
        <view class="memory-mode-row">
          <view class="memory-mode-check {{mode === 'cloud_sync' ? 'on' : ''}}"></view>
          <view class="memory-mode-title">跨设备同步</view>
        </view>
        <view class="memory-mode-desc">保存少量脱敏消息，可在其他设备恢复。</view>
      </view>
    </view>

    <view class="memory-preference-section">
      <view class="memory-section-head">
        <view class="memory-section-title">已记住的偏好</view>
        <view class="memory-section-meta">只有你明确要求记住的内容</view>
      </view>
      <view class="memory-preference-loading" wx:if="{{preferencesLoading}}">正在读取…</view>
      <view class="memory-preference-empty" wx:elif="{{!preferences.length}}">暂无长期偏好</view>
      <view class="memory-preference-list" wx:else>
        <view class="memory-preference-item" wx:for="{{preferences}}" wx:key="key">
          <view class="memory-preference-copy">
            <view class="memory-preference-label">{{item.key === 'preferredName' ? '称呼' : (item.key === 'campus' ? '常用校区' : '默认提醒')}}</view>
            <view class="memory-preference-value">{{item.key === 'defaultReminderLeadMinutes' ? '提前 ' + item.value + ' 分钟' : item.value}}</view>
          </view>
          <button class="memory-preference-delete" data-key="{{item.key}}" bindtap="onDeletePreference" aria-label="删除这项记忆">删除</button>
        </view>
      </view>
    </view>

    <view class="memory-privacy-toggle" bindtap="onTogglePrivacyDetail">
      {{privacyExpanded ? '收起隐私说明' : '了解会保存什么'}}
    </view>
    <view class="memory-note" wx:if="{{privacyExpanded}}">
      <view>会保存：任务类型、班级/教师/教室等槽位、简短摘要、数据来源引用。</view>
      <view>不会保存：学号密码 Cookie Token、完整个人课表、原始 XLS、模型隐藏推理。</view>
      <view>保留周期：会话状态约 7 天；同步对话约 30 天。关闭同步后可选择是否删除云端数据。</view>
    </view>

    <view class="memory-actions memory-actions-stack">
      <button class="memory-action" bindtap="onClearLocal">清空本机消息</button>
      <button class="memory-action" bindtap="onClearCurrent">清除当前会话状态</button>
      <button class="memory-action danger text-danger" bindtap="onClearAll">清除全部云端记忆</button>
    </view>
  </scroll-view>
</view>
