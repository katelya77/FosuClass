<view class="memory-sheet" wx:if="{{visible}}">
  <view class="sheet-handle"></view>
  <view class="memory-head">
    <view class="memory-head-text">
      <view class="memory-title">记忆</view>
      <view class="memory-subtitle">选择保存范围；本机内容在服务器不可用时仍可查看。</view>
    </view>
    <button class="sheet-close-icon" bindtap="onClose" aria-label="关闭">✕</button>
  </view>

  <scroll-view class="memory-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="memory-inline-error" wx:if="{{inlineError}}">
      <view class="memory-inline-error-copy">{{inlineError}}</view>
      <button bindtap="onDismissInlineError" aria-label="关闭错误提示">知道了</button>
    </view>
    <view class="memory-undo" wx:if="{{undoItem}}">
      <text>已遗忘“{{undoItem.label || undoItem.key}}”</text>
      <button bindtap="onUndoDelete">撤销遗忘</button>
    </view>
    <view class="memory-mode-list">
      <view
        class="memory-mode-item {{mode === 'local_only' ? 'active' : ''}}"
        data-mode="local_only"
        bindtap="onSelectMode"
      >
        <view class="memory-mode-row">
          <view class="memory-mode-check {{mode === 'local_only' ? 'on' : ''}}"></view>
          <view class="memory-mode-title">仅本机</view>
        </view>
        <view class="memory-mode-desc">保存本机消息与偏好，直到你清除；不会跨设备。</view>
      </view>
      <view
        class="memory-mode-item {{mode === 'session_state' ? 'active' : ''}}"
        data-mode="session_state"
        bindtap="onSelectMode"
      >
        <view class="memory-mode-row">
          <view class="memory-mode-check {{mode === 'session_state' ? 'on' : ''}}"></view>
          <view class="memory-mode-title">保留当前对话状态</view>
        </view>
        <view class="memory-mode-desc">保存本对话的任务槽位与脱敏摘要约 7 天；不会跨对话或设备。</view>
      </view>
      <view
        class="memory-mode-item {{mode === 'cloud_sync' ? 'active' : ''}}"
        data-mode="cloud_sync"
        bindtap="onSelectMode"
      >
        <view class="memory-mode-row">
          <view class="memory-mode-check {{mode === 'cloud_sync' ? 'on' : ''}}"></view>
          <view class="memory-mode-title">跨设备记忆</view>
        </view>
        <view class="memory-mode-desc">保存低风险偏好与脱敏对话状态，按期限保留；可跨对话与设备恢复。</view>
      </view>
    </view>

    <view class="memory-auto-row" bindtap="onToggleAutoMemory">
      <view class="memory-auto-copy">
        <view class="memory-mode-title">自动记忆低风险偏好</view>
        <view class="memory-mode-desc">仅在跨设备同步开启时写入称呼/校区等；可随时暂停。</view>
      </view>
      <view class="memory-mode-check {{autoMemoryEnabled ? 'on' : ''}}"></view>
    </view>
    <view class="memory-policy-status">
      <text>{{autoMemoryEnabled ? '自动记忆已启用' : '自动记忆已暂停'}}</text>
      <text wx:if="{{memoryRevision}}"> · 配置版本 {{memoryRevision}}</text>
    </view>

    <view class="memory-preference-section">
      <view class="memory-section-head">
        <view class="memory-section-title">小序记得的内容</view>
        <view class="memory-section-meta">展示类别、作用域与更新时间；可修改或单项遗忘</view>
      </view>
      <view class="memory-preference-loading" wx:if="{{preferencesLoading}}">正在读取…</view>
      <view class="memory-preference-empty" wx:elif="{{!preferences.length}}">暂无已保存的内容</view>
      <view class="memory-preference-list" wx:else>
        <view class="memory-preference-item" wx:for="{{preferences}}" wx:key="key">
          <view class="memory-preference-copy">
            <view class="memory-preference-label">{{item.label || item.category || item.key}}</view>
            <view class="memory-preference-value">{{item.displayValue || item.value}}</view>
            <view class="memory-preference-meta" wx:if="{{item.scopeText || item.updatedAtText}}">
              <text wx:if="{{item.scopeText}}">{{item.scopeText}}</text>
              <text wx:if="{{item.updatedAtText}}"> · {{item.updatedAtText}}</text>
            </view>
            <view class="memory-preference-reason" wx:if="{{item.whyText}}">为什么记住：{{item.whyText}}</view>
            <view class="memory-preference-source" wx:if="{{item.sourceText}}">来源：{{item.sourceText}}</view>
          </view>
          <view class="memory-preference-actions">
            <button
              class="memory-preference-edit"
              wx:if="{{item.editable !== false}}"
              data-memory-id="{{item.memoryId}}"
              data-key="{{item.key}}"
              data-value="{{item.value}}"
              bindtap="onEditPreference"
              aria-label="修改这项记忆"
            >修改</button>
            <button class="memory-preference-delete" data-memory-id="{{item.memoryId}}" data-key="{{item.key}}" bindtap="onDeletePreference" aria-label="删除这项记忆">遗忘</button>
          </view>
        </view>
      </view>
    </view>

    <view class="memory-episode-section" wx:if="{{episodes.length}}">
      <view class="memory-section-head">
        <view class="memory-section-title">最近完成的任务</view>
        <view class="memory-section-meta">仅保留经核验的简短结果</view>
      </view>
      <view class="memory-episode-list">
        <view class="memory-episode-item" wx:for="{{episodes}}" wx:key="episodeId">
          <view class="memory-episode-goal">{{item.goal || '已完成任务'}}</view>
          <view class="memory-episode-summary">{{item.summary}}</view>
        </view>
      </view>
    </view>

    <view class="memory-privacy-toggle" bindtap="onTogglePrivacyDetail">
      {{privacyExpanded ? '收起隐私说明' : '了解会保存什么'}}
    </view>
    <view class="memory-note" wx:if="{{privacyExpanded}}">
      <view>会保存：任务类型、班级/教师/教室等槽位、简短摘要、数据来源引用。</view>
      <view>不会保存：学号密码 Cookie Token、完整个人课表、原始 XLS、模型隐藏推理。</view>
      <view>保留周期：会话状态约 7 天；同步对话约 30 天。关闭同步后可选择是否删除云端数据。</view>
    </view>

    <view class="memory-actions memory-actions-stack">
      <button class="memory-action" bindtap="onExportMemory" disabled="{{operationPending}}">导出我的记忆</button>
      <button class="memory-action" bindtap="onClearLocal">清空本机消息</button>
      <button class="memory-action" bindtap="onClearCurrent">清除当前会话状态</button>
      <button class="memory-action danger text-danger" bindtap="onClearAll">清除全部云端记忆</button>
    </view>
  </scroll-view>
</view>
