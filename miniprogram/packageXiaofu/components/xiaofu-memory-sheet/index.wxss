.memory-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  padding: 12rpx 24rpx 0;
  border-radius: 28rpx 28rpx 0 0;
  background: #fbfaf8;
  box-shadow: 0 -8rpx 40rpx rgba(40, 36, 32, 0.12);
  box-sizing: border-box;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 8rpx auto 18rpx;
  border-radius: 999rpx;
  background: rgba(40, 36, 32, 0.12);
  flex-shrink: 0;
}

.memory-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
  flex-shrink: 0;
}

.memory-head-text {
  min-width: 0;
  flex: 1;
}

.memory-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d2925;
  line-height: 1.35;
  white-space: nowrap;
}

.memory-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8178;
  line-height: 1.4;
}

.sheet-close {
  margin: 0;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: #6b635a;
  background: #efece7;
  border-radius: 999rpx;
  line-height: 1.4;
  flex-shrink: 0;
}

.sheet-close::after {
  border: none;
}

.memory-scroll {
  flex: 1;
  min-height: 0;
  max-height: 62vh;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.memory-mode-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
}

.memory-mode-item {
  width: 100%;
  box-sizing: border-box;
  margin: 0;
  padding: 18rpx 20rpx;
  text-align: left;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid rgba(40, 36, 32, 0.08);
  line-height: 1.4;
  min-height: 96rpx;
}

.memory-mode-item.active {
  border-color: rgba(196, 48, 43, 0.35);
  background: #fff8f7;
}

.memory-mode-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  width: 100%;
  min-width: 0;
}

.memory-mode-check {
  width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(40, 36, 32, 0.22);
  box-sizing: border-box;
  flex-shrink: 0;
}

.memory-mode-check.on {
  border-color: #c4302b;
  background: radial-gradient(circle at center, #c4302b 0 55%, transparent 58%);
}

.memory-mode-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2d2925;
  font-weight: 600;
  line-height: 1.35;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.memory-mode-desc {
  margin-top: 10rpx;
  margin-left: 40rpx;
  font-size: 22rpx;
  color: #6b635a;
  line-height: 1.5;
  white-space: normal;
  word-break: break-word;
  min-width: 0;
}

.memory-note {
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: #f3f0eb;
  font-size: 22rpx;
  color: #6b635a;
  line-height: 1.55;
}

.memory-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.memory-action {
  width: 100%;
  margin: 0;
  padding: 16rpx 12rpx;
  font-size: 24rpx;
  border-radius: 16rpx;
  background: #efece7;
  color: #3f3a34;
  line-height: 1.4;
  box-sizing: border-box;
}

.memory-action.danger {
  color: #c53030;
  background: #fff5f5;
}

.memory-action::after {
  border: none;
}

@media (min-width: 390px) {
  /* Keep danger actions stacked on all widths to avoid cramped small text */
  .memory-actions,
  .memory-actions-stack {
    flex-direction: column;
  }
  .memory-action {
    flex: 0 0 auto;
    width: 100%;
  }
}
