<view class="page ai-page">
  <!-- Slim header: conversation title primary; ≤2 icon actions; no thick card chrome -->
  <view class="xiaofu-header xiaofu-header-compact">
    <view class="xiaofu-avatar-wrap" aria-hidden="true">
      <image wx:if="{{hasHeroLogo}}" class="xiaofu-avatar" src="/assets/icons/ai-campus-butler.png" mode="aspectFit" binderror="onHeroLogoError" />
      <view wx:else class="xiaofu-avatar-text">佛</view>
    </view>
    <view class="xiaofu-title-block" bindtap="openConversationSheet" aria-label="打开对话列表">
      <view class="xiaofu-title-line xiaofu-title-sr"><text class="xiaofu-title">小佛助手</text></view>
      <view class="xiaofu-conversation-sub xiaofu-conversation-primary">{{activeConversationTitle || conversationTitle || '新对话'}}</view>
      <view class="xiaofu-status-line" wx:if="{{headerStatusLine}}">{{headerStatusLine}}</view>
    </view>
    <view class="xiaofu-actions">
      <button class="xiaofu-icon-btn" bindtap="openConversationSheet" aria-label="新建或对话列表">＋</button>
      <button class="xiaofu-icon-btn" bindtap="openHeaderMenu" aria-label="更多">···</button>
    </view>
  </view>

  <!-- Full content-width long capsule; collapsed/expanded share the same width. -->
  <view class="agent-status-island-wrap" id="agent-status-island-wrap">
    <view
      id="agent-status-capsule"
      class="agent-status-capsule {{agentActivityState}} {{statusCapsuleExpanded ? 'expanded' : ''}}"
      bindtap="toggleStatusCapsule"
      role="button"
      aria-label="{{statusCapsuleText}}"
    >
      <view class="agent-status-dot" aria-hidden="true"></view>
      <view class="agent-status-copy">
        <view class="agent-status-text">{{statusCapsuleText}}</view>
        <view class="agent-status-detail" wx:if="{{statusCapsuleExpanded}}">{{statusCapsuleDetail}}</view>
      </view>
      <view class="agent-status-chevron" aria-hidden="true">{{statusCapsuleExpanded ? '−' : '+'}}</view>
    </view>
  </view>

  <view
    class="in-app-reminder-banner {{inAppReminderBanner.kind}}"
    wx:if="{{inAppReminderBanner}}"
    bindtap="onOpenInAppReminder"
    role="button"
    aria-label="{{inAppReminderBanner.title}}，{{inAppReminderBanner.actionLabel}}"
  >
    <view class="in-app-reminder-copy">
      <view class="in-app-reminder-eyebrow">{{inAppReminderBanner.eyebrow || '应用内提醒'}}</view>
      <view class="in-app-reminder-title">{{inAppReminderBanner.title}}</view>
      <view class="in-app-reminder-detail">{{inAppReminderBanner.detail}}</view>
    </view>
    <view class="in-app-reminder-actions">
      <view class="in-app-reminder-link">{{inAppReminderBanner.actionLabel}} →</view>
      <button
        class="in-app-reminder-dismiss"
        catchtap="onAcknowledgeInAppReminder"
        loading="{{inAppReminderAcknowledging}}"
        disabled="{{inAppReminderAcknowledging}}"
        aria-label="知道了，不再显示这条应用内提醒"
      >知道了</button>
    </view>
  </view>

  <view class="history-trim-tip" wx:if="{{historyTrimNotice}}">已仅保留最近 20 条</view>

  <scroll-view
    class="message-scroll"
    style="padding-bottom: {{composerInsetPx || 120}}px;"
    scroll-y="{{!(showTaskPanel || showConversationSheet || showCapabilityGuide || showPrivacySheet || showHeaderMenu || showMemorySheet || showComposerPlus || showReminderSheet)}}"
    scroll-top="{{scrollTop}}"
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation="{{scrollWithAnimation}}"
    scroll-anchoring="{{true}}"
    enhanced
    show-scrollbar="{{false}}"
    lower-threshold="80"
  >
    <!-- Empty state: one verified contextual insight and at most three actions -->
    <view class="empty-welcome" wx:if="{{!messages.length}}">
      <view class="empty-brand">小佛助手</view>
      <view class="empty-title">可以直接告诉我你想完成的校园任务。</view>
      <button
        wx:if="{{proactiveInsight}}"
        class="proactive-insight {{proactiveInsight.kind}}"
        bindtap="onProactiveInsightTap"
        aria-label="{{proactiveInsight.title}}"
      >
        <view class="proactive-eyebrow">{{proactiveInsight.eyebrow}}</view>
        <view class="proactive-title">{{proactiveInsight.title}}</view>
        <view class="proactive-detail">{{proactiveInsight.detail}}</view>
        <view class="proactive-link" wx:if="{{proactiveInsight.actionLabel}}">{{proactiveInsight.actionLabel}} →</view>
      </button>
      <view class="contextual-action-row" wx:if="{{contextualActions.length}}">
        <button
          wx:for="{{contextualActions}}"
          wx:key="id"
          class="contextual-action"
          data-index="{{index}}"
          bindtap="onContextualActionTap"
        >{{item.label}}</button>
      </view>
      <view class="empty-safe-note" wx:if="{{showPrivacyTip}}">请勿输入学号、密码等敏感信息</view>
    </view>

    <view
      wx:for="{{messages}}"
      wx:for-item="message"
      wx:for-index="messageIndex"
      wx:key="id"
      class="message-row {{message.role}} {{message.showAvatar ? '' : 'no-avatar'}}"
    >
      <view wx:if="{{message.role == 'assistant' && message.showAvatar}}" class="assistant-avatar">
        <image wx:if="{{hasHeroLogo}}" class="avatar-logo" src="/assets/icons/ai-campus-butler.png" mode="aspectFit" />
        <text wx:else>佛</text>
      </view>
      <view wx:elif="{{message.role == 'assistant'}}" class="assistant-avatar-spacer"></view>

      <view
        class="message-body"
        data-message-id="{{message.id}}"
        data-role="{{message.role}}"
        bindlongpress="onMessageLongPress"
      >
        <!-- Assistant: flat text on page bg; User: soft brand bubble -->
        <view
          class="message-content-wrap {{message.role == 'user' ? 'user-bubble' : 'assistant-plain'}}"
          wx:if="{{message.content}}"
        >
          <view class="message-content">
            <safe-markdown
              wx:if="{{message.role == 'assistant'}}"
              content="{{message.content}}"
              selectable="{{true}}"
            />
            <text
              wx:else
              class="message-content-text"
              selectable="{{false}}"
              user-select="{{false}}"
            >{{message.content}}</text>
          </view>
          <view class="message-meta" wx:if="{{message.timeText}}">
            <text class="message-meta-text">{{message.timeText}}</text>
          </view>
          <view class="send-fail-retry" wx:if="{{message.role == 'user' && message.sendFailed}}" data-message-id="{{message.id}}" catchtap="onRetryUserMessage">重试</view>
        </view>

        <view class="fallback-banner" wx:if="{{message.fallbackBanner}}">{{message.fallbackBanner}}</view>

        <!-- Collapsed task trace from real Run Events only -->
        <view
          class="run-compact"
          wx:if="{{message.role == 'assistant' && message.hasCollapsedRun && message.runCompactText}}"
          data-message-id="{{message.id}}"
          bindtap="onToggleRunDetails"
        >{{message.runCompactText}} · 展开</view>

        <view class="task-trajectory" wx:if="{{message.role == 'assistant' && message.trajectoryExpanded && message.taskTrajectory}}">
          <view class="trajectory-section" wx:if="{{message.taskTrajectory.understanding}}">
            <view class="trajectory-label">理解</view>
            <view class="trajectory-body">「{{message.taskTrajectory.understanding}}」</view>
          </view>
          <view class="trajectory-section" wx:if="{{message.taskTrajectory.plan.length}}">
            <view class="trajectory-label">计划</view>
            <view class="trajectory-plan-item" wx:for="{{message.taskTrajectory.plan}}" wx:key="index" wx:for-item="p">{{p.index}}. {{p.label}}</view>
          </view>
          <view class="trajectory-section" wx:if="{{message.taskTrajectory.execution.length}}">
            <view class="trajectory-label">执行</view>
            <view class="trajectory-exec-item" wx:for="{{message.taskTrajectory.execution}}" wx:key="label" wx:for-item="e">
              <text class="trajectory-mark">{{e.status == 'failed' ? '×' : '✓'}}</text>
              <text>{{e.label}}</text>
            </view>
          </view>
          <view class="trajectory-section" wx:if="{{message.taskTrajectory.verification}}">
            <view class="trajectory-label">核验</view>
            <view class="trajectory-body">{{message.taskTrajectory.verification}}</view>
          </view>
          <view class="trajectory-collapse" data-message-id="{{message.id}}" bindtap="onToggleRunDetails">收起</view>
        </view>

        <xiaofu-agent-run
          wx:if="{{message.role == 'assistant' && message.displaySteps.length && !message.taskTrajectory}}"
          steps="{{message.displaySteps}}"
          taskSteps="{{message.taskSteps}}"
          evidenceText=""
          fallback="{{message.fallback}}"
          status="{{message.runStatus}}"
        />

        <!-- Evidence progressive disclosure only -->
        <view
          class="evidence-strip evidence-collapsed"
          wx:if="{{message.evidenceText && !message.evidenceExpanded}}"
          data-message-id="{{message.id}}"
          bindtap="onToggleEvidence"
        >{{message.evidenceCompact || message.evidenceText}}</view>
        <view class="evidence-strip evidence-expanded" wx:if="{{message.evidenceText && message.evidenceExpanded}}">
          <view>{{message.evidenceText}}</view>
          <view class="evidence-collapse" data-message-id="{{message.id}}" bindtap="onToggleEvidence">收起来源</view>
        </view>

        <view class="ai-card-list" wx:if="{{message.displayCards.length}}">
          <xiaofu-result-card
            wx:for="{{message.displayCards}}"
            wx:for-item="card"
            wx:for-index="cardIndex"
            wx:key="key"
            card="{{card}}"
            messageIndex="{{messageIndex}}"
            cardIndex="{{cardIndex}}"
            bind:action="onResultCardAction"
            bind:overflow="onResultCardOverflow"
          />
        </view>

        <!-- Compact suggestions: ≤2, text buttons not full-width pills -->
        <view class="suggestion-row" wx:if="{{message.suggestions.length}}">
          <button
            wx:for="{{message.suggestions}}"
            wx:key="*this"
            class="suggestion-chip"
            data-suggestion="{{item}}"
            bindtap="onSuggestionTap"
          >{{item}}</button>
        </view>
      </view>
    </view>

    <view class="slow-tip" wx:if="{{slowRequest}}">网络较慢，正在继续等待查询结果...</view>
    <xiaofu-live-run
      visible="{{sending && liveRunVisible}}"
      events="{{liveRunEvents}}"
      statusText="{{sendingStatusText}}"
      expanded="{{liveRunExpanded}}"
      bind:toggleexpand="onToggleLiveRunExpand"
    />
    <view class="sending-row" wx:if="{{sending && !liveRunVisible}}">
      <view class="sending-dot"></view>
      <view class="sending-text">{{sendingStatusText}}</view>
    </view>
    <view id="message-bottom-anchor" class="message-bottom-anchor"></view>
  </scroll-view>

  <view
    class="sheet-mask"
    wx:if="{{showTaskPanel || showConversationSheet || showCapabilityGuide || showPrivacySheet || showHeaderMenu || showMemorySheet || showComposerPlus || showReminderSheet}}"
    catchtap="closeSheets"
    catchtouchmove="preventScrollPassThrough"
  ></view>

  <xiaofu-conversation-sheet
    visible="{{showConversationSheet}}"
    conversations="{{conversations}}"
    bind:close="closeConversationSheet"
    bind:create="createNewConversation"
    bind:select="onConversationSheetSelect"
    bind:rename="onConversationSheetRename"
    bind:clear="onConversationSheetClear"
    bind:delete="onConversationSheetDelete"
    bind:pin="onConversationSheetPin"
  />

  <xiaofu-memory-sheet
    visible="{{showMemorySheet}}"
    mode="{{memoryMode}}"
    preferences="{{memoryPreferences}}"
    preferences-loading="{{memoryPreferencesLoading}}"
    auto-memory-enabled="{{autoMemoryEnabled}}"
    bind:close="closeMemorySheet"
    bind:change="onMemoryModeChange"
    bind:clearlocal="onClearLocalMemory"
    bind:clearcurrent="onClearCurrentMemory"
    bind:clearall="onClearAllMemory"
    bind:deletepreference="onDeleteMemoryPreference"
    bind:editpreference="onEditMemoryPreference"
    bind:toggleautomemory="onToggleAutoMemory"
  />

  <xiaofu-reminder-sheet
    visible="{{showReminderSheet}}"
    open-create="{{reminderSheetOpenCreate}}"
    bind:close="closeReminderSheet"
    bind:create="onReminderCreate"
    bind:change="onReminderChange"
  />

  <xiaofu-settings-sheet
    visible="{{showHeaderMenu}}"
    memoryStatusText="{{memoryStatusText}}"
    privacyStatusText="{{privacyStatusText}}"
    floatEnabled="{{xiaofuFloatEnabled}}"
    bind:close="closeHeaderMenu"
    bind:conversations="openConversationSheetFromMenu"
    bind:memory="openMemorySheet"
    bind:privacy="openPrivacySheet"
    bind:capability="openCapabilityGuide"
    bind:privacyhelp="openPrivacyHelp"
    bind:clear="clearHistory"
    bind:floatchange="onFloatSwitchChangeFromSheet"
  />

  <!-- Composer + quick actions sheet -->
  <view class="bottom-sheet composer-plus-sheet" wx:if="{{showComposerPlus}}">
    <view class="sheet-handle"></view>
    <view class="settings-sheet-head">
      <view class="settings-sheet-title">快捷操作</view>
      <button class="sheet-close-icon" bindtap="closeComposerPlus" aria-label="关闭">✕</button>
    </view>
    <scroll-view class="plus-action-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="plus-action-list">
        <view class="plus-action-section-label">现在就做</view>
        <view class="plus-action-grid">
          <button class="plus-action-card" bindtap="viewNextCourseFromPlus">
            <image class="plus-action-icon" src="/assets/icons/ai-actions/next-course.svg" mode="aspectFit" />
            <view class="plus-action-copy"><view class="plus-action-title">下一节课</view><view class="plus-action-desc">地点与出发建议</view></view>
          </button>
          <button class="plus-action-card" bindtap="createReminderFromPlus">
            <image class="plus-action-icon" src="/assets/icons/ai-actions/reminder-add.svg" mode="aspectFit" />
            <view class="plus-action-copy"><view class="plus-action-title">创建提醒</view><view class="plus-action-desc">先确认再开启</view></view>
          </button>
          <button class="plus-action-card" bindtap="findEmptyRoomFromPlus">
            <image class="plus-action-icon" src="/assets/icons/ai-actions/room-search.svg" mode="aspectFit" />
            <view class="plus-action-copy"><view class="plus-action-title">找空教室</view><view class="plus-action-desc">按时段核验占用</view></view>
          </button>
          <button class="plus-action-card" bindtap="openPersonalSyncFromPlus">
            <image class="plus-action-icon" src="/assets/icons/ai-actions/schedule-import.svg" mode="aspectFit" />
            <view class="plus-action-copy"><view class="plus-action-title">导入课表</view><view class="plus-action-desc">补全个人上下文</view></view>
          </button>
        </view>
        <view class="plus-action-section-label plus-action-more-label">更多入口</view>
        <view class="plus-action-secondary">
          <button class="plus-action-row" bindtap="openRemindersFromPlus"><image class="plus-action-icon" src="/assets/icons/ai-actions/reminder-manage.svg" mode="aspectFit" /><view class="plus-action-title">管理提醒</view><view class="plus-action-arrow">›</view></button>
          <button class="plus-action-row" bindtap="openTaskPanelFromPlus"><image class="plus-action-icon" src="/assets/icons/ai-actions/campus-tools.svg" mode="aspectFit" /><view class="plus-action-title">校园工具</view><view class="plus-action-arrow">›</view></button>
          <button class="plus-action-row" bindtap="openCampusMapFromPlus"><image class="plus-action-icon" src="/assets/icons/ai-actions/campus-map.svg" mode="aspectFit" /><view class="plus-action-title">校园地图</view><view class="plus-action-arrow">›</view></button>
          <button class="plus-action-row" bindtap="startVoiceFromPlus" wx:if="{{voiceInputVisible}}"><image class="plus-action-icon" src="/assets/icons/ai-actions/voice.svg" mode="aspectFit" /><view class="plus-action-title">语音输入</view><view class="plus-action-arrow">›</view></button>
          <button class="plus-action-row" bindtap="createNewConversationFromPlus"><image class="plus-action-icon" src="/assets/icons/ai-actions/conversation-new.svg" mode="aspectFit" /><view class="plus-action-title">新建对话</view><view class="plus-action-arrow">›</view></button>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="bottom-sheet task-sheet" wx:if="{{showTaskPanel}}">
    <view class="sheet-handle"></view>
    <view class="task-panel-head">
      <view class="panel-title-wrap">
        <view class="task-panel-title">校园工具</view>
        <view class="task-panel-subtitle">课表、校园信息和常用入口</view>
      </view>
      <button class="sheet-close-icon" bindtap="closeTaskPanel" aria-label="关闭">✕</button>
    </view>
    <scroll-view wx:if="{{taskPanelReady}}" class="task-section-scroll" scroll-y enhanced scroll-with-animation="{{false}}" show-scrollbar="{{false}}">
      <view
        wx:for="{{taskPanelGroups}}"
        wx:for-item="group"
        wx:for-index="groupIndex"
        wx:key="title"
        class="task-section"
      >
        <view class="task-section-title">{{group.title}}</view>
        <button
          wx:for="{{group.items}}"
          wx:for-item="task"
          wx:for-index="taskIndex"
          wx:key="label"
          class="task-item"
          data-group-index="{{groupIndex}}"
          data-task-index="{{taskIndex}}"
          bindtap="onTaskPanelItemTap"
        >
          <image class="task-icon" src="{{task.iconPath}}" mode="aspectFit" />
          <view class="task-copy">
            <view class="task-label">{{task.label}}</view>
            <view class="task-desc">{{task.desc}}</view>
          </view>
        </button>
      </view>
    </scroll-view>
    <view wx:else class="task-section-loading">加载中</view>
  </view>

  <view class="bottom-sheet capability-sheet" wx:if="{{showCapabilityGuide}}">
    <view class="sheet-handle"></view>
    <view class="task-panel-head">
      <view class="panel-title-wrap">
        <view class="task-panel-title">小佛能做什么</view>
        <view class="task-panel-subtitle">选择示例后，会在当前对话中整理结果</view>
      </view>
      <button class="sheet-close-icon" bindtap="closeCapabilityGuide" aria-label="关闭">✕</button>
    </view>
    <scroll-view class="capability-scroll" scroll-y enhanced scroll-with-animation="{{false}}" show-scrollbar="{{false}}">
      <view
        wx:for="{{capabilityGuideGroups}}"
        wx:for-item="group"
        wx:key="title"
        class="capability-section"
      >
        <view class="capability-title">{{group.title}}</view>
        <view class="capability-list">
          <button
            wx:for="{{group.items}}"
            wx:for-item="example"
            wx:key="*this"
            class="capability-chip"
            data-text="{{example}}"
            bindtap="onCapabilityExampleTap"
          >{{example}}</button>
        </view>
      </view>
      <button class="capability-map-btn" bindtap="openCampusMapFromGuide">查看校园地图</button>
    </scroll-view>
  </view>

  <view class="bottom-sheet privacy-sheet" wx:if="{{showPrivacySheet}}">
    <view class="sheet-handle"></view>
    <view class="privacy-head">
      <view class="privacy-copy">
        <view class="privacy-title">个人课表授权</view>
        <view class="privacy-desc">{{privacyText}}</view>
      </view>
      <switch
        class="privacy-switch"
        checked="{{allowPersonalContext}}"
        color="#3d7a5a"
        bindchange="onPersonalContextToggle"
      />
    </view>
    <view class="privacy-footer">
      <text>{{privacyStatusText}}</text>
      <button wx:if="{{showPrivacyTip}}" class="privacy-btn" bindtap="dismissPrivacyTip">{{privacyActionLabel}}</button>
      <button wx:else class="privacy-btn secondary" bindtap="closePrivacySheet">关闭</button>
    </view>
  </view>

  <!-- Unified floating pill composer: [+] [input] [mic/stop] [send]; safe-area only on outer shell -->
  <view class="composer" id="composer-shell">
    <view class="composer-pill" id="composer-pill">
      <button class="composer-icon-btn composer-plus-btn" bindtap="openComposerPlus" disabled="{{sending}}" aria-label="快捷操作">
        <image class="composer-icon" src="/assets/icons/composer/plus.svg" mode="aspectFit" aria-hidden="true" />
      </button>
      <view class="composer-input-wrap">
        <view wx:if="{{!inputValue}}" class="composer-custom-placeholder">告诉小佛你想完成什么…</view>
        <textarea
          class="composer-input"
          value="{{inputValue}}"
          placeholder=""
          auto-height="{{true}}"
          maxlength="600"
          fixed="{{false}}"
          cursor-spacing="12"
          focus="{{inputFocus}}"
          confirm-type="send"
          confirm-hold="{{false}}"
          show-confirm-bar="{{false}}"
          adjust-position="{{true}}"
          bindinput="onInput"
          bindconfirm="onComposerConfirm"
          bindcompositionstart="onCompositionStart"
          bindcompositionend="onCompositionEnd"
          disabled="{{sending}}"
        />
      </view>
      <button
        wx:if="{{voiceInputVisible && !sending}}"
        class="composer-icon-btn voice-btn {{voiceRecording ? 'recording' : ''}} {{voiceRecognizing ? 'disabled' : ''}}"
        bindtap="onVoiceTap"
        disabled="{{voiceRecognizing}}"
        aria-label="{{voiceRecording ? '停止录音' : '语音输入'}}"
      >
        <image
          class="composer-icon"
          src="{{voiceRecording ? '/assets/icons/composer/stop-wave.svg' : '/assets/icons/composer/microphone.svg'}}"
          mode="aspectFit"
          aria-hidden="true"
        />
      </button>
      <button
        class="composer-icon-btn send-btn icon-send {{!sending && !inputValue ? 'disabled' : ''}} {{sending ? 'cancel' : ''}}"
        bindtap="onSubmit"
        disabled="{{!sending && !inputValue}}"
        aria-label="{{sending ? '停止' : '发送'}}"
      >
        <image
          wx:if="{{!sending}}"
          class="composer-icon composer-icon-send"
          src="/assets/icons/composer/send.svg"
          mode="aspectFit"
          aria-hidden="true"
        />
        <view wx:else class="composer-stop-mark" aria-hidden="true"></view>
      </button>
    </view>
    <view wx:if="{{voiceStatusText}}" class="voice-status">{{voiceStatusText}}</view>
  </view>
  <xiaofu-float />
</view>
