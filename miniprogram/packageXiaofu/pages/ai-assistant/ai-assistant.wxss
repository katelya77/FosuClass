  gap: 14rpx;
  margin-top: 16rpx;
  color: var(--xf-gray);
  font-size: 20rpx;
  font-weight: 800;
}

.privacy-footer text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.privacy-btn {
  flex: 0 0 auto;
  height: 46rpx;
  min-width: 98rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--xf-primary-strong);
  color: var(--xf-surface);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-align: center;
}

.privacy-btn.secondary {
  background: #f1f3f6;
  color: #4b5563;
}

.composer {
  /* In-flow bottom chrome: no absolute overlay blank covering messages */
  position: relative;
  flex: 0 0 auto;
  z-index: 30;
  box-sizing: border-box;
  width: 100%;
  margin: 0;
  padding: 8rpx 8rpx calc(10rpx + env(safe-area-inset-bottom));
  border-top: 0;
  background: #f6f4f1;
  box-shadow: none;
}

.composer-pill {
  display: flex;
  align-items: center;
  gap: 4rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  max-height: 280rpx;
  padding: 8rpx 12rpx;
  border: 1rpx solid rgba(42, 38, 34, 0.1);
  border-radius: 999rpx;
  background: #fbf9f6;
  box-shadow: 0 8rpx 28rpx rgba(42, 38, 34, 0.08);
}

.composer-icon-btn {
  flex: 0 0 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  line-height: 1;
}

.composer-icon-btn::after {
  border: 0;
}

.composer-icon {
  width: 40rpx;
  height: 40rpx;
}

.composer-icon-send {
  width: 36rpx;
  height: 36rpx;
}

.composer-plus-btn {
  color: var(--xf-text-soft);
}

.voice-btn {
  color: var(--xf-text-soft);
}

.voice-btn.recording {
  background: rgba(185, 28, 28, 0.1);
}

.voice-btn.disabled {
  opacity: 0.45;
}

.composer-input-wrap {
  position: relative;
  box-sizing: border-box;
  flex: 1 1 auto;
  min-width: 0;
  min-height: 68rpx;
  max-height: 240rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.composer-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 68rpx;
  max-height: 240rpx;
  padding: 16rpx 8rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--xf-text);
  font-size: 28rpx;
  line-height: 1.45;
}

.composer-custom-placeholder {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 50%;
  z-index: 1;
  overflow: hidden;
  color: #a5adba;
  font-size: 24rpx;
  line-height: 1.2;
  pointer-events: none;
  text-overflow: ellipsis;
  transform: translateY(-50%);
  white-space: nowrap;
}

.voice-status {
  height: 28rpx;
  margin-top: 6rpx;
  color: #64748b;
  font-size: 18rpx;
  font-weight: 650;
  line-height: 28rpx;
  text-align: center;
}

.send-btn {
  flex: 0 0 72rpx;
  width: 72rpx;
  min-width: 72rpx;
  background: var(--xf-primary-strong);
}

.send-btn.disabled {
  background: rgba(198, 40, 40, 0.28);
  opacity: 1;
}

.send-btn.cancel {
  background: var(--xf-danger-strong, #7d302e);
}

.composer-stop-mark {
  width: 22rpx;
  height: 22rpx;
  border-radius: 4rpx;
  background: #fff;
}

.send-btn.icon-send {
  min-width: 72rpx;
  width: 72rpx;
  padding: 0;
  border-radius: 999rpx;
}

/* Settings sheet system */
.settings-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 16rpx 20rpx;
}

.settings-sheet-title {
  color: var(--xf-text);
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-close-icon {
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  border-radius: 32rpx;
  background: var(--xf-surface-soft);
  color: var(--xf-text-secondary);
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
}

.settings-sheet-scroll {
  max-height: 62vh;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.settings-section {
  margin-bottom: 12rpx;
  padding: 0 8rpx;
}

.settings-section-label {
  padding: 12rpx 16rpx 8rpx;
  color: #9a9188;
  font-size: 22rpx;
  font-weight: 600;
}

.settings-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 96rpx;
  padding: 16rpx 12rpx;
  gap: 14rpx;
  border-bottom: 1rpx solid rgba(42, 38, 34, 0.06);
}

.settings-row-icon {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: var(--xf-surface-soft);
  color: var(--xf-text-secondary);
  font-size: 22rpx;
  line-height: 48rpx;
  text-align: center;
}

.settings-row-body {
  flex: 1 1 auto;
  min-width: 0;
}

.settings-row .header-menu-row-title {
  flex: none;
  width: 100%;
  color: var(--xf-text);
  font-size: 28rpx;
  font-weight: 600;
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
}

.settings-row-desc {
  margin-top: 4rpx;
  color: #9a9188;
  font-size: 22rpx;
  line-height: 1.4;
  white-space: normal;
  word-break: break-word;
}

.settings-row-switch {
  padding-right: 8rpx;
}

.settings-switch {
  flex: 0 0 auto;
  transform: scale(0.9);
}

.settings-section-danger .header-menu-row-title {
  color: #b91c1c;
}

.plus-action-list {
  box-sizing: border-box;
  width: 100%;
  padding: 4rpx 6rpx calc(24rpx + env(safe-area-inset-bottom));
}

.plus-action-scroll {
  box-sizing: border-box;
  width: 100%;
  max-height: calc(72vh - 104rpx - env(safe-area-inset-bottom));
}

.plus-action-section-label {
  margin: 4rpx 2rpx 12rpx;
  color: #766f67;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.plus-action-more-label {
  margin-top: 22rpx;
}

.plus-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  width: 100%;
}

.plus-action-card {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  width: 100%;
  min-height: 126rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid #e8e3dc;
  border-radius: 18rpx;
  background: #fffdf9;
  text-align: left;
}

.plus-action-icon {
  flex: 0 0 auto;
  width: 42rpx;
  height: 42rpx;
}

.plus-action-copy {
  flex: 1;
  min-width: 0;
}

.plus-action-title {
  color: var(--xf-text);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
}

.plus-action-desc {
  margin-top: 7rpx;
  color: #837b72;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.35;
}

.plus-action-secondary {
  overflow: hidden;
  width: 100%;
  border: 1rpx solid #e8e3dc;
  border-radius: 18rpx;
  background: #fffdf9;
}

.plus-action-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-height: 88rpx;
  padding: 18rpx 16rpx;
  border-bottom: 1rpx solid #eeeae4;
  text-align: left;
}

.plus-action-row:last-child {
  border-bottom: 0;
}

.plus-action-row .plus-action-title {
  flex: 1;
  min-width: 0;
}

.plus-action-arrow {
  flex: 0 0 auto;
  color: #a49b91;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 1;
}

.xiaofu-settings-sheet {
  max-height: 78vh;
}

.composer-plus-sheet {
  max-height: 72vh;
  padding-right: 18rpx;
  padding-left: 18rpx;
}

@media (max-width: 360px) {
  .ai-page {
    padding-left: 12rpx;
    padding-right: 12rpx;
  }

  .quick-action-pill {
    width: 154rpx;
  }

  .xiaofu-header {
    gap: 8rpx;
    padding-left: 10rpx;
    padding-right: 10rpx;
  }

  .xiaofu-avatar-wrap {
    width: 52rpx;
    height: 52rpx;
  }

  
.xiaofu-title-line {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.xiaofu-title {
    font-size: 28rpx;
  }

  .xiaofu-actions {
    flex-basis: 104rpx;
    width: 104rpx;
    min-width: 104rpx;
    gap: 4rpx;
  }

  .xiaofu-icon-btn {
    flex-basis: 50rpx;
    width: 50rpx;
    height: 50rpx;
    min-width: 50rpx;
    max-width: 50rpx;
    min-height: 50rpx;
    line-height: 50rpx;
  }

  .quick-action-label {
    max-width: 86rpx;
  }

  .message-row.user .message-body {
    max-width: 84%;
  }

  .in-app-reminder-banner {
    align-items: flex-start;
  }

  .in-app-reminder-actions {
    margin-left: 8rpx;
  }

  .in-app-reminder-link {
    display: none;
  }

  .in-app-reminder-dismiss {
    min-width: 88rpx;
    margin-top: 0;
  }

  .send-btn {
    width: 104rpx;
  }
}

.weather-icon-css{width:72rpx;height:72rpx;border-radius:50%;background:#f5b942;opacity:.9;}

@media (prefers-color-scheme: dark) {
  .ai-page {
    background: #181614;
  }

  .xiaofu-header-compact {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .xiaofu-conversation-primary,
  .empty-brand,
  .proactive-title,
  .contextual-action {
    color: #f4f0ea;
  }

  .empty-title,
  .proactive-detail {
    color: #bcb3aa;
  }

  .proactive-insight {
    border-color: #3d3833;
    border-left-color: #e05b55;
    background: #24211e;
    box-shadow: none;
  }

  .proactive-insight.schedule_change {
    border-left-color: #c58350;
  }

  .proactive-insight.free_day,
  .proactive-insight.day_finished {
    border-left-color: #68a982;
  }

  .proactive-link {
    color: #ef7771;
  }

  .in-app-reminder-banner {
    border-color: rgba(104, 169, 130, 0.3);
    border-left-color: #68a982;
    background: #202620;
  }

  .in-app-reminder-banner.schedule_change {
    border-color: rgba(224, 91, 85, 0.28);
    border-left-color: #e05b55;
    background: #2a1e1d;
  }

  .in-app-reminder-eyebrow,
  .in-app-reminder-link {
    color: #86c49e;
  }

  .in-app-reminder-banner.schedule_change .in-app-reminder-eyebrow {
    color: #ef7771;
  }

  .in-app-reminder-title {
    color: #f4f0ea;
  }

  .in-app-reminder-detail {
    color: #bcb3aa;
  }

  .in-app-reminder-dismiss {
    background: #312c27;
    color: #e5ded6;
  }

  .contextual-action {
    border-bottom-color: #4a433d;
  }
}

@media (prefers-reduced-motion: reduce) {
  .agent-status-capsule,
  .composer,
  .send-btn,
  .voice-btn {
    transition: none !important;
    animation: none !important;
  }
}
