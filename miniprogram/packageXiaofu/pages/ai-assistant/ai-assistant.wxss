@import "../../styles/xiaofu-tokens.wxss";

.ai-page {
  box-sizing: border-box;
  position: relative;
  display: flex;
  height: 100vh;
  min-height: 100vh;
  flex-direction: column;
  overflow: hidden;
  /* Flex column: scroll fills middle, composer is real bottom chrome (no absolute overlay blank). */
  padding: calc(8rpx + env(safe-area-inset-top)) 16rpx 0;
  padding-bottom: 0;
  background: #f6f4f1;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  text-align: inherit;
}

button::after {
  border: 0;
}

.card {
  box-sizing: border-box;
  border-radius: 16rpx;
  background: var(--xf-surface);
}

.xiaofu-header {
  box-sizing: border-box;
  position: relative;
  z-index: 30;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 12rpx;
  min-height: 96rpx;
  max-height: 112rpx;
  padding: 10rpx 4rpx 12rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.xiaofu-header-compact {
  min-height: 96rpx;
  padding: 8rpx 2rpx 10rpx;
  gap: 10rpx;
  box-shadow: none;
  border-bottom: 1rpx solid rgba(42, 38, 34, 0.06);
}

.xiaofu-header-compact .xiaofu-avatar-wrap {
  flex-basis: 48rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  box-shadow: none;
  background: #ebe7e1;
}

.xiaofu-header-compact .xiaofu-avatar,
.xiaofu-header-compact .xiaofu-avatar-text {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 20rpx;
  border-radius: 12rpx;
}

/* Full content-width capsule: same width collapsed/expanded; no extra wrapper inset */
.agent-status-island-wrap {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 auto;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin: 4rpx 0 2rpx;
  padding: 0;
}

.agent-status-capsule {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 auto;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  max-width: 100%;
  min-height: 56rpx;
  max-height: none;
  margin: 0;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(42, 38, 34, 0.08);
  border-radius: 999rpx;
  background: rgba(42, 38, 34, 0.05);
  color: var(--xf-text);
  box-shadow: 0 2rpx 8rpx rgba(42, 38, 34, 0.06);
  /* Animate height / opacity / translate only — never width */
  transition:
    min-height 200ms cubic-bezier(0.22, 1, 0.36, 1),
    border-radius 200ms cubic-bezier(0.22, 1, 0.36, 1),
    background-color 200ms ease-out,
    transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  transform: translateY(0);
}

.agent-status-capsule.expanded {
  min-height: 96rpx;
  border-radius: 28rpx;
  width: 100%;
  max-width: 100%;
  align-items: flex-start;
  padding: 14rpx 18rpx;
  transform: translateY(0);
}

/* Symmetric side rails so title reads centered */
.agent-status-dot {
  flex: 0 0 28rpx;
  width: 12rpx;
  height: 12rpx;
  margin: 0 8rpx 0 0;
  border-radius: 999rpx;
  background: currentColor;
  opacity: 0.55;
}

.agent-status-copy {
  flex: 1 1 auto;
  min-width: 0;
  text-align: center;
}

.agent-status-chevron {
  flex: 0 0 28rpx;
  width: 28rpx;
  margin-left: 8rpx;
  color: inherit;
  font-size: 28rpx;
  line-height: 1;
  text-align: center;
  opacity: 0.65;
}

.agent-status-capsule.expanded .agent-status-copy {
  flex: 1 1 auto;
  max-width: none;
  min-width: 0;
  text-align: left;
}

.agent-status-detail {
  margin-top: 6rpx;
  opacity: 0;
  transform: translateY(-4rpx);
  transition: opacity 200ms ease-out, transform 200ms ease-out;
  pointer-events: none;
}

.agent-status-capsule.expanded .agent-status-detail {
  white-space: normal;
  word-break: break-word;
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

@media (prefers-reduced-motion: reduce) {
  .agent-status-capsule,
  .agent-status-detail {
    transition: none !important;
  }
}

.agent-status-capsule.waiting_confirmation {
  background: rgba(108, 61, 46, 0.1);
  border-color: rgba(108, 61, 46, 0.22);
  color: #6c3d2e;
}

.agent-status-capsule.complete {
  background: rgba(47, 111, 78, 0.08);
  border-color: rgba(47, 111, 78, 0.2);
  color: var(--xf-success-strong);
}

.agent-status-capsule.network_error {
  background: rgba(125, 48, 46, 0.1);
  border-color: rgba(125, 48, 46, 0.22);
  color: #7d302e;
}

.in-app-reminder-banner {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  width: 100%;
  min-height: 128rpx;
  margin: 14rpx 0 2rpx;
  padding: 18rpx 18rpx 18rpx 20rpx;
  border: 1rpx solid rgba(47, 111, 78, 0.2);
  border-left: 6rpx solid var(--xf-success-strong);
  border-radius: 18rpx;
  background: #f3f7f4;
}

.in-app-reminder-banner.schedule_change {
  border-color: rgba(198, 40, 40, 0.2);
  border-left-color: var(--xf-primary-strong);
  background: #fff6f4;
}

.in-app-reminder-copy {
  flex: 1 1 auto;
  min-width: 0;
}

.in-app-reminder-eyebrow {
  color: var(--xf-success-strong);
  font-size: 19rpx;
  font-weight: 650;
  line-height: 1.3;
}

.in-app-reminder-banner.schedule_change .in-app-reminder-eyebrow {
  color: #a82121;
}

.in-app-reminder-title {
  overflow: hidden;
  margin-top: 5rpx;
  color: var(--xf-text);
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.in-app-reminder-detail {
  overflow: hidden;
  margin-top: 5rpx;
  color: #766f67;
  font-size: 20rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.in-app-reminder-actions {
  flex: 0 0 auto;
  margin-left: 16rpx;
  text-align: right;
}

.in-app-reminder-link {
  color: var(--xf-success-strong);
  font-size: 19rpx;
  font-weight: 650;
  line-height: 1.4;
}

.in-app-reminder-dismiss {
  min-width: 104rpx;
  min-height: 64rpx;
  margin: 8rpx 0 0;
  padding: 0 14rpx;
  border: 0;
  border-radius: 12rpx;
  background: var(--xf-surface);
  color: #5f5851;
  font-size: 20rpx;
  line-height: 64rpx;
}

.in-app-reminder-dismiss::after {
  border: 1rpx solid rgba(42, 38, 34, 0.1);
  border-radius: 12rpx;
}

/* Dot visual (size rails set earlier for left/right symmetry) */
.agent-status-dot {
  border: 3rpx solid rgba(42, 38, 34, 0.08);
  background: #c9c2ba;
  opacity: 1;
}

.agent-status-capsule.querying .agent-status-dot,
.agent-status-capsule.composing .agent-status-dot,
.agent-status-capsule.thinking .agent-status-dot,
.agent-status-capsule.understanding .agent-status-dot {
  background: #f3b34c;
}

.agent-status-capsule.complete .agent-status-dot {
  background: var(--xf-success-strong);
}

.agent-status-text {
  overflow: hidden;
  color: var(--xf-text-strong);
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-status-detail {
  margin-top: 7rpx;
  color: var(--xf-text-secondary);
  font-size: 19rpx;
  line-height: 1.45;
}

.agent-status-chevron {
  color: var(--xf-text-faint);
}

.xiaofu-conversation-primary {
  margin-top: 0;
  font-size: 30rpx;
  font-weight: 650;
  color: var(--xf-text);
  line-height: 1.3;
}

.xiaofu-status-line {
  margin-top: 4rpx;
  max-width: 100%;
  overflow: hidden;
  color: #9a9188;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Keep product name in DOM for accessibility/tests without repeating large header title */
.xiaofu-title-sr {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.ai-mode-row-slim {
  margin-top: 8rpx;
  margin-bottom: 4rpx;
}

.run-compact {
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--xf-surface-soft);
  color: var(--xf-text-secondary);
  font-size: 20rpx;
  line-height: 1.3;
  align-self: flex-start;
}

.evidence-collapsed {
  opacity: 0.85;
}

.evidence-collapse {
  margin-top: 6rpx;
  color: var(--xf-text-faint);
  font-size: 20rpx;
}

/* Default feedback-row removed from product UI; feedback only via long-press */

.header-menu-list {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding: 0 8rpx 24rpx;
  box-sizing: border-box;
}

.header-menu-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 88rpx;
  padding: 18rpx 16rpx;
  margin: 0;
  border-radius: 0;
  border-bottom: 1rpx solid rgba(40, 36, 32, 0.06);
  background: transparent;
  text-align: left;
}

.header-menu-row-title {
  flex: 1 1 auto;
  color: #2b2622;
  font-size: 28rpx;
  font-weight: 600;
}

.header-menu-row-meta {
  flex: 0 1 auto;
  margin-right: 8rpx;
  color: var(--xf-text-faint);
  font-size: 22rpx;
  line-height: 1.35;
  white-space: normal;
  word-break: break-word;
}

.header-menu-row-arrow {
  flex: 0 0 auto;
  color: #b0a8a0;
  font-size: 32rpx;
  line-height: 1;
}

.header-menu-row.danger .header-menu-row-title {
  color: var(--xf-primary-strong);
}

.header-menu-sheet-full .task-panel-head {
  width: 100%;
}

.xiaofu-avatar-wrap {
  flex: 0 0 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: var(--xf-surface);
  box-shadow: 0 8rpx 18rpx rgba(198, 40, 40, 0.12);
}

.xiaofu-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
}

.xiaofu-avatar-text {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: var(--xf-primary-strong);
  color: var(--xf-surface);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 48rpx;
  text-align: center;
}

.xiaofu-title-block {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
  overflow: hidden;
}



.xiaofu-conversation-sub {
  max-width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--xf-text-soft);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xiaofu-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
  max-width: 100%;
  min-width: 0;
}

.xiaofu-chip {
  max-width: 100%;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--xf-surface-soft);
  color: var(--xf-text-secondary);
  font-size: 18rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.xiaofu-chip.soft {
  background: #efece7;
  color: var(--xf-text-faint);
}

.xiaofu-chip.status-online {
  color: #2f855a;
  background: rgba(47, 133, 90, 0.1);
}

.xiaofu-chip.status-offline,
.xiaofu-chip.status-warn {
  color: #c05621;
  background: rgba(192, 86, 33, 0.1);
}

.send-btn.cancel {
  background: var(--xf-text-soft) !important;
  color: #fff !important;
  min-width: 72rpx;
}

.task-card-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.task-entry-card {
  margin: 0;
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  background: var(--xf-surface);
  border: 1rpx solid rgba(40, 36, 32, 0.06);
  box-shadow: 0 8rpx 20rpx rgba(40, 36, 32, 0.04);
  text-align: left;
  line-height: 1.35;
}

.task-entry-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #2d2925;
}

.task-entry-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--xf-text-faint);
}

.fallback-banner {
  margin: 8rpx 0 4rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: #fff7ed;
  color: #9a3412;
  font-size: 22rpx;
  line-height: 1.4;
  border: 1rpx solid rgba(194, 120, 40, 0.18);
}



.send-btn.icon-send {
  min-width: 72rpx;
  width: 72rpx;
  padding: 0;
  font-size: 28rpx;
  font-weight: 700;
}


.xiaofu-title-line {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.xiaofu-title {
  flex: 0 0 auto;
  color: var(--xf-text-strong);
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.xiaofu-actions {
  flex: 0 0 120rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  width: 110rpx;
  min-width: 110rpx;
}

.xiaofu-icon-btn {
  flex: 0 0 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  min-width: 56rpx;
  max-width: 56rpx;
  min-height: 56rpx;
  padding: 0;
  border-radius: 14rpx;
  background: transparent;
  color: var(--xf-text-soft);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 56rpx;
  text-align: center;
}

.ai-mode-row {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  margin-top: 12rpx;
  padding: 0 8rpx;
}

.quick-action-scroll {
  flex: 0 0 auto;
  width: 100%;
  min-width: 0;
  height: 60rpx;
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
}

.quick-action-list {
  display: inline-flex;
  gap: 8rpx;
  padding: 1rpx 10rpx 5rpx 2rpx;
}

.quick-action-pill {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 156rpx;
  height: 52rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #374151;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 52rpx;
  box-shadow: 0 6rpx 18rpx rgba(31, 41, 55, 0.05);
}

.quick-action-pill.today {
  color: #1f5f8b;
}

.quick-action-pill.room {
  color: var(--xf-success-strong);
}

.quick-action-pill.classroom {
  color: #7a4f28;
}

.quick-action-pill.teacher {
  color: #8a4b4b;
}

.quick-action-pill.xls,
.quick-action-pill.sync {
  color: #6b4d16;
}

.quick-action-icon {
  flex: 0 0 auto;
  width: 31rpx;
  height: 31rpx;
}

.quick-action-label {
  max-width: 94rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-nav-segment {
  box-sizing: border-box;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 186rpx;
  max-width: 60vw;
  height: 42rpx;
  padding: 3rpx;
  overflow: hidden;
  border: 1rpx solid rgba(214, 222, 232, 0.92);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 4rpx 12rpx rgba(31, 41, 55, 0.035);
}

.quick-nav-option {
  box-sizing: border-box;
  flex: 1 1 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  height: 34rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #5f6b7c;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 34rpx;
  text-align: center;
  box-shadow: none;
}

.quick-nav-option.active {
  background: #f2faf5;
  color: var(--xf-success-strong);
  box-shadow: 0 3rpx 10rpx rgba(47, 111, 78, 0.08);
}

.quick-nav-option text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-trim-tip {
  flex: 0 0 auto;
  margin: 6rpx 4rpx 0;
  color: #8a6f64;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.message-scroll {
  box-sizing: border-box;
  width: 100%;
  flex: 1 1 auto;
  min-height: 0;
  margin-top: 10rpx;
  /* Composer sits in flex flow below; only a tight gap to the pill top edge. */
  padding: 4rpx 0 12rpx;
}

.message-bottom-anchor {
  width: 1rpx;
  height: 1rpx;
}

.empty-welcome {
  box-sizing: border-box;
  width: 100%;
  max-height: none;
  margin: 48rpx 0 24rpx;
  padding: 12rpx 0 8rpx;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.empty-brand {
  color: var(--xf-text);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 0.02em;
}

.empty-title {
  margin-top: 12rpx;
  color: var(--xf-text-secondary);
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.5;
}

.empty-desc {
  margin-top: 10rpx;
  color: var(--xf-gray);
  font-size: 23rpx;
  line-height: 1.45;
}

button.proactive-insight {
  box-sizing: border-box;
  display: block;
  width: 100%;
  max-width: none;
  min-height: 210rpx;
  margin: 30rpx 0 0;
  padding: 26rpx 28rpx 24rpx;
  border: 1rpx solid #e5dfd7;
  border-left: 8rpx solid var(--xf-primary-strong);
  border-radius: 18rpx;
  background: var(--xf-surface);
  box-shadow: 0 8rpx 24rpx rgba(42, 38, 34, 0.06);
  text-align: left;
}

.proactive-insight.schedule_change {
  border-left-color: #9a5b2e;
}

.proactive-insight.free_day,
.proactive-insight.day_finished {
  border-left-color: var(--xf-success-strong);
}

.proactive-eyebrow {
  color: var(--xf-text-faint);
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: 0.08em;
  line-height: 1.3;
}

.proactive-title {
  margin-top: 12rpx;
  color: var(--xf-text);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.38;
}

.proactive-detail {
  margin-top: 12rpx;
  color: var(--xf-text-secondary);
  font-size: 23rpx;
  line-height: 1.58;
}

.proactive-link {
  margin-top: 18rpx;
  color: #a51f1f;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 1.4;
}

.contextual-action-row {
  display: flex;
  gap: 10rpx;
  margin-top: 16rpx;
}

.contextual-action {
  flex: 1 1 0;
  min-width: 0;
  min-height: 88rpx;
  padding: 20rpx 10rpx;
  border-bottom: 2rpx solid #d8d1c9;
  color: #4f4841;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: center;
}

.empty-safe-note {
  margin-top: 18rpx;
  color: #b0a8a0;
  font-size: 18rpx;
  font-weight: 500;
  line-height: 1.3;
}

.message-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.message-row.user {
  justify-content: flex-end;
}

.assistant-avatar,
.assistant-avatar-spacer {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
}

.assistant-avatar {
  border-radius: 12rpx;
  background: #ebe7e1;
  color: var(--xf-primary);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 40rpx;
  text-align: center;
