{
  "pages": [
    "pages/index/index",
    "pages/school/school",
    "pages/today/today",
    "pages/calendar/calendar",
    "pages/settings/settings",
    "pages/custom-courses/custom-courses",
    "pages/timetable/timetable",
    "pages/login/login",
    "pages/schedule-view/schedule-view",
    "pages/empty-room/empty-room",
    "pages/contribute/contribute",
    "pages/personal-sync/personal-sync"
  ],
  "subPackages": [
    {
      "root": "packageXiaofu",
      "name": "xiaofu",
      "pages": [
        "pages/ai-assistant/ai-assistant"
      ]
    },
    {
      "root": "packageMaps",
      "name": "maps",
      "pages": [
        "pages/campus-map/campus-map"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "wifi",
      "packages": ["xiaofu"]
    },
    "pages/settings/settings": {
      "network": "all",
      "packages": ["maps"]
    }
  },
  "window": {
    "backgroundColor": "#f7f8fa",
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTitleText": "佛课小表",
    "navigationBarTextStyle": "black"
  },
  "networkTimeout": {
    "request": 60000
  },
  "__usePrivacyCheck__": true,
  "requiredPrivateInfos": [],
  "tabBar": {
    "color": "#7a8494",
    "selectedColor": "#c62828",
    "backgroundColor": "#ffffff",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "课表",
        "iconPath": "images/icons/home.png",
        "selectedIconPath": "images/icons/home-active.png"
      },
      {
        "pagePath": "pages/school/school",
        "text": "全校",
        "iconPath": "images/icons/business.png",
        "selectedIconPath": "images/icons/business-active.png"
      },
      {
        "pagePath": "pages/today/today",
        "text": "今日",
        "iconPath": "images/icons/goods.png",
        "selectedIconPath": "images/icons/goods-active.png"
      },
      {
        "pagePath": "pages/calendar/calendar",
        "text": "周历",
        "iconPath": "images/icons/examples.png",
        "selectedIconPath": "images/icons/examples-active.png"
      },
      {
        "pagePath": "pages/settings/settings",
        "text": "设置",
        "iconPath": "images/icons/usercenter.png",
        "selectedIconPath": "images/icons/usercenter-active.png"
      }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "xiaofu-float": "/components/xiaofu-float/index"
  }
}
