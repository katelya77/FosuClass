<view wx:if="{{compact && summary.total > 0}}" class="reaction-glance" aria-label="{{summary.total}} 人回应">
  <text wx:for="{{topItems}}" wx:key="id" class="reaction-glance-emoji">{{item.emoji}}</text><text class="reaction-glance-count">{{totalText}}</text>
</view>
<view wx:if="{{!compact && (summary.enabled || summary.total > 0 || error)}}" class="reaction-section" catchtap="noop" catchlongpress="openPicker">
  <view class="reaction-heading"><text class="reaction-heading-title">表情回应</text><text class="reaction-heading-count">{{summary.total ? totalText + ' 人回应' : '用一个表情，说声收到'}}</text></view>
  <view class="reaction-chips">
    <button wx:for="{{items}}" wx:key="id" class="reaction-chip {{item.selected ? 'is-selected' : ''}} {{pulseId === item.id ? 'is-popping' : ''}}" data-id="{{item.id}}" catchtap="select" disabled="{{busy || (!summary.enabled && !item.selected)}}" aria-label="{{item.label}}，{{item.count}} 人{{item.selected ? '，再次点击撤回' : ''}}"><text class="reaction-chip-emoji">{{item.emoji}}</text><text class="reaction-chip-count">{{item.countText}}</text><text wx:if="{{item.selected}}" class="reaction-check">✓</text></button>
    <button wx:if="{{summary.enabled}}" class="reaction-add {{pickerOpen ? 'is-open' : ''}}" catchtap="openPicker" disabled="{{busy}}" aria-label="{{pickerOpen ? '收起表情' : '选择表情'}}"><text>☺</text><text class="reaction-add-plus">{{pickerOpen ? '−' : '+'}}</text></button>
  </view>
  <view wx:if="{{pickerOpen}}" class="reaction-picker">
    <view class="reaction-picker-heading"><text>选一个，表达你的心情</text><text class="reaction-picker-close" catchtap="closePicker" role="button" aria-label="收起表情">×</text></view>
    <view class="reaction-grid"><button wx:for="{{choices}}" wx:key="id" class="reaction-option {{item.selected ? 'is-selected' : ''}}" data-id="{{item.id}}" catchtap="select" aria-label="{{item.label}}" hover-class="reaction-option-pressed"><text>{{item.emoji}}</text></button></view>
  </view>
  <text class="reaction-hint">{{busy ? '正在发送…' : (summary.enabled ? '每人一个表情 · 点已选表情可撤回' : '表情互动已关闭')}}</text>
  <text wx:if="{{error}}" class="reaction-error" catchtap="retry" role="button">{{error}}</text>
</view>
