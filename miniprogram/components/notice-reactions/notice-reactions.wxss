:host { display:block; }
button { margin:0; padding:0; box-sizing:border-box; line-height:1; }
button::after { border:0; }
.reaction-glance { display:flex; align-items:center; white-space:nowrap; padding:6rpx 12rpx; border-radius:99rpx; background:#f8f4f3; }
.reaction-glance-emoji { font-size:22rpx; margin-right:3rpx; }
.reaction-glance-count { margin-left:5rpx; color:#84706e; font-size:19rpx; font-weight:600; }
.reaction-section { padding-top:24rpx; margin-top:24rpx; border-top:1rpx solid #f0eeed; }
.reaction-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:18rpx; }
.reaction-heading-title { font-size:24rpx; font-weight:700; color:#4c4040; }
.reaction-heading-count { font-size:21rpx; color:#958989; }
.reaction-chips { display:flex; flex-wrap:wrap; align-items:center; gap:12rpx; }
.reaction-chip { display:flex; align-items:center; justify-content:center; min-height:64rpx; min-width:98rpx; padding:10rpx 18rpx; border-radius:99rpx; background:#f5f5f7; border:2rpx solid transparent; color:#685e61; transition:background 160ms,transform 160ms,border-color 160ms; }
.reaction-chip.is-selected { background:#fff0ee; border-color:#c83a32; color:#b4232a; }
.reaction-chip[disabled] { opacity:.75; color:#685e61; }
.reaction-chip[disabled].is-selected { color:#b4232a; }
.reaction-chip-emoji { font-size:32rpx; line-height:1.2; }
.reaction-chip-count { margin-left:10rpx; font-size:24rpx; font-weight:600; }
.reaction-check { margin-left:8rpx; font-size:19rpx; }
.reaction-add { display:flex; align-items:center; justify-content:center; width:76rpx; height:64rpx; border:2rpx dashed #d9cecc; border-radius:99rpx; background:#fff; color:#a48a85; font-size:36rpx; }
.reaction-add-plus { margin-left:3rpx; font-size:21rpx; }
.reaction-add.is-open { background:#fff0ee; border-color:#c83a32; color:#c83a32; }
.reaction-picker { margin-top:18rpx; padding:16rpx; background:#faf7f5; border:1rpx solid #eee6e2; border-radius:24rpx; animation:reactionReveal 180ms ease-out both; transform-origin:top center; }
.reaction-picker-heading { display:flex; align-items:center; justify-content:space-between; padding:0 8rpx 10rpx; font-size:21rpx; color:#8c7771; }
.reaction-picker-close { display:flex; align-items:center; justify-content:center; width:44rpx; height:44rpx; font-size:30rpx; }
.reaction-grid { display:grid; grid-template-columns:repeat(6,1fr); gap:6rpx; }
.reaction-option { display:flex; align-items:center; justify-content:center; width:100%; height:70rpx; background:transparent; border-radius:16rpx; border:2rpx solid transparent; font-size:42rpx; }
.reaction-option.is-selected { background:#ffe8e4; border-color:#d7897e; }
.reaction-option-pressed { background:#f0e7e2; transform:scale(.88); }
.reaction-hint { display:block; margin-top:16rpx; color:#aaa0a0; font-size:20rpx; line-height:1.5; }
.reaction-error { display:block; margin-top:10rpx; color:#b4232a; font-size:22rpx; }
.is-popping { animation:reactionPop 380ms cubic-bezier(.2,.8,.25,1); }
@keyframes reactionReveal { from { opacity:0; transform:translateY(-8rpx) scale(.98); } to { opacity:1; transform:translateY(0) scale(1); } }
@keyframes reactionPop { 0%,100% { transform:scale(1); } 40% { transform:scale(1.12); } 70% { transform:scale(.98); } }
@media (prefers-reduced-motion:reduce) { .reaction-picker,.is-popping { animation:none; } }
