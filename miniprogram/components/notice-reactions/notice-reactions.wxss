:host { display:block; }
.reaction-glance { display:flex; align-items:center; white-space:nowrap; padding:6rpx 12rpx; border-radius:99rpx; background:#f8f4f3; }
.reaction-glance-emoji { font-size:22rpx; margin-right:3rpx; }
.reaction-glance-count { margin-left:5rpx; color:#84706e; font-size:19rpx; font-weight:600; }
.reaction-section { padding-top:24rpx; margin-top:24rpx; border-top:1rpx solid #f0eeed; }
.reaction-heading { display:flex; align-items:center; justify-content:space-between; margin-bottom:16rpx; }
.reaction-heading-title { flex-shrink:0; font-size:24rpx; font-weight:700; color:#4c4040; }
.reaction-heading-count { margin-left:12rpx; font-size:21rpx; color:#958989; text-align:right; }
.reaction-chips { display:flex; flex-wrap:wrap; align-items:center; margin-right:-12rpx; }
/* Emoji controls use view to avoid the native v2 button's fixed default width. */
.reaction-chip,.reaction-add { flex:0 0 auto; display:flex; align-items:center; justify-content:center; box-sizing:border-box; height:76rpx; margin:0 12rpx 12rpx 0; line-height:1; }
.reaction-chip { min-width:94rpx; padding:0 16rpx; border-radius:99rpx; background:#f5f5f7; border:2rpx solid transparent; color:#685e61; transition:background 160ms,transform 160ms,border-color 160ms; }
.reaction-chip.is-selected { background:#fff0ee; border-color:#c83a32; color:#b4232a; }
.is-disabled { opacity:.6; }
.reaction-chip-emoji { font-size:32rpx; line-height:1.2; }
.reaction-chip-count { margin-left:10rpx; font-size:24rpx; font-weight:600; }
.reaction-check { margin-left:8rpx; font-size:19rpx; }
.reaction-add { width:76rpx; border:2rpx dashed #d9cecc; border-radius:99rpx; background:#fff; color:#a48a85; font-size:36rpx; transition:background 160ms,transform 160ms; }
.reaction-add-plus { margin-left:3rpx; font-size:21rpx; }
.reaction-add.is-open { background:#fff0ee; border-color:#c83a32; color:#c83a32; }
.reaction-chip-pressed { transform:scale(.94); }
.reaction-picker { box-sizing:border-box; margin-top:4rpx; padding:12rpx; background:#faf7f5; border:1rpx solid #eee6e2; border-radius:24rpx; animation:reactionReveal 180ms ease-out both; transform-origin:top center; }
.reaction-picker-heading { display:flex; align-items:center; justify-content:space-between; padding:0 8rpx 6rpx; font-size:21rpx; color:#8c7771; }
.reaction-picker-close { display:flex; align-items:center; justify-content:center; width:44rpx; height:44rpx; font-size:30rpx; }
/* Flex cells work in older WebViews too; padding keeps six equal touch targets. */
.reaction-grid { display:flex; flex-wrap:wrap; width:100%; }
.reaction-option { box-sizing:border-box; flex:0 0 16.666666%; width:16.666666%; min-width:0; height:88rpx; padding:4rpx; }
.reaction-option-face { box-sizing:border-box; display:flex; align-items:center; justify-content:center; width:100%; height:100%; border:2rpx solid transparent; border-radius:16rpx; font-size:42rpx; line-height:1; transition:background 140ms,transform 140ms; }
.reaction-option.is-selected .reaction-option-face { background:#ffe8e4; border-color:#d7897e; }
.reaction-option-pressed .reaction-option-face { background:#f0e7e2; transform:scale(.88); }
.reaction-hint { display:block; margin-top:8rpx; color:#aaa0a0; font-size:20rpx; line-height:1.5; }
.reaction-error { display:block; margin-top:10rpx; color:#b4232a; font-size:22rpx; }
.is-popping { animation:reactionPop 380ms cubic-bezier(.2,.8,.25,1); }
@keyframes reactionReveal { from { opacity:0; transform:translateY(-8rpx) scale(.98); } to { opacity:1; transform:translateY(0) scale(1); } }
@keyframes reactionPop { 0%,100% { transform:scale(1); } 40% { transform:scale(1.12); } 70% { transform:scale(.98); } }
@media (prefers-reduced-motion:reduce) { .reaction-picker,.is-popping { animation:none; } }
