.week-switcher {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  padding: 6rpx;
  border: 1rpx solid #e4eaf2;
  border-radius: 16rpx;
  background: #f7f9fc;
}

.week-button,
.week-current {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  border-radius: 12rpx;
  background: transparent;
  color: #172033;
}

.week-button {
  flex: 0 0 72rpx;
  width: 72rpx;
  color: #5a6678;
  font-size: 40rpx;
  font-weight: 600;
}

.week-current {
  flex: 1;
  min-width: 0;
  margin: 0 6rpx;
  padding: 0 16rpx;
  background: #ffffff;
  color: #c62828;
  font-size: 25rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow: 0 6rpx 16rpx rgba(16, 31, 55, 0.06);
}
