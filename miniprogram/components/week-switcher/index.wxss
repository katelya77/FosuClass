:host {
  display: block;
  width: 100%;
  min-width: 0;
}

.week-switcher {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  padding: 6rpx;
  border: 1rpx solid #e8ebef;
  border-radius: 16rpx;
  background: #f7f8fa;
}

.week-button,
.week-current {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  border-radius: 12rpx;
  background: transparent;
  color: #172033;
}

.week-button {
  flex: 0 0 52rpx;
  width: 52rpx;
  color: #68707d;
  font-size: 36rpx;
  font-weight: 500;
}

.week-button.is-disabled {
  color: #c9cdd3;
  opacity: 1;
}

.week-current {
  flex: 1;
  min-width: 0;
  margin: 0 6rpx;
  padding: 0 12rpx;
  background: #ffffff;
  color: #1f2329;
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(16, 31, 55, 0.04);
}
