.conversation-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  max-height: 78vh;
  padding: 12rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fbfaf8;
  box-shadow: 0 -8rpx 40rpx rgba(40, 36, 32, 0.12);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 8rpx auto 18rpx;
  border-radius: 999rpx;
  background: rgba(40, 36, 32, 0.12);
}

.task-panel-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.panel-title-wrap {
  min-width: 0;
  flex: 1;
}

.task-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d2925;
}

.task-panel-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a8178;
  line-height: 1.4;
}

.sheet-close {
  margin: 0;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: #6b635a;
  background: #efece7;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.sheet-close::after,
.conversation-new-btn::after,
.conversation-main::after,
.conversation-more::after,
.conversation-actions button::after {
  border: none;
}

.conversation-new-btn {
  margin: 0 0 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #c4302b;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.conversation-scroll {
  flex: 1;
  max-height: 52vh;
  min-height: 0;
}

.conversation-item {
  margin-bottom: 12rpx;
  padding: 14rpx 14rpx 12rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid rgba(40, 36, 32, 0.06);
  box-sizing: border-box;
}

.conversation-item.active {
  border-color: rgba(196, 48, 43, 0.28);
  background: #fff8f7;
}

.conversation-top {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  min-width: 0;
}

.conversation-main {
  margin: 0;
  padding: 0;
  flex: 1;
  min-width: 0;
  text-align: left;
  background: transparent;
  line-height: 1.4;
}

.conversation-title-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  min-width: 0;
}

.conversation-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #2d2925;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-word;
}

.conversation-current {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #c4302b;
  background: rgba(196, 48, 43, 0.08);
  border-radius: 999rpx;
  padding: 4rpx 10rpx;
  line-height: 1.3;
}

.conversation-more {
  margin: 0;
  padding: 4rpx 12rpx;
  font-size: 28rpx;
  line-height: 1.2;
  color: #6b635a;
  background: transparent;
  flex-shrink: 0;
}

.conversation-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a8178;
  line-height: 1.4;
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 0;
}

.meta-dot {
  margin: 0 8rpx;
  color: rgba(40, 36, 32, 0.28);
}

.conversation-badges {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.source-badge {
  font-size: 20rpx;
  color: #6b635a;
  background: #f3f0eb;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  line-height: 1.3;
}

.source-badge.warn {
  color: #b45309;
  background: #fff7ed;
}

.conversation-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(40, 36, 32, 0.06);
}

.conversation-actions button {
  margin: 0;
  padding: 8rpx 14rpx;
  font-size: 22rpx;
  color: #6b635a;
  background: #f3f0eb;
  border-radius: 999rpx;
}

.conversation-actions button.danger {
  color: #c53030;
  background: #fff5f5;
}
