:host { display: block; }

.notice-ticker {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 70rpx;
  margin: 14rpx 0 0;
  padding: 0 12rpx 0 18rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #e8e9ed;
  color: #243042;
  box-sizing: border-box;
  overflow: hidden;
}

.notice-ticker.has-close { padding-right: 64rpx; }

.notice-ticker-important {
  border-color: #e9c7c5;
  background: #fffafa;
}

.notice-ticker-urgent {
  border-color: #e5aaa8;
  background: #fff7f6;
}

.notice-ticker-label {
  flex: 0 0 auto;
  padding: 5rpx 10rpx;
  border-radius: 6rpx;
  background: #fff1f0;
  color: #b4232a;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.2;
}

.notice-ticker-urgent .notice-ticker-label {
  background: #c62828;
  color: #ffffff;
}

.notice-ticker-track {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  margin: 0 10rpx 0 12rpx;
}

.notice-ticker-chevron { flex: 0 0 auto; margin-left:10rpx; color: #99a1ac; font-size: 30rpx; line-height: 1; }

.notice-ticker-line {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;
  font-size: 23rpx;
  font-weight: 600;
  line-height: normal;
}

.notice-ticker-text {
  padding-right: 48rpx;
}

.notice-ticker-line.is-scroll {
  min-width: 200%;
  animation: noticeTickerScroll 24s linear infinite;
}

.notice-ticker-line.is-static {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.notice-ticker-line.is-static .notice-ticker-text { padding-right: 0; }

.notice-ticker-close,
.notice-ticker-panel-close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-sizing: border-box;
}

.notice-ticker-close {
  position: absolute;
  top: 50%;
  right: 8rpx;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  border-radius: 6rpx;
  color: #89929d;
}

.notice-ticker-close text {
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1;
}

.notice-ticker-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(15, 23, 42, 0.38);
  animation: noticeMaskIn 180ms ease-out;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.notice-ticker-panel {
  width: 100%;
  max-width: 660rpx;
  max-height: 84vh;
  border-radius: 30rpx;
  background: #ffffff;
  padding: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.16);
  animation: noticePanelIn 220ms cubic-bezier(.2,.8,.25,1);
}
.notice-ticker-panel-scroll { max-height:60vh; }
.notice-ticker-panel-footer { padding-top:24rpx; }
.notice-ticker-panel-footer button::after { border:0; }
.notice-ticker-panel-dismiss { padding:10rpx; margin-top:8rpx; color:#9c9090; background:transparent; font-size:21rpx; line-height:1.8; }

.notice-ticker-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.notice-ticker-panel-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f5f6f8;
  color: #566170;
  font-size: 22rpx;
  font-weight: 800;
  line-height: normal;
}

.notice-ticker-panel-tag.important {
  background: #fff1f0;
  color: #b4232a;
}

.notice-ticker-panel-tag.urgent {
  background: #fef2f2;
  color: #b91c1c;
}

.notice-ticker-panel-close {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  color: #89929d;
}

.notice-ticker-panel-close text {
  font-size: 22rpx;
  line-height: 1;
}

.notice-ticker-panel-title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.notice-ticker-panel-content {
  font-size: 26rpx;
  line-height: 1.7;
  color: #475569;
  white-space: pre-wrap;
  word-break: break-word;
}

.notice-ticker-panel-date { margin-top: 22rpx; color: #89919d; font-size: 22rpx; }
.notice-ticker-panel-action { display:flex; align-items:center; justify-content:center; min-height:76rpx; border-radius:16rpx; background:#fff0ee; color:#b4232a; font-size:25rpx; font-weight:600; }
@keyframes noticeMaskIn { from { opacity:0; } to { opacity:1; } }
@keyframes noticePanelIn { from { opacity:0; transform:translateY(18rpx) scale(.97); } to { opacity:1; transform:translateY(0) scale(1); } }
@media (prefers-reduced-motion:reduce) { .notice-ticker-mask,.notice-ticker-panel { animation:none; } }

@keyframes noticeTickerScroll {
  0%, 8% {
    transform: translateX(0);
  }
  92%, 100% {
    transform: translateX(-50%);
  }
}
