.course-card {
  overflow: hidden;
  border-radius: 10rpx;
  color: var(--course-text, #173247);
  max-width: 100%;
}

.course-card-grid {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  padding: 4rpx 6rpx;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(26, 50, 89, 0.08);
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.course-card-list {
  position: relative;
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #edf0f5;
  border-left: 8rpx solid #5d9cec;
  background: #ffffff;
  color: #172033;
  box-shadow: 0 10rpx 30rpx rgba(16, 31, 55, 0.06);
}

.course-card-list.is-ongoing {
  border-color: #a5d6a7;
  border-left-color: #2e7d32;
  background: #f1f8e9;
  box-shadow: 0 16rpx 38rpx rgba(46, 125, 50, 0.1);
}

.course-card-list.is-next {
  border-color: #90caf9;
  border-left-color: #1976d2;
  background: #e3f2fd;
  box-shadow: 0 16rpx 38rpx rgba(25, 118, 210, 0.1);
}

.list-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.course-name {
  display: -webkit-box;
  overflow: hidden;
  max-width: 100%;
  min-width: 0;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.course-name.span-1 {
  -webkit-line-clamp: 1;
  font-size: 17rpx;
}

.course-card-list .course-name {
  min-width: 0;
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
  -webkit-line-clamp: 2;
}

.status-pill {
  flex: 0 0 auto;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  color: #536174;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 42rpx;
  white-space: nowrap;
}

.header-pills {
  display: flex;
  gap: 8rpx;
  align-items: center;
  flex-shrink: 0;
}

.merged-pill {
  background: #fff3e0 !important;
  color: #ff9800 !important;
  border: 1rpx solid #ffe0b2;
}

.custom-pill {
  background: #eef2ff !important;
  color: #3654d4 !important;
  border: 1rpx solid #dbe4ff;
}

.personalized-pill { background: #fff0f0 !important; color: #b4232b !important; border: 1rpx solid #f4c7c7; }

.event-pill {
  background: #ecfeff !important;
  color: #0e7490 !important;
  border: 1rpx solid #a5f3fc;
}

.is-true-conflict .event-pill {
  background: #fff1f2 !important;
  color: #be123c !important;
  border-color: #fecdd3;
}

.grid-custom-tag {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  padding: 0 6rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #3654d4;
  font-size: 14rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  height: 20rpx;
  pointer-events: none;
}

.grid-personalized-tag { color: #b4232b; }

.status-ongoing {
  background: #2e7d32;
  color: #ffffff;
}

.status-upcoming {
  background: #1976d2;
  color: #ffffff;
}

.status-finished {
  background: #eef2f7;
  color: #8a94a6;
}

.time-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.time-text {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.1;
}

.section-text {
  color: #687386;
  font-size: 24rpx;
  font-weight: 700;
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.meta-item {
  display: flex;
  width: 50%;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  padding-right: 12rpx;
}

.meta-label {
  flex: 0 0 auto;
  color: #9aa4b5;
  font-size: 22rpx;
  font-weight: 700;
}

.meta-value {
  overflow: hidden;
  min-width: 0;
  color: #536174;
  font-size: 23rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta,
.course-week {
  overflow: hidden;
  max-width: 100%;
  min-width: 0;
  margin-top: 4rpx;
  color: var(--course-meta-text, currentColor);
  font-size: 17rpx;
  line-height: 1.18;
  opacity: 0.92;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-event-badge {
  align-self: flex-start;
  max-width: 100%;
  height: 24rpx;
  margin-top: 4rpx;
  padding: 0 6rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.68);
  color: var(--course-meta-text, #475569);
  font-size: 15rpx;
  font-weight: 800;
  line-height: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-card-grid .course-event-badge {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  max-width: 58rpx;
  height: 22rpx;
  margin-top: 0;
  padding: 0 5rpx;
  border-radius: 5rpx;
  font-size: 13rpx;
  line-height: 22rpx;
}

.course-card-grid.is-preview-grid {
  padding: 5rpx 6rpx;
  color: #173247;
  border: 1rpx solid rgba(50, 74, 99, 0.16);
  box-shadow: 0 4rpx 12rpx rgba(50, 74, 99, 0.08);
}

.is-preview-grid .course-name {
  color: inherit;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 1.16;
  -webkit-line-clamp: 2;
}

.is-preview-grid .course-name.span-1 {
  font-size: 19rpx;
}

.is-preview-grid .course-meta {
  margin-top: 3rpx;
  color: var(--course-meta-text, currentColor);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.12;
  opacity: 0.92;
}

.is-preview-grid .course-event-subtext {
  margin-top: 3rpx;
  color: var(--course-meta-text, rgba(23, 50, 71, 0.72));
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.12;
}

.is-preview-grid .course-event-badge {
  max-width: 54rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #475569;
  border: 1rpx solid rgba(71, 85, 105, 0.14);
}

.course-event-subtext {
  overflow: hidden;
  max-width: 100%;
  min-width: 0;
  margin-top: 3rpx;
  color: var(--course-meta-text, rgba(23, 50, 71, 0.72));
  font-size: 15rpx;
  font-weight: 700;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-badge {
  height: 18rpx;
  margin-top: 2rpx;
  padding: 0 4rpx;
  font-size: 12rpx;
  line-height: 18rpx;
}

.course-conflict-hint {
  overflow: hidden;
  max-width: 100%;
  min-width: 0;
  margin-top: auto;
  padding-top: 3rpx;
  color: var(--course-meta-text, rgba(23, 50, 71, 0.82));
  font-size: 15rpx;
  font-weight: 800;
  line-height: 1.15;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-conflict-hint.active-conflict {
  color: #9a5b08;
}

.classroom-highlight {
  color: var(--course-room-text, #f1c40f) !important;
  font-weight: 900;
  opacity: 1 !important;
}

.is-preview-grid .classroom-highlight {
  color: var(--course-room-text, #f1c40f) !important;
}

.is-preview-grid.is-muted {
  background: #eef2f6 !important;
  color: #64748b;
  border-color: #cbd5e1;
  box-shadow: none;
}

.is-preview-grid.is-true-conflict {
  color: #8c1d35;
}

.is-muted {
  color: #5b6575;
  box-shadow: none;
}

.course-card-list.is-muted {
  border-color: #edf0f5;
  border-left-color: #ccd4df;
  background: #f7f9fc;
}

.is-muted .course-name,
.is-muted .time-text,
.is-muted .section-text,
.is-muted .meta-value {
  color: #8a94a6;
}

.is-muted .course-meta,
.is-muted .course-week {
  opacity: 0.86;
}

.is-muted .course-conflict-hint {
  color: #7a8494;
}

/* ================== 七天概览模式专用样式 ================== */
.course-card.overview-card {
  left: 2rpx;
  right: 2rpx;
  padding: 2rpx 4rpx;
  border-radius: 6rpx;
}

.overview-name {
  font-size: 15rpx;
  font-weight: 700;
  -webkit-line-clamp: 2;
  line-height: 1.1;
  word-break: break-all;
}

.overview-meta {
  font-size: 13rpx;
  margin-top: 1rpx;
  line-height: 1.05;
  color: var(--course-room-text, #f1c40f) !important;
  opacity: 1 !important;
}
