.course-card {
  overflow: hidden;
  border-radius: 10rpx;
  color: #ffffff;
  max-width: 100%;
}

.course-card-grid {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  padding: 4rpx 6rpx;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(26, 50, 89, 0.08);
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.course-card-list {
  position: relative;
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #edf0f5;
  border-left: 8rpx solid #5d9cec;
  background: #ffffff;
  color: #172033;
  box-shadow: 0 10rpx 30rpx rgba(16, 31, 55, 0.06);
}

.course-card-list.is-ongoing {
  border-color: #a5d6a7;
  border-left-color: #2e7d32;
  background: #f1f8e9;
  box-shadow: 0 16rpx 38rpx rgba(46, 125, 50, 0.1);
}

.course-card-list.is-next {
  border-color: #90caf9;
  border-left-color: #1976d2;
  background: #e3f2fd;
  box-shadow: 0 16rpx 38rpx rgba(25, 118, 210, 0.1);
}

.list-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.course-name {
  display: -webkit-box;
  overflow: hidden;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  word-break: break-all;
}

.course-name.span-1 {
  -webkit-line-clamp: 1;
  font-size: 17rpx;
}

.course-card-list .course-name {
  min-width: 0;
  color: #172033;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
  -webkit-line-clamp: 2;
}

.status-pill {
  flex: 0 0 auto;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  color: #536174;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 42rpx;
  white-space: nowrap;
}

.status-ongoing {
  background: #2e7d32;
  color: #ffffff;
}

.status-upcoming {
  background: #1976d2;
  color: #ffffff;
}

.status-finished {
  background: #eef2f7;
  color: #8a94a6;
}

.time-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.time-text {
  color: #172033;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.1;
}

.section-text {
  color: #687386;
  font-size: 24rpx;
  font-weight: 700;
}

.meta-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.meta-item {
  display: flex;
  width: 50%;
  min-width: 0;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  padding-right: 12rpx;
}

.meta-label {
  flex: 0 0 auto;
  color: #9aa4b5;
  font-size: 22rpx;
  font-weight: 700;
}

.meta-value {
  overflow: hidden;
  min-width: 0;
  color: #536174;
  font-size: 23rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-meta,
.course-week {
  overflow: hidden;
  margin-top: 4rpx;
  font-size: 17rpx;
  line-height: 1.18;
  opacity: 0.92;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.classroom-highlight {
  color: #ffeb3b !important;
  font-weight: 800;
  opacity: 1 !important;
}

.is-muted {
  color: #5b6575;
  box-shadow: none;
}

.course-card-list.is-muted {
  border-color: #edf0f5;
  border-left-color: #ccd4df;
  background: #f7f9fc;
}

.is-muted .course-name,
.is-muted .time-text,
.is-muted .section-text,
.is-muted .meta-value {
  color: #8a94a6;
}

.is-muted .course-meta,
.is-muted .course-week {
  opacity: 0.86;
}
