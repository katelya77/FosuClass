<view
  class="course-card {{layout === 'list' ? 'course-card-list' : 'course-card-grid'}} {{isMuted ? 'is-muted' : ''}} {{course.isNext ? 'is-next' : ''}} {{course.status === 'ongoing' ? 'is-ongoing' : ''}}"
  style="{{layout === 'list' ? listStyle : cardStyle}}"
  bindtap="handleTap"
>
  <block wx:if="{{layout === 'list'}}">
    <view class="list-header">
      <view class="course-name">{{course.courseName}}</view>
      <view wx:if="{{course.statusText}}" class="status-pill {{statusClass}}">{{course.statusText}}</view>
    </view>

    <view class="time-row">
      <text class="time-text">{{course.timeText}}</text>
      <text class="section-text">{{course.sectionText}}</text>
    </view>

    <view class="meta-grid">
      <view class="meta-item">
        <text class="meta-label">教室</text>
        <text class="meta-value">{{course.classroom || "待补充"}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">教师</text>
        <text class="meta-value">{{course.teacherName || "待补充"}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">周次</text>
        <text class="meta-value">{{course.weekText || "待补充"}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">班级</text>
        <text class="meta-value">{{course.className || "当前班级"}}</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="course-name {{span === 1 ? 'span-1' : ''}}">{{course.courseName}}</view>
    <view class="course-meta classroom-highlight" wx:if="{{course.classroom}}">{{course.classroom}}</view>
    <view class="course-meta" wx:if="{{span > 1 && course.teacherName}}">{{course.teacherName}}</view>
    <view class="course-week" wx:if="{{span > 2 && course.weekText}}">{{course.weekText}}</view>
  </block>
</view>
