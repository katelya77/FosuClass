.xiaofu-float {
  position: fixed;
  z-index: 35;
  box-sizing: border-box;
  touch-action: none;
  will-change: left, top, transform, opacity;
  transition: left 180ms cubic-bezier(0.2, 0.8, 0.2, 1), top 180ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 160ms ease, transform 160ms ease;
}

.xiaofu-float.moving {
  transition: none;
  transform: scale(1.03);
}

.xiaofu-float.dimmed {
  opacity: 0.62;
}

.xiaofu-float-ball {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border: 1rpx solid #d8d1c9;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(42, 38, 34, 0.18);
}

.xiaofu-float-logo {
  width: 72%;
  height: 72%;
  border-radius: 999rpx;
}

.xiaofu-float-text {
  width: 72%;
  height: 72%;
  border-radius: 999rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.9;
  text-align: center;
}

.xiaofu-float-hint {
  position: absolute;
  box-sizing: border-box;
  top: 1px;
  z-index: 0;
  width: 196px;
  min-height: 56px;
  padding: 9px 13px;
  border: 1px solid #d8d1c9;
  border-radius: 15px;
  background: #fffdf9;
  box-shadow: 0 8px 22px rgba(42, 38, 34, 0.12);
  pointer-events: none;
}

.xiaofu-float-hint.left {
  right: 64px;
  text-align: right;
}

.xiaofu-float-hint.right {
  left: 64px;
  text-align: left;
}

.xiaofu-float-hint-eyebrow {
  overflow: hidden;
  color: #9a5b2e;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.05em;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xiaofu-float-hint-text {
  display: -webkit-box;
  margin-top: 3px;
  overflow: hidden;
  color: #2a2622;
  font-size: 12px;
  font-weight: 650;
  line-height: 1.35;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

@media (prefers-color-scheme: dark) {
  .xiaofu-float-ball {
    border-color: #4a433d;
    background: #24211e;
  }

  .xiaofu-float-hint {
    border-color: #4a433d;
    background: #24211e;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.26);
  }

  .xiaofu-float-hint-text {
    color: #f4f0ea;
  }
}

@media (prefers-reduced-motion: reduce) {
  .xiaofu-float {
    transition: none;
  }
}
