.xiaofu-float {
  position: fixed;
  z-index: 35;
  box-sizing: border-box;
  touch-action: none;
  will-change: left, top, transform, opacity;
  transition: left 180ms cubic-bezier(0.2, 0.8, 0.2, 1), top 180ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 160ms ease, transform 160ms ease;
}

.xiaofu-float.moving {
  transition: none;
  transform: scale(1.03);
}

.xiaofu-float.dimmed {
  opacity: 0.62;
}

.xiaofu-float-glow {
  position: absolute;
  left: 8%;
  right: 8%;
  top: 8%;
  bottom: 8%;
  border-radius: 999rpx;
  background: rgba(198, 40, 40, 0.18);
  box-shadow: 0 0 26rpx rgba(198, 40, 40, 0.24);
  animation: xiaofuFloatBreath 2.8s ease-in-out infinite;
}

.xiaofu-float-ball {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 14rpx 36rpx rgba(31, 41, 55, 0.18), 0 4rpx 12rpx rgba(198, 40, 40, 0.12);
}

.xiaofu-float-logo {
  width: 72%;
  height: 72%;
  border-radius: 999rpx;
}

.xiaofu-float-text {
  width: 72%;
  height: 72%;
  border-radius: 999rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.9;
  text-align: center;
}

.xiaofu-float-online {
  position: absolute;
  right: 5rpx;
  bottom: 7rpx;
  width: 15rpx;
  height: 15rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  background: #2f9e57;
  box-shadow: 0 0 0 4rpx rgba(47, 158, 87, 0.12);
}

@keyframes xiaofuFloatBreath {
  0%, 100% {
    opacity: 0.55;
    transform: scale(0.92);
  }
  50% {
    opacity: 0.92;
    transform: scale(1.08);
  }
}
