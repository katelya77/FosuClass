<view
  wx:if="{{visible}}"
  class="xiaofu-float {{moving ? 'moving' : ''}} {{dimmed ? 'dimmed' : ''}}"
  style="left: 0; top: 0; transform: translate3d({{x}}px, {{y}}px, 0) {{moving ? 'scale(1.03)' : 'scale(1)'}}; width: {{size}}px; height: {{size}}px;"
>
  <view class="xiaofu-float-hint {{hintSide}}" wx:if="{{hintText && !moving}}" catchtap="onHintTap" aria-label="收起小序提示">
    <view class="xiaofu-float-hint-close">×</view>
    <view class="xiaofu-float-hint-eyebrow">{{hintEyebrow}}</view>
    <view class="xiaofu-float-hint-text">{{hintText}}</view>
  </view>
  <view
    class="xiaofu-float-ball"
    catchtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    catchtouchend="onTouchEnd"
    catchtouchcancel="onTouchCancel"
    bindtap="onTap"
    bindlongpress="onLongPress"
  >
    <image class="xiaofu-float-logo" src="/assets/icons/ai-campus-butler.png" mode="aspectFit" binderror="onLogoError" wx:if="{{logoReady}}" />
    <text wx:else class="xiaofu-float-text">序</text>
  </view>
</view>
