.search-filter {
  padding: 16rpx;
  border: 1rpx solid #e5ebf3;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(16, 31, 55, 0.06);
}

.search-row {
  display: flex;
  align-items: center;
  min-height: 82rpx;
  padding: 0 22rpx;
  border-radius: 14rpx;
  background: #f2f5f9;
}

.search-icon {
  margin-right: 12rpx;
  color: #7a8494;
  font-size: 34rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #172033;
  font-size: 29rpx;
}

.search-placeholder {
  color: #a5adba;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

picker {
  flex: 1;
  min-width: 0;
}

.filter-pill {
  overflow: hidden;
  height: 64rpx;
  padding: 0 12rpx;
  border: 1rpx solid #e5eaf2;
  border-radius: 999rpx;
  color: #4c586a;
  font-size: 24rpx;
  line-height: 62rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}
