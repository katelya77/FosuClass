.popup-mask {
  position: fixed;
  z-index: 99;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 24, 40, 0.42);
}

.popup-panel {
  width: 100%;
  padding: 16rpx 24rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
}

.popup-handle {
  width: 76rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #d9dee8;
}

.popup-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.popup-title-block {
  min-width: 0;
}

.course-title {
  overflow: hidden;
  color: #172033;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.28;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.course-subtitle {
  overflow: hidden;
  margin-top: 8rpx;
  color: #778297;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.close-button {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f3f7;
  color: #687386;
  font-size: 40rpx;
  line-height: 50rpx;
}

.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.detail-item,
.remark {
  padding: 18rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 12rpx;
  background: #f8fafc;
}

.detail-item {
  flex: 1 1 42%;
  min-width: 0;
}

.detail-item.full {
  flex-basis: 100%;
}

.detail-label {
  display: block;
  color: #8a94a6;
  font-size: 21rpx;
}

.detail-value,
.remark-text {
  display: block;
  margin-top: 7rpx;
  color: #172033;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
}

.remark {
  margin-top: 12rpx;
}

.popup-scroll-content {
  max-height: 60vh;
  margin-top: 16rpx;
}

.grouped-detail-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.grouped-title-hint {
  font-size: 24rpx;
  color: #c62828;
  font-weight: bold;
}

.grouped-item-box {
  padding: 16rpx;
  border: 1rpx solid #edf0f5;
  border-radius: 12rpx;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.grouped-item-title {
  font-size: 22rpx;
  color: #778297;
  font-weight: bold;
  border-bottom: 1rpx dashed #edf0f5;
  padding-bottom: 6rpx;
  margin-bottom: 6rpx;
}

.grouped-meta-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.grouped-meta-label {
  color: #8a94a6;
  width: 90rpx;
  flex-shrink: 0;
}

.grouped-meta-value {
  color: #172033;
  font-weight: 600;
}

