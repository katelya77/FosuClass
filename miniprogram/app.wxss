page {
  width: 100%;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  background: #f7f8fa;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
}

view,
text,
scroll-view,
input,
button,
textarea {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  line-height: 1;
  border-radius: 0;
  box-sizing: border-box;
}

button::after {
  border: 0;
}

/* 统一按钮基础规范 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  line-height: 1;
  font-family: inherit;
  transition: all 0.2s ease;
  vertical-align: middle;
  padding: 0 32rpx;
  border: none;
}

.btn-primary {
  height: 88rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.btn-secondary {
  height: 88rpx;
  background: #f0f4fa;
  color: #2b5c8f;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
}

.btn-ghost {
  height: 88rpx;
  background: transparent;
  border: 2rpx solid #dce4ef;
  color: #172033;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.btn-disabled {
  background: #e9eff5 !important;
  color: #a4b3c6 !important;
  border-color: transparent !important;
  cursor: not-allowed;
}

.pill-btn {
  height: 64rpx;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.action-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  background: #f1f3f7;
  color: #626f86;
  font-size: 24rpx;
  border-radius: 27rpx;
  padding: 0 20rpx;
}

.modal-footer-btn {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.tool-btn {
  height: 72rpx;
  font-size: 26rpx;
  border-radius: 36rpx;
}

.page {
  width: 100%;
  min-height: 100vh;
  padding: 28rpx 24rpx calc(32rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.card {
  border: 1rpx solid #edf0f5;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(16, 31, 55, 0.06);
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: #c62828;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  border: 1rpx solid #dce4ef;
  border-radius: 999rpx;
  background: #ffffff;
  color: #172033;
  font-size: 28rpx;
  font-weight: 500;
}

.muted-text {
  color: #778297;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #172033;
}
