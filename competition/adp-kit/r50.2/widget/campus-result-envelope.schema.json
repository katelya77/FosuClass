{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CampusResultEnvelope",
  "description": "R50.2B canonical public presentation contract。确定性工具结果经 projection 投影后进入本契约，再由统一 Native Widget campus-result-unified-v1 渲染。展示专用：不得携带任何内部协议字段。",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["variant", "status", "title", "verified", "summary"],
  "properties": {
    "version": {
      "const": "1.0",
      "description": "平台内部版本，由确定性投影注入，Agent 不生成；缺省合法。UI 与 Runtime Prompt 不得展示"
    },
    "variant": {
      "type": "string",
      "enum": [
        "schedule",
        "space",
        "collaboration",
        "risk",
        "reschedule",
        "ranking",
        "overview",
        "empty",
        "error",
        "message"
      ],
      "description": "语义结果变体。schedule/space/collaboration/risk/reschedule/ranking/overview 为富结果卡；empty=verified empty；error=可恢复失败；message=轻量结构化结果（支撑类工具作为最终答案时）"
    },
    "status": {
      "type": "string",
      "enum": ["success", "empty", "error"],
      "description": "结果状态。success 仅用于富结果变体；empty 仅用于 empty 变体；error 仅用于 error 变体"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "卡片标题（用户语义，中文）"
    },
    "subtitle": {
      "type": "string",
      "description": "副标题 / 时间范围等补充（可选）"
    },
    "verified": {
      "type": "boolean",
      "description": "结果是否来自确定性工具核验；false 仅允许 error 变体"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "一句话关键结果，全部来自工具返回事实的摘要"
    },
    "context": {
      "type": "string",
      "description": "展示性上下文（如教学周 / 窗口 / 校区），不得含内部协议 JSON"
    },
    "sections": {
      "type": "array",
      "description": "结构化展示区块（重复行列表）",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "rows"],
        "properties": {
          "title": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["metric", "timeline", "route", "recommendation", "ranking", "comparison", "entity-list", "notice", "prose"],
            "description": "确定性展示模块；缺省时按 v7 variant 兼容渲染"
          },
          "note": { "type": "string", "description": "区块级说明（如并列说明 / 周末标记 / 未执行声明）" },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string", "description": "行标签（时段 / 排名 / 类别）" },
                "value": { "type": "string", "description": "行主内容" },
                "badge": { "type": "string", "description": "行徽标（可选）" },
                "hint": { "type": "string", "description": "行辅助说明（可选）" }
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "官方 Widget Action 列表；仅允许 sys.chat，payload 为用户语义续接文本",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "payload"],
        "properties": {
          "id": { "type": "string", "description": "渲染 key（展示无关）" },
          "type": { "const": "sys.chat" },
          "label": { "type": "string", "minLength": 1, "description": "按钮可见文案（用户语义）" },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query"],
            "properties": {
              "query": {
                "type": "string",
                "minLength": 1,
                "description": "自然语言续接输入，重新进入 User Turn → Main → Child 路由；禁止携带 ID / 内部状态 / JSON 协议"
              }
            }
          }
        }
      }
    },
    "displayMeta": {
      "type": "object",
      "additionalProperties": false,
      "description": "展示元数据（presentation-only）：simulated / weekendMarked / tieNote / tieGroupCount / recoverable",
      "properties": {
        "simulated": { "type": "boolean", "description": "reschedule：结果仅为模拟，未执行" },
        "weekendMarked": { "type": "boolean", "description": "collaboration：候选明确标注工作日/周末" },
        "tieNote": { "type": "string", "description": "ranking：并列说明（如「并列最高」）" },
        "tieGroupCount": { "type": "integer", "minimum": 0, "description": "ranking：并列组数；无并列时为 0 或缺省" },
        "recoverable": { "type": "boolean", "description": "error：是否可恢复" }
      }
    }
  }
}
