{
  "schema": "fosuclass-adp-widget-contract/v5",
  "kind": "campus-result-unified",
  "status": "PREPARED_PENDING_REAL_ADP_WIDGET_EXPORT_INTEGRATION",
  "widgetId": null,
  "widgetIdPolicy": "FAIL_CLOSED_REAL_TENCENT_EXPORT_ONLY",
  "activeFallback": "小序-课表票据-V2 / RuntimeSafe V3",
  "adapter": "adapter.py",
  "description": "R50.4 统一 Native Widget（双布局）：只消费 CampusResultEnvelope 公开字段（version/variant/status/title/subtitle/verified/summary/context/sections/actions/displayMeta）+ 服务端 WidgetViewModel 投影的布局字段（layoutMode/weekBoardTitle/weekBoardSubtitle/days）。layoutMode=week-board 用于整周/周范围课表，layoutMode=result-card 用于风险/空教室/态势/TopN/调课模拟/空结果/错误/单日明细。禁止任何内部协议字段进入本 Widget 数据。",
  "variants": [
    "schedule",
    "space",
    "collaboration",
    "risk",
    "reschedule",
    "ranking",
    "overview",
    "empty",
    "error",
    "message"
  ],
  "layoutModes": [
    "result-card",
    "week-board"
  ],
  "layoutModeRule": "variant=schedule 且为整周/周范围查询（campus_schedule_query / campus_schedule_range_query、无单日过滤、有课程事实）→ week-board；其余（含 campus_day_plan 单日、带 weekday 过滤、非 schedule 变体）→ result-card；week-board 数据损坏时回退 result-card。",
  "fields": [
    {"name": "version", "type": "string"},
    {"name": "variant", "type": "string"},
    {"name": "status", "type": "string"},
    {"name": "title", "type": "string"},
    {"name": "subtitle", "type": "string"},
    {"name": "verified", "type": "boolean"},
    {"name": "summary", "type": "string"},
    {"name": "context", "type": "string"},
    {"name": "sections", "type": "array<object>"},
    {"name": "actions", "type": "array<object>"},
    {"name": "displayMeta", "type": "object"},
    {"name": "layoutMode", "type": "string"},
    {"name": "weekBoardTitle", "type": "string"},
    {"name": "weekBoardSubtitle", "type": "string"},
    {"name": "days", "type": "array<object>"}
  ],
  "sectionFields": [
    "title",
    "note",
    "rows"
  ],
  "rowFields": [
    "label",
    "value",
    "badge",
    "hint"
  ],
  "actionFields": [
    "id",
    "type",
    "label",
    "payload"
  ],
  "actionPayloadFields": [
    "query"
  ],
  "displayMetaFields": [
    "simulated",
    "weekendMarked",
    "tieNote",
    "tieGroupCount",
    "recoverable"
  ],
  "dayFields": [
    "label",
    "blocks"
  ],
  "blockFields": [
    "time",
    "title",
    "location",
    "meta"
  ],
  "weekBoardFields": [
    "weekBoardTitle",
    "weekBoardSubtitle",
    "days"
  ],
  "leakFree": true,
  "forbiddenFields": [
    "queryId",
    "dataHash",
    "dataVersion",
    "sourceTool",
    "rankContext",
    "temporalContext",
    "NodeID",
    "VarBizID",
    "Authorization",
    "Token",
    "evidence",
    "computedAt",
    "internalUrl"
  ]
}
