{
  "schema": "fosuclass-adp-widget-contract/v7",
  "kind": "campus-result-unified",
  "name": "小序-校园智序结果卡",
  "status": "REAL_TENCENT_EXPORT_BOUND_FINAL_CANDIDATE",
  "widgetId": "978b004b2f054e8bbd5438159c7329ff",
  "sourceFile": "小序-校园智序结果卡.widget",
  "sourceSha256": "074d4b99d46f618e71ae08d4ac6718900a0cdd71c9d1944ba7ddb77a6c8a50d5",
  "widgetIdPolicy": "FAIL_CLOSED_REAL_TENCENT_EXPORT_ONLY",
  "activeFallback": null,
  "adapter": "adapter.py",
  "description": "小序-校园智序结果卡是唯一用户可见 Native Widget。契约绑定用户提供的真实腾讯 ADP 导出结构与 Widget ID；保持 15 字段双布局，整周课表使用时间板，其余校园结果使用结论优先结果卡。version 由确定性投影注入；空日被投影层过滤；tieGroupCount 无并列时省略、出现时至少为 1；actions 仅 sys.chat 且 payload 仅含自然语言 query；最终变体由当前目标与完成结果确定。任何内部协议、约束标识或研发版本不得进入用户界面。",
  "variants": [
    "schedule",
    "space",
    "collaboration",
    "risk",
    "reschedule",
    "ranking",
    "overview",
    "empty",
    "error",
    "message"
  ],
  "layoutModes": [
    "result-card",
    "week-board"
  ],
  "layoutModeRule": "variant=schedule 且为整周/周范围查询（campus_schedule_query / campus_schedule_range_query、无单日过滤、有课程事实）→ week-board；其余（含 campus_day_plan 单日、带 weekday 过滤、非 schedule 变体）→ result-card；week-board 数据损坏时回退 result-card。",
  "fields": [
    {"name": "version", "type": "string"},
    {"name": "variant", "type": "string"},
    {"name": "status", "type": "string"},
    {"name": "title", "type": "string"},
    {"name": "subtitle", "type": "string"},
    {"name": "verified", "type": "boolean"},
    {"name": "summary", "type": "string"},
    {"name": "context", "type": "string"},
    {"name": "sections", "type": "array<object>"},
    {"name": "actions", "type": "array<object>"},
    {"name": "displayMeta", "type": "object"},
    {"name": "layoutMode", "type": "string"},
    {"name": "weekBoardTitle", "type": "string"},
    {"name": "weekBoardSubtitle", "type": "string"},
    {"name": "days", "type": "array<object>"}
  ],
  "sectionFields": [
