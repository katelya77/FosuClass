  "widgetIdPolicy": "FAIL_CLOSED_REAL_TENCENT_EXPORT_ONLY",
  "activeFallback": null,
  "adapter": "adapter.py",
  "description": "小序-校园智序结果卡是唯一用户可见 Native Widget。契约绑定最新腾讯 ADP 导出结构与 Widget ID；保持 15 字段双布局，并以可选 section.kind 提供确定性 Campus Canvas 模块。v7 payload 缺少 kind 时兼容回退；未知 kind fail closed。version 由确定性投影注入；空日被过滤；tieGroupCount 无并列时省略、出现时至少为 1；actions 仅 sys.chat 且 payload 仅含自然语言 query。任何内部协议、约束标识或研发版本不得进入用户界面。",
  "variants": [
    "schedule",
    "space",
    "collaboration",
    "risk",
    "reschedule",
    "ranking",
    "overview",
    "empty",
    "error",
    "message"
  ],
  "layoutModes": [
    "result-card",
    "week-board"
  ],
  "layoutModeRule": "variant=schedule 且为整周/周范围查询（campus_schedule_query / campus_schedule_range_query、无单日过滤、有课程事实）→ week-board；其余（含 campus_day_plan 单日、带 weekday 过滤、非 schedule 变体）→ result-card；week-board 数据损坏时回退 result-card。",
  "fields": [
    {"name": "version", "type": "string"},
    {"name": "variant", "type": "string"},
    {"name": "status", "type": "string"},
    {"name": "title", "type": "string"},
    {"name": "subtitle", "type": "string"},
    {"name": "verified", "type": "boolean"},
    {"name": "summary", "type": "string"},
