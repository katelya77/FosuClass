    {"name": "sections", "type": "array<object>"},
    {"name": "actions", "type": "array<object>"},
    {"name": "displayMeta", "type": "object"},
    {"name": "layoutMode", "type": "string"},
    {"name": "weekBoardTitle", "type": "string"},
    {"name": "weekBoardSubtitle", "type": "string"},
    {"name": "days", "type": "array<object>"}
  ],
