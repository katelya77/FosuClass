{
  "schema": "fosuclass-adp-widget-contract/v8",
  "kind": "campus-result-unified",
  "name": "小序-校园智序结果卡",
  "status": "REAL_TENCENT_EXPORT_BOUND_FINAL_CANDIDATE",
  "widgetId": "601418106a374b2eb7de54c65a3de7e0",
