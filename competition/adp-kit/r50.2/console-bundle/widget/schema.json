{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "variant",
    "status",
    "title",
    "subtitle",
    "verified",
    "summary",
    "context",
    "sections",
    "actions",
    "displayMeta",
    "layoutMode",
    "weekBoardTitle",
    "weekBoardSubtitle",
    "days"
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "variant": {
      "type": "string",
      "enum": ["schedule", "space", "collaboration", "risk", "reschedule", "ranking", "overview", "empty", "error", "message"]
    },
    "status": { "type": "string", "enum": ["success", "empty", "error"] },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "verified": { "type": "boolean" },
    "summary": { "type": "string", "minLength": 1 },
    "context": { "type": "string" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "rows"],
        "properties": {
          "title": { "type": "string" },
          "note": { "type": "string" },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string" },
                "value": { "type": "string" },
                "badge": { "type": "string" },
                "hint": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "payload"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "const": "sys.chat" },
          "label": { "type": "string", "minLength": 1 },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["query"],
            "properties": {
              "query": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "displayMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simulated": { "type": "boolean" },
        "weekendMarked": { "type": "boolean" },
        "tieNote": { "type": "string" },
        "tieGroupCount": { "type": "integer", "minimum": 0 },
        "recoverable": { "type": "boolean" }
      }
    },
    "layoutMode": {
      "type": "string",
      "enum": ["result-card", "week-board"]
    },
    "weekBoardTitle": { "type": "string" },
    "weekBoardSubtitle": { "type": "string" },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "blocks"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "blocks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["time", "title", "location"],
              "properties": {
                "time": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "location": { "type": "string", "minLength": 1 },
                "meta": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": { "layoutMode": { "const": "week-board" } },
    "required": ["layoutMode"]
  },
  "then": {
    "properties": {
      "weekBoardTitle": { "type": "string", "minLength": 1 },
      "weekBoardSubtitle": { "type": "string", "minLength": 1 },
      "days": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["label", "blocks"],
          "properties": {
            "label": { "type": "string", "minLength": 1 },
            "blocks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["time", "title", "location"],
                "properties": {
                  "time": { "type": "string", "minLength": 1 },
                  "title": { "type": "string", "minLength": 1 },
                  "location": { "type": "string", "minLength": 1 },
                  "meta": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
