{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "timeText": { "type": "string" },
    "statusText": { "type": "string" },
    "footerText": { "type": "string" },
    "summary": {
      "type": "object",
      "properties": {
        "conflictCount": { "type": "integer", "minimum": 0 },
        "rushWarningCount": { "type": "integer", "minimum": 0 },
        "selfCompare": { "type": "boolean" },
        "firstBusySlots": { "type": "integer", "minimum": 0 },
        "secondBusySlots": { "type": "integer", "minimum": 0 }
      },
      "required": ["conflictCount", "rushWarningCount", "selfCompare", "firstBusySlots", "secondBusySlots"],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string" },
          "weekdayName": { "type": "string" },
          "periodText": { "type": "string" },
          "first": {
            "type": "object",
            "properties": {
              "courseName": { "type": "string" },
              "periodText": { "type": "string" },
              "campusName": { "type": "string" },
              "roomName": { "type": "string" }
            },
            "required": ["courseName", "periodText", "campusName", "roomName"],
            "additionalProperties": false
          },
          "second": {
            "type": "object",
            "properties": {
              "courseName": { "type": "string" },
              "periodText": { "type": "string" },
              "campusName": { "type": "string" },
              "roomName": { "type": "string" }
            },
            "required": ["courseName", "periodText", "campusName", "roomName"],
            "additionalProperties": false
          }
        },
        "required": ["date", "weekdayName", "periodText", "first", "second"],
        "additionalProperties": false
      }
    },
    "rushWarnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": { "type": "string" },
          "date": { "type": "string" },
          "weekdayName": { "type": "string" },
          "gapMinutes": { "type": "integer", "minimum": 0 },
          "from": {
            "type": "object",
            "properties": {
              "courseName": { "type": "string" },
              "periodText": { "type": "string" },
              "campusName": { "type": "string" },
              "roomName": { "type": "string" }
            },
            "required": ["courseName", "periodText", "campusName", "roomName"],
            "additionalProperties": false
          },
          "to": {
            "type": "object",
            "properties": {
              "courseName": { "type": "string" },
              "periodText": { "type": "string" },
              "campusName": { "type": "string" },
              "roomName": { "type": "string" }
            },
            "required": ["courseName", "periodText", "campusName", "roomName"],
            "additionalProperties": false
          }
        },
        "required": ["entity", "date", "weekdayName", "gapMinutes", "from", "to"],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "const": "sys.chat" },
          "label": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["id", "type", "label", "message"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "subtitle", "timeText", "statusText", "footerText", "summary", "items", "rushWarnings", "actions"],
  "additionalProperties": false
}
