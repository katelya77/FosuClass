{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "timeText": { "type": "string" },
    "phaseText": { "type": "string" },
    "statusText": { "type": "string" },
    "footerText": { "type": "string" },
    "metrics": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "value": { "type": "string" }
        },
        "required": ["id", "label", "value"],
        "additionalProperties": false
      }
    },
    "weeks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 }
        },
        "required": ["label", "count"],
        "additionalProperties": false
      }
    },
    "campuses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "campusName": { "type": "string" },
          "loadText": { "type": "string" },
          "freeText": { "type": "string" }
        },
        "required": ["campusName", "loadText", "freeText"],
        "additionalProperties": false
      }
    },
    "topTeachers": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "teacherName": { "type": "string" },
          "loadText": { "type": "string" }
        },
        "required": ["teacherName", "loadText"],
        "additionalProperties": false
      }
    },
    "top1": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "teacherName": { "type": "string" },
            "loadText": { "type": "string" },
            "week": { "type": "integer", "minimum": 1, "maximum": 20 }
          },
          "required": ["teacherName", "loadText", "week"],
          "additionalProperties": false
        }
      ]
    },
    "risks": {
      "type": "object",
      "properties": {
        "conflictCount": { "type": "integer", "minimum": 0 },
        "rushCount": { "type": "integer", "minimum": 0 },
        "continuousLoadCount": { "type": "integer", "minimum": 0 },
        "summaryText": { "type": "string" },
        "peakText": { "type": "string" }
      },
      "required": ["conflictCount", "rushCount", "continuousLoadCount", "summaryText", "peakText"],
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "const": "sys.chat" },
          "label": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["id", "type", "label", "message"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "subtitle", "timeText", "phaseText", "statusText", "footerText", "metrics", "weeks", "campuses", "topTeachers", "top1", "risks", "actions"],
  "additionalProperties": false
}
