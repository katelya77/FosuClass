{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/campus-task-widget.schema.json",
  "title": "校园任务结果卡",
  "type": "object",
  "required": ["cardType", "success", "queryId", "dataVersion", "items", "actions", "evidence"],
  "properties": {
    "cardType": { "enum": ["schedule", "classroom", "conflict", "day_plan", "error", "choice"] },
    "success": { "type": "boolean" },
    "queryId": { "type": "string" },
    "dataVersion": { "const": "competition-demo-v1" },
    "title": { "type": "string" },
    "timeText": { "type": "string" },
    "resolvedEntity": { "type": ["object", "null"] },
    "items": { "type": "array", "items": { "type": "object" } },
    "actions": { "type": "array", "maxItems": 4, "items": { "type": "object", "required": ["type", "label"] } },
    "evidence": { "type": "object", "required": ["verified"] },
    "error": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
