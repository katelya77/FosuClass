{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/campus-task-widget.schema.json",
  "title": "校园智序任务卡 ViewModel",
  "type": "object",
  "required": [
    "schemaVersion",
    "cardType",
    "success",
    "queryId",
    "dataVersion",
    "filters",
    "summary",
    "items",
    "actions",
    "interaction",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": "campus-widget/v2" },
    "cardType": { "enum": ["schedule", "classroom", "conflict", "day_plan", "error", "choice"] },
    "success": { "type": "boolean" },
    "queryId": { "type": "string" },
    "dataVersion": { "const": "competition-demo-v1" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "timeText": { "type": "string" },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "value": {}
        },
        "additionalProperties": true
      }
    },
    "summary": { "type": "object" },
    "items": { "type": "array", "items": { "type": "object" } },
    "rushWarnings": { "type": "array", "items": { "type": "object" } },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["sys.chat", "sys.go_to_url", "sys.download"] },
          "label": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "interaction": {
      "type": "object",
      "required": ["waitForUser"],
      "properties": {
        "waitForUser": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["verified"],
      "properties": {
        "verified": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "error": {
      "anyOf": [
        { "type": "object" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": { "const": true },
          "cardType": { "enum": ["schedule", "classroom", "conflict", "day_plan"] }
        },
        "required": ["success", "cardType"]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "verified": { "const": true }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
