{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "queryId": {
      "type": "string"
    },
    "dataVersion": {
      "type": "string",
      "const": "competition-demo-v1"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "action": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "sys.chat"
              },
              "label": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "key",
          "name",
          "type",
          "description",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "sys.chat",
              "sys.go_to_url",
              "sys.download"
            ]
          },
          "label": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "label"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "title",
    "subtitle",
    "queryId",
    "dataVersion",
    "items",
    "actions"
  ],
  "additionalProperties": false
}
