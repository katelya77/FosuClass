{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": { "type": "string" },
    "timeText": { "type": "string" },
    "queryId": { "type": "string" },
    "dataVersion": { "type": "string", "const": "competition-demo-v1" },
    "summary": {
      "type": "object",
      "properties": {
        "totalCount": { "type": "integer" },
        "shownCount": { "type": "integer" },
        "hiddenCount": { "type": "integer" },
        "entityType": { "type": "string" },
        "entityName": { "type": "string" }
      },
      "required": ["totalCount", "shownCount", "hiddenCount", "entityType", "entityName"],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lessonId": { "type": "string" },
          "courseName": { "type": "string" },
          "periodText": { "type": "string" },
          "startTime": { "type": "string" },
          "endTime": { "type": "string" },
          "date": { "type": "string" },
          "weekdayName": { "type": "string" },
          "campusName": { "type": "string" },
          "building": { "type": "string" },
          "roomName": { "type": "string" },
          "teachers": { "type": "array", "items": { "type": "string" } },
          "classes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["lessonId", "courseName", "periodText", "startTime", "endTime", "date", "weekdayName", "campusName", "building", "roomName", "teachers", "classes"],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "const": "sys.chat" },
          "label": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["id", "type", "label", "message"],
        "additionalProperties": false
      }
    }
  },
  "required": ["title", "timeText", "queryId", "dataVersion", "summary", "items", "actions"],
  "additionalProperties": false
}
