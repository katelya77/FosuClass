{
  "toolContractVersion": "1.0",
  "note": "R49-MA Agent Tool 契约真源。tests/ 直接引用本文件做 schema 校验。动态事实由底层 CampusTools 确定性计算；所有 ID 均为占位符（未取得真实腾讯 ID 前 FAIL CLOSED）。",
  "tools": [
    {
      "name": "campus_schedule_query",
      "agent": "schedule",
      "campusTool": "query_schedule",
      "restPath": "/api/query_schedule",
      "description": "查询班级/教师/教室/课程在指定教学周、星期或日期的课表，支持节次过滤。动态事实由 CampusTools 确定性计算。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entityType": { "type": "string", "enum": ["class", "teacher", "room", "course"], "description": "实体类型" },
          "entityName": { "type": "string", "description": "实体名称，如 教师009 / 2025级A班 / A1-101" },
          "week": { "type": "integer", "minimum": 1, "maximum": 20, "description": "教学周" },
          "weekday": { "type": "integer", "minimum": 1, "maximum": 7, "description": "星期 1-7" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "具体日期 YYYY-MM-DD（与 week/weekday 二选一）" },
          "periodStart": { "type": "integer", "minimum": 1, "maximum": 10 },
          "periodEnd": { "type": "integer", "minimum": 1, "maximum": 10 }
        },
        "required": ["entityType", "entityName"]
      },
      "outputStatus": ["success", "clarification", "no_result", "error"]
    },
    {
      "name": "campus_classroom_search",
      "agent": "schedule",
      "campusTool": "find_available_classrooms",
      "restPath": "/api/find_available_classrooms",
      "description": "查询指定日期/星期与连续节次范围内的空闲教室，支持校区、楼栋、最小容量过滤。动态事实由 CampusTools 确定性计算。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "campus": { "type": "string", "description": "校区A / 校区B / 校区C" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "week": { "type": "integer", "minimum": 1, "maximum": 20 },
          "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
          "periodStart": { "type": "integer", "minimum": 1, "maximum": 10 },
          "periodEnd": { "type": "integer", "minimum": 1, "maximum": 10 },
          "minCapacity": { "type": "integer", "minimum": 1 },
          "building": { "type": "string" },
          "consecutivePeriods": { "type": "integer", "minimum": 1, "maximum": 10 }
        },
        "required": []
      },
      "outputStatus": ["success", "clarification", "no_result", "error"]
    },
    {
      "name": "campus_risk_check",
      "agent": "risk",
      "campusTool": "compare_schedules",
      "restPath": "/api/compare_schedules",
      "description": "检查单个校园实体的自身时间冲突/跨校区赶场风险（mode=self，无需第二对象），或显式比较两个实体的课表冲突（mode=compare，需第二对象）。动态事实由 CampusTools 确定性计算。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": { "type": "string", "enum": ["self", "compare"], "description": "self=单对象自身风险（默认）；compare=显式双对象冲突比较" },
          "entityType": { "type": "string", "enum": ["class", "teacher", "room", "course"], "description": "第一对象类型" },
          "entityName": { "type": "string", "description": "第一对象名称" },
          "secondEntityType": { "type": "string", "enum": ["class", "teacher", "room", "course"], "description": "compare 模式必填：第二对象类型" },
          "secondEntityName": { "type": "string", "description": "compare 模式必填：第二对象名称" },
          "week": { "type": "integer", "minimum": 1, "maximum": 20 },
          "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "periodStart": { "type": "integer", "minimum": 1, "maximum": 10 },
          "periodEnd": { "type": "integer", "minimum": 1, "maximum": 10 }
        },
        "required": ["entityType", "entityName"],
        "if": { "properties": { "mode": { "const": "compare" } } },
        "then": { "required": ["secondEntityType", "secondEntityName"] }
      },
      "outputStatus": ["success", "clarification", "no_result", "error"]
    },
    {
      "name": "campus_day_plan",
      "agent": "risk",
      "campusTool": "generate_day_plan",
      "restPath": "/api/generate_day_plan",
      "description": "为演示用户生成指定日期的校园计划：课程、空闲空档、自习教室建议与跨校区提醒。动态事实由 CampusTools 确定性计算。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "visitorId": { "type": "string", "description": "演示用户（唯一真源 competition-demo-v2.json demoUsers[0].id = user-demo-001）" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "计划日期 YYYY-MM-DD" },
          "preferredCampus": { "type": "string", "description": "优先校区（可选）" },
          "preferredStudyDuration": { "type": "integer", "minimum": 1, "maximum": 10, "description": "期望连续自习节数（可选）" }
        },
        "required": ["date"]
      },
      "outputStatus": ["success", "clarification", "no_result", "error"]
    },
    {
      "name": "campus_overview",
      "agent": "insight",
      "campusTool": "get_campus_teaching_overview",
      "restPath": "/api/get_campus_teaching_overview",
      "description": "确定性汇总 2026-08-25 至 2026-09-27 校园教学态势：四周负载、校区空间压力、教师负载 Top、全局风险。动态事实由 CampusTools 确定性计算，所有指标只从 competition-demo-v2 匿名数据集派生。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "windowStart": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "首版固定 2026-08-25" },
          "teachingStart": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "首版固定 2026-08-31" },
          "windowEnd": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "首版固定 2026-09-27" }
        },
        "required": []
      },
      "outputStatus": ["success", "clarification", "no_result", "error"]
    },
    {
      "name": "campus_teacher_load_query",
      "agent": "insight",
      "campusTool": "query_teacher_load",
      "restPath": "/api/query_teacher_load",
      "description": "查询并确定性汇总教学周窗口（weekStart..weekEnd）内的教师课表负载排名，支持 topN 与校区过滤。动态事实由 CampusTools 确定性计算，所有指标只从 competition-demo-v2 匿名数据集派生。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "weekStart": { "type": "integer", "minimum": 1, "maximum": 20, "description": "起始教学周（必填）" },
          "weekEnd": { "type": "integer", "minimum": 1, "maximum": 20, "description": "结束教学周（必填，须 >= weekStart）" },
          "topN": { "type": "integer", "minimum": 1, "maximum": 10, "description": "返回前 N 名（可选）" },
          "campus": { "type": "string", "description": "校区A / 校区B / 校区C（可选）" }
        },
        "required": ["weekStart", "weekEnd"]
      },
      "outputStatus": ["success", "clarification", "no_result", "error"]
    },
    {
      "name": "campus_schedule_range_query",
      "agent": "schedule",
      "campusTool": "query_schedule_range",
      "restPath": "/api/query_schedule_range",
      "description": "查询班级/教师/教室/课程在 weekStart..weekEnd 教学周窗口内的课表，逐周展开（每个匹配周一条，携带 academicWeek），支持星期与节次过滤。动态事实由 CampusTools 确定性计算。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "entityType": { "type": "string", "enum": ["class", "teacher", "room", "course"], "description": "实体类型" },
          "entityName": { "type": "string", "description": "实体名称，如 教师009 / 2025级A班 / A1-101" },
          "weekStart": { "type": "integer", "minimum": 1, "maximum": 20, "description": "起始教学周（必填）" },
          "weekEnd": { "type": "integer", "minimum": 1, "maximum": 20, "description": "结束教学周（必填，须 >= weekStart）" },
          "weekday": { "type": "integer", "minimum": 1, "maximum": 7, "description": "星期 1-7（可选，0 视为未指定）" },
          "periodStart": { "type": "integer", "minimum": 1, "maximum": 10, "description": "起始节次（可选，0 视为未指定）" },
          "periodEnd": { "type": "integer", "minimum": 1, "maximum": 10, "description": "结束节次（可选，0 视为未指定）" }
        },
        "required": ["entityType", "entityName", "weekStart", "weekEnd"]
      },
      "outputStatus": ["success", "clarification", "no_result", "error"]
    }
  ],
  "ids": {
