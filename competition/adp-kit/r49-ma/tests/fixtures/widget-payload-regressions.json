        "version": "1.2.3-dev",
        "variant": "schedule",
        "status": "success",
        "title": "第1周课表",
        "subtitle": "教师003",
        "verified": true,
        "summary": "共 4 门课程。",
        "context": "第1教学周",
        "sections": [],
        "actions": [],
        "displayMeta": {},
        "layoutMode": "result-card",
        "weekBoardTitle": "",
        "weekBoardSubtitle": "",
        "days": []
      }
    },
    {
      "id": "week-board-empty-day",
      "kind": "week-board 携带无课空日（违反过滤 SSOT）",
      "expect": "fail",
      "mustMatch": ["课表"],
      "payload": {
        "version": "1.0",
        "variant": "schedule",
        "status": "success",
        "title": "第1周课表",
        "subtitle": "教师003",
