{
  "version": "1.0",
  "name": "小序-校园智序结果卡",
  "template": "",
  "jsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "default": "1.0",
        "type": "string",
        "const": "1.0"
      },
      "variant": {
        "default": "message",
        "type": "string",
        "enum": [
          "schedule",
          "space",
          "collaboration",
          "risk",
          "reschedule",
          "ranking",
          "overview",
          "empty",
          "error",
          "message"
        ]
      },
      "status": {
        "default": "success",
        "type": "string",
        "enum": [
          "success",
          "empty",
          "error"
        ]
      },
      "title": {
        "default": "校园智序结果",
        "type": "string"
      },
      "subtitle": {
        "default": "",
        "type": "string"
      },
      "verified": {
        "default": false,
        "type": "boolean"
      },
      "summary": {
        "default": "",
        "type": "string"
      },
      "context": {
        "default": "",
        "type": "string"
      },
      "sections": {
        "default": [],
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "default": "",
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "rows": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "default": "",
                    "type": "string"
                  },
                  "value": {
                    "default": "",
                    "type": "string"
                  },
                  "badge": {
                    "type": "string"
                  },
                  "hint": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "title",
            "rows"
          ],
          "additionalProperties": false
        }
      },
      "actions": {
        "default": [],
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "sys.chat"
            },
            "label": {
              "type": "string"
            },
            "payload": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                }
              },
              "required": [
                "query"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "label",
            "payload"
          ],
          "additionalProperties": false
        }
      },
      "displayMeta": {
        "default": {},
        "type": "object",
        "properties": {
          "simulated": {
            "type": "boolean"
          },
          "weekendMarked": {
            "type": "boolean"
          },
          "tieNote": {
            "type": "string"
          },
          "tieGroupCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "recoverable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "layoutMode": {
        "default": "result-card",
        "type": "string",
        "enum": [
          "result-card",
          "week-board"
        ]
      },
      "weekBoardTitle": {
        "default": "",
        "type": "string"
      },
      "weekBoardSubtitle": {
        "default": "",
        "type": "string"
      },
      "days": {
        "default": [],
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "default": "",
              "type": "string"
            },
            "blocks": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "time": {
                    "default": "",
                    "type": "string"
                  },
                  "title": {
                    "default": "",
                    "type": "string"
                  },
                  "location": {
                    "default": "",
                    "type": "string"
                  },
                  "meta": {
                    "type": "string"
                  }
                },
                "required": [
                  "time",
                  "title",
                  "location"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "label",
            "blocks"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "version",
      "variant",
      "status",
      "title",
      "subtitle",
      "verified",
      "summary",
      "context",
      "sections",
      "actions",
      "displayMeta",
      "layoutMode",
      "weekBoardTitle",
      "weekBoardSubtitle",
      "days"
    ],
    "additionalProperties": false
  },
  "outputJsonPreview": {
    "type": "Card",
    "size": "md",
    "background": "#FFF9F5",
    "status": "待核验",
    "children": [
      {
        "type": "Col",
        "gap": 3,
        "children": [
          {
            "type": "Box",
            "direction": "col",
            "gap": 2,
            "padding": "16px",
            "background": "#FBE5DE",
            "border": {
              "size": 1,
              "color": "#F2D4CC",
              "style": "solid"
            },
            "radius": "xl",
            "children": [
              {
                "type": "Row",
                "gap": 2,
                "align": "center",
                "justify": "between",
                "children": [
                  {
                    "type": "Caption",
                    "value": "校园结果",
                    "color": "#B94535",
                    "weight": "semibold"
                  },
                  {
                    "type": "Badge",
                    "label": "已核验",
                    "color": "success",
                    "variant": "soft",
                    "size": "sm",
                    "pill": true
                  }
                ]
              },
              {
                "type": "Title",
                "value": "校园智序 · 结果说明",
                "size": "md",
                "maxLines": 3
              },
              {
                "type": "Caption",
                "value": "统一结果卡",
                "color": "#806F6B"
              },
              {
                "type": "Text",
                "value": "课程、空间、风险、协作与教学态势，会在这里以清晰的结果卡呈现。",
                "size": "sm",
                "weight": "semibold",
                "color": "#302522"
              }
            ]
          },
          {
            "type": "Col",
            "key": "说明-0",
            "gap": 2,
            "children": [
              {
                "type": "Divider"
              },
              {
                "type": "Col",
                "gap": 1,
                "children": [
                  {
                    "type": "Text",
                    "value": "说明",
                    "size": "sm",
                    "weight": "semibold",
                    "color": "#302522"
                  }
                ]
              },
              {
                "type": "Col",
                "gap": 2,
                "children": [
                  {
                    "type": "Box",
                    "key": "说明--0",
                    "direction": "col",
                    "gap": 1,
                    "padding": "10px",
                    "background": "#FFFDFB",
                    "radius": "md",
                    "children": [
                      {
                        "type": "Text",
                        "value": "小序会把查询、核验与结论整理成可读的结果；业务事实仍完全来自已核验工具。",
                        "size": "sm",
                        "color": "#302522"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "encodedWidget": ""
}