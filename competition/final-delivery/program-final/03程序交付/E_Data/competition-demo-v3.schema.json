{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campus-demo/v3/competition-demo-v3.schema.json",
  "title": "competition-demo-v3 Anonymous Campus Demo Dataset",
  "description": "校园智序·小序 腾讯云 ADP 赛事匿名演示数据 V3 契约（与 R50.0-SEMANTIC-CORE-DESIGN.md §5 一致）：4 校区 / 24 班 / 40 师 / 73 课 / 84 教室 / 172 课次，全部虚构、确定性生成。",
  "type": "object",
  "required": [
    "meta",
    "campuses",
    "campusTravelMatrix",
    "colleges",
    "classes",
    "teachers",
    "courses",
    "rooms",
    "lessons",
    "demoUsers"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["dataVersion", "schema", "demoReferenceDate", "semester", "periods", "weekdayNames", "designedScenarios", "dataHash"],
      "properties": {
        "dataVersion": { "const": "competition-demo-v3" },
        "schema": { "const": "campus-demo/v3" },
        "timezone": { "type": "string" },
        "demoReferenceDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "semester": {
          "type": "object",
          "required": ["id", "name", "startDate", "endDate", "totalWeeks"],
          "properties": {
            "id": { "const": "2026-2027-1" },
            "name": { "type": "string" },
            "startDate": { "const": "2026-08-31" },
            "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "totalWeeks": { "const": 20 }
          }
        },
        "periods": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["period", "start", "end"],
            "properties": {
              "period": { "type": "integer", "minimum": 1, "maximum": 10 },
              "start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
              "end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" }
            }
          }
        },
        "weekdayNames": { "type": "array", "minItems": 7 },
        "designedScenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "description"],
            "properties": {
              "id": { "type": "string", "pattern": "^g\\d{2}$" },
              "name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "dataHash": { "type": "string", "pattern": "^sha1:[0-9a-f]{12}$" }
      }
    },
    "campuses": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "buildings"],
        "properties": {
          "id": { "type": "string", "pattern": "^campus-[a-d]$" },
          "name": { "enum": ["校区A", "校区B", "校区C", "校区D"] },
          "buildings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "campusTravelMatrix": {
      "type": "object",
      "required": ["unit", "matrix"],
      "properties": {
        "unit": { "const": "minutes" },
        "matrix": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {
            "type": "object",
            "minProperties": 4,
            "additionalProperties": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "colleges": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": { "id": { "type": "string" }, "name": { "type": "string" } }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 24,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "name", "collegeId", "campusId", "size"],
        "properties": {
          "id": { "type": "string", "pattern": "^class-[a-z]+-\\d{2}$" },
          "name": { "type": "string", "pattern": "^202[45]级.+类\\d{2}班$" },
          "collegeId": { "type": "string" },
          "campusId": { "type": "string", "pattern": "^campus-[a-d]$" },
          "size": { "type": "integer", "minimum": 30, "maximum": 130 }
        }
      }
    },
    "teachers": {
      "type": "array",
      "minItems": 36,
      "maxItems": 48,
      "items": {
        "type": "object",
        "required": ["id", "name", "collegeId", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^teacher-\\d{3}$" },
          "name": { "type": "string", "pattern": "^教师\\d{3}$" },
          "collegeId": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "courses": {
      "type": "array",
      "minItems": 60,
      "maxItems": 80,
      "items": {
        "type": "object",
        "required": ["id", "name", "collegeId", "credits", "category", "courseType", "requiredFeatures", "expectedSize"],
        "properties": {
          "id": { "type": "string", "pattern": "^course-\\d{3}$" },
          "name": { "type": "string" },
          "collegeId": { "type": "string" },
          "credits": { "type": "number" },
          "category": { "enum": ["必修", "选修", "实验", "实践"] },
          "courseType": { "enum": ["lecture", "lab", "practice", "pe", "seminar"] },
          "requiredFeatures": { "type": "array", "items": { "type": "string" } },
          "expectedSize": { "type": "integer" }
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 72,
      "maxItems": 96,
      "items": {
        "type": "object",
        "required": ["id", "name", "building", "capacity", "type", "features", "campusId"],
        "properties": {
          "id": { "type": "string", "pattern": "^room-[a-d]-\\d{3}$" },
          "name": { "type": "string" },
          "building": { "type": "string" },
          "capacity": { "type": "integer", "minimum": 20, "maximum": 300 },
          "type": { "type": "string" },
          "features": { "type": "array", "items": { "type": "string" } },
          "campusId": { "type": "string", "pattern": "^campus-[a-d]$" }
        }
      }
    },
    "lessons": {
      "type": "array",
      "minItems": 160,
      "maxItems": 220,
      "items": {
        "type": "object",
        "required": [
          "id", "courseId", "teacherIds", "classIds", "roomId", "roomName",
          "campusId", "weekday", "periodStart", "periodEnd", "weeks", "weekList"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^lesson-\\d{3}$" },
          "courseId": { "type": "string" },
          "teacherIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "classIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "roomId": { "type": "string" },
          "roomName": { "type": "string" },
          "campusId": { "type": "string", "pattern": "^campus-[a-d]$" },
          "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
          "periodStart": { "type": "integer", "minimum": 1, "maximum": 10 },
          "periodEnd": { "type": "integer", "minimum": 1, "maximum": 10 },
          "weeks": { "type": "string" },
          "weekList": { "type": "array", "minItems": 1, "items": { "type": "integer" } }
        }
      }
    },
    "demoUsers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "campusId", "collegeId"],
        "properties": {
          "id": { "type": "string", "pattern": "^user-demo-\\d{3}$" },
          "name": { "type": "string", "pattern": "^演示用户\\d{3}$" },
          "role": { "enum": ["student", "teacher"] },
          "classIds": { "type": "array", "items": { "type": "string" } },
          "teacherId": { "type": "string" },
          "campusId": { "type": "string" },
          "collegeId": { "type": "string" }
        }
      }
    }
  }
}
