{
  "version": "1.0",
  "name": "小序-校园智序结果卡",
  "template": "",
  "jsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "string",
        "const": "1.0"
      },
      "variant": {
        "type": "string",
        "enum": [
          "schedule",
          "space",
          "collaboration",
          "risk",
          "reschedule",
          "ranking",
          "overview",
          "empty",
          "error",
          "message"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "success",
          "empty",
          "error"
        ]
      },
      "title": {
        "type": "string"
      },
      "subtitle": {
        "type": "string"
      },
      "verified": {
        "type": "boolean"
      },
      "summary": {
        "type": "string"
      },
      "context": {
        "type": "string"
      },
      "sections": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "metric",
                "timeline",
                "route",
                "recommendation",
                "ranking",
                "comparison",
                "entity-list",
                "notice",
                "prose"
              ]
            },
            "note": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "value": {
                    "type": "string"
                  },
                  "badge": {
                    "type": "string"
                  },
                  "hint": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "title",
            "rows"
          ],
          "additionalProperties": false
        }
      },
      "actions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "sys.chat"
            },
            "label": {
              "type": "string"
            },
            "payload": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                }
              },
              "required": [
                "query"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "type",
            "label",
            "payload"
          ],
          "additionalProperties": false
        }
      },
      "displayMeta": {
        "type": "object",
        "properties": {
          "simulated": {
            "type": "boolean"
          },
          "weekendMarked": {
            "type": "boolean"
          },
          "tieNote": {
            "type": "string"
          },
          "tieGroupCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "recoverable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "layoutMode": {
        "type": "string",
        "enum": [
          "result-card",
          "week-board"
        ]
      },
      "weekBoardTitle": {
        "type": "string"
      },
      "weekBoardSubtitle": {
        "type": "string"
      },
      "days": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string"
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "time": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "meta": {
                    "type": "string"
                  }
                },
                "required": [
                  "time",
                  "title",
                  "location"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "label",
            "blocks"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "version",
      "variant",
      "status",
      "title",
      "subtitle",
      "verified",
      "summary",
      "context",
      "sections",
      "actions",
      "displayMeta",
      "layoutMode",
      "weekBoardTitle",
      "weekBoardSubtitle",
      "days"
    ],
    "additionalProperties": false
  },
  "outputJsonPreview": {
    "type": "Card",
    "size": "md",
    "background": "#FFFDFC",
    "status": "待核验",
    "children": [
      {
        "type": "Col",
        "gap": 3,
        "children": [
          {
            "type": "Box",
            "direction": "col",
            "gap": 2,
            "padding": "14px",
            "background": "#F7F9F8",
            "radius": "xl",
            "children": [
              {
                "type": "Row",
                "gap": 2,
                "align": "center",
                "justify": "between",
                "children": [
                  {
                    "type": "Caption",
                    "value": "暂无结果",
                    "color": "#159A62",
                    "weight": "semibold"
                  },
                  {
                    "type": "Row",
                    "gap": 1,
                    "align": "center",
                    "children": [
                      {
                        "type": "Badge",
                        "label": "暂无",
                        "color": "secondary",
                        "variant": "soft",
                        "size": "sm",
                        "pill": true
                      }
                    ]
                  }
                ]
              },
              {
                "type": "Title",
                "value": "校园教学任务结果",
                "size": "md"
              },
              {
                "type": "Caption",
                "value": "课表 · 空间 · 协同 · 风险",
                "color": "#77827D"
              },
              {
                "type": "Box",
                "direction": "col",
                "gap": 1,
                "padding": "11px",
                "background": "#F7F9F8",
                "border": {
                  "left": {
                    "size": 3,
                    "color": "#A2AAA6",
                    "style": "solid"
                  }
                },
                "radius": "md",
                "children": [
                  {
                    "type": "Caption",
                    "value": "结论先行",
                    "color": "#77827D",
                    "weight": "semibold"
                  },
                  {
                    "type": "Text",
                    "value": "输入一个校园教学问题，小序会在这里展示经过核验的结果。",
                    "size": "md",
                    "weight": "semibold",
                    "color": "#68736E"
                  }
                ]
              },
              {
                "type": "Caption",
                "value": "通用预览",
                "color": "#77827D"
              }
            ]
          },
          {
            "type": "Col",
            "key": "可以从这些问题开始-0",
            "gap": 2,
            "children": [
              {
                "type": "Divider"
              },
              {
                "type": "Row",
                "gap": 2,
                "align": "center",
                "justify": "between",
                "children": [
                  {
                    "type": "Text",
                    "value": "可以从这些问题开始",
                    "size": "sm",
                    "weight": "semibold",
                    "color": "#26312D"
                  },
                  {
                    "type": "Caption",
                    "value": "真实答案由 CampusTools 查询后生成",
                    "color": "#77827D"
                  }
                ]
              },
              {
                "type": "Col",
                "gap": 1,
                "children": [
                  {
                    "type": "Box",
                    "key": "可以从这些问题开始-课表与空间-0",
                    "direction": "row",
                    "gap": 2,
                    "padding": "8px",
                    "children": [
                      {
                        "type": "Col",
                        "gap": 1,
                        "flex": 1,
                        "children": [
                          {
                            "type": "Text",
                            "value": "课表与空间",
                            "size": "sm",
                            "weight": "semibold",
                            "color": "#26312D"
                          },
                          {
                            "type": "Caption",
                            "value": "查询课程安排、教师、班级、教室与时间",
                            "color": "#77827D"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Box",
                    "key": "可以从这些问题开始-协同与调课-1",
                    "direction": "row",
                    "gap": 2,
                    "padding": "8px",
                    "children": [
                      {
                        "type": "Col",
                        "gap": 1,
                        "flex": 1,
                        "children": [
                          {
                            "type": "Text",
                            "value": "协同与调课",
                            "size": "sm",
                            "weight": "semibold",
                            "color": "#26312D"
                          },
                          {
                            "type": "Caption",
                            "value": "查找共同空闲，并校验调课约束",
                            "color": "#77827D"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "type": "Box",
                    "key": "可以从这些问题开始-风险与洞察-2",
                    "direction": "row",
                    "gap": 2,
                    "padding": "8px",
                    "children": [
                      {
                        "type": "Col",
                        "gap": 1,
                        "flex": 1,
                        "children": [
                          {
                            "type": "Text",
                            "value": "风险与洞察",
                            "size": "sm",
                            "weight": "semibold",
                            "color": "#26312D"
                          },
                          {
                            "type": "Caption",
                            "value": "检查时间冲突、转场压力与教学负载",
                            "color": "#77827D"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "Col",
        "gap": 2,
        "children": [
          {
            "type": "Divider"
          },
          {
            "type": "Row",
            "gap": 2,
            "wrap": "wrap",
            "children": [
              {
                "type": "Button",
                "key": "preview-schedule",
                "label": "查看我的课表",
                "size": "sm",
                "variant": "solid",
                "onClickAction": {
                  "type": "sys.chat",
                  "payload": {
                    "query": "查看我的本周课表"
                  }
                }
              },
              {
                "type": "Button",
                "key": "preview-space",
                "label": "查找空闲教室",
                "size": "sm",
                "variant": "outline",
                "onClickAction": {
                  "type": "sys.chat",
                  "payload": {
                    "query": "查找今天可用的空闲教室"
                  }
                }
              },
              {
                "type": "Button",
                "key": "preview-risk",
                "label": "检查教学风险",
                "size": "sm",
                "variant": "outline",
                "onClickAction": {
                  "type": "sys.chat",
                  "payload": {
                    "query": "检查我的本周课表是否存在时间冲突或转场压力"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "encodedWidget": ""
}