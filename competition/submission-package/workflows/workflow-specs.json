    {
      "id": "wf-conflict",
      "name": "03-课程冲突比较",
      "intent": "compare_schedules",
      "trigger": "用户要比较两个班级、教师、教室或课程的时间重叠/赶场风险；不处理单对象课表或空教室。",
      "actualStartInputs": [
        "first_entity_type",
        "first_entity_name",
        "second_entity_type",
        "second_entity_name",
        "date_range",
        "period_scope"
