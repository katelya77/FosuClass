{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/campus-demo-v1.schema.json",
  "title": "校园智序 · 小序 匿名演示数据 competition-demo-v1",
  "description": "腾讯云 ADP 参赛智能体演示数据集结构约束。全部实体为虚构匿名数据。",
  "type": "object",
  "required": ["meta", "campuses", "colleges", "classes", "teachers", "courses", "rooms", "lessons", "demoUsers", "nameIndex", "dataHash"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["dataVersion", "schema", "timezone", "demoReferenceDate", "semester", "periods", "anonymization"],
      "properties": {
        "dataVersion": { "const": "competition-demo-v1" },
        "schema": { "const": "campus-demo/v1" },
        "timezone": { "const": "Asia/Shanghai" },
        "demoReferenceDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "anonymization": { "type": "string" },
        "designedScenarios": { "type": "array", "items": { "type": "string" } },
        "semester": {
          "type": "object",
          "required": ["id", "name", "startDate", "endDate", "totalWeeks"],
          "properties": {
            "id": { "const": "2026-2027-1" },
            "name": { "const": "2026-2027学年第一学期" },
            "startDate": { "const": "2026-08-31" },
            "endDate": { "const": "2027-01-17" },
            "totalWeeks": { "const": 20 }
          }
        },
        "periods": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["period", "start", "end"],
            "properties": {
              "period": { "type": "integer", "minimum": 1, "maximum": 10 },
              "start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
              "end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" }
            }
          }
        }
      }
    },
    "campuses": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "required": ["id", "name", "buildings"],
        "properties": {
          "id": { "type": "string", "pattern": "^campus-" },
          "name": { "type": "string", "pattern": "^校区[A-Z]$" },
          "buildings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "colleges": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^college-" },
          "name": { "type": "string", "pattern": "^学院[A-Z]$" }
        }
      }
    },
    "classes": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object", "required": ["id", "name", "collegeId", "campusId", "size"],
        "properties": {
          "id": { "type": "string", "pattern": "^cls-" },
          "name": { "type": "string", "pattern": "^2025级[A-Z]班$" },
          "collegeId": { "type": "string" },
          "campusId": { "type": "string" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "teachers": {
      "type": "array", "minItems": 8,
      "items": {
        "type": "object", "required": ["id", "name", "collegeId", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^t-\\d{3}$" },
          "name": { "type": "string", "pattern": "^教师\\d{3}$" },
          "collegeId": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "courses": {
      "type": "array", "minItems": 16,
      "items": {
        "type": "object", "required": ["id", "name", "credits", "collegeId", "category"],
        "properties": {
          "id": { "type": "string", "pattern": "^c-\\d{2}$" },
          "name": { "type": "string" },
          "credits": { "type": "number" },
          "collegeId": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },
    "rooms": {
      "type": "array", "minItems": 20,
      "items": {
        "type": "object", "required": ["id", "name", "campusId", "building", "capacity", "type"],
        "properties": {
          "id": { "type": "string", "pattern": "^r-" },
          "name": { "type": "string" },
          "campusId": { "type": "string" },
          "building": { "type": "string" },
          "capacity": { "type": "integer", "minimum": 1 },
          "type": { "type": "string" }
        }
      }
    },
    "lessons": {
      "type": "array", "minItems": 30,
      "items": {
        "type": "object",
        "required": ["id", "courseId", "teacherIds", "classIds", "roomId", "campusId", "weekday", "periodStart", "periodEnd", "weeks", "weekList"],
        "properties": {
          "id": { "type": "string", "pattern": "^les-\\d{3}$" },
          "courseId": { "type": "string" },
          "teacherIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "classIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "roomId": { "type": "string" },
          "campusId": { "type": "string" },
          "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
          "periodStart": { "type": "integer", "minimum": 1, "maximum": 10 },
          "periodEnd": { "type": "integer", "minimum": 1, "maximum": 10 },
          "weeks": { "type": "string", "pattern": "^\\d+(-\\d+)?(,\\d+(-\\d+)?)*$" },
          "weekList": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 20 } }
        }
      }
    },
    "demoUsers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "visitorId", "classId", "electiveCourseIds", "preferredCampus"],
        "properties": {
          "id": { "type": "string", "pattern": "^demo-user-\\d{3}$" },
          "name": { "type": "string", "pattern": "^演示用户\\d{3}$" },
          "visitorId": { "type": "string" },
          "classId": { "type": "string" },
          "electiveCourseIds": { "type": "array", "items": { "type": "string" } },
          "preferredCampus": { "type": "string" }
        }
      }
    },
    "nameIndex": { "type": "object" },
    "dataHash": { "type": "string", "pattern": "^sha1:[0-9a-f]{12}$" }
  }
}
