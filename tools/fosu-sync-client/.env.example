FOSU_BASE_URL=https://100.fosu.edu.cn
FOSU_AUTH_URL=https://authserver.fosu.edu.cn
FOSU_API_BASE=https://class.katelya.eu.org
ADMIN_API_TOKEN=your_admin_token_here

# 登录模式：
# playwright-manual：打开浏览器，用户手动登录，然后脚本复用会话
# manual-cookie：用户手动复制 Cookie 到本地 .env
# password-mobile：用账号密码和移动端 UA 尝试登录，不绕过验证码
FOSU_SYNC_AUTH_MODE=playwright-manual

FOSU_USERNAME=
FOSU_PASSWORD=
FOSU_MANUAL_COOKIE=

# 可选：移动端 UA，降低验证码触发概率，但不破解验证码
FOSU_LOGIN_PROFILE=mobile
