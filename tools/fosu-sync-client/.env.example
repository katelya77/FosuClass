FOSU_API_BASE=https://class.katelya.eu.org
ADMIN_API_TOKEN=your_admin_token_here
FOSU_BASE_URL=http://100.fosu.edu.cn
FOSU_AUTH_URL=https://authserver.fosu.edu.cn
FOSU_SYNC_AUTH_MODE=playwright-manual
# Optional explicit override. Leave empty for canonical config/terms preferred term
# and the online active pointer to remain authoritative.
PREFERRED_SEMESTER=
# Production crawl commands print and enforce SyncPlan.
# Daily/new-term/crawl profiles default to dynamic schedule network-only,
# ignore progress, ignore negative cache, and mergeOldData=false.
SYNC_CATALOG_POLICY=reuse-validated
SYNC_SCHEDULE_POLICY=network-only
SYNC_PROGRESS_POLICY=ignore
SYNC_NEGATIVE_CACHE_POLICY=ignore
SYNC_GRADE_RANGE=custom
SYNC_GRADES=2021,2022,2023,2024,2025
SYNC_DISABLE_PROXY=true
SYNC_UPLOAD_CHUNK_SIZE=10
# Upload-only commands do not access 100.fosu.edu.cn.
SYNC_RELEASE_INCLUDE_RESOURCES=true
SYNC_RESOURCE_CONCURRENCY=1
SYNC_RESOURCE_DELAY_MIN_MS=800
SYNC_RESOURCE_DELAY_MAX_MS=1500
