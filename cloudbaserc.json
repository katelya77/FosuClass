{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "envId": "cloud1-d3g17rpe7566d3d5c",
  "functionRoot": "cloudfunctions",
  "functions": [
    {
      "name": "fosuImportRelay",
      "handler": "index.main",
      "runtime": "Nodejs18.15",
      "timeout": 60,
      "memorySize": 512,
      "description": "FosuClass APaaS personal schedule import relay",
      "envVariables": {
        "NODE_ENV": "production",
        "FOSU_AUTH_BASE": "https://authserver.fosu.edu.cn",
        "FOSU_APAAS_BASE": "https://apaas.fosu.edu.cn",
        "FOSU_IMPORT_TIMEOUT_MS": "25000",
        "FOSU_APAAS_PAGE_SIZE": "500",
        "FOSU_APAAS_PAGE_CONCURRENCY": "3"
      }
    },
    {
      "name": "aiVoiceTranscribe",
      "handler": "index.main",
      "runtime": "Nodejs18.15",
      "timeout": 30,
      "memorySize": 256,
      "description": "Xiaofu voice to Tencent ASR transcribe",
      "envVariables": {
        "NODE_ENV": "production"
      },
      "installDependency": true
    },
    {
      "name": "xiaofuAgentGateway",
      "handler": "index.main",
      "runtime": "Nodejs18.15",
      "timeout": 60,
      "memorySize": 256,
      "description": "AG-UI gateway for Xiaofu Agent",
      "envVariables": {
        "NODE_ENV": "production",
        "FOSU_AGENT_TIMEOUT_MS": "25000",
        "FOSU_AGENT_API_BASE": "https://class.katelya.eu.org"
      },
      "installDependency": true
    }
  ]
}
