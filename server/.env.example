NODE_ENV=production
PORT=3000

# 宿主机本地绑定的 IP 和 API 暴露端口，防止跟 DecoTV 3000 等容器发生冲突
HOST_BIND_IP=127.0.0.1
HOST_API_PORT=18318

PUBLIC_API_ORIGIN=https://class.katelya.eu.org

FOSU_BASE_URL=https://100.fosu.edu.cn
FOSU_AUTH_URL=https://authserver.fosu.edu.cn

FOSU_SERVICE_USERNAME=your_fosu_username_here
FOSU_SERVICE_PASSWORD=your_fosu_password_here

CACHE_TTL_CATALOG=600
CACHE_TTL_MAJOR=1800
CACHE_TTL_SCHEDULE=600

REQUEST_TIMEOUT_MS=15000

CORS_ALLOWED_ORIGINS=https://class.katelya.eu.org,http://localhost:3000,http://127.0.0.1:18318
