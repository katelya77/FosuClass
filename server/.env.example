# FosuClass server environment example (never commit real secrets)
NODE_ENV=development
PORT=3000

# Web admin login (required in production)
ADMIN_PASSWORD=change-me
# Optional separate static admin token for login/Bearer full access
# ADMIN_TOKEN=

# Machine sync / publisher token — set explicitly in production.
# Do NOT leave this empty in production if you rely on publisher clients.
# If empty and ADMIN_PASSWORD is set, a derived token is generated (legacy, migration debt).
ADMIN_API_TOKEN=replace-with-long-random-token

# Optional: restrict legacy ADMIN_API_TOKEN scopes (default admin:full)
# ADMIN_API_TOKEN_SCOPES=admin:full

# Optional scoped service tokens (JSON array). Values never logged by preflight.
# ADMIN_SERVICE_TOKENS=[{"name":"stager","token":"...","scopes":["staging:init","staging:chunk","staging:finalize"]}]

# Config validation hard-fail (default off / migration-safe).
# Set true only after secrets migration is complete.
# FOSU_CONFIG_HARD_FAIL=false

# Admin SPA rollout
# FOSU_ADMIN_NEXT_ENABLED=true
# FOSU_ADMIN_PRIMARY=legacy
# FOSU_ADMIN_PRIMARY=next

PUBLIC_API_ORIGIN=http://localhost:3000
