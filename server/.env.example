NODE_ENV=production
PORT=3000

# 宿主机本地绑定的 IP 和 API 暴露端口，防止与主机其他容器冲突
HOST_BIND_IP=127.0.0.1
HOST_API_PORT=18318

PUBLIC_API_ORIGIN=https://class.katelya.eu.org

# 强智教务系统与 CAS 统一登录的端点
FOSU_BASE_URL=https://100.fosu.edu.cn
FOSU_AUTH_URL=https://authserver.fosu.edu.cn

# 数据源模式: cache-first (优先从本地缓存提取) | realtime (实时穿透请求教务)
DATA_SOURCE_MODE=cache-first

# 后台管理端凭证配置
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD   # 必须：Web 后台的登录密码
ADMIN_TOKEN=YOUR_ADMIN_TOKEN         # 可选：静态登录 Token 或 Bearer 鉴权 Token
ADMIN_API_TOKEN=YOUR_ADMIN_API_TOKEN # 可选：同步客户端认证 Token (若留空则基于密码派生)

# 强智各层数据缓存时间（秒）
CACHE_TTL_CATALOG=600
CACHE_TTL_MAJOR=1800
CACHE_TTL_SCHEDULE=600

REQUEST_TIMEOUT_MS=15000

# CORS 跨域域名授权白名单
CORS_ALLOWED_ORIGINS=https://class.katelya.eu.org,http://localhost:3000,http://127.0.0.1:18318
