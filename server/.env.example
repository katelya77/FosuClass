NODE_ENV=production
PORT=3000

# 宿主机本地绑定的 IP 和 API 暴露端口，防止与主机其他容器冲突
HOST_BIND_IP=127.0.0.1
HOST_API_PORT=18318

PUBLIC_API_ORIGIN=https://class.katelya.eu.org

# 强智教务系统与 CAS 统一登录的端点
FOSU_BASE_URL=https://100.fosu.edu.cn
FOSU_AUTH_URL=https://authserver.fosu.edu.cn
FOSU_AUTH_BASE=https://authserver.fosu.edu.cn
FOSU_APAAS_BASE=https://apaas.fosu.edu.cn
FOSU_IMPORT_TIMEOUT_MS=30000
FOSU_IMPORT_PREVIEW_TTL_SECONDS=600
FOSU_IMPORT_ENABLE=true
FOSU_IMPORT_USE_PLAYWRIGHT_FALLBACK=false
FOSU_IMPORT_MOBILE_UA=Mozilla/5.0 (iPhone; CPU iPhone OS 17_4 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 MicroMessenger/8.0.49
FOSU_IMPORT_RATE_LIMIT_ENABLED=true
FOSU_IMPORT_IP_RATE_LIMIT_10M=12

# 数据源模式: cache-first (优先从本地缓存提取) | realtime (实时穿透请求教务)
DATA_SOURCE_MODE=cache-first

# 后台管理端凭证配置
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
ADMIN_TOKEN=YOUR_ADMIN_TOKEN
ADMIN_API_TOKEN=YOUR_ADMIN_API_TOKEN

# 强智各层数据缓存时间（秒）
CACHE_TTL_CATALOG=600
CACHE_TTL_MAJOR=1800
CACHE_TTL_SCHEDULE=600

REQUEST_TIMEOUT_MS=15000

# 2C12G 资源保护：普通 API 低 body limit，大上传和 XLS 导入单独放宽
FOSU_JSON_BODY_LIMIT=2mb
FOSU_LARGE_JSON_BODY_LIMIT=30mb
FOSU_PERSONAL_XLS_BODY_LIMIT=20mb
FOSU_URLENCODED_BODY_LIMIT=1mb
FOSU_RAW_UPLOAD_BODY_LIMIT=150mb
FOSU_STAGING_CHUNK_BODY_LIMIT=12mb
FOSU_API_CPUS=1.5
FOSU_API_MEM_LIMIT=1536m

# AI 校园管家：优先使用 DeepSeek；密钥只从 server/.env 或运行环境变量读取
AI_AGENT_ENABLED=true
AI_RUNTIME_MODE=public
AI_PROVIDER=deepseek
AI_PROVIDER_POLICY=auto
AI_MODEL=deepseek-v4-flash
AI_REASONING_MODEL=deepseek-v4-pro
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_TIMEOUT_MS=15000
AI_MAX_TOKENS=1200
AI_TEMPERATURE=0.1
AI_THINKING_ENABLED=false
AI_REASONING_EFFORT=medium
AI_PROVIDER_JSON_REPAIR=true
DEEPSEEK_STRICT_JSON_MODE=false
AI_MAX_CONTEXT_COURSES=80
AI_LOG_PROMPTS=false
AI_ALLOW_PERSONAL_CONTEXT=false
FOSU_AGENT_MEMORY_SECRET=
COZE_API_BASE_URL=https://api.coze.cn
COZE_API_KEY=
COZE_API_MODE=bot
COZE_BOT_ID=
COZE_CHAT_ENDPOINT=/v3/chat
COZE_WORKLOAD_ENDPOINT=
COZE_PROJECT_ID=
COZE_POLL_ENABLED=true
COZE_POLL_INTERVAL_MS=1000
COZE_POLL_MAX_ATTEMPTS=8

# 小佛助手课程提醒：写操作必须经确认；调度默认关闭，配置完成后再启用
FOSU_AGENT_REMINDER_SECRET=
FOSU_WECHAT_RECIPIENT_SECRET=
FOSU_COURSE_REMINDER_DATA_DIR=
FOSU_WECHAT_RECIPIENT_DATA_DIR=
FOSU_COURSE_REMINDER_DISPATCH_ENABLED=false
FOSU_COURSE_REMINDER_DISPATCH_INTERVAL_MS=60000
WECHAT_COURSE_REMINDER_TEMPLATE_ID=
WECHAT_COURSE_REMINDER_DATA_FIELDS_JSON={"courseName":"thing1","startTime":"time2","classroom":"thing3","teacherName":"name4","campus":"thing5"}
WECHAT_REMINDER_MINIPROGRAM_STATE=formal
WECHAT_REMINDER_TIMEOUT_MS=5000

CLOUDBASE_OPENAI_ENABLED=false
CLOUDBASE_OPENAI_BASE_URL=https://cloud1-d3g17rpe7566d3d5c.api.tcloudbasegateway.com/v1/ai/cloudbase
CLOUDBASE_OPENAI_API_KEY=
CLOUDBASE_OPENAI_TEXT_MODEL=hy3-preview
CLOUDBASE_OPENAI_TIMEOUT_MS=15000
CLOUDBASE_OPENAI_MAX_TOKENS=1200

# OpenRouter（仅 trial/dev；public 仍强制 mock/tool-only）
OPENROUTER_ENABLED=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODELS=z-ai/glm-5.2:free,nvidia/nemotron-3-super-120b-a12b:free,liquid/lfm-2.5-2.6b:free,openrouter/free
OPENROUTER_TIMEOUT_MS=12000
OPENROUTER_MAX_TOKENS=800
AI_DISABLED_PROVIDERS=
FOSU_AI_CONFIG_ENCRYPTION_KEY=

# CORS 跨域域名授权白名单
CORS_ALLOWED_ORIGINS=https://class.katelya.eu.org,http://localhost:3000,http://127.0.0.1:18318

# ---- Progressive admin modernization ----
# Optional: restrict legacy ADMIN_API_TOKEN scopes (default admin:full)
# ADMIN_API_TOKEN_SCOPES=admin:full

# Optional scoped service tokens (JSON array). Never put real secrets in example.
# ADMIN_SERVICE_TOKENS=[{"name":"stager","token":"...","scopes":["staging:init","staging:chunk","staging:finalize"]}]

# Migration-safe config validation (default false). Set true only after secrets migration.
FOSU_CONFIG_HARD_FAIL=false
