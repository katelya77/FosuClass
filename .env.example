# 强智教务系统测试学生账号 (仅用于本地或开发环境)
FOSU_STUDENT_ID=YOUR_STUDENT_ID
FOSU_PASSWORD=YOUR_PASSWORD

# 后台管理登录密码 (必须配置，生产环境不可缺失)
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# 后台管理静态 Token (可选，配置后可用作静态 Token 登录或 API 访问)
ADMIN_TOKEN=YOUR_ADMIN_TOKEN

# 强智同步客户端使用的 API Token (可选，若不配置会根据 ADMIN_PASSWORD 自动派生)
ADMIN_API_TOKEN=YOUR_ADMIN_API_TOKEN

# 公开 API 与静态 Release Pack 资源域名
FOSU_API_BASE_URL=https://class.katelya.eu.org
FOSU_STATIC_RELEASE_BASE_URL=/static/releases

# Optional: custom server storage dir. Defaults to server/storage when empty.
FOSU_STORAGE_DIR=

# Optional: sync generated Release Pack files into the OpenResty static directory after publish/rebuild.
OPENRESTY_HOST_RELEASE_DIR=/opt/1panel/www/sites/class.katelya.eu.org/index/static/releases
STATIC_RELEASE_SYNC_ENABLED=true
RELEASE_PACK_SRC=/app/storage/public/releases
OPENRESTY_STATIC_RELEASE_DIR=/openresty-static/releases
PUBLIC_BASE_URL=https://class.katelya.eu.org/static/releases
STATIC_RELEASE_KEEP_LATEST=3
STATIC_RELEASE_SYNC_VERIFY_HTTP=true
STATIC_RELEASE_SYNC_HTTP_TIMEOUT_MS=8000
STATIC_RELEASE_VERIFY_CONCURRENCY=2

# Production maintenance and resource guardrails.
FOSU_MAINTENANCE_ENABLED=true
FOSU_MAINTENANCE_INTERVAL_HOURS=24
FOSU_MAINTENANCE_START_DELAY_MS=60000
FOSU_RELEASE_RETENTION_COUNT=3
FOSU_RELEASE_RETENTION_DAYS=30
FOSU_JOB_SUCCESS_RETENTION_DAYS=14
FOSU_JOB_FAILED_RETENTION_DAYS=30
FOSU_STAGING_FILE_RETENTION_DAYS=14
FOSU_ARCHIVE_METADATA_RETENTION_DAYS=90
FOSU_TEMP_RETENTION_HOURS=24
FOSU_LOG_RETENTION_DAYS=30
FOSU_LOG_ROTATE_SIZE_MB=10
FOSU_DISK_WARNING_PERCENT=80
FOSU_DISK_CRITICAL_PERCENT=90
FOSU_MIN_FREE_DISK_GB=5

# Browser CORS allow-lists. Do not use "*" for production dynamic APIs.
FOSU_ALLOWED_ADMIN_ORIGINS=https://class.katelya.eu.org
FOSU_ALLOWED_PUBLIC_ORIGINS=
FOSU_TRUSTED_PROXY_IPS=

# Security rollout mode. Keep observe/public until miniprogram, OpenResty, and Cloudflare checks pass.
FOSU_SECURITY_MODE=observe
FOSU_DYNAMIC_API_SESSION_REQUIRED=false
WECHAT_APPID=
WECHAT_APPSECRET=
FOSU_SESSION_SECRET_CURRENT=
FOSU_SESSION_SECRET_PREVIOUS=
FOSU_SESSION_SECRET_KID=current
FOSU_SESSION_TTL_SECONDS=7200
FOSU_CSRF_SECRET=
FOSU_STATIC_ACCESS_MODE=public
FOSU_OPENRESTY_STATIC_SECURITY_MODE=public
FOSU_STATIC_TICKET_SECRET_CURRENT=
FOSU_STATIC_TICKET_SECRET_PREVIOUS=
FOSU_STATIC_TICKET_SECRET_KID=current
FOSU_STATIC_TICKET_TTL_SECONDS=600
FOSU_STATIC_TICKET_CACHE_MAX=500
# Deprecated compatibility only. Do not use in production ticket mode.
FOSU_STATIC_TICKET_SECRET=

# Release Pack heavy jobs run in a child process so API health/job polling stay responsive.
FOSU_RELEASE_WORKER_ENABLED=true
FOSU_RELEASE_PRECOMPRESS=gzip
FOSU_RELEASE_BROTLI_ENABLED=false
FOSU_RELEASE_COMPRESSION_CONCURRENCY=1
