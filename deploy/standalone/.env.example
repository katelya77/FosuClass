# ============================================================================
# FosuClass 小佛 Agent 平台 — standalone 环境变量模板
#
# 用法：cp .env.example .env，然后逐项填值。本文件全部为占位值，
#       不包含任何真实域名、Token 或密钥；切勿把真实凭据提交进仓库。
# 随机密钥生成提示（Linux/macOS/Git Bash 均可）：
#   openssl rand -hex 24
# ============================================================================

# ---- 镜像（生产必填；纪律：禁止 floating latest）----
# 生产必须按 commit SHA tag 或 digest 固定，例如：
#   AGENT_PLATFORM_IMAGE=fosu-agent-platform
#   AGENT_PLATFORM_VERSION=9f3a1c2                 # git commit SHA tag
# 或：
#   AGENT_PLATFORM_IMAGE=registry.example.com/fosu-agent-platform@sha256:<digest>
# 默认 local 仅用于本地 docker compose build 回退，不是生产依据。
AGENT_PLATFORM_IMAGE=fosu-agent-platform
AGENT_PLATFORM_VERSION=local
# 本地构建时写入 OCI label 的元数据（可选）：
#   AGENT_PLATFORM_GIT_REVISION=$(git rev-parse HEAD)
#   AGENT_PLATFORM_BUILD_CREATED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
AGENT_PLATFORM_GIT_REVISION=
AGENT_PLATFORM_BUILD_CREATED=

# ---- PostgreSQL（必填）----
# 密码必填且必须够强；生成：openssl rand -hex 24
AGENT_PG_USER=agent
AGENT_PG_PASSWORD=
AGENT_PG_DATABASE=agent_platform
# 可选：完整连接串，设置后优先于离散项（一般留空，用上面的离散项即可）。
AGENT_PG_URL=
# 可选：托管 PG 自签证书时设 require；本地 compose 内网留空。
AGENT_PG_SSL=

# ---- Redis（必填）----
# 指向 compose 内部 redis 服务；Redis 只做队列暂存，不是权威事实源。
AGENT_REDIS_URL=redis://redis:6379/0
# 可选：给内部 Redis 加密码。一旦设置，必须同步把上面的 URL 改为：
#   AGENT_REDIS_URL=redis://:<password>@redis:6379/0
AGENT_REDIS_PASSWORD=

# ---- 持久化后端与角色 ----
# standalone 必须为 postgres（file 仅 integrated/本地开发）。
FOSU_AGENT_REPOSITORY_BACKEND=postgres
# 角色由 compose 各服务固定注入（server/worker/migrate），此处无需设置；
# 仅在本机裸跑 node server/src/standalone/agentServerMain.js 时才需要：
# AGENT_PLATFORM_ROLE=server
# AGENT_PLATFORM_PORT=8080

# ---- 宿主端口发布 ----
# 默认仅绑回环；公网暴露请交给反向代理（见 docs/deployment/1panel.md）。
AGENT_PLATFORM_HOST_BIND=127.0.0.1
AGENT_PLATFORM_HOST_PORT=8080

# ---- Admin 控制台鉴权（server 角色必填至少一项）----
# 全权管理令牌；生成：openssl rand -hex 24
AGENT_PLATFORM_ADMIN_TOKEN=
# 可选：细粒度 service token 列表（JSON 数组，元素 {"name","token","scopes"}）。
# 留空 = 仅全权令牌可用。
AGENT_PLATFORM_SERVICE_TOKENS=

# ---- Provider 凭据（可选；留空 = 未配置）----
# public 模式零外部 Provider 调用（确定性能力仍可跑）。
# trial/dev 的 strict_model_first 在 Provider 未配置时 readiness 如实 not ready，
# 平台不会用 Mock 冒充真实 Provider。凭据只经本文件/Secret 注入，不进日志。
AGENT_PLATFORM_RUNTIME_MODE=public
# Provider 声明（JSON 数组，元素 {"id","apiKeyEnv","baseUrl"?}）；apiKeyEnv
# 指向本文件中的变量名，平台只按名读取，不落库、不进日志、不进 Trace。
# 例：AGENT_PLATFORM_PROVIDERS=[{"id":"deepseek","apiKeyEnv":"DEEPSEEK_API_KEY"}]
AGENT_PLATFORM_PROVIDERS=
# 被 AGENT_PLATFORM_PROVIDERS 引用的密钥变量（示例占位，按实际声明增删）：
DEEPSEEK_API_KEY=
