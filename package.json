{
  "name": "fosuclass",
  "version": "1.0.0",
  "description": "面向佛山大学的原生微信小程序课表模板。V4 开始把脱敏 HAR 样本沉淀为强智教务接口适配层，产品侧采用“云函数同步 + 小程序读取缓存”的长期架构。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "analyze:har": "node tools/analyze-third-party-har.js",
    "sync:teachers": "npm --prefix tools/fosu-sync-client run sync:teachers",
    "sync:classrooms": "npm --prefix tools/fosu-sync-client run sync:classrooms",
    "sync:courses": "npm --prefix tools/fosu-sync-client run sync:courses",
    "sync:release": "npm --prefix tools/fosu-sync-client run sync:release",
    "sync:resources": "npm --prefix tools/fosu-sync-client run sync:resources",
    "sync:upload-cache": "npm --prefix tools/fosu-sync-client run sync:upload-cache",
    "sync:fresh": "npm --prefix tools/fosu-sync-client run sync:fresh",
    "sync:quick": "npm --prefix tools/fosu-sync-client run sync:quick",
    "test:course-normalizer": "node tools/test-course-normalizer.js",
    "test:personal-encrypt": "node server/scripts/test-personal-encrypt.js",
    "test:personal-parser": "node server/scripts/test-personal-parser.js",
    "sync:personal": "node server/scripts/sync-personal.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katelya77/FosuClass.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/katelya77/FosuClass/issues"
  },
  "homepage": "https://github.com/katelya77/FosuClass#readme",
  "dependencies": {
    "axios": "^1.16.1",
    "axios-cookiejar-support": "^7.0.0",
    "iconv-lite": "^0.7.2",
    "tough-cookie": "^6.0.1"
  }
}
